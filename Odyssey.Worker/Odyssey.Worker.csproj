<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Odyssey.Worker-6b0d6f3e-8a52-4d5f-9b0a-3f6d2a9c41e7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- The thumbnail decoder (issue #362): this project is the only one that may reference it. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Odyssey.Worker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The coder allow-list and the self-test's positive controls (issue #362 §6). -->
    <EmbeddedResource Include="Thumbnails\policy.xml" LogicalName="Odyssey.Worker.Thumbnails.policy.xml" />
    <EmbeddedResource Include="Thumbnails\SelfTest\*" LogicalName="Odyssey.Worker.Thumbnails.SelfTest.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Odyssey.Context\Odyssey.Context.csproj" />
    <!-- The jobs themselves live in Odyssey.Core (Odyssey.Core.Jobs.IPeriodicJob); this project only hosts them. -->
    <ProjectReference Include="..\Odyssey.Core\Odyssey.Core.csproj" />
    <ProjectReference Include="..\Odyssey.Dtos\Odyssey.Dtos.csproj" />
  </ItemGroup>
</Project>
