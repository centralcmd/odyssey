# Production environment file. Copy to .env.prod on the server and fill in real values.
# NEVER commit .env.prod — it holds secrets. (.env* is already gitignored.)
#
# Deploy with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod pull
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Every secret still in this file is deliberately EMPTY rather than a "CHANGE_ME" placeholder: an
# unedited copy must fail the deploy, and a placeholder that is a valid value does not. Compose
# refuses on the required ones before pulling an image, and if a CHANGE_ME value reaches a host
# anyway — copied from an older .env.prod or from the docs — startup refuses too
# (PlaceholderConfigurationGuard).
#
# Only four deploy-time secrets remain: the two database passwords and the bootstrap administrator.
# The five application credentials moved into the encrypted secret store (issue #445) and are entered
# at System Settings -> Credentials; the sections below say so where they used to live.

# ── Release selection ────────────────────────────────────────────────────────
# GitHub owner/org that hosts the GHCR images (the <owner> in ghcr.io/<owner>/odyssey-api).
GHCR_OWNER=your-github-user
# Immutable SemVer tag to deploy. Bump this and re-run pull+up to upgrade. Avoid "latest"
# in production so you control exactly when new schema migrations run.
IMAGE_TAG=0.7.0

# ── Public URL / TLS ─────────────────────────────────────────────────────────
# The domain Caddy serves and requests a Let's Encrypt cert for. Must already point (A/AAAA)
# at this server, with ports 80 and 443 reachable.
ODYSSEY_DOMAIN=odyssey.example.com

# ── Runtime ──────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
SWAGGER_ENABLED=false
USE_IN_MEMORY_DATABASE=false

# ── Database (use strong, unique secrets) ────────────────────────────────────
# Left EMPTY on purpose (issue #451 §1.4). The previous CHANGE_ME_* placeholders were valid values,
# so an operator who edited only ODYSSEY_DOMAIN and GHCR_OWNER deployed with database passwords
# published in this repository. docker-compose.prod.yml guards both with `${VAR:?...}`, which refuses
# at `docker compose config` — before an image is even pulled. Generate each with:
#   openssl rand -base64 36
# MARIADB_ROOT_PASSWORD is the one value no application host ever reads, so that compose guard is the
# only thing standing behind it. Do not reuse the app password for it.
MARIADB_ROOT_PASSWORD=
MARIADB_USER=odyssey
MARIADB_PASSWORD=
# One EF context, one database, named "odyssey" by default. It cannot be split: identity, finance
# and journal are a single model with real foreign keys between them.
MARIADB_DATABASE=odyssey
ODYSSEY_DATABASE=odyssey

# ── Bootstrap administrator (REQUIRED on a fresh database) ───────────────────
# The first administrator is created from these values by the migrations job — registration
# order grants nobody any privilege. Applied ONLY when the database has no users at all;
# ignored on every later deploy, so this is not a way to reset a forgotten password (use the
# forgot-password flow). The deploy FAILS on an empty database if these are unset. The
# password is a ONE-TIME secret: the account cannot use the app until it is changed at first
# sign-in. Must satisfy the password policy (16+ chars, upper + lower + digit + symbol).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Legal / audit pseudonymisation (now entered in the UI) ────────────
# LEGAL_PSEUDONYMIZATION_SECRET is gone (issue #445 Wave 4). The salt lives in the encrypted secret
# store and is entered once at System Settings -> Credentials, after this upgrade. Startup no longer
# fails without it; the FIRST ACCOUNT DELETION does, with the remedy in the message.
#
# UPGRADING AN EXISTING DEPLOYMENT: this is a DERIVATION key. If any consent rows were already
# pseudonymised under your old environment value, enter that SAME value — a different one leaves those
# rows permanently un-re-derivable, which is the property GDPR Art. 7(1) attribution depends on. Copy
# it out of your current .env.prod BEFORE removing it. Generate a new one only for a fresh deployment:
#   openssl rand -base64 48

# ── Demo data ───────────────────────────────────────────────────────
# Never seed the demo dataset on a production instance: it creates four accounts, one of them
# Admin, sharing a password published in this repository's README. docker-compose.prod.yml pins
# this to false and the migration service seeds only in Development/Testing regardless; this line
# exists so the base compose file's `true` default can never apply to a prod env-file.
SEED_DEMO_DATA=false

# ── Registration / email ─────────────────────────────────────────────────────
# Registration approval and email-confirmation policy are no longer static config (issue #349) —
# they're admin-editable at runtime via the System Settings page, backed by the database.
# Real SMTP is required in production or confirmation/reset links are only logged, not sent.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_USE_STARTTLS=true
# EMAIL_USERNAME / EMAIL_PASSWORD are gone (issue #445 Wave 2) — enter the relay credential once at
# System Settings -> Credentials. Until you do, TRANSACTIONAL MAIL IS NOT SENT: confirmation and
# password-reset messages are logged and skipped rather than attempted unauthenticated.
EMAIL_FROM_ADDRESS=no-reply@odyssey.example.com
EMAIL_FROM_NAME=Odyssey
# Public base URL — confirmation/reset links point here. MUST be your real https domain.
EMAIL_CLIENT_BASE_URL=https://odyssey.example.com

# ── AI file analysis (Claude) ────────────────────────────────────────────────
# Extracts transactions from uploaded statements/receipts. Requires an Anthropic API key.
#
# FILE_ANALYSIS_API_KEY is gone (issue #445 Wave 1): the key moved into the encrypted secret store and
# is entered at System Settings -> Credentials. Until it is, every analysis job is recorded as failed
# with a credential problem. Nothing else changes — the key still travels to whatever base URL is in
# force, so repoint that only to a host you control or trust.
#
# The switch, the model and the destination are admin-editable in System Settings -> File analysis
# (issue #439). The three variables below are read ONLY by the migrations job, once, to carry a value
# you had configured before upgrading into the store; after that the UI owns them and these are
# ignored. Leaving one empty means the shipped default applies — which is why analysis is OFF unless
# an administrator turns it on, or unless FILE_ANALYSIS_ENABLED=true is set here before the first
# upgrade.
FILE_ANALYSIS_ENABLED=true
FILE_ANALYSIS_MODEL=
FILE_ANALYSIS_BASE_URL=
