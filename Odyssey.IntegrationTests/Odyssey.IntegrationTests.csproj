<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- UserAdministrationService's delete-with-pseudonymization is transactional, and a real
         transaction is the one thing EF InMemory cannot model — so the test that proves it rolls back
         as a unit has to drive the real service against a real engine, from this tier. -->
    <ProjectReference Include="..\Odyssey.Dtos\Odyssey.Dtos.csproj" />
    <ProjectReference Include="..\Odyssey.Api\Odyssey.Api.csproj" />
    <ProjectReference Include="..\Odyssey.Context\Odyssey.Context.csproj" />
    <ProjectReference Include="..\Odyssey.Core\Odyssey.Core.csproj" />
    <ProjectReference Include="..\Odyssey.MigrationService\Odyssey.MigrationService.csproj" />
    <ProjectReference Include="..\Odyssey.TestData\Odyssey.TestData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared skip-or-fail rule for the self-skipping tiers (issue #257); linked, not referenced. -->
    <Compile Include="..\TestShared\TestTierGate.cs" Link="TestShared\TestTierGate.cs" />
    <Compile Include="..\TestShared\FileStorage\*.cs" Link="TestShared\FileStorage\%(Filename)%(Extension)" />
    <!-- The thumbnail scenarios (issue #362), rerun on MariaDB by PhotoThumbnailRelationalScenarioTests. -->
    <Compile Include="..\Odyssey.Core.Tests\FileStorage\FileStorageTestBase.cs" Link="CoreScenarios\FileStorageTestBase.cs" />
    <Compile Include="..\Odyssey.Core.Tests\Thumbnails\PhotoThumbnailTestBase.cs" Link="CoreScenarios\PhotoThumbnailTestBase.cs" />
    <Compile Include="..\Odyssey.Core.Tests\Thumbnails\ThumbnailFixtures.cs" Link="CoreScenarios\ThumbnailFixtures.cs" />
    <Compile Include="..\Odyssey.Core.Tests\Thumbnails\PhotoThumbnailJobScenarios.cs" Link="CoreScenarios\PhotoThumbnailJobScenarios.cs" />
    <Compile Include="..\Odyssey.Core.Tests\Thumbnails\PhotoThumbnailRenameScenarios.cs" Link="CoreScenarios\PhotoThumbnailRenameScenarios.cs" />
  </ItemGroup>

</Project>
