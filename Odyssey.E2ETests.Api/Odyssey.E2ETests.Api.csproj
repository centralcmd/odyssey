<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Seeded demo credentials/data to assert against, and the canonical role -> claim sets. -->
    <ProjectReference Include="..\Odyssey.ApiClient\Odyssey.ApiClient.csproj" />
    <ProjectReference Include="..\Odyssey.TestData\Odyssey.TestData.csproj" />
    <ProjectReference Include="..\Odyssey.Context\Odyssey.Context.csproj" />
    <!-- Enum values (ContactType/AccountType/InsurancePolicyType) for building request bodies. -->
    <ProjectReference Include="..\Odyssey.Dtos\Odyssey.Dtos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
