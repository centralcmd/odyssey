@*
    OdsFilesTable — the attachments surface (Odyssey Design System · components/FilesTable).

    THE files table shared by the flat Files page, the Accounts detail and the
    Transactions detail/edit panels. A PRESET of OdsRecordTable: it inherits the
    record-row lifecycle (sortable headers, the Saved flash, the overflow menu)
    and fixes the file-specific parts — the columns and the Edit-file dialog.

    ROWS DON'T EXPAND: every field is a column. Columns: kind avatar · Name ·
    Type · Size · Uploaded (default sort, newest first) · actions, plus the
    read-only document-validity set (Valid from · Valid to · Issued · Issued by)
    when ValidityColumns is set. `TypeFor` resolves each row's kind visuals
    (icon + color + soft tint) so a kind reads the same here as in the upload
    picker; unknown kinds fall back to the neutral document glyph.

    Row lifecycle:
      • "Edit" (menu) → the standard OdsFilesEditDialog for a file's mutable
        fields. The default dialog edits name + document type (Kinds feeds the
        picker, Issuers adds the validity fields) and commits an OdsFileEdit
        patch through OnSave; supply RenderEdit for a different field set (e.g.
        the flat Files page's name + description). Edit only appears when the
        table can persist the result.
      • Actions(file) supplies the file-specific menu items — Preview (the
        document viewer) / Download / Analyze / Copy ID — slotted between Edit and
        Delete per the menu convention. Host any modals those open OUTSIDE the table.
      • OnDelete appends the danger Delete item after a divider.
*@

<OdsRecordTable TRow="OdsFilesRow"
                Rows="@Files"
                RowKey="@(f => (object)f.Id)"
                Columns="@_columns"
                DefaultSort="@(DefaultSort ?? DefaultUploadedSort)"
                Sort="@Sort"
                SortChanged="@SortChanged"
                ServerSort="@ServerSort"
                Class="@Class"
                AriaLabel="@(AriaLabel ?? "Files")"
                Actions="BuildActions"
                OnDelete="HandleDelete"
                Loading="@Loading"
                Refetching="@Refetching"
                Error="@Error"
                OnRetry="@OnRetry"
                ErrorDescription="@ErrorDescription"
                HasFilters="@HasFilters"
                OnClearFilters="@OnClearFilters"
                Noun="@Noun"
                EmptyIcon="@EmptyIcon"
                EmptyTitle="@EmptyTitle"
                EmptyDescription="@EmptyDescription"
                CreateAction="@CreateAction"
                BarClass="@BarClass"
                Empty="@Empty">
    <Leading Context="file">
        @{ var kind = ResolveKind(file); }
        <span class="odc-ft-kind" style="background:@kind.Soft;color:@kind.Color;">
            <span class="material-icons" aria-hidden="true">@kind.Icon</span>
        </span>
    </Leading>
</OdsRecordTable>

@* The Edit dialog lives OUTSIDE the table, like every other modal a row action opens. *@
@if (_editRow is not null)
{
    @EditFragment(_editRow)
}

@code {
    private RenderFragment TypeChip(OdsFilesRow file)
    {
        var kind = ResolveKind(file);
        return @<span class="odc-ft-type" style="background:@kind.Soft;color:@kind.Color;">@file.Kind</span>;
    }

    private List<OdsRecordColumn<OdsFilesRow>> BuildColumns()
    {
        var columns = new List<OdsRecordColumn<OdsFilesRow>>
        {
            new()
            {
                Key = "name", HeaderText = "Name", Sortable = true,
                SortValue = f => f.Name.ToLowerInvariant(),
                Cell = (file, ctx) =>
                    @<span class="odc-ft-name-cell">
                        <span class="odc-ft-name-text">
                            <span class="odc-ft-name" title="@file.Name">@file.Name</span>
                            @if (!string.IsNullOrWhiteSpace(file.Description))
                            {
                                <span class="odc-ft-desc" title="@file.Description">@file.Description</span>
                            }
                        </span>
                        @* The flash is the table's own now that editing happens in a dialog rather than
                           through OdsRecordTable's edit lifecycle; ctx.JustSaved still covers a host
                           that saves through the record table directly. *@
                        @if (ctx.JustSaved || _savedIds.Contains(file.Id))
                        {
                            <OdsChip Tone="OdsChipTone.Income" Dot="true">Saved</OdsChip>
                        }
                        @if (file.StatusBadge is { } badge)
                        {
                            <OdsChip Tone="badge.Tone" Icon="@badge.Icon" Dot="@(string.IsNullOrEmpty(badge.Icon))">
                                @* The accessible name (file + count) is carried in a visually-hidden text node, not an
                                   aria-label on the visible span: a span's implicit role is `generic`, which prohibits
                                   aria-label, so screen readers would otherwise hear only the short visible text. *@
                                @if (!string.IsNullOrEmpty(badge.AriaLabel))
                                {
                                    <span class="sr-only">@badge.AriaLabel</span>
                                    <span aria-hidden="true">@badge.Text</span>
                                }
                                else
                                {
                                    @badge.Text
                                }
                            </OdsChip>
                        }
                    </span>,
            },
            new()
            {
                Key = "kind", HeaderText = "Type", Sortable = true, SortType = OdsSortType.Status,
                SortValue = f => f.Kind.ToLowerInvariant(),
                Cell = (file, _) => TypeChip(file),
            },
            new()
            {
                Key = "size", HeaderText = "Size", Sortable = true, Align = OdsAlign.End, SortType = OdsSortType.Number,
                CellClass = "odc-rec-muted", SortValue = f => f.SizeBytes,
                Cell = (file, _) => b => b.AddContent(0, SizeText(file)),
            },
            new()
            {
                Key = "uploaded", HeaderText = "Uploaded", Sortable = true, Align = OdsAlign.End, SortType = OdsSortType.Date,
                CellClass = "odc-rec-muted", SortValue = f => f.UploadedAtUtc,
                Cell = (file, _) => b => b.AddContent(0, DateText(file.UploadedAtUtc)),
            },
        };

        // Document-validity metadata (opt-in — only surfaces that track it, e.g. account files).
        // Read-only here: the values are edited in the Edit-file dialog. Dates use the compact
        // form — four extra date columns can't each carry a long-form date without overflowing.
        if (ValidityColumns)
            columns.AddRange(
            [
                new()
                {
                    Key = "validFrom", HeaderText = "Valid from", Sortable = true, Align = OdsAlign.End,
                    SortType = OdsSortType.Date, CellClass = "odc-rec-muted", SortValue = f => f.ValidFrom,
                    Cell = (file, _) => b => b.AddContent(0, ShortDateText(file.ValidFrom)),
                },
                new()
                {
                    Key = "validTo", HeaderText = "Valid to", Sortable = true, Align = OdsAlign.End,
                    SortType = OdsSortType.Date, CellClass = "odc-rec-muted", SortValue = f => f.ValidTo,
                    Cell = (file, _) => b => b.AddContent(0, ShortDateText(file.ValidTo)),
                },
                new()
                {
                    Key = "issuedAt", HeaderText = "Issued", Sortable = true, Align = OdsAlign.End,
                    SortType = OdsSortType.Date, CellClass = "odc-rec-muted", SortValue = f => f.IssuedAt,
                    Cell = (file, _) => b => b.AddContent(0, ShortDateText(file.IssuedAt)),
                },
                new()
                {
                    Key = "issuedBy", HeaderText = "Issued by", Sortable = true, CellClass = "odc-rec-muted",
                    SortValue = f => (IssuerName(f) ?? string.Empty).ToLowerInvariant(),
                    Cell = (file, _) => b => b.AddContent(0, IssuerName(file) ?? "—"),
                },
            ]);

        return columns;
    }


    // Default Edit dialog: name + document type — a file's mutable fields (bytes are immutable;
    // you replace a file by re-uploading) — plus the validity fields when Issuers is supplied.
    private RenderFragment DefaultEditDialog(OdsFilesRow file) =>
        @<OdsFilesEditDialog @key="_editKey"
                             File="file"
                             Open="_editOpen"
                             OpenChanged="OnEditOpenChanged"
                             Kinds="@(Kinds ?? OdsTypeRegistries.AccountFileOptions)"
                             Issuers="Issuers"
                             OnSave="@(patch => CommitEditAsync(file, patch))" />;
}
