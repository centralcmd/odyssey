@using Odyssey.Dtos
@*
    OdsContactTypeSelect — a single-select pre-wired to the ContactType
    vocabulary (Odyssey Design System · components/ContactTypeSelect).

    The two enum members, each rendered with its Material icon in its category
    color. A thin, domain-typed wrapper over the shared OdsTypeSelect — every prop
    (Help, Error, Required, Disabled, Class, unmatched attrs) passes straight
    through. Value is the enum key (Person · Organization). Bind via @bind-Value.
*@

<OdsTypeSelect Value="@Value"
               ValueChanged="ValueChanged"
               Types="OdsTypeRegistries.ContactTypes"
               Label="@Label"
               Placeholder="@Placeholder"
               Help="@Help"
               Error="@Error"
               Required="@Required"
               Disabled="@Disabled"
               Class="@Class"
               @attributes="UserAttributes" />

@code {
    /// <summary>Selected enum key. Bindable via @bind-Value.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? Label { get; set; } = "Type";

    [Parameter] public string? Placeholder { get; set; } = "Select type…";

    [Parameter] public string? Help { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }
}
