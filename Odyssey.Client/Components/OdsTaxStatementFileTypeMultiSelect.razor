@* DS parity — no consumer yet: the per-statement attachments section lists one statement's
   files and offers no type filter, so there is nothing to filter across. Its single-select
   sibling OdsTaxStatementFileTypeSelect is used to tag files on upload. *@
@*
    OdsTaxStatementFileTypeMultiSelect — the filter pre-wired to the
    TaxStatementFileType vocabulary (Odyssey Design System ·
    components/TaxStatementFileTypeMultiSelect).

    A checkbox-list popover whose rows each carry the type's Material icon in its
    category color, with a count badge on the trigger. A thin wrapper over
    OdsMultiSelect — Values + Align pass straight through. Defaults: trigger label
    "Any type", trigger glyph `request_quote`. Bind the chosen keys via @bind-Values.
*@

<OdsMultiSelect Values="@Values"
                ValuesChanged="ValuesChanged"
                Options="OdsTypeRegistries.TaxStatementFileOptions"
                Label="@Label"
                Icon="@Icon"
                Align="@Align"
                Class="@Class"
                @attributes="UserAttributes" />

@code {
    /// <summary>Selected enum keys. Bindable via @bind-Values.</summary>
    [Parameter] public IReadOnlyCollection<string> Values { get; set; } = [];

    [Parameter] public EventCallback<IReadOnlyCollection<string>> ValuesChanged { get; set; }

    [Parameter] public string? Label { get; set; } = "Any type";

    [Parameter] public string? Icon { get; set; } = "request_quote";

    [Parameter] public OdsAlign Align { get; set; } = OdsAlign.Start;

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }
}
