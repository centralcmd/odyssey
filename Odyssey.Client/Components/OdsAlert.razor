@*
    OdsAlert — a block-level notification banner (Odyssey Design System · components/Alert).

    A MudAlert with the Odyssey severity → color + icon mapping. Distinct from
    OdsChip (which is an inline pill): use this for a full-width message. Keep
    copy terse, sentence case. Errors get role="alert"; the rest are status.
*@

<MudAlert Severity="@MudSeverity"
          Variant="Variant.Filled"
          Dense="true"
          Class="@Class"
          @attributes="MergedAttributes">
    @ChildContent
</MudAlert>

@code {
    /// <summary>Sets the color and leading icon — info (default) / success / warning / error.</summary>
    [Parameter] public Severity Severity { get; set; } = Severity.Info;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }

    private Severity MudSeverity => Severity;

    // Announce alerts to assistive tech (WCAG 4.1.3 Status Messages). MudAlert emits no live role of its
    // own, so an alert that appears dynamically (e.g. a save error) would be silent. Errors/warnings get
    // role="alert" (implicitly assertive); info/success get role="status" (implicitly polite). A
    // caller-supplied role always wins.
    private Dictionary<string, object> MergedAttributes
    {
        get
        {
            var attrs = UserAttributes is null
                ? new Dictionary<string, object>(StringComparer.Ordinal)
                : new Dictionary<string, object>(UserAttributes, StringComparer.Ordinal);

            if (!attrs.ContainsKey("role"))
            {
                attrs["role"] = Severity is Severity.Error or Severity.Warning ? "alert" : "status";
            }

            return attrs;
        }
    }
}
