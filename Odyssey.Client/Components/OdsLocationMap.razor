@using Odyssey.Client.Components
@using Odyssey.Client.Pages.Journal
@implements IAsyncDisposable

@*
    OdsLocationMap — one map with one pin, the Map band of an expanded record (issue #371; design system ·
    components/LocationMap, "Locations → Map band"). Two features draw it: a location's record and a weather
    point's (the point's current position), so it lives in Components/ rather than beside the Locations page. MapLibre is driven through wwwroot/js/location-map.js, the only file that
    touches it; this component owns the state machine, the theme, the caption and the announcements.
*@

<div class="loc-map" style="@RootStyle">
    @if (ShowsFrame)
    {
        <span id="@DescriptionId" class="sr-only">Pin at @LocationVisuals.FormatHemispheres(Latitude, Longitude).</span>
        <span id="@KeysId" class="sr-only">Arrow keys pan, plus and minus zoom.</span>
        <div class="loc-map-frame" tabindex="-1" @ref="_frame"
             aria-busy="@(_state == OdsLocationMapState.Loading ? "true" : null)">
            <div class="loc-map-host" @ref="_host"></div>
            @if (_state == OdsLocationMapState.Loading)
            {
                <div class="loc-map-skeleton">
                    <OdsSkeleton Variant="OdsSkeletonVariant.Block" Width="100%" Height="100%" />
                </div>
            }
        </div>
        @if (_state == OdsLocationMapState.Degraded)
        {
            <OdsAlert Severity="Severity.Warning" Live="OdsAlertLive.None" Class="loc-map-alert">
                Some map tiles didn't load. The tile service may be slow.
            </OdsAlert>
        }
        @if (ShowsCaption && _styles is { } styles)
        {
            <p class="loc-map-caption">
                <span class="material-icons" aria-hidden="true">map</span>
                <span>Basemap</span>
                <a href="@styles.AttributionUrl" target="_blank" rel="noopener noreferrer">
                    @styles.Attribution<span class="material-icons" aria-hidden="true">open_in_new</span><span class="sr-only"> (opens in a new tab)</span>
                </a>
            </p>
        }
    }
    else
    {
        <div class="loc-map-state" tabindex="-1" @ref="_stateBox">
            <OdsEmptyLine Pad="OdsSize.Sm" Text="@StateText" />
            @if (CanRetry)
            {
                <OdsButton Variant="OdsButtonVariant.Text" Icon="refresh" OnClick="RetryAsync">Try again</OdsButton>
            }
        </div>
    }
</div>
