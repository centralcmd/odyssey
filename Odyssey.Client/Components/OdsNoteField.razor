@*
    OdsNoteField — a labelled multi-line input with a live character counter
    (Odyssey Design System · components/NoteField).

    The canonical "note / description / comment" field. Consolidates the textarea +
    counter that was hand-rolled across the create/edit dialogs (.trm-textarea +
    .trm-charcount / .est-charcount). Built on OdsFieldShell: the label row carries the
    required marker on the left and the "0/512" counter on the right; the
    counter turns red once the length reaches MaxLength. For a single-line value use
    OdsField; for a money / numeric value use OdsAmountField.

    Controlled: bind via @bind-Value.

    Long-text settings (issue #434) need the counter without the truncation:
    CounterMax shows the counter independently of MaxLength (which keeps meaning
    "set the native maxlength attribute"), and CountLength supplies the count, so a
    setting can count what the server will store. The visible counter is
    aria-hidden; an sr-only twin ("{n} of {max} characters") is appended to
    aria-describedby. At the limit a visible "Character limit reached" sits beside
    the number and above it "{n} over limit", so colour is never the only signal.
    ReadOnly renders readonly + aria-readonly (focusable, selectable, copyable),
    never disabled. A caller's AriaDescribedBy is merged ahead of the field's own ids.
    The sr-only twin is read when the field is focused, not live: a caller that wants threshold
    announcements makes them itself (the settings guidance rows do, debounced and edge-triggered).
*@

<OdsFieldShell Label="@Label" HtmlFor="@FieldId" Required="@Required"
               Help="@Help" Error="@Error" Class="@Class" Aside="@Counter">
    <textarea id="@FieldId"
              class="odc-input odc-input-multiline"
              rows="@Rows"
              value="@Value"
              placeholder="@Placeholder"
              maxlength="@MaxLength"
              disabled="@Disabled"
              readonly="@ReadOnly"
              aria-readonly="@(ReadOnly ? "true" : null)"
              spellcheck="@Spellcheck"
              autocomplete="@AutoComplete"
              autocapitalize="@AutoCapitalize"
              autofocus="@AutoFocus"
              aria-required="@(Required ? "true" : null)"
              aria-invalid="@(string.IsNullOrEmpty(Error) ? null : "true")"
              aria-describedby="@DescribedBy"
              @oninput="OnInput"
              @attributes="UserAttributes"></textarea>
</OdsFieldShell>

@code {
    /// <summary>Visible label, rendered above the control.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Field value. Bindable via @bind-Value.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Maximum length — also drives the character counter.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Visible rows (the textarea stays resizable). Default 3.</summary>
    [Parameter] public int Rows { get; set; } = 3;

    /// <summary>
    /// Show the counter against this number without setting native <c>maxlength</c>. Defaults to
    /// <see cref="MaxLength"/>. A long-text setting passes this alone, so an over-limit paste is kept,
    /// counted and explained rather than silently truncated.
    /// </summary>
    [Parameter] public int? CounterMax { get; set; }

    /// <summary>Supplies the counted length (e.g. the server's normalised length). Defaults to <c>Value.Length</c>.</summary>
    [Parameter] public Func<string, int>? CountLength { get; set; }

    /// <summary><c>readonly</c> + <c>aria-readonly</c>: focusable and copyable. Never use Disabled for "you may look but not edit".</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Ids merged ahead of the field's own help, error and counter ids, de-duplicated.</summary>
    [Parameter] public string? AriaDescribedBy { get; set; }

    /// <summary>Rendered <c>spellcheck</c> value ("true"/"false"); omitted when null.</summary>
    [Parameter] public string? Spellcheck { get; set; }

    [Parameter] public string? AutoComplete { get; set; }

    [Parameter] public string? AutoCapitalize { get; set; }

    /// <summary>Show the "len/max" counter (requires MaxLength or CounterMax). Default true.</summary>
    [Parameter] public bool ShowCount { get; set; } = true;

    [Parameter] public string? Help { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool AutoFocus { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Id { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }

    private string FieldId = default!;

    protected override void OnInitialized() => FieldId = Id ?? $"odc-note-{Guid.NewGuid():N}";

    private int? Max => CounterMax ?? MaxLength;

    private bool Counted => ShowCount && Max.HasValue;

    private int Length => CountLength is { } count ? count(Value ?? "") : Value?.Length ?? 0;

    private string CountId => $"{FieldId}-count";

    private string? DescribedBy
    {
        get
        {
            var ids = new List<string>();
            if (!string.IsNullOrWhiteSpace(AriaDescribedBy))
            {
                ids.AddRange(AriaDescribedBy.Split(' ', StringSplitOptions.RemoveEmptyEntries));
            }

            var hasHelp = !string.IsNullOrEmpty(Help);
            var hasError = !string.IsNullOrEmpty(Error);
            if (hasHelp) ids.Add($"{FieldId}-help");
            // OdsFieldShell gives the error its own id only when a help node renders alongside it.
            if (hasError) ids.Add(hasHelp ? $"{FieldId}-help-error" : $"{FieldId}-help");
            if (Counted) ids.Add(CountId);

            return ids.Count == 0 ? null : string.Join(' ', ids.Distinct(StringComparer.Ordinal));
        }
    }

    private RenderFragment? Counter => Counted
        ? @<span class="odc-field-count @(Length >= Max ? "over" : null)">
              <span aria-hidden="true">@Length/@Max</span>
              @if (Length == Max)
              {
                  <span class="odc-field-count-note" aria-hidden="true"> · Character limit reached</span>
              }
              else if (Length > Max)
              {
                  <span class="odc-field-count-note" aria-hidden="true"> · @(Length - Max) over limit</span>
              }
              <span class="odc-sr-only" id="@CountId">@Length of @Max characters</span>
          </span>
        : null;

    private Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";
        return ValueChanged.InvokeAsync(Value);
    }
}
