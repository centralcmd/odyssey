@*
    OdsField — a labelled text input with helper / error states
    (Odyssey Design System · components/Field).

    A MudTextField (Outlined) carrying the Odyssey label + helper/error layout.
    Pass Error (string) to flip the field to its error state and replace the
    helper text. Icon renders a leading Material Icons adornment. InputType maps
    to the native input type (Text, Email, Password, Number, Search…).
    Set Multiline to render a resizable textarea (for long values like
    descriptions and notes); Rows controls the visible height (default 3).
    Two-way bindable via @bind-Value.

    InputType.Password gets a trailing show/hide reveal toggle (design update to
    components/Field.jsx) instead of any leading Icon — MudTextField exposes a
    single Adornment slot, so a password field's reveal button takes over that
    slot regardless of Icon, and its own Clearable (✕) is suppressed in favor of
    it, matching the design (which reuses the same trailing-icon position for
    either affordance, never both).
*@

<MudTextField T="string"
              Value="@Value"
              ValueChanged="OnValueChanged"
              Immediate="true"
              Label="@EffectiveLabel"
              Placeholder="@Placeholder"
              InputType="@EffectiveInputType"
              MaxLength="@(MaxLength ?? 524288)"
              Lines="@(Multiline ? Rows : 1)"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Adornment="@EffectiveAdornment"
              AdornmentIcon="@EffectiveAdornmentIcon"
              AdornmentColor="Color.Default"
              AdornmentAriaLabel="@EffectiveAdornmentAriaLabel"
              OnAdornmentClick="EffectiveOnAdornmentClick"
              Clearable="@(Clearable && !Multiline && !IsPassword)"
              HelperText="@(string.IsNullOrEmpty(Error) ? Help : null)"
              Error="@(!string.IsNullOrEmpty(Error))"
              ErrorText="@Error"
              Required="@Required"
              Disabled="@Disabled"
              AutoFocus="@AutoFocus"
              Class="@CssClass"
              @attributes="UserAttributes" />

@code {
    /// <summary>Visible label, rendered above the control.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Field value. Bindable via @bind-Value.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Native input type (Text, Email, Password, Number, Search…).</summary>
    [Parameter] public InputType InputType { get; set; } = InputType.Text;

    /// <summary>Maximum input length. Maps to the native maxlength; defaults to MudBlazor's 524288.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Render a multi-line, vertically resizable textarea instead of a single-line input.</summary>
    [Parameter] public bool Multiline { get; set; }

    /// <summary>Visible rows when <see cref="Multiline"/> is set (the textarea stays resizable). Default 3.</summary>
    [Parameter] public int Rows { get; set; } = 3;

    /// <summary>Leading Material Icons ligature name (e.g. "title", "place").</summary>
    [Parameter] public string? Icon { get; set; }

    // MudBlazor's AdornmentIcon needs an SVG icon CONSTANT — a Material Icons ligature renders nothing
    // (see the MudBlazor icon gotcha; same class of bug fixed in OdsButton). Resolve the ligature names
    // used for field icons to their SVG constants; an already-SVG value passes through, an unknown
    // ligature yields no adornment (the prior silent behavior, so no regression).
    private static readonly IReadOnlyDictionary<string, string> LigatureSvg = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["title"] = Icons.Material.Filled.Title,
        ["image"] = Icons.Material.Filled.Image,
        ["schedule"] = Icons.Material.Filled.Schedule,
        ["place"] = Icons.Material.Filled.Place,
        ["photo_album"] = Icons.Material.Filled.PhotoAlbum,
        ["event"] = Icons.Material.Filled.Event,
        ["my_location"] = Icons.Material.Filled.MyLocation,
        ["search"] = Icons.Material.Filled.Search,
        ["notes"] = Icons.Material.Filled.Notes,
        ["description"] = Icons.Material.Filled.Description,
        ["link"] = Icons.Material.Filled.Link,
        ["person"] = Icons.Material.Filled.Person,
        ["sell"] = Icons.Material.Filled.Sell,
    };

    private string? ResolvedIcon =>
        string.IsNullOrEmpty(Icon) ? null
        : Icon.StartsWith('<') ? Icon
        : LigatureSvg.GetValueOrDefault(Icon);

    // ── Password reveal (design update: components/Field.jsx) ─────────────────
    private bool _revealed;

    private bool IsPassword => InputType == InputType.Password;

    private InputType EffectiveInputType => IsPassword && _revealed ? InputType.Text : InputType;

    private Adornment EffectiveAdornment =>
        IsPassword ? Adornment.End
        : Multiline || ResolvedIcon is null ? Adornment.None
        : Adornment.Start;

    private string? EffectiveAdornmentIcon =>
        IsPassword ? (_revealed ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)
        : ResolvedIcon;

    private string? EffectiveAdornmentAriaLabel =>
        IsPassword ? (_revealed ? "Hide password" : "Show password") : null;

    private EventCallback<MouseEventArgs> EffectiveOnAdornmentClick =>
        IsPassword ? EventCallback.Factory.Create<MouseEventArgs>(this, ToggleRevealed) : default;

    private void ToggleRevealed() => _revealed = !_revealed;

    /// <summary>Helper text shown below the input.</summary>
    [Parameter] public string? Help { get; set; }

    /// <summary>Error message — flips the field to its error state and replaces the helper.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    /// <summary>Mark the field as optional — appends a muted "(optional)" to the label.
    /// (The DS renders a separate <c>.odc-field-opt</c> marker; MudBlazor owns this control's label
    /// element, so the marker is folded into the label text.)</summary>
    [Parameter] public bool Optional { get; set; }

    /// <summary>Show a trailing clear (✕) affordance that empties the value. Ignored for multiline.</summary>
    /// <summary>Focus the input when it first renders (e.g. the Name field of an inline editor).
    /// A real bool parameter so it maps to MudTextField.AutoFocus — passing it as a stray unmatched
    /// attribute would splat the string "true" onto a bool and throw, dropping the whole field.</summary>
    [Parameter] public bool AutoFocus { get; set; }

    [Parameter] public bool Clearable { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }

    private string? EffectiveLabel =>
        Optional && !string.IsNullOrEmpty(Label) ? $"{Label} (optional)" : Label;

    private string CssClass =>
        string.Join(' ', new[] { Multiline ? "odc-field-multiline" : null, Class }
            .Where(value => !string.IsNullOrEmpty(value)));

    private Task OnValueChanged(string value)
    {
        Value = value;
        return ValueChanged.InvokeAsync(value);
    }
}
