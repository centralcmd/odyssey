@*
    OdsFileUpload — the drag-and-drop upload field (Odyssey Design System · components/FileUpload).

    A click-or-drop dropzone plus a ready-file list where each row can be renamed,
    retyped via an inline file-kind picker (Statement / Document / Receipt / Tax),
    and removed. Built on MudFileUpload (the file-input mechanics + drag-and-drop)
    with the design-system dropzone + list chrome on top.

    Runs controlled (Files + FilesChanged) or uncontrolled (DefaultFiles). Each
    file is an OdsUploadFile { Uid, Name, Kind, SizeBytes }; FilesChanged fires
    the full next list on every add / rename / retype / remove. Compact gives the
    low-profile dropzone for tight modals; ShowKinds=false drops the kind picker.
*@

@using Microsoft.AspNetCore.Components.Forms

<div class="odc-upload" id="@Id">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                   Accept="@Accept"
                   AppendMultipleFiles="@Multiple"
                   FilesChanged="OnFilesChanged"
                   DragAndDrop="true"
                   @bind-Dragging="_dragging"
                   Class="ma-0 pa-0">
        <CustomContent Context="upload">
            @* The error is LINKED to the dropzone, not merely rendered under it: a failure attributable
               to a control has to reach assistive tech through that control (aria-invalid +
               aria-describedby), or a caller that moves focus here announces a button with no stated
               problem. Deliberately not role="alert" — focusing a control whose description IS the
               error already announces it, and both together announce it twice. *@
            <div class="odc-upload-drop @(Compact ? "compact" : null) @(_dragging ? "drag" : null) @(string.IsNullOrEmpty(Error) ? null : "has-error")"
                 role="button" tabindex="0"
                 aria-invalid="@(string.IsNullOrEmpty(Error) ? null : "true")"
                 aria-describedby="@(string.IsNullOrEmpty(Error) ? null : ErrorId)"
                 @onclick="@upload.OpenFilePickerAsync"
                 @onkeydown="@(e => OnDropzoneKey(e, upload))">
                <span class="odc-upload-drop-ic">
                    <span class="material-icons" aria-hidden="true" style="@(Compact ? "font-size:22px;" : "font-size:26px;")">cloud_upload</span>
                </span>
                <div class="odc-upload-drop-text">
                    <strong>Drop files here</strong> or <span class="odc-upload-drop-link">browse</span>
                </div>
                <div class="odc-upload-drop-hint">@EffectiveHint</div>
            </div>
        </CustomContent>
        @* Empty on purpose: without a SelectedTemplate MudFileUpload renders its own chip per picked
           file, a second file list above the ready-file list below — which is the DS's only one. *@
        <SelectedTemplate Context="_" />
    </MudFileUpload>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div id="@ErrorId" class="odc-upload-err">@Error</div>
    }

    @if (Current.Count > 0)
    {
        <div class="odc-upload-list">
            <div class="odc-upload-list-head">
                <span>@Current.Count file@(Current.Count == 1 ? "" : "s") ready</span>
                <span class="odc-upload-file-size">@OdsFileUploadDefaults.FmtSize(TotalBytes)</span>
            </div>
            <div class="odc-upload-list-scroll" style="@(MaxHeight is null ? null : $"max-height:{MaxHeight};")">
                @foreach (var file in Current)
                {
                    var kind = KindFor(file.Kind);
                    <div class="odc-upload-file @(RenderFileExtra is not null ? "has-meta" : null)" @key="file.Uid">
                        @if (ShowKinds)
                        {
                            <span class="odc-upload-file-ic" style="background:@kind.Soft;color:@kind.Color;">
                                <span class="material-icons" aria-hidden="true" style="font-size:20px;">@kind.Icon</span>
                            </span>
                        }
                        else
                        {
                            <span class="odc-upload-file-ic" style="background:var(--mud-palette-action-default-hover);color:var(--mud-palette-text-secondary);">
                                <span class="material-icons" aria-hidden="true" style="font-size:20px;">insert_drive_file</span>
                            </span>
                        }
                        <div class="odc-upload-file-main">
                            <input class="odc-upload-file-name" value="@file.Name" spellcheck="false" aria-label="File name"
                                   @oninput="@(e => Rename(file, e.Value?.ToString() ?? string.Empty))" />
                            <div class="odc-upload-file-sub">
                                @if (ShowKinds)
                                {
                                    @* Inline file-kind picker — delegates to the shared OdsTypeSelect engine (the
                                       same control behind AccountTypeSelect and the file-type pickers), so
                                       positioning, scrolling and keyboard/selection behaviour all match the rest of
                                       the app. Rendered compact via the .odc-upload-kind wrapper. *@
                                    <div class="odc-upload-kind">
                                        <OdsTypeSelect Value="@file.Kind"
                                                       ValueChanged="@(k => Retype(file, k))"
                                                       Types="EffectiveKindOptions"
                                                       Placeholder="Type"
                                                       AriaLabel="File type"
                                                       PopoverClass="odc-upload-kind-pop" />
                                    </div>
                                }
                                <span class="odc-upload-file-size">@OdsFileUploadDefaults.FmtSize(file.SizeBytes)</span>
                            </div>
                            @if (RenderFileExtra is not null)
                            {
                                <div class="odc-upload-file-extra">
                                    @RenderFileExtra(new OdsUploadFileExtraContext(file, EventCallback.Factory.Create(this, () => Commit([.. Current]))))
                                </div>
                            }
                        </div>
                        <button type="button" class="odc-upload-file-x" aria-label="Remove file" @onclick="@(() => Remove(file))">
                            <span class="material-icons" aria-hidden="true" style="font-size:18px;">close</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>
