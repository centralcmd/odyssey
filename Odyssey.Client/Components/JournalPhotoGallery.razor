@*
    JournalPhotoGallery — a responsive thumbnail grid over a journal entry's photos
    (Odyssey Design System · components/JournalPhotoGallery). Each tile is a real
    <button> (tab-order, Enter/Space, focus ring for free) with an accessible name
    (the photo's filename) that opens the full-res file via the host's OnOpen handler.

    Thumbnail-aware (issues #362 / #365): each tile is an OdsPhotoImage over the photo's
    Image — the 200 px Small thumbnail, then the original, then the striped placeholder,
    once each per Image value, silently. A runtime failure keeps the <img> with img-failed
    and reveals the .odc-photogrid-ph-fallback sibling. With NEITHER source the tile shows
    the placeholder directly; when Unavailable it reads "no access" and the tile's accessible
    name says so (WCAG 1.3.1). The lightbox always opens the original. The filename is never
    shown as a visible caption: it lives in the tile's accessible name and title tooltip only.
    The count is announced as text in the heading, never colour/icon alone.
*@

<section class="odc-photogrid @Class" aria-label="@AriaLabel">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="odc-photogrid-head">
            <span class="material-icons" aria-hidden="true">photo_library</span>
            <span class="odc-photogrid-title">@Title</span>
            <span class="odc-photogrid-count">@Photos.Count</span>
        </div>
    }

    @if (Photos.Count == 0)
    {
        <div class="odc-photogrid-empty">@EmptyText</div>
    }
    else
    {
        <ul class="odc-photogrid-list" style="grid-template-columns: repeat(auto-fill, minmax(@(MinTile)px, 1fr));">
            @foreach (var (p, index) in Photos.Select((photo, i) => (photo, i)))
            {
                var noAccess = p.Image.IsEmpty && p.Unavailable;
                // An unnamed photo still needs a distinct accessible name, so a grid of untitled tiles is not a
                // row of identical "Open photo" buttons. Its position, not its id: a GUID read out character by
                // character distinguishes the tiles but describes none of them (WCAG 2.4.6).
                var name = string.IsNullOrEmpty(p.Name) ? $"{index + 1} of {Photos.Count}" : p.Name;
                <li class="odc-photogrid-item" @key="p.Id">
                    <button type="button" class="odc-photogrid-tile"
                            aria-label="@($"Open photo {name}{(noAccess ? " (no access)" : "")}")"
                            title="@(string.IsNullOrEmpty(p.Name) ? null : p.Name)"
                            @onclick="@(() => OnOpen.InvokeAsync(p))">
                        @if (!p.Image.IsEmpty)
                        {
                            <OdsPhotoImage Source="p.Image" Alt="@p.Name" Class="odc-photogrid-img"
                                           PlaceholderClass="odc-photogrid-ph odc-photogrid-ph-fallback">
                                <Placeholder><span class="odc-photogrid-ph-label mono">photo</span></Placeholder>
                            </OdsPhotoImage>
                        }
                        else
                        {
                            <span class="odc-photogrid-ph" aria-hidden="true">
                                <span class="odc-photogrid-ph-label mono">@(noAccess ? "no access" : "photo")</span>
                            </span>
                        }
                    </button>
                </li>
            }
        </ul>
    }
</section>

@code {
    /// <summary>A gallery photo: a stable id, a display filename and its image sources (thumbnail, original).
    /// <c>Unavailable</c> marks a photo the caller can see neither source of; it changes the placeholder's
    /// label and the tile's accessible name only when both sources are absent. The host's lightbox opens the
    /// original, never the thumbnail.</summary>
    public sealed record Photo(string Id, string Name, PhotoImageSource Image, bool Unavailable = false);

    [Parameter, EditorRequired] public IReadOnlyList<Photo> Photos { get; set; } = [];

    /// <summary>Raised when a tile is activated — the host opens the full-res file.</summary>
    [Parameter] public EventCallback<Photo> OnOpen { get; set; }

    /// <summary>Section heading; set empty to hide the header row.</summary>
    [Parameter] public string? Title { get; set; } = "Photos";

    /// <summary>Minimum tile width in px (the grid auto-fills to fit).</summary>
    [Parameter] public int MinTile { get; set; } = 120;

    [Parameter] public string EmptyText { get; set; } = "No photos.";

    [Parameter] public string? Class { get; set; }

    private string? AriaLabel => string.IsNullOrEmpty(Title) ? null : $"{Title} ({Photos.Count})";
}
