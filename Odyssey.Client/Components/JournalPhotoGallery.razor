@*
    JournalPhotoGallery — a titled photo section (Odyssey Design System · components/JournalPhotoGallery,
    version 1795477868-c9a2): a heading with the count (announced as text, never colour/icon alone) and
    the empty line, over an OdsPhotoGrid of OdsPhotoTiles. The tiles are THE shared library tile, so a
    journal entry, a book, an event and the Photos page show one tile; this component only adds the
    heading, the count and the empty line. New surfaces may compose OdsPhotoGrid + OdsPhotoTile directly.

    Each tile draws its photo through OdsPhotoImage (thumbnail → original → striped placeholder, silently).
    With NEITHER source an Unavailable photo reads "no access" and its tile's name says so (WCAG 1.3.1).
    An unnamed photo is named by its position ("2 of 5"), never its id: a GUID read out character by
    character distinguishes the tiles but describes none of them (WCAG 2.4.6). The host's viewer always
    opens the original.
*@

<section class="@($"odc-photogrid {Class}".TrimEnd())" aria-label="@AriaLabel">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="odc-photogrid-head">
            <span class="material-icons" aria-hidden="true">photo_library</span>
            <span class="odc-photogrid-title">@Title</span>
            <span class="odc-photogrid-count">@Photos.Count</span>
        </div>
    }

    @if (Photos.Count == 0)
    {
        <div class="odc-photogrid-empty">@EmptyText</div>
    }
    else
    {
        <OdsPhotoGrid TItem="(Photo Photo, int Index)" Items="Indexed" ItemKey="x => x.Photo.Id" MinTile="MinTile"
                      AriaLabel="@(string.IsNullOrEmpty(Title) ? $"{Photos.Count} photo{(Photos.Count == 1 ? "" : "s")}" : null)">
            <ItemTemplate Context="x">
                <OdsPhotoTile Name="@NameOf(x.Photo, x.Index)" Image="x.Photo.Image" Unavailable="x.Photo.Unavailable"
                              OnOpen="() => OnOpen.InvokeAsync(x.Photo)" />
            </ItemTemplate>
        </OdsPhotoGrid>
    }
</section>

@code {
    /// <summary>A gallery photo: a stable id, a display name and its image sources (thumbnail, original).
    /// <c>Unavailable</c> marks a photo the caller can see neither source of; it changes the placeholder's
    /// label and the tile's accessible name only when both sources are absent. The host's viewer opens the
    /// original, never the thumbnail.</summary>
    public sealed record Photo(string Id, string Name, PhotoImageSource Image, bool Unavailable = false);

    [Parameter, EditorRequired] public IReadOnlyList<Photo> Photos { get; set; } = [];

    /// <summary>Raised when a tile is activated — the host opens the shared PhotoViewer (Pages/Photos).</summary>
    [Parameter] public EventCallback<Photo> OnOpen { get; set; }

    /// <summary>Section heading; set empty to hide the header row (the grid is then named by its count).</summary>
    [Parameter] public string? Title { get; set; } = "Photos";

    /// <summary>Minimum tile width in px (the grid auto-fills to fit).</summary>
    [Parameter] public int MinTile { get; set; } = 120;

    [Parameter] public string EmptyText { get; set; } = "No photos.";

    [Parameter] public string? Class { get; set; }

    private string? AriaLabel => string.IsNullOrEmpty(Title) ? null : $"{Title} ({Photos.Count})";

    private IEnumerable<(Photo Photo, int Index)> Indexed => Photos.Select((p, i) => (p, i));

    private string NameOf(Photo p, int index) => string.IsNullOrEmpty(p.Name) ? $"{index + 1} of {Photos.Count}" : p.Name;
}
