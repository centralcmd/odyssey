@* DS parity — no consumer yet: the per-policy attachments table shows one policy's documents
   and offers no type filter, so there is nothing to filter across. Adopt it if that table
   grows a filter bar. *@
@*
    OdsPolicyFileTypeMultiSelect — a filter pre-wired to the PolicyFileType vocabulary
    (Odyssey Design System · components/PolicyFileTypeMultiSelect). A checkbox-list
    popover whose rows each carry the type's Material icon in its category color. A thin
    wrapper over OdsMultiSelect — bind the chosen keys via @bind-Values.
*@

<OdsMultiSelect Values="@Values"
                ValuesChanged="ValuesChanged"
                Options="OdsTypeRegistries.PolicyFileOptions"
                Label="@Label"
                Icon="@Icon"
                Align="@Align"
                Class="@Class"
                @attributes="UserAttributes" />

@code {
    /// <summary>Selected enum keys. Bindable via @bind-Values.</summary>
    [Parameter] public IReadOnlyCollection<string> Values { get; set; } = [];

    [Parameter] public EventCallback<IReadOnlyCollection<string>> ValuesChanged { get; set; }

    [Parameter] public string? Label { get; set; } = "Any type";

    [Parameter] public string? Icon { get; set; } = "folder";

    [Parameter] public OdsAlign Align { get; set; } = OdsAlign.Start;

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }
}
