@*
    OdsTable — the data-driven table primitive (Odyssey Design System · components/Table).

    Pass Columns (each with a Cell renderer) and Rows. Sorting is CONTROLLED — give Sort ({Key,Dir})
    and an OnSort handler; the component renders the indicator and aria-sort, you own the sort. A
    column with Align=End right-aligns and renders monospace tabular figures (amounts, dates). Dense
    for nav-embedded tables; OnRowClick for expand-in-place records.

    CAPTION AND ROW HEADER (issue #451). Caption names the table by its own content — a real
    <caption>, visually hidden with CaptionHidden. RowHeader names ONE column key whose body cells
    render as <th scope="row">, styled exactly like a cell, so a screen reader announces the row's
    identity as it moves across the other cells.

    NATIVE MARKUP, NOT MudTable. MudTable 9 has no caption slot, and inserting one from JS puts a
    node Blazor does not own at the front of a <table> whose children Blazor patches by position
    (PR #457 review). So this renders the design system's own .odc-table markup, as OdsRecordTable
    already does.
*@

@typeparam TRow

<table class="odc-table @(Dense ? "dense" : null) @(OnRowClick.HasDelegate ? "clickable" : null) @Class">
    @if (!string.IsNullOrEmpty(Caption))
    {
        <caption class="@(CaptionHidden ? "odc-sr-only" : "odc-table-caption")">@Caption</caption>
    }
    <thead>
        <tr>
            @foreach (var col in Columns)
            {
                <th scope="col" class="@HeaderClass(col)" style="@(col.Width is not null ? $"width:{col.Width}" : null)"
                    aria-sort="@AriaSort(col)">
                    @if (col.Sortable && OnSort.HasDelegate)
                    {
                        var active = IsActive(col);
                        <button type="button" class="odc-th-btn" data-active="@(active ? "" : null)"
                                @onclick="@(() => OnSort.InvokeAsync(col.Key))">
                            <span>@HeaderFor(col)</span>
                            <span class="material-icons odc-th-sort" aria-hidden="true">@(active && Sort!.Dir == OdsSortDirection.Asc ? "arrow_upward" : "arrow_downward")</span>
                        </button>
                    }
                    else
                    {
                        @HeaderFor(col)
                    }
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @if (!Rows.Any())
        {
            <tr>
                <td class="odc-table-empty" colspan="@Columns.Count">
                    @if (Empty is not null)
                    {
                        @Empty
                    }
                    else
                    {
                        <span>No records.</span>
                    }
                </td>
            </tr>
        }
        else
        {
            @foreach (var row in Rows)
            {
                <tr @onclick="@(() => HandleRowClick(row))">
                    @foreach (var col in Columns)
                    {
                        @if (RowHeader is not null && col.Key == RowHeader)
                        {
                            <th scope="row" class="@CellClass(col)">@col.Cell?.Invoke(row)</th>
                        }
                        else
                        {
                            <td class="@CellClass(col)">@col.Cell?.Invoke(row)</td>
                        }
                    }
                </tr>
            }
        }
    </tbody>
</table>

@code {
    /// <summary>The column definitions.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<OdsTableColumn<TRow>> Columns { get; set; } = [];

    /// <summary>The rows.</summary>
    [Parameter, EditorRequired] public IEnumerable<TRow> Rows { get; set; } = [];

    /// <summary>Controlled sort state. The component renders the indicator; you do the sorting.</summary>
    [Parameter] public OdsTableSort? Sort { get; set; }

    /// <summary>Called with a column key when a sortable header is clicked.</summary>
    [Parameter] public EventCallback<string> OnSort { get; set; }

    /// <summary>Compact row height — nav-embedded tables, dense lists.</summary>
    [Parameter] public bool Dense { get; set; }

    /// <summary>Makes rows clickable — used for expand-in-place records.</summary>
    [Parameter] public EventCallback<TRow> OnRowClick { get; set; }

    /// <summary>Rendered when Rows is empty (e.g. an OdsEmptyState).</summary>
    [Parameter] public RenderFragment? Empty { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// The table's accessible name, from its own content: rendered as a <c>&lt;caption&gt;</c>
    /// (Odyssey Design System · Table <c>caption</c>, issue #451).
    /// </summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>Keep the <see cref="Caption"/> visually hidden (still read by assistive technology).</summary>
    [Parameter] public bool CaptionHidden { get; set; }

    /// <summary>
    /// Key of the ONE column whose body cells render as <c>&lt;th scope="row"&gt;</c> — the row's identity
    /// (a symbol, a name), announced as a screen reader moves across the other cells.
    /// </summary>
    [Parameter] public string? RowHeader { get; set; }

    private RenderFragment HeaderFor(OdsTableColumn<TRow> col) =>
        col.Header ?? (builder => builder.AddContent(0, col.HeaderText));

    private bool IsActive(OdsTableColumn<TRow> col) => Sort is not null && Sort.Key == col.Key;

    private string? AriaSort(OdsTableColumn<TRow> col) => !col.Sortable || !OnSort.HasDelegate
        ? null
        : IsActive(col) ? (Sort!.Dir == OdsSortDirection.Asc ? "ascending" : "descending") : "none";

    private static string HeaderClass(OdsTableColumn<TRow> col) => col.Align == OdsAlign.End ? "odc-th num" : "odc-th";

    private static string? CellClass(OdsTableColumn<TRow> col)
    {
        var num = col.Align == OdsAlign.End ? "num" : null;
        return string.IsNullOrEmpty(col.CellClass) ? num : num is null ? col.CellClass : $"num {col.CellClass}";
    }

    private Task HandleRowClick(TRow row) =>
        OnRowClick.HasDelegate ? OnRowClick.InvokeAsync(row) : Task.CompletedTask;
}
