@*
    OdsMultiSelect — the checkbox-list filter with a count badge
    (Odyssey Design System · components/MultiSelect).

    The filter control behind every page header (account / status / tag /
    direction on Transactions, type / status elsewhere). A trigger button shows
    the label + a count badge of active selections; the popover is a checkbox
    list with Clear / Done. Built on OdsPopupMenu (one real trigger button beside a
    MudPopover, issue #255) so the popover is portaled out of any
    overflow:hidden ancestor (the filter card), flips above when there isn't room
    below, and closes on outside-click / Esc. Bind via @bind-Values.

    Glyph typesets a literal mark (§, №, ‰) in the icon's slot for marks the icon
    font has no glyph for; it wins over Icon. Quiet withholds the trigger's border
    and fill until hover, focus or open — for a trigger that is a heading as much
    as a control (a chart's own series picker). OptionContent renders a row that
    needs more than one voice (a coloured figure beside muted qualifying text);
    the option's plain Label stays its text form, and is what the search matches.

    A list of more than 8 options gets a search field (Searchable overrides), and the rows sit in a
    232px scroll region. Loading shows an announced row distinct from the "No matches" one. Keyboard
    inside the popover (DS MultiSelect): Tab and Shift+Tab cycle through the search field, the rows
    and the footer, ↑/↓ rove the rows (↓ from the search field enters the list), Enter toggles the
    focused row — wired by odsCheckListKeys (wwwroot/index.html), since the panel is portaled.
*@

<OdsPopupMenu @ref="_popup"
              Class="@($"odc-ms {(OpenEnded ? "open-ended" : null)} {Class}".Trim())"
              TriggerId="@TriggerId"
              TriggerClass="@(Quiet ? "odc-ms-trigger quiet" : "odc-ms-trigger")"
              AriaDescribedBy="@DescribedBy"
              AnchorOrigin="@Anchor"
              TransformOrigin="@Transform"
              PanelLabel="@Label"
              PopoverClass="odc-ms-pop-paper"
              RelativeWidth="@(OpenEnded ? DropdownWidth.Relative : DropdownWidth.Adaptive)"
              ListClass="pa-0"
              FocusOnOpenId="@(SearchOn ? SearchId : null)"
              OpenChanged="OnOpenChanged"
              @attributes="UserAttributes">
    <TriggerContent>
        @if (Fits)
        {
            @* Fit ghosts: the trigger's content and an invisible copy of every option row stack in one
               inline-grid cell, so the trigger is as wide as its widest row and the popover (never
               narrower than its trigger) opens at the trigger's own width. *@
            <span class="odc-ms-fit">
                <span class="odc-ms-fit-cur">@TriggerFace</span>
                @foreach (var option in Options)
                {
                    <span class="odc-ms-fit-ghost" aria-hidden="true">
                        <span class="odc-check-box"></span>
                        @if (!string.IsNullOrEmpty(option.Icon))
                        {
                            <span class="material-icons odc-opt-icon">@option.Icon</span>
                        }
                        <span class="odc-check-label">@option.Label</span>
                    </span>
                }
            </span>
        }
        else
        {
            @TriggerFace
        }
    </TriggerContent>
    <ChildContent>
        @{ var filtered = Filtered.ToList(); }
        <div class="odc-ms-pop @AlignClass @(Fits ? "fit" : OpenEnded ? "open-ended" : null)">
            @* Always rendered, so a change of its text is announced: the result count while a search
               narrows the list, "No matches", or "Loading…" (WCAG 4.1.3). A row inserted already
               holding its text is not reliably read. *@
            <div class="odc-sr-only odc-ms-status" role="status" aria-live="polite">@StatusText(filtered.Count)</div>
            @if (SearchOn)
            {
                <div class="odc-ms-search">
                    <span class="material-icons" aria-hidden="true">search</span>
                    <input id="@SearchId"
                           value="@_query"
                           @oninput="@(e => _query = e.Value?.ToString() ?? string.Empty)"
                           placeholder="@SearchPlaceholder"
                           aria-label="@EffectiveSearchLabel" />
                </div>
            }
            <div class="odc-ms-list">
                @if (Loading)
                {
                    @* Visually distinct from "no match", and announced through the status line above:
                       options that arrive asynchronously must never read as an empty list. *@
                    <div class="odc-ms-loading">
                        <span class="material-icons" aria-hidden="true">hourglass_top</span>
                        <span>@LoadingText</span>
                    </div>
                }
                else
                {
                    @foreach (var option in filtered)
                    {
                        <label class="odc-ms-opt odc-check">
                            <input type="checkbox"
                                   checked="@_selected.Contains(option.Value)"
                                   @onchange="@(() => Toggle(option.Value))" />
                            <span class="odc-check-box" aria-hidden="true">
                                <span class="material-icons">check</span>
                            </span>
                            @if (!string.IsNullOrEmpty(option.Icon))
                            {
                                <span class="material-icons odc-opt-icon" style="@IconStyle(option)" aria-hidden="true">@option.Icon</span>
                            }
                            <span class="odc-check-label">
                                @if (OptionContent is not null)
                                {
                                    @OptionContent(option)
                                }
                                else
                                {
                                    @option.Label
                                }
                            </span>
                        </label>
                    }
                    @if (filtered.Count == 0)
                    {
                        <div class="odc-tagms-empty">@EmptyText</div>
                    }
                }
            </div>
            <div class="odc-ms-foot">
                <button type="button" class="odc-btn text" @onclick="Clear" disabled="@(Values.Count == 0)">Clear</button>
                <button type="button" class="odc-btn text" @onclick="Done">Done</button>
            </div>
        </div>
    </ChildContent>
</OdsPopupMenu>

@code {
    private RenderFragment TriggerFace => __builder =>
    {
        @if (!string.IsNullOrEmpty(Glyph))
        {
            <span class="odc-ms-glyph" aria-hidden="true">@Glyph</span>
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <span class="material-icons" aria-hidden="true">@Icon</span>
        }
        <span class="odc-ms-label">@Label</span>
        @if (Values.Count > 0)
        {
            <span class="odc-ms-count">@Values.Count</span>
        }
        <span class="material-icons odc-ms-chevron" aria-hidden="true">expand_more</span>
    };
}
