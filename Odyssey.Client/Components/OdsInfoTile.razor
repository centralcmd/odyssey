@*
    OdsInfoTile — a labeled fact/stat tile (Odyssey Design System · components/InfoTile).

    An icon chip + uppercase label on top, a headline value, and an optional muted
    foot caption — on an elevated card. The richer sibling of OdsMetaTile (a bare
    label/value well) and OdsStatTile (a bare figure). Used for policy/account facts
    and current-state snapshots where each fact reads as its own tile in a responsive
    grid.

    The icon chip defaults to the brand accent; pass IconColor (+ optional IconSoft
    background) to tint it per-tile. To re-tint a whole grid at once, set
    --odc-infotile-accent / --odc-infotile-accent-soft on the grid container instead.

    ValueVariant: Mono (default — numbers/IDs/dates, tabular) · Text (proportional,
    for names/labels) · Sm (smaller, for dates). Wide makes the tile span all grid
    columns and lets its value wrap (e.g. a notes tile).

    Tone tints the VALUE with a state colour (an upcoming date in info blue, a lapsed one
    in expense coral) — distinct from the icon chip, which carries the record's accent.
    WrapValue wraps a value that must never truncate (a record's name) instead.

    Inside an OdsRecordCard the tiles live in an OdsInfoTileGrid, which maps the card's
    --rec / --rec-soft onto the accent, so a tile there should need no IconColor at all.

    A tile renders if and only if ITS OWN field has a value — never because a sibling
    "already shows that", and a derived tile (Status) summarises without replacing the
    tiles of the fields it is computed from. A foot caption has to earn its place; a tile
    does not — which is what OdsInfoTile.Caption(text) is for: it returns null rather than
    an empty fragment, so an absent caption renders no foot ELEMENT, not an empty one.
*@

<div class="@TileClass" style="@Style">
    <div class="odc-infotile-top">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="odc-infotile-ic" style="@IconStyle">
                <span class="material-icons" aria-hidden="true">@Icon</span>
            </span>
        }
        @if (LabelContent is not null)
        {
            <span class="odc-infotile-k">@LabelContent</span>
        }
        else if (!string.IsNullOrEmpty(Label))
        {
            <span class="odc-infotile-k">@Label</span>
        }
    </div>
    <div class="odc-infotile-v @VariantClass">@Value</div>
    @if (Foot is not null)
    {
        <div class="odc-infotile-foot">@Foot</div>
    }
</div>

@code {
    /// <summary>Leading Material Icons ligature.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Per-tile icon foreground color (any CSS color). Inherits the grid accent otherwise.</summary>
    [Parameter] public string? IconColor { get; set; }

    /// <summary>Per-tile icon background tint. Pairs with <see cref="IconColor"/>.</summary>
    [Parameter] public string? IconSoft { get; set; }

    /// <summary>Uppercase overline label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// The overline as markup, for the rare tile whose label carries something besides text — a
    /// per-member term line, a tile-local action. Takes precedence over <see cref="Label"/>, which
    /// stays the parameter every ordinary tile uses: a plain string cannot be styled wrong.
    /// </summary>
    [Parameter] public RenderFragment? LabelContent { get; set; }

    /// <summary>Headline value.</summary>
    [Parameter] public RenderFragment? Value { get; set; }

    /// <summary>Optional muted foot caption.</summary>
    [Parameter] public RenderFragment? Foot { get; set; }

    /// <summary>
    /// Wraps optional caption text for <see cref="Foot"/>. Blank text returns <c>null</c>, so the tile
    /// renders no foot element at all — a foot has to earn its place, and an empty one is not the same
    /// as none.
    ///
    /// <para>
    /// It lives here, on the component whose parameter it feeds, because every record card needs it and
    /// seven pages had grown their own byte-identical private copy. Same shape as
    /// <see cref="OdsBillingIntervalChip"/>'s label statics.
    /// </para>
    /// </summary>
    public static RenderFragment? Caption(string? text) =>
        string.IsNullOrWhiteSpace(text) ? null : builder => builder.AddContent(0, text);

    /// <summary>Value typography — Mono (numbers/dates) · Text (names/labels) · Sm (dates).</summary>
    [Parameter] public OdsInfoTileVariant ValueVariant { get; set; } = OdsInfoTileVariant.Mono;

    /// <summary>Span all grid columns and let the value wrap (e.g. a notes tile).</summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>State colour for the value — info (upcoming) · pending · income · expense · muted.
    /// The icon chip keeps the record's accent.</summary>
    [Parameter] public OdsInfoTileTone Tone { get; set; } = OdsInfoTileTone.Default;

    /// <summary>Wrap a value that must never truncate (a record's name) instead of ellipsising it.</summary>
    [Parameter] public bool WrapValue { get; set; }

    /// <summary>Drop the card elevation.</summary>
    [Parameter] public bool Elevated { get; set; } = true;

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }

    private string TileClass =>
        string.Join(' ', new[]
        {
            "odc-infotile",
            Elevated ? "elevated" : null,
            Wide ? "wide" : null,
            WrapValue ? "wrapvalue" : null,
            ToneClass,
            Class,
        }.Where(c => !string.IsNullOrEmpty(c)));

    private string? ToneClass => Tone switch
    {
        OdsInfoTileTone.Info => "tone-info",
        OdsInfoTileTone.Pending => "tone-pending",
        OdsInfoTileTone.Income => "tone-income",
        OdsInfoTileTone.Expense => "tone-expense",
        OdsInfoTileTone.Muted => "tone-muted",
        _ => null,
    };

    private string VariantClass => ValueVariant switch
    {
        OdsInfoTileVariant.Text => "text",
        OdsInfoTileVariant.Sm => "sm",
        _ => "mono",
    };

    private string? IconStyle =>
        string.IsNullOrEmpty(IconColor) ? null
            : $"color:{IconColor};{(string.IsNullOrEmpty(IconSoft) ? "" : $"background:{IconSoft};")}";
}
