@using Odyssey.Dtos
@*
    JournalTagChips — a compact row of tag-tone chips for the journal, task and photo tag families (the
    shared OdsTagChips is typed to the Finance ExistingTransactionTag). Each chip leads with ITS tag's
    icon (issue #345), or the generic "label" glyph when the tag has none; the record's title carries no
    glyph. The glyph is decorative (aria-hidden) — the chip's text names the tag. A coloured tag's chip
    takes that colour (OdsChip.UserColor: text and glyph through --user-text-l on a soft tint); an
    uncoloured one keeps the tag tone, as does the +N chip. Max caps the visible chips + shows a +N; null
    shows them all.
*@

@if (_tags.Count > 0)
{
    <span class="je-tagchips">
        @foreach (var tag in _shown)
        {
            <OdsChip Tone="OdsChipTone.Tag" Icon="@GlyphFor(tag.Icon)" UserColor="@tag.Color">@tag.Name</OdsChip>
        }
        @if (_hidden.Count > 0)
        {
            <OdsChip Tone="OdsChipTone.Tag" Class="je-tagchips-more" Title="@HiddenTitle">
                +@_hidden.Count
                @* Title is mouse-only — give AT the hidden names as text. *@
                <span class="sr-only"> more tags: @HiddenTitle</span>
            </OdsChip>
        }
    </span>
}

@code {
    /// <summary>
    /// A tag as the chip draws it: its name, its stored <see cref="TagIcons"/> key and its colour (null = none;
    /// issue #394). All positional with no defaults, so every construction site states the colour.
    /// </summary>
    public sealed record Tag(string Name, string? Icon, string? Color)
    {
        /// <summary>
        /// Resolves a record's tag ids through the host's loaded tag map, in the ids' order, skipping an id
        /// the map does not hold (deleted, or not yet loaded). One projection for every tag family.
        /// </summary>
        public static IReadOnlyList<Tag> For<TTag>(
            IEnumerable<Guid> ids, IReadOnlyDictionary<Guid, TTag> byId, Func<TTag, string> name, Func<TTag, string?> icon,
            Func<TTag, string?> color) =>
            [.. ids.Select(id => byId.TryGetValue(id, out var tag) ? new Tag(name(tag), icon(tag), color(tag)) : null).OfType<Tag>()];
    }

    /// <summary>
    /// The glyph a tag chip leads with when its tag has no (known) icon. Deliberately <c>label</c>, not
    /// <see cref="TagIcons.Default"/> (<c>local_offer</c>): <c>label</c> is the chip glyph the design system
    /// draws for these footers, and the two keys answer different questions — this one is a chip's
    /// fallback, <c>TagIcons.Default</c> is a record's resolved display icon.
    /// </summary>
    public const string FallbackGlyph = "label";

    [Parameter] public IEnumerable<Tag> Tags { get; set; } = [];

    /// <summary>Cap the visible chips; the overflow collapses into a "+N" chip. Null = show all.</summary>
    [Parameter] public int? Max { get; set; }

    private List<Tag> _tags = [];
    private List<Tag> _shown = [];
    private List<Tag> _hidden = [];

    /// <summary>The tag's own icon when it is a known key, else <see cref="FallbackGlyph"/>.</summary>
    public static string GlyphFor(string? icon) => TagIcons.IsKnown(icon) ? icon! : FallbackGlyph;

    protected override void OnParametersSet()
    {
        _tags = [.. Tags];
        if (Max is { } max && max >= 0 && _tags.Count > max)
        {
            _shown = _tags[..max];
            _hidden = _tags[max..];
        }
        else
        {
            _shown = _tags;
            _hidden = [];
        }
    }

    private string HiddenTitle => string.Join(", ", _hidden.Select(t => t.Name));
}
