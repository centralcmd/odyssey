@*
    OdsSelect — a styled single-select dropdown with helper / error states
    (Odyssey Design System · components/Select). A MudSelect sharing the input
    look + focus ring with OdsField. Pass Options as OdsOption records.
    Two-way bindable via @bind-Value.
*@
@inject IJSRuntime Js

<MudSelect T="string"
           Value="@Value"
           ValueChanged="OnValueChanged"
           Label="@Label"
           Placeholder="@Placeholder"
           Variant="Variant.Outlined"
           Margin="Margin.Dense"
           AdornmentIcon="@(SelectedOption?.Icon)"
           Adornment="@(string.IsNullOrEmpty(SelectedOption?.Icon) ? Adornment.None : Adornment.Start)"
           HelperText="@(string.IsNullOrEmpty(Error) ? Help : null)"
           Error="@(!string.IsNullOrEmpty(Error))"
           ErrorText="@Error"
           Required="@Required"
           Disabled="@Disabled"
           MaxHeight="360"
           Class="@Class"
           InputId="@_inputId"
           @attributes="UserAttributes">
    @foreach (var option in Options)
    {
        <MudSelectItem T="string" Value="@option.Value">
            @if (!string.IsNullOrEmpty(option.Icon))
            {
                <span class="odc-select-opt">
                    <span class="material-icons odc-opt-icon" style="@IconStyle(option)" aria-hidden="true">@option.Icon</span>
                    <span>@option.Label</span>
                </span>
            }
            else
            {
                @option.Label
            }
        </MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter] public string? Label { get; set; }

    /// <summary>Selected value. Bindable via @bind-Value.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>The options.</summary>
    [Parameter, EditorRequired] public IEnumerable<OdsOption> Options { get; set; } = [];

    /// <summary>Placeholder shown when nothing is selected.</summary>
    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Help { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>Accessible name for a label-less select (a settings row). Applied to the inner input,
    /// as on <see cref="OdsCurrencySelect"/>, because MudSelect splats attributes onto its wrapper.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }

    private readonly string _inputId = $"odc-select-{Guid.NewGuid():N}";

    // The label applied to the inner input so far: re-applied whenever the parameter changes, not only on the
    // first render, so a label that follows state never goes stale.
    private string? _appliedAriaLabel;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.Equals(AriaLabel, _appliedAriaLabel, StringComparison.Ordinal)) return;
        try
        {
            await Js.InvokeVoidAsync("odsSetAttr", _inputId, "aria-label", AriaLabel);
            _appliedAriaLabel = AriaLabel;
        }
        catch { /* JS unavailable (e.g. prerender / teardown) */ }
    }

    /// <summary>The currently selected option (drives the trigger's leading glyph).</summary>
    private OdsOption? SelectedOption => Options.FirstOrDefault(o => o.Value == Value);

    private static string? IconStyle(OdsOption option) =>
        string.IsNullOrEmpty(option.IconColor) ? null : $"color:{OdsGlyphInk.Glyph(option.IconColor)};";

    private Task OnValueChanged(string value)
    {
        Value = value;
        return ValueChanged.InvokeAsync(value);
    }
}
