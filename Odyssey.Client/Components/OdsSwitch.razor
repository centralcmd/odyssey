@*
    OdsSwitch — a binary on/off toggle (Odyssey Design System · components/Switch).

    The Preferences "Dark mode" control and any instant setting. A MudSwitch.
    Two-way bindable via @bind-Checked.

    Two focusable "can't change now" states, distinct from Disabled — a native disabled drops focus
    out of the control (issue #351 Phase 0):
      Busy          a save is in flight: aria-disabled + aria-busy, changes ignored, focus kept.
      AriaDisabled  permanently locked (a base-currency row): aria-disabled only, changes ignored.
    Both render MudSwitch ReadOnly, so the input stays in the tab order and keeps its checked state.
    Only the track dims; the label keeps full text contrast.

    ResetToModel() rebuilds the input (a new @key) so its checked state matches Checked after a
    refused change — Blazor does not re-patch a value that did not change — and hands focus back.
    ResetKey is the same thing as a parameter (the design system's resetKey): a table row bumps it,
    since a row has no @ref to call the method through.
*@

@inject IJSRuntime Js

<MudSwitch T="bool"
           @key="_resetKey"
           Value="@Checked"
           ValueChanged="OnValueChanged"
           Label="@Label"
           AriaLabel="@AriaLabel"
           Disabled="@Disabled"
           ReadOnly="@(Busy || AriaDisabled)"
           Color="Color.Primary"
           Class="@SwitchClass"
           @attributes="UserAttributes"
           id="@_inputId"
           aria-disabled="@(Busy || AriaDisabled ? "true" : null)"
           aria-busy="@(Busy ? "true" : null)"
           aria-describedby="@AriaDescribedBy" />

@code {
    /// <summary>On/off state. Bindable via @bind-Checked.</summary>
    [Parameter] public bool Checked { get; set; }

    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Optional trailing label (also the click target).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Accessible name for a label-less switch (e.g. a system-settings row whose title lives in the
    /// surrounding row, not this control). MudSwitch renders it via <c>aria-labelledby</c> on the
    /// underlying input and hides the (absent) visible label from assistive tech — reliable, unlike
    /// splatting a bare <c>aria-label</c> onto a MudBlazor component and hoping it lands on the input.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Ids of the elements describing this switch — the row's helper line and any advisory.
    ///
    /// <para>
    /// Written AFTER the <c>UserAttributes</c> splat so this parameter wins over a stray
    /// <c>aria-describedby</c> from a call site. MudSwitch has no <c>AriaDescribedBy</c> of its own, but
    /// it merges its <c>AriaLabel</c> into <c>UserAttributes</c> and splats those onto the underlying
    /// input — so an unmatched attribute reaches the input, which is the element that has to carry it.
    /// Without this a label-less switch has an accessible NAME and no accessible DESCRIPTION, and its
    /// helper line is invisible to assistive tech (WCAG 1.3.1).
    /// </para>
    /// </summary>
    [Parameter] public string? AriaDescribedBy { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>A save is in flight: <c>aria-disabled</c> + <c>aria-busy</c>, changes ignored, focus kept.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Permanently locked: <c>aria-disabled</c> only, changes ignored, focus kept.</summary>
    [Parameter] public bool AriaDisabled { get; set; }

    /// <summary>Bump to rebuild the input from <see cref="Checked"/> and return focus to it, as
    /// <see cref="ResetToModel"/> does. The first value is the baseline and resets nothing.</summary>
    [Parameter] public int ResetKey { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }

    private readonly string _inputId = $"ods-switch-{Guid.NewGuid():N}";
    private int _resetKey;
    private bool _focusAfterReset;
    private int? _lastResetKey;

    protected override void OnParametersSet()
    {
        if (_lastResetKey is { } last && last != ResetKey)
        {
            _resetKey++;
            _focusAfterReset = true;
        }
        _lastResetKey = ResetKey;
    }

    private string? SwitchClass
    {
        get
        {
            var state = Busy ? "odc-switch-busy" : AriaDisabled ? "odc-switch-locked" : null;
            return string.Join(' ', new[] { state, Class }.Where(c => !string.IsNullOrEmpty(c))) is { Length: > 0 } c ? c : null;
        }
    }

    /// <summary>
    /// Rebuild the input from <see cref="Checked"/> after a refused change and return focus to it —
    /// the Blazor counterpart of the design system's <c>resetKey</c>.
    /// </summary>
    public void ResetToModel()
    {
        _resetKey++;
        _focusAfterReset = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusAfterReset)
            return;
        _focusAfterReset = false;
        try
        { await Js.InvokeVoidAsync("odsFocusById", _inputId); }
        catch (JSException) { }
    }

    private Task OnValueChanged(bool value)
    {
        if (Busy || AriaDisabled)
            return Task.CompletedTask;
        Checked = value;
        return CheckedChanged.InvokeAsync(value);
    }
}
