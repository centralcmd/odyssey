@using Odyssey.Dtos.Finance
@*
    OdsBudgetCategoryTypeSelect — a single-select pre-wired to the BudgetCategoryType
    vocabulary (Odyssey Design System · components/BudgetCategoryTypeSelect): the two
    directions a budget line can take — Expense (money out, warm red trending_down) and
    Income (money in, green trending_up) — each rendered with its Material icon in its
    category color. A thin, domain-typed wrapper over the shared OdsTypeSelect; binds the enum directly.
    Bind via @bind-Value.
*@

<OdsTypeSelect Value="@Value.ToString()"
               ValueChanged="OnValueChanged"
               Types="OdsTypeRegistries.BudgetCategoryTypes"
               Label="@Label"
               Placeholder="@Placeholder"
               Help="@Help"
               Error="@Error"
               Required="@Required"
               Disabled="@Disabled"
               Class="@Class"
               @attributes="UserAttributes" />

@code {
    /// <summary>Selected category. Bindable via @bind-Value.</summary>
    [Parameter] public BudgetCategoryType Value { get; set; }

    [Parameter] public EventCallback<BudgetCategoryType> ValueChanged { get; set; }

    [Parameter] public string? Label { get; set; } = "Category";

    [Parameter] public string? Placeholder { get; set; } = "Select category…";

    [Parameter] public string? Help { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }

    private Task OnValueChanged(string key)
    {
        if (Enum.TryParse<BudgetCategoryType>(key, out var parsed))
        {
            Value = parsed;
            return ValueChanged.InvokeAsync(parsed);
        }
        return Task.CompletedTask;
    }
}
