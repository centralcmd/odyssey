@*
    OdsCoordinateField — paired latitude / longitude entry (Odyssey Design System · CoordinateField).

    Two OdsNumberFields in an OdsFormRow, each with its geographic range enforced (WeatherRules'
    LatitudeMin/Max and LongitudeMin/Max, shared with the server) and an inline out-of-range error, so every "pin a place" spot reads and validates
    identically instead of re-deriving the ranges. Bind the two ends via @bind-Lat / @bind-Lng
    (decimal?, the Blazor-idiomatic form of the design's {lat,lng} pair — mirrors OdsDatePicker's
    DateTime? adaptation).
*@

@using Odyssey.Dtos.Journal
<div class="@(string.IsNullOrEmpty(Class) ? "odc-coordfield" : $"odc-coordfield {Class}")">
    <OdsFormRow Cols="2">
        <OdsNumberField Label="@LatLabel" Value="Lat" ValueChanged="OnLatChanged"
                        Placeholder="@Range(WeatherRules.LatitudeMin, WeatherRules.LatitudeMax, " … ")" Min="WeatherRules.LatitudeMin" Max="WeatherRules.LatitudeMax" Step="0.000001"
                        Required="Required" Disabled="Disabled" Error="@LatError" />
        <OdsNumberField Label="@LngLabel" Value="Lng" ValueChanged="OnLngChanged"
                        Placeholder="@Range(WeatherRules.LongitudeMin, WeatherRules.LongitudeMax, " … ")" Min="WeatherRules.LongitudeMin" Max="WeatherRules.LongitudeMax" Step="0.000001"
                        Required="Required" Disabled="Disabled" Error="@LngError" />
    </OdsFormRow>
    @if (Message is not null)
    {
        <div class="odc-field-help @(string.IsNullOrEmpty(Error) ? null : "error")" role="@(string.IsNullOrEmpty(Error) ? null : "alert")"
             style="margin-top: 6px;">@Message</div>
    }
</div>

@code {
    /// <summary>Latitude in decimal degrees, or null when empty. Bindable via @bind-Lat.</summary>
    [Parameter] public decimal? Lat { get; set; }

    [Parameter] public EventCallback<decimal?> LatChanged { get; set; }

    /// <summary>Longitude in decimal degrees, or null when empty. Bindable via @bind-Lng.</summary>
    [Parameter] public decimal? Lng { get; set; }

    [Parameter] public EventCallback<decimal?> LngChanged { get; set; }

    [Parameter] public string LatLabel { get; set; } = "Latitude";

    [Parameter] public string LngLabel { get; set; } = "Longitude";

    /// <summary>Helper text below the pair. Suppressed while a range error shows.</summary>
    [Parameter] public string? Help { get; set; }

    /// <summary>Explicit error message below the pair.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    // The bounds are WeatherRules' (issue #388 §8), the same constants the server's [Range] attributes name.
    private string? LatError => Lat is { } lat && ((double)lat < WeatherRules.LatitudeMin || (double)lat > WeatherRules.LatitudeMax)
        ? $"Must be between {Range(WeatherRules.LatitudeMin, WeatherRules.LatitudeMax, " and ")}" : null;

    private string? LngError => Lng is { } lng && ((double)lng < WeatherRules.LongitudeMin || (double)lng > WeatherRules.LongitudeMax)
        ? $"Must be between {Range(WeatherRules.LongitudeMin, WeatherRules.LongitudeMax, " and ")}" : null;

    /// <summary><c>−90 and 90</c>, with a true minus sign.</summary>
    private static string Range(double min, double max, string separator) =>
        $"{Signed(min)}{separator}{Signed(max)}";

    private static string Signed(double value) =>
        value < 0 ? $"−{(-value).ToString(System.Globalization.CultureInfo.InvariantCulture)}" : value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string? Message =>
        Error ?? (LatError is null && LngError is null ? Help : null);

    private Task OnLatChanged(decimal? value)
    {
        Lat = value;
        return LatChanged.InvokeAsync(value);
    }

    private Task OnLngChanged(decimal? value)
    {
        Lng = value;
        return LngChanged.InvokeAsync(value);
    }
}
