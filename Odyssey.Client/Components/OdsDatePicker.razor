@*
    OdsDatePicker — a single-date calendar popover (Odyssey Design System · components/DatePicker).

    A MudDatePicker exchanging a DateTime?, matching MudBlazor's native type and
    the app's date DTOs. The picker shows the ISO yyyy-MM-dd format with no
    toolbar (the DS look). Min / Max disable out-of-range days. Bind via
    @bind-Value.
*@
@inject IJSRuntime Js

<MudDatePicker @ref="_picker"
               Date="@Value"
               DateChanged="OnDateChanged"
               Placeholder="@Placeholder"
               MinDate="@Min"
               MaxDate="@Max"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Editable="true"
               DateFormat="yyyy-MM-dd"
               ShowToolbar="false"
               AnchorOrigin="@(Align == OdsAlign.End ? Origin.BottomRight : Origin.BottomLeft)"
               TransformOrigin="@(Align == OdsAlign.End ? Origin.TopRight : Origin.TopLeft)"
               Disabled="@Disabled"
               Clearable="@Clearable"
               Required="@Required"
               HelperText="@HelperText"
               Style="@(Full ? null : "width:fit-content")"
               Class="@Class"
               InputId="@_inputId"
               @attributes="UserAttributes" />

@code {
    /// <summary>Selected date, or null when empty. Bindable via @bind-Value.</summary>
    [Parameter] public DateTime? Value { get; set; }

    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Shows a clear (×) button once a date is picked. Default false.</summary>
    [Parameter] public bool Clearable { get; set; }

    [Parameter] public string? HelperText { get; set; }

    /// <summary>Marks the field required — the label's `*` (the system's single obligation marker). A
    /// real bool parameter: passed as a stray unmatched attribute it would splat a string onto
    /// MudDatePicker's bool and throw.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Earliest selectable date. Earlier days are disabled.</summary>
    [Parameter] public DateTime? Min { get; set; }

    /// <summary>Latest selectable date. Later days are disabled.</summary>
    [Parameter] public DateTime? Max { get; set; }

    /// <summary>Popover alignment relative to the trigger. Start (default) opens left-aligned; End right-aligned.</summary>
    [Parameter] public OdsAlign Align { get; set; } = OdsAlign.Start;

    /// <summary>Stretch the control to the container width. Default true (the DS default).</summary>
    [Parameter] public bool Full { get; set; } = true;

    [Parameter] public string? Class { get; set; }

    /// <summary>Accessible name for a label-less picker — the two ends of a range shown as a period. Applied
    /// to the inner input, as on <see cref="OdsSelect"/>, because MudDatePicker splats attributes onto its wrapper.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// The id of text elsewhere in the form that explains this field. Added to the inner input's
    /// <c>aria-describedby</c> after MudBlazor's own helper text, which it keeps.
    /// </summary>
    [Parameter] public string? AriaDescribedBy { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }

    private MudDatePicker? _picker;
    private readonly string _inputId = $"odc-dp-{Guid.NewGuid():N}";

    // The label applied to the inner input so far: re-applied whenever the parameter changes, not only on the
    // first render, so a label that follows state never goes stale.
    private string? _appliedAriaLabel;
    private string? _appliedDescribedBy;

    // MudBlazor names its helper text after the input id; setting the attribute replaces Mud's own value,
    // so the helper is listed first to keep it.
    private string? DescribedBy => string.IsNullOrEmpty(AriaDescribedBy) ? null
        : string.IsNullOrEmpty(HelperText) ? AriaDescribedBy
        : $"{_inputId}-helper-text {AriaDescribedBy}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!string.Equals(AriaLabel, _appliedAriaLabel, StringComparison.Ordinal))
            {
                await Js.InvokeVoidAsync("odsSetAttr", _inputId, "aria-label", AriaLabel);
                _appliedAriaLabel = AriaLabel;
            }

            if (!string.Equals(DescribedBy, _appliedDescribedBy, StringComparison.Ordinal))
            {
                await Js.InvokeVoidAsync("odsSetAttr", _inputId, "aria-describedby", DescribedBy);
                _appliedDescribedBy = DescribedBy;
            }
        }
        catch { /* JS unavailable (e.g. prerender / teardown) */ }
    }

    /// <summary>Opens the calendar — for a control elsewhere that hands the choice to this picker.</summary>
    public Task OpenAsync() => _picker?.OpenAsync() ?? Task.CompletedTask;

    /// <summary>Moves keyboard focus to the picker's input — for a host whose focused control just
    /// disappeared and must hand focus somewhere meaningful (WCAG 2.4.3).</summary>
    public ValueTask FocusAsync() => _picker?.FocusAsync() ?? ValueTask.CompletedTask;

    private Task OnDateChanged(DateTime? date)
    {
        Value = date;
        return ValueChanged.InvokeAsync(date);
    }
}
