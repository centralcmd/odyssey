@*
    OdsIconButton — the bare icon-only button (Odyssey Design System · components/IconButton).

    Used for the modal close, table row actions, and menu triggers. A
    MudIconButton with the Odyssey size steps and a required accessible name.
    Renders as a link when Href is set. Danger tints it for destructive actions.
      sm = 28px · md = 36px (default) · lg = 44px (touch target).

    AriaLabel is REQUIRED — the button shows no text.

    Busy (issue #517) marks an action in progress, such as the per-calendar export while its summary loads: a
    spinner replaces the glyph, and the button keeps its accessible name and its focus, carries
    aria-disabled="true" and aria-busy="true", and swallows clicks. Never a native disabled, which would drop it
    from the tab order and lose focus mid-action.
*@

@* One element in both states, so the button keeps focus when it turns busy and back. *@
<MudIconButton Icon="@(Busy ? null : Icon)"
               Size="@MudSize"
               Color="@(Danger ? Color.Error : Color.Default)"
               Href="@(Busy ? null : Href)"
               ButtonType="@Type"
               Disabled="@Disabled"
               OnClick="HandleClickAsync"
               aria-label="@AriaLabel"
               aria-disabled="@(Busy ? "true" : null)"
               aria-busy="@(Busy ? "true" : null)"
               Class="@ButtonClass"
               @attributes="UserAttributes">
    @if (Busy)
    {
        <span class="odc-iconbtn-spinner" aria-hidden="true"></span>
    }
</MudIconButton>

@code {
    /// <summary>An @Icons.Material.Filled.* SVG constant — a Material ligature ("edit") renders no glyph.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    /// <summary>Accessible name — REQUIRED, since the button shows no text.</summary>
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = string.Empty;

    /// <summary>sm = 28px · md = 36px (default) · lg = 44px.</summary>
    [Parameter] public OdsSize Size { get; set; } = OdsSize.Md;

    /// <summary>Tint for destructive actions.</summary>
    [Parameter] public bool Danger { get; set; }

    /// <summary>Render as a link with this href instead of a button.</summary>
    [Parameter] public string? Href { get; set; }

    [Parameter] public ButtonType Type { get; set; } = ButtonType.Button;

    [Parameter] public bool Disabled { get; set; }

    /// <summary>An action in progress: spinner, aria-disabled and aria-busy, clicks ignored, focus and name kept.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }

    private string? ButtonClass => Busy ? $"{Class} odc-iconbtn-busy".TrimStart() : Class;

    private Task HandleClickAsync(MouseEventArgs e) => Busy ? Task.CompletedTask : OnClick.InvokeAsync(e);

    private Size MudSize => Size switch
    {
        OdsSize.Sm => MudBlazor.Size.Small,
        OdsSize.Lg => MudBlazor.Size.Large,
        _ => MudBlazor.Size.Medium,
    };
}
