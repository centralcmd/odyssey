@*
    OdsAddRow — the closing create affordance for a record list (Odyssey Design
    System · components/AddRow).

    A full-width dashed "add" row that sits after the last item (Accounts, Budgets, …).
    Pass a Title (the verb) and an optional one-line Sub; Icon defaults to `add`. The
    whole row is the button — OnClick fires the create flow.

    AriaDisabled (issue #526) marks a list at its cap: the row stays focusable and in the tab order,
    carries aria-disabled="true", swallows the click and dims. DisabledReason then replaces Sub as the
    visible second line ("A recipe holds at most 100 ingredients.") and is linked by aria-describedby,
    so the name stays the verb and the reason is read after it. Native Disabled drops focus to <body>.
*@

<button type="button" class="@RowClass" @onclick="HandleClickAsync" disabled="@Disabled"
        aria-disabled="@(AriaDisabled ? "true" : null)"
        aria-describedby="@(ShowsReason ? _reasonId : null)">
    <span class="odc-add-row-ic">
        <span class="material-icons" aria-hidden="true">@Icon</span>
    </span>
    <span class="odc-add-row-text">
        <span class="odc-add-row-title">@Title</span>
        @if (ShowsReason)
        {
            <span class="odc-add-row-sub" id="@_reasonId">@DisabledReason</span>
        }
        else if (!string.IsNullOrEmpty(Sub))
        {
            <span class="odc-add-row-sub">@Sub</span>
        }
    </span>
</button>

@code {
    /// <summary>The verb / primary label (e.g. "Add account").</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Optional one-line supporting text under the title.</summary>
    [Parameter] public string? Sub { get; set; }

    /// <summary>Leading Material Icons ligature. Defaults to `add`.</summary>
    [Parameter] public string Icon { get; set; } = "add";

    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Focusable unavailable state: aria-disabled, click swallowed, focus kept (issue #526).</summary>
    [Parameter] public bool AriaDisabled { get; set; }

    /// <summary>Why the row is unavailable — shown in place of <see cref="Sub"/> while <see cref="AriaDisabled"/>.</summary>
    [Parameter] public string? DisabledReason { get; set; }

    [Parameter] public string? Class { get; set; }

    private readonly string _reasonId = $"odc-add-row-why-{Guid.NewGuid():N}";

    private bool ShowsReason => AriaDisabled && !string.IsNullOrEmpty(DisabledReason);

    private string RowClass => string.Join(' ', new[] { "odc-add-row", AriaDisabled ? "aria-disabled" : null, Class }
        .Where(c => !string.IsNullOrEmpty(c)));

    private Task HandleClickAsync() => AriaDisabled ? Task.CompletedTask : OnClick.InvokeAsync();
}
