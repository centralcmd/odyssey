@*
    OdsTaxStatementFileTypeSelect — a single-select pre-wired to the
    TaxStatementFileType vocabulary (Odyssey Design System ·
    components/TaxStatementFileTypeSelect).

    The kind of document attached to a *tax statement*: Tax return · Tax assessment ·
    Supporting document · Other — each rendered with its Material icon in its category
    color. A thin, domain-typed wrapper over OdsSelect; every OdsSelect prop passes
    straight through. Value is the enum key. Bind via @bind-Value. For files attached
    to an *account*, use OdsAccountFileTypeSelect; to a *transaction*,
    OdsTransactionFileTypeSelect.
*@

<OdsSelect Value="@Value"
           ValueChanged="ValueChanged"
           Options="OdsTypeRegistries.TaxStatementFileOptions"
           Label="@Label"
           Placeholder="@Placeholder"
           Help="@Help"
           Error="@Error"
           Required="@Required"
           Disabled="@Disabled"
           Class="@Class"
           @attributes="UserAttributes" />

@code {
    /// <summary>Selected enum key. Bindable via @bind-Value.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? Label { get; set; } = "Type";

    [Parameter] public string? Placeholder { get; set; } = "Select type…";

    [Parameter] public string? Help { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }
}
