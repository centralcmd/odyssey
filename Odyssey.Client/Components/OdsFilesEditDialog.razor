@*
    OdsFilesEditDialog — the Edit-file dialog for OdsFilesTable
    (Odyssey Design System · components/FilesTable → FTEditModal).

    Edits a file's mutable fields: display name + document type (bytes are
    immutable — you replace a file by re-uploading). When the host supplies
    Issuers (the contact options, i.e. on account-file surfaces) the dialog
    grows the document-validity fields — a Valid from / Valid to period, the
    issue date, and the issuing contact.

    "Issued by" is the canonical OdsContactSelect like every other contact field,
    so it searches, shows each candidate's type glyph, and — with OnCreateContact
    (gated on contacts.create) — adds a missing issuer inline rather than sending
    the user to Contacts mid-edit.

    This replaced the in-row OdsFilesEditPanel: editing runs in the standard
    modal every other create/edit surface uses, so the files table no longer
    needs an expandable row to host it. Commits an OdsFileEdit patch through
    OnSave; the table raises its own OnSave and flashes "Saved" on the row.
    Hosts that edit a different field set supply OdsFilesTable.RenderEdit.
*@

<OdsFormDialog Open="Open" OpenChanged="OpenChanged"
               Icon="edit" Title="Edit file" Subtitle="@File.Name"
               SubmitLabel="Save changes" SubmitIcon="check"
               OnSubmit="SubmitAsync">
    <OdsField Label="File name" @bind-Value="_name" Required="true" AutoFocus="true"
              Error="@(_touched && !_valid ? "A file needs a name." : null)" />
    <OdsSelect Label="Document type" @bind-Value="_kind" Options="Kinds" Placeholder="Select type…" />
    @if (ShowValidity)
    {
        <OdsDatePicker Label="Valid from" @bind-Value="_validFrom" Max="_validTo" />
        <OdsDatePicker Label="Valid to" @bind-Value="_validTo" Min="_validFrom" />
        @if (_rangeBad)
        {
            <div class="odc-rec-edit-err">“Valid to” can’t be before “Valid from”.</div>
        }
        <OdsDatePicker Label="Issued" @bind-Value="_issuedAt" />
        <OdsContactSelect Label="Issued by" Optional @bind-Value="_issuedBy"
                          Options="_issuerOptions"
                          AllowCreate="@(OnCreateContact is not null)" OnCreate="CreateContactOption" />
    }
</OdsFormDialog>

@code {
    [Parameter, EditorRequired] public OdsFilesRow File { get; set; } = default!;

    /// <summary>Dialog visibility. Bindable via @bind-Open.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Document-type options for the picker.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<OdsOption> Kinds { get; set; } = [];

    /// <summary>Issuing-contact options. When non-null the document-validity fields are shown.</summary>
    [Parameter] public IReadOnlyList<OdsOption>? Issuers { get; set; }

    /// <summary>
    /// Create a contact from the Issued-by picker's inline create rows and return the option to
    /// select: <c>(name, kind) =&gt; option</c>. Supplying it turns the create rows on — gate it on
    /// the host's <c>contacts.create</c> claim.
    /// </summary>
    [Parameter] public Func<string, string, OdsOption?>? OnCreateContact { get; set; }

    /// <summary>Commit the edit patch (an <see cref="OdsFileEdit"/>).</summary>
    [Parameter] public EventCallback<object?> OnSave { get; set; }

    private string _name = string.Empty;
    private string _kind = string.Empty;
    private DateTime? _validFrom;
    private DateTime? _validTo;
    private DateTime? _issuedAt;
    private string? _issuedBy;
    private bool _touched;

    private bool ShowValidity => Issuers is not null;

    // Issuers created here, ahead of the host's option refresh, so the picker keeps resolving the
    // value it was just handed.
    private readonly List<OdsOption> _created = [];

    private IReadOnlyList<OdsOption> _issuerOptions => _created.Count == 0
        ? Issuers ?? []
        : [.. _created.Where(c => (Issuers ?? []).All(o => o.Value != c.Value)), .. Issuers ?? []];

    private OdsOption? CreateContactOption(string text, string kind)
    {
        var option = OnCreateContact?.Invoke(text, kind);
        if (option is not null)
            _created.Add(option);
        return option;
    }

    private bool _valid => !string.IsNullOrWhiteSpace(_name);

    private bool _rangeBad => _validFrom is not null && _validTo is not null && _validTo < _validFrom;

    protected override void OnInitialized()
    {
        _name = File.Name;
        _kind = File.Kind;
        _validFrom = File.ValidFrom;
        _validTo = File.ValidTo;
        _issuedAt = File.IssuedAt;
        _issuedBy = File.IssuedBy?.ToString();
    }

    // Validation surfaces on submit rather than disabling the button, so the reason a save
    // didn't happen is stated on the field instead of being left to guesswork.
    private async Task<bool> SubmitAsync()
    {
        _touched = true;
        if (!_valid || _rangeBad)
            return false;

        var patch = new OdsFileEdit(_name.Trim(), _kind)
        {
            ValidFrom = _validFrom,
            ValidTo = _validTo,
            IssuedAt = _issuedAt,
            IssuedBy = Guid.TryParse(_issuedBy, out var id) ? id : null,
        };
        await OnSave.InvokeAsync(patch);
        return true;
    }
}
