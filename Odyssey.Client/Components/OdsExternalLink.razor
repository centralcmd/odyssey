@implements IAsyncDisposable
@inject IJSRuntime JS
@inject TimeProvider Time
@*
    OdsExternalLink — a URL someone else wrote (a publisher's article link, a feed's site), shown so its
    destination cannot be disguised and opened only when that is safe (Odyssey Design System ·
    components/ExternalLink; issue #473 §4.1, §6.2). Shared app-wide.

      • An <a target="_blank" rel="noopener noreferrer"> ONLY for an absolute http/https URL with a host
        and no user info (Target). Anything else — javascript:, data:, a relative or protocol-relative
        URL, https://user@host — is plain text, "Not a web link" and Copy, with no href at all.
      • The URL is shown verbatim in <bdi dir="ltr"> and wraps anywhere; the host is a separate token
        in punycode (Uri.IdnHost), so a look-alike IDN host reads as what it is.
      • The link's name is its visible text plus an sr-only "(opens in a new tab)".
      • Copy is an icon button named "Copy link"; its result is written to this component's own polite
        status line, which is also visible ("Link copied" / "Couldn't copy. Select the text instead."),
        and clears after 5 s. OnCopy reports the result; do not announce it a second time.
      • Actions="false" drops the actions row: the URL (itself the link when safe) and the host only, for a tile
        whose ⋯ menu carries Open original and Copy link.
      • Every value is rendered as text, never as markup.
*@

@if (string.IsNullOrEmpty(Url))
{
    <span class="@ClassName("odc-extlink empty")">—</span>
}
else
{
    var target = Target(Url);
    <span class="@ClassName("odc-extlink")">
        @if (!Actions && target is not null)
        {
            <a class="odc-extlink-url odc-extlink-urllink" href="@target.AbsoluteUri" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"><bdi dir="ltr">@Url</bdi><span class="odc-sr-only"> (opens in a new tab)</span></a>
        }
        else
        {
            <bdi dir="ltr" class="odc-extlink-url" @ref="_urlRef">@Url</bdi>
        }
        @if (target is not null)
        {
            <span class="odc-extlink-host"><span class="odc-sr-only">Host: </span><bdi dir="ltr">@target.IdnHost</bdi></span>
        }
        else
        {
            <span class="odc-extlink-host">Not a web link</span>
        }
        @if (Actions)
        {
        <span class="odc-extlink-actions">
            @if (target is not null)
            {
                <a class="odc-extlink-open" href="@target.AbsoluteUri" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">
                    <span class="material-icons" aria-hidden="true">open_in_new</span>
                    <span>@Text<span class="odc-sr-only"> (opens in a new tab)</span></span>
                </a>
            }
            @if (Copyable)
            {
                <OdsIconButton Icon="@Icons.Material.Filled.ContentCopy" AriaLabel="Copy link" Size="OdsSize.Sm"
                               Class="odc-extlink-copy" title="Copy link" OnClick="CopyAsync" />
            }
            <span class="@(_status == false ? "odc-extlink-status fail" : "odc-extlink-status")" role="status" aria-live="polite" aria-atomic="true">@StatusText</span>
        </span>
        }
    </span>
}
