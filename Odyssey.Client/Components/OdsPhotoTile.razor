@*
    OdsPhotoTile — THE library photo tile (Odyssey Design System · components/PhotoTile, version
    1795477868-c9a2). One look wherever library photos are listed: the Photos page grid and album view,
    a journal entry's photos (JournalPhotoGallery), and any record that links library photos.

    A square image that zooms slightly on hover, a scrim, the name as a caption, and its controls
    revealed on hover and on keyboard focus (always shown under `(hover: none)`):
      • top-left  — Select, a check (OnToggleSelect / OnStartSelect);
      • top-right — Favourite, a heart (OnToggleFav), and the ⋯ menu (Actions, an OdsMenu), the heart
                    sitting left of the menu when both;
      • bottom    — Badges ("Cover", "Archived" … always shown, in TEXT, WCAG 1.4.1), then the caption.
    A control that is ON stays visible without hover (a selected check, a favourited heart, an open
    menu), so state is never hidden.

    Structure: the tile is a container, not a button. The image is its own <button> ("Open {name}"; in
    selection mode "Select {name}" with aria-pressed), and the check, heart and menu are SIBLING buttons
    above it, so no control is nested inside another (WCAG 4.1.2). In selection mode the image button is
    THE control and the check is its visible state — always shown (a hollow ring, or the filled check),
    out of the tab order and aria-hidden — so each tile is one tab stop.

    Disabled dims the tile and makes it inert (no open, select, heart or menu) — say why with a badge.
    Unavailable (neither source, no access — known at render) labels the placeholder "no access" and
    suffixes the accessible name " (no access)" (WCAG 1.3.1); it is ignored when a source exists.

    The image is an OdsPhotoImage: thumbnail, then original, then the striped placeholder, silently.
    Styled by .odc-phototile (wwwroot/css/odyssey-components.css).
*@

<div class="@RootClass">
    <button type="button" class="odc-phototile-open" title="@(string.IsNullOrEmpty(Name) ? null : Name)"
            disabled="@Disabled" aria-label="@OpenLabel"
            aria-pressed="@(Selectable && !Disabled ? (Selected ? "true" : "false") : null)"
            @onclick="OnOpenClick">
        @if (!Image.IsEmpty)
        {
            <OdsPhotoImage Source="Image" Alt="" Fill="true" Class="odc-phototile-img"
                           PlaceholderClass="odc-phototile-img odc-phototile-ph">
                <Placeholder><span class="mono">photo</span></Placeholder>
            </OdsPhotoImage>
        }
        else
        {
            <span class="odc-phototile-img odc-phototile-ph" aria-hidden="true"><span class="mono">@(NoAccess ? "no access" : "photo")</span></span>
        }
    </button>
    <span class="odc-phototile-scrim" aria-hidden="true"></span>
    <span class="odc-phototile-foot" aria-hidden="true">
        @foreach (var badge in Badges.Where(b => !string.IsNullOrEmpty(b)))
        {
            <span class="odc-phototile-badge">@badge</span>
        }
        <span class="odc-phototile-cap">@Name</span>
    </span>
    @if (CanSelect)
    {
        <button type="button" class="@($"odc-phototile-check{(Selected ? " on" : "")}")"
                aria-label="@(Selected ? $"Deselect {Name}" : $"Select {Name}")"
                aria-pressed="@(Selected ? "true" : "false")"
                tabindex="@(Selectable ? "-1" : null)" aria-hidden="@(Selectable ? "true" : null)"
                @onclick="OnCheckClick">
            <span class="material-icons" aria-hidden="true">check</span>
        </button>
    }
    @if (OnToggleFav.HasDelegate && !Disabled)
    {
        <button type="button" class="@($"odc-phototile-fav{(Fav ? " on" : "")}")"
                aria-label="@(Fav ? $"Unfavourite {Name}" : $"Favourite {Name}")"
                aria-pressed="@(Fav ? "true" : "false")"
                @onclick="() => OnToggleFav.InvokeAsync()">
            <span class="material-icons" aria-hidden="true">@(Fav ? "favorite" : "favorite_border")</span>
        </button>
    }
    @if (HasMenu)
    {
        <span class="odc-phototile-menu">
            <OdsMenu Items="Actions!" AriaLabel="@(ActionsLabel ?? $"Actions for photo: {Name}")" />
        </span>
    }
</div>

@code {
    /// <summary>The photo's title, else its file name — the caption, the tooltip and every control's name
    /// ("Open {name}", "Favourite {name}"). A host lists an unnamed photo by its position, not its id.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>The image sources (<see cref="PhotoImageSources.For"/>): thumbnail, then original, then the
    /// striped placeholder.</summary>
    [Parameter] public PhotoImageSource Image { get; set; } = PhotoImageSource.None;

    /// <summary>Always-visible text badges at the bottom-left, e.g. "Cover", "Archived". Empty entries are skipped.</summary>
    [Parameter] public IReadOnlyList<string?> Badges { get; set; } = [];

    /// <summary>Selection mode: the image toggles selection (aria-pressed) instead of opening and is the
    /// tile's one tab stop; the check is always shown as its visible state, out of the tab order.</summary>
    [Parameter] public bool Selectable { get; set; }

    [Parameter] public bool Selected { get; set; }

    /// <summary>Open the photo — the host mounts the shared <c>PhotoViewer</c> (Pages/Photos).</summary>
    [Parameter] public EventCallback OnOpen { get; set; }

    /// <summary>Toggle this photo's selection. With it (or <see cref="OnStartSelect"/>) the check is drawn.</summary>
    [Parameter] public EventCallback OnToggleSelect { get; set; }

    /// <summary>Enter selection mode with this photo selected — what the check does outside selection mode.</summary>
    [Parameter] public EventCallback OnStartSelect { get; set; }

    /// <summary>Favourite state; the heart is drawn only when <see cref="OnToggleFav"/> is set.</summary>
    [Parameter] public bool Fav { get; set; }

    [Parameter] public EventCallback OnToggleFav { get; set; }

    /// <summary>This tile's ⋯ menu items (an <see cref="OdsMenu"/>), top-right. Null or empty for no menu.</summary>
    [Parameter] public IReadOnlyList<OdsMenuItem>? Actions { get; set; }

    /// <summary>The menu trigger's name. Default "Actions for photo: {name}".</summary>
    [Parameter] public string? ActionsLabel { get; set; }

    /// <summary>Dimmed and inert — no open, select, heart or menu (a picker's "Already added"). Say why with a badge.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Neither source is available to this caller (no access, known at render): the placeholder
    /// reads "no access" and the name gains " (no access)". Ignored when a source exists.</summary>
    [Parameter] public bool Unavailable { get; set; }

    [Parameter] public string? Class { get; set; }

    private bool HasMenu => !Disabled && Actions is { Count: > 0 };

    private bool CanSelect => !Disabled && (OnToggleSelect.HasDelegate || OnStartSelect.HasDelegate);

    private bool NoAccess => Unavailable && Image.IsEmpty;

    internal string OpenLabel => $"{(Selectable ? "Select" : "Open")} {Name}{(NoAccess ? " (no access)" : "")}";

    private string RootClass =>
        "odc-phototile"
        + (Selected ? " is-selected" : "")
        + (Selectable ? " is-selectable" : "")
        + (Disabled ? " is-disabled" : "")
        + (HasMenu ? " has-menu" : "")
        + (string.IsNullOrEmpty(Class) ? "" : " " + Class);

    private Task OnOpenClick()
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }

        return Selectable && OnToggleSelect.HasDelegate ? OnToggleSelect.InvokeAsync() : OnOpen.InvokeAsync();
    }

    private Task OnCheckClick() =>
        Selectable && OnToggleSelect.HasDelegate ? OnToggleSelect.InvokeAsync() : OnStartSelect.InvokeAsync();
}
