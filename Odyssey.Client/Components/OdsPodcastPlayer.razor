@*
    OdsPodcastPlayer — the in-browser player for one stored podcast episode (issue #594; Odyssey Design System ·
    components/PodcastPlayer). A VIEW: it owns no <audio>, timer or request. The page's PodcastPlaybackSession owns the
    one detached <audio> (podcast-player.js), the save queue and the announcements, and hands this the state to draw —
    which is why the card can collapse, and this unmount, while the episode keeps playing.

      • role="group" "Player, ‹title›"; the toggle's NAME carries the state ("Pause, ‹title›"), no aria-pressed.
      • The seek slider is a native range: ←/→ 5 s, PageUp/PageDown 60 s, Home/End (podcast-player.js bindSeek, since a
        key-dependent preventDefault cannot be done from Blazor). Its aria-valuetext is the spoken form and refreshes on a
        seek, on pause, on focus-in and when the length becomes known — never per tick (4.1.3).
      • Unknown length: total "‑‑:‑‑", the slider aria-disabled with "… elapsed, length unknown".
      • The visible times are aria-hidden; the component announces nothing (the page's polite region does).
*@
@implements IAsyncDisposable

<div class="@($"odc-podplayer {Class}".TrimEnd())" role="group" aria-label="@($"Player, {Name}")" lang="@Lang">
    <div class="odc-podplayer-main">
        <button type="button" id="@ToggleId" class="@(Busy ? "odc-podplayer-toggle busy" : "odc-podplayer-toggle")"
                aria-label="@($"{(PlayingNow ? "Pause" : "Play")}, {Name}")"
                aria-busy="@(Busy ? "true" : null)" aria-disabled="@(ToggleBlocked ? "true" : null)"
                @onclick="ToggleAsync">
            @if (Busy)
            {
                <OdsSpinner Size="OdsSize.Md" Decorative="true" />
            }
            else
            {
                <span class="material-icons" aria-hidden="true">@(PlayingNow ? "pause" : "play_arrow")</span>
            }
        </button>
        <span class="odc-podplayer-time" aria-hidden="true">@OdsPodcastPlayback.Clock(Shown)</span>
        <input @ref="_seek" type="range" id="@SeekId" class="odc-range odc-podplayer-seek"
               min="0" max="@(Known ? Total : 0)" step="1" value="@(Known ? Shown : 0)"
               aria-label="Position" aria-valuetext="@_valueText"
               aria-disabled="@(Known ? null : "true")"
               style="@($"--odc-podplayer-pct: {Percent(Shown, Total)}%")"
               @onfocus="OnSeekFocus" @oninput="OnScrub" @onchange="OnSeekCommitAsync" />
        <span class="odc-podplayer-time" aria-hidden="true">@(Known ? OdsPodcastPlayback.Clock(Total) : "--:--")</span>
    </div>
    <div class="odc-podplayer-sub">
        <div class="odc-podplayer-volume">
            <button type="button" class="odc-iconbtn sm odc-podplayer-mute" aria-label="@(Muted ? "Unmute" : "Mute")" @onclick="() => OnMute.InvokeAsync()">
                <span class="material-icons" aria-hidden="true">@(Muted || VolumePercent == 0 ? "volume_off" : "volume_up")</span>
            </button>
            <input type="range" class="odc-range odc-podplayer-vol" min="0" max="100" step="@OdsPodcastPlayback.VolumeStep" value="@VolumePercent"
                   aria-label="Volume" aria-valuetext="@($"{VolumePercent} percent{(Muted ? ", muted" : string.Empty)}")"
                   style="@($"--odc-podplayer-pct: {(Muted ? 0 : VolumePercent)}%")"
                   @onchange="OnVolumeChangeAsync" />
        </div>
        @if (Line is { Length: > 0 } line)
        {
            <p class="odc-podplayer-status">@line</p>
        }
    </div>
    @if (Error is { } error)
    {
        var info = error == OdsPodcastPlayerError.Unsupported;
        <div class="@(info ? "odc-alert info odc-podplayer-alert" : "odc-alert error odc-podplayer-alert")"
             role="@(info ? "status" : "alert")" tabindex="-1" id="@AlertId">
            <span class="material-icons" aria-hidden="true">@(info ? "info" : "error")</span>
            <div class="odc-alert-body">
                <span>@OdsPodcastPlayback.ErrorText(error, ContentTypeLabel)</span>
                @if (OdsPodcastPlayback.OffersRetry(error) && OnRetry.HasDelegate)
                {
                    <button type="button" id="@RetryId" class="odc-btn outlined sm odc-podplayer-retry"
                            aria-label="@($"Try again, {Name}")" @onclick="() => OnRetry.InvokeAsync()">Try again</button>
                }
            </div>
        </div>
    }
</div>
