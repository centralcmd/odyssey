@*
    OdsFilesEditPanel — the default inline edit panel for OdsFilesTable
    (Odyssey Design System · components/FilesTable → the RecordTable edit panel).

    Edits a file's mutable fields: display name + document type (bytes are
    immutable — you replace a file by re-uploading). When the host supplies
    Issuers (the contact options, i.e. on account-file surfaces) the panel
    grows the document-validity row — a Valid from / Valid to period, the issue
    date, and the issuing contact. Commits an OdsFileEdit patch back through
    the table's edit ctx.Save; the host PUTs it. Hosts that edit a different field
    set supply OdsFilesTable.RenderEdit instead of this panel.
*@

<div class="odc-rec-edit-head">
    <span class="material-icons odc-rec-edit-ic" aria-hidden="true">edit</span>
    <span>Edit file — @File.Name</span>
</div>
<div class="odc-rec-edit-grid">
    <div class="wide">
        <OdsField Label="File name" @bind-Value="_name" Required="true"
                  Error="@(_valid ? null : "A file needs a name.")" />
    </div>
    <OdsSelect Label="Document type" @bind-Value="_kind" Options="Kinds" />
</div>
@if (ShowValidity)
{
    <div class="odc-rec-edit-grid mt-3">
        <OdsDatePicker Label="Valid from" @bind-Value="_validFrom" Max="_validTo" />
        <OdsDatePicker Label="Valid to" @bind-Value="_validTo" Min="_validFrom" />
        <OdsDatePicker Label="Issued" @bind-Value="_issuedAt" />
        <OdsSelect Label="Issued by" @bind-Value="_issuedBy" Options="Issuers!" Placeholder="Select issuer…" />
        @if (_rangeBad)
        {
            <div class="wide odc-rec-edit-err">“Valid to” can’t be before “Valid from”.</div>
        }
    </div>
}
<div class="odc-rec-edit-actions">
    <OdsButton Variant="OdsButtonVariant.Text" OnClick="@(() => OnCancel.InvokeAsync())">Cancel</OdsButton>
    <OdsButton Variant="OdsButtonVariant.Filled" Icon="check" Disabled="@(!_valid || _rangeBad)" OnClick="Commit">
        Save changes
    </OdsButton>
</div>

@code {
    [Parameter, EditorRequired] public OdsFilesRow File { get; set; } = default!;

    /// <summary>Document-type options for the picker.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<OdsOption> Kinds { get; set; } = [];

    /// <summary>Issuing-contact options. When non-null the document-validity row is shown.</summary>
    [Parameter] public IReadOnlyList<OdsOption>? Issuers { get; set; }

    /// <summary>Commit the edit patch (an <see cref="OdsFileEdit"/>).</summary>
    [Parameter] public EventCallback<object?> OnSave { get; set; }

    /// <summary>Leave edit mode without saving.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _name = string.Empty;
    private string _kind = string.Empty;
    private DateTime? _validFrom;
    private DateTime? _validTo;
    private DateTime? _issuedAt;
    private string? _issuedBy;

    private bool ShowValidity => Issuers is not null;

    private bool _valid => !string.IsNullOrWhiteSpace(_name);

    private bool _rangeBad => _validFrom is not null && _validTo is not null && _validTo < _validFrom;

    protected override void OnInitialized()
    {
        _name = File.Name;
        _kind = File.Kind;
        _validFrom = File.ValidFrom;
        _validTo = File.ValidTo;
        _issuedAt = File.IssuedAt;
        _issuedBy = File.IssuedBy?.ToString();
    }

    private Task Commit()
    {
        if (!_valid || _rangeBad)
            return Task.CompletedTask;

        var patch = new OdsFileEdit(_name.Trim(), _kind)
        {
            ValidFrom = _validFrom,
            ValidTo = _validTo,
            IssuedAt = _issuedAt,
            IssuedBy = Guid.TryParse(_issuedBy, out var id) ? id : null,
        };
        return OnSave.InvokeAsync(patch);
    }
}
