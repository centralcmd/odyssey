@*
    The Storage health panel's tile shell (Odyssey Design System · admin.css `.sth-tile`): an overline heading
    and a column of StorageHealthRows. h3, the same level as the panel heading (as the design system has it).
*@
<section class="sth-tile" aria-labelledby="@HeadingId">
    <h3 class="sth-tile-ov" id="@HeadingId">@Heading</h3>
    <div class="sth-rows">@ChildContent</div>
</section>

@code {
    [Parameter, EditorRequired] public string HeadingId { get; set; } = string.Empty;

    [Parameter, EditorRequired] public RenderFragment Heading { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
