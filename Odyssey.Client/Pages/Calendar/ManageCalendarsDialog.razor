@*
    ManageCalendarsDialog — the calendars CRUD dialog (Odyssey Design System · ManageCalendarsModal).
    Per-row inline editor (name, description, icon — the tag icon picker with the calendar glyph as its
    Default — and colour — the tag colour picker without No color), an add row, and per-row delete. Each
    row leads with the calendar's own glyph in its colour (CalendarVisuals), as every calendar surface does.
    Deleting a calendar that still holds events/patterns is blocked by the service (409) — rather than
    proactively disabling Delete from a live count (this client only ever loads the current month-grid
    window, not full history), the delete is attempted and the returned reason surfaces via the
    standard error toast. Duplicate-name (409) on create/save is shown inline next to that row.
*@

<OdsModal Open="Open" OpenChanged="OpenChanged" OnClose="CloseAsync" Icon="calendar_month" Title="@TitleContent">
    <ChildContent>
        <div class="ods-modal-body cal-mgr-body">
            <div class="cal-mgr-list">
                @foreach (var calendar in Calendars)
                {
                    var editing = _editingId == calendar.CalendarId;
                    <div class="@("cal-mgr-item" + (editing ? " editing" : ""))">
                        <div class="cal-mgr-row">
                            <span class="material-icons cal-mgr-glyph" style="@CalendarVisuals.GlyphStyle(calendar)" aria-hidden="true">@CalendarVisuals.Glyph(calendar)</span>
                            <div class="cal-mgr-id">
                                <div class="cal-mgr-name">@calendar.Name</div>
                                <div class="cal-mgr-sub">
                                    @if (string.IsNullOrWhiteSpace(calendar.Description))
                                    {
                                        <span class="muted">No description</span>
                                    }
                                    else
                                    {
                                        <span>@calendar.Description</span>
                                    }
                                    <span class="cal-mgr-dot" aria-hidden="true">·</span>
                                    <span class="cal-mgr-swname">@ColorName(calendar.Color)</span>
                                </div>
                            </div>
                            <div class="cal-mgr-actions">
                                @* The tooltip adds the format the export produces — supplementary to the
                                   accessible name, and shown on keyboard focus as the native title was not. *@
                                <OdsTooltip Label="@($"Export {calendar.Name} as an .ics file")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                   aria-label="@($"Export {calendar.Name}")"
                                                   OnClick="@(() => OnExport.InvokeAsync(calendar))" />
                                </OdsTooltip>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="@($"Edit {calendar.Name}")"
                                               OnClick="@(() => { if (editing) { CancelEdit(); } else { StartEdit(calendar); } })" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="@($"Delete {calendar.Name}")"
                                               OnClick="@(() => DeleteAsync(calendar))" />
                            </div>
                        </div>
                        @if (editing)
                        {
                            <div class="cal-mgr-editor">
                                <div class="cal-mgr-editor-grid">
                                    <OdsField Label="Name" Required="true" Value="@_editDraft.Name" MaxLength="150" AutoFocus="true"
                                              ValueChanged="@(v => _editDraft.Name = v)" Error="@_editError" Placeholder="e.g. Personal" />
                                    <OdsField Label="Description" Value="@_editDraft.Description" MaxLength="1000"
                                              ValueChanged="@(v => _editDraft.Description = v)" Placeholder="What this calendar holds" />
                                </div>
                                @IconField(_editDraft, $"cal-icon-{calendar.CalendarId:N}")
                                @ColorField(_editDraft, $"cal-color-{calendar.CalendarId:N}")
                            </div>
                            <div class="cal-mgr-editor-actions">
                                <OdsButton Variant="OdsButtonVariant.Text" OnClick="CancelEdit">Cancel</OdsButton>
                                <OdsButton Variant="OdsButtonVariant.Filled" Icon="check" Loading="_isSaving" OnClick="SaveEditAsync">Save</OdsButton>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (_adding)
            {
                <div class="cal-mgr-item editing cal-mgr-add-open">
                    <div class="cal-mgr-add-head">
                        <span class="material-icons" aria-hidden="true">add</span>
                        <span>New calendar</span>
                    </div>
                    <div class="cal-mgr-editor">
                        <div class="cal-mgr-editor-grid">
                            <OdsField Label="Name" Required="true" Value="@_newDraft.Name" MaxLength="150" AutoFocus="true"
                                      ValueChanged="@(v => _newDraft.Name = v)" Error="@_addError" Placeholder="e.g. Personal" />
                            <OdsField Label="Description" Value="@_newDraft.Description" MaxLength="1000"
                                      ValueChanged="@(v => _newDraft.Description = v)" Placeholder="What this calendar holds" />
                        </div>
                        @IconField(_newDraft, "cal-icon-new")
                        @ColorField(_newDraft, "cal-color-new")
                    </div>
                    <div class="cal-mgr-editor-actions">
                        <OdsButton Variant="OdsButtonVariant.Text" OnClick="@(() => _adding = false)">Cancel</OdsButton>
                        <OdsButton Variant="OdsButtonVariant.Filled" Icon="check" Loading="_isSaving" OnClick="SaveNewAsync">Create calendar</OdsButton>
                    </div>
                </div>
            }
            else
            {
                <OdsAddRow Title="New calendar" Sub="Name, an optional description, an icon and a colour."
                           OnClick="@(() => { _adding = true; _editingId = null; ResetColorState(); })" />
            }
        </div>
    </ChildContent>
    <Footer>
        <div class="cal-mgr-footer">
            <span class="cal-mgr-footer-spacer"></span>
            <OdsButton Variant="OdsButtonVariant.Text" OnClick="CloseAsync">Done</OdsButton>
        </div>
    </Footer>
</OdsModal>

@code {
    private RenderFragment TitleContent => @<text>Manage calendars</text>;

    // Keyed by the field id for the same reason as the colour picker below: it reads Value once.
    private RenderFragment IconField(RowDraft draft, string id) =>
        @<OdsFieldShell Label="Icon" HtmlFor="@id" LabelId="@($"{id}-label")" Help="@IconHelp">
            <OdsTagIconPicker @key="@id" Id="@id" Value="@draft.Icon" ValueChanged="@(v => draft.Icon = v)"
                              AriaLabelledBy="@($"{id}-label")" AriaDescribedBy="@($"{id}-help")" Disabled="@_isSaving"
                              DefaultIcon="@Odyssey.Dtos.CalendarIcons.Default" DefaultLabel="Default (calendar icon)"
                              DefaultCaption="the calendar icon" />
        </OdsFieldShell>;

    // One editor is open at a time (edit and add are exclusive), so one picker state serves both. The
    // picker reads Value once, so it is keyed by the field id to re-open on the draft it belongs to.
    private RenderFragment ColorField(RowDraft draft, string id) =>
        @<OdsFieldShell Label="Color" HtmlFor="@id" LabelId="@($"{id}-label")" Help="@ColorHelp">
            <OdsTagColorPicker @key="@id" @ref="_colorPicker" Id="@id" Value="@draft.Color" AllowNone="false"
                               ValueChanged="@(v => OnColorChanged(draft, v))" ValidChanged="OnColorValidChanged"
                               AriaLabelledBy="@($"{id}-label")" AriaDescribedBy="@($"{id}-help")"
                               Disabled="@_isSaving" ShowErrors="@_colorShowErrors"
                               Invalid="@(_colorError is not null)" Error="@_colorError" />
        </OdsFieldShell>;
}
