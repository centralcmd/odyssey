@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthApiClient AuthApiClient

@* /forgot-password (issue #405 · design system ForgotPassword.jsx). Anonymous, two phases.

   The Sent panel is shown on EVERY 200 — unknown, unconfirmed and recipient-throttled
   addresses included — which is why its copy is conditional ("If an account exists…"):
   it has to be true in all four cases without revealing which one happened. A 429 is the
   one answer that keeps the user in Request, because it is about this browser, not about
   the address. *@

<PageTitle>Reset your password</PageTitle>

<MudCard Outlined="true" Class="pa-8" Style="width: 100%; max-width: 420px;">
    <div style="display: flex; flex-direction: column; align-items: center; gap: 12px; margin-bottom: 28px;">
        <OdsBrandMark Size="70" />
        <span style="font-weight: 500; font-size: 14px; letter-spacing: 0.32em; color: var(--mud-palette-primary);">ODYSSEY</span>
    </div>

    @if (_phase == Phase.Request)
    {
        <h2 @ref="_headingRef" tabindex="-1" class="auth-panel-heading mb-2">Reset your password</h2>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-2" Style="color: var(--mud-palette-text-secondary);">
            Enter the email address for your account and we'll send you a link to set a new password.
        </MudText>

        <MudTextField @bind-Value="_email"
                      Label="Email"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Required="true"
                      Immediate="true"
                      Class="mt-2"
                      autocomplete="email"
                      OnKeyDown="OnEmailKeyDown" />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <OdsAlert Severity="Severity.Error" Class="mt-4">@_error</OdsAlert>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   Class="mt-6"
                   Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_email))"
                   OnClick="SendAsync">
            @if (_isSubmitting)
            {
                <OdsSpinner Class="me-2" Decorative="true" />
            }
            Send reset link
        </MudButton>

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
            <MudLink Href="/login">Back to sign in</MudLink>
        </MudText>
    }
    else
    {
        <h2 @ref="_headingRef" tabindex="-1" class="auth-panel-heading">Check your email</h2>

        <OdsAlert Severity="Severity.Success" Class="mt-4">
            If an account exists for that address, we've sent a link to reset your password.
            The link expires in 1 hour.
        </OdsAlert>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   Class="mt-6"
                   Href="/login">
            Back to sign in
        </MudButton>

        @* A real button, not a link: it re-runs an action on this page rather than navigating.
           Matches the text-button affordance the two-step verification card already uses. *@
        <div class="mt-4" style="display: flex; align-items: center; justify-content: center; gap: 4px;">
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Didn't get it?</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="SendAgain">
                Send again
            </MudButton>
        </div>
    }
</MudCard>

@code {
    private enum Phase { Request, Sent }

    private Phase _phase = Phase.Request;
    private string _email = string.Empty;
    private string? _error;
    private bool _isSubmitting;
    private ElementReference _headingRef;

    // Nullable on purpose: a non-nullable field would default to the first enum member — Request —
    // and the guard below would silently never fire on the phase the page opens in. It costs nothing
    // here and is what makes the same pattern correct on /reset-password, where the first-render
    // phase (InvalidLink) is the one with no live region to fall back on.
    private Phase? _announcedPhase;

    // Every phase change moves focus to the heading of the panel that replaced the old one. That
    // includes Sent → Request via "Send again", which is the transition that unmounts the very button
    // the user just activated: with nothing to receive focus it falls to <body>, and a keyboard or
    // screen-reader user resumes from the top of the document (WCAG 2.4.3). Both panels therefore
    // carry a programmatic heading, not just the outcome one.
    //
    // The first render is exempt — the page opens in Request, and taking focus on load is a move the
    // user didn't ask for. Priming the sentinel there keeps the first *real* change announced.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _announcedPhase = _phase;
            return;
        }

        if (_announcedPhase == _phase)
        {
            return;
        }

        _announcedPhase = _phase;
        await _headingRef.FocusAsync();
    }

    private async Task SendAsync()
    {
        var address = _email.Trim();
        if (string.IsNullOrEmpty(address) || _isSubmitting)
        {
            return;
        }

        _error = null;
        _isSubmitting = true;

        var outcome = await AuthApiClient.RequestPasswordResetAsync(address);

        _isSubmitting = false;
        _phase = outcome switch
        {
            PasswordResetRequestOutcome.Sent => Phase.Sent,
            _ => Phase.Request,
        };

        _error = outcome switch
        {
            PasswordResetRequestOutcome.Sent => null,
            PasswordResetRequestOutcome.RateLimited => "Too many attempts. Please wait a few minutes and try again.",
            _ => "Unable to send the reset link right now. Please try again.",
        };
    }

    // A second request issues an independent token; the first link stays valid until one of them is
    // used, so nothing is invalidated by asking again.
    private void SendAgain()
    {
        _email = string.Empty;
        _error = null;
        _phase = Phase.Request;
        // The sentinel is left holding Sent so the render that follows sees the phase change and
        // moves focus onto the Request heading; clearing it here would work too, but it would hide
        // which panel the user is actually coming back from.
    }

    private async Task OnEmailKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendAsync();
        }
    }
}
