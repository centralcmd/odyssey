@page "/reset-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthApiClient AuthApiClient
@inject NavigationManager NavigationManager

@* /reset-password?code=<token> (issue #405 · design system ResetPassword.jsx). Anonymous, four phases.

   The email is deliberately NOT pre-filled from the URL — it isn't in the URL at all. The link
   carries only the code, because NGINX logs query strings and the URL also lands in browser
   history and in mail-scanner logs; retyping the address costs one field and adds a weak
   knowledge check on top of possession. The live token is scrubbed out of the address bar once
   it has been read into state. *@

<PageTitle>Choose a new password</PageTitle>

<MudCard Outlined="true" Class="pa-8" Style="width: 100%; max-width: 420px;">
    <div style="display: flex; flex-direction: column; align-items: center; gap: 12px; margin-bottom: 28px;">
        <OdsBrandMark Size="70" />
        <span style="font-weight: 500; font-size: 14px; letter-spacing: 0.32em; color: var(--mud-palette-primary);">ODYSSEY</span>
    </div>

    @if (_phase == Phase.Form)
    {
        @* A real <h2>, like the outcome panel's: MudText Typo.h5 renders an <h5>, so the two phases of
           the same card announced at two different levels — and the form phase skipped from h1 to h5. *@
        <h2 class="auth-panel-heading mb-2">Choose a new password</h2>

        <MudTextField @bind-Value="_email"
                      Label="Email"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Required="true"
                      Immediate="true"
                      Class="mt-2"
                      autocomplete="email"
                      OnKeyDown="OnFieldKeyDown" />

        <MudTextField @bind-Value="_password"
                      Label="New password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Required="true"
                      Immediate="true"
                      Class="mt-4"
                      autocomplete="new-password"
                      OnKeyDown="OnFieldKeyDown" />

        <div class="mt-3 mb-1">
            <OdsPasswordRules Password="@_password" />
        </div>

        <MudTextField @bind-Value="_confirmPassword"
                      Label="Confirm new password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Required="true"
                      Immediate="true"
                      Class="mt-4"
                      autocomplete="new-password"
                      Error="@(_confirmPassword.Length > 0 && _password != _confirmPassword)"
                      ErrorText="Passwords do not match."
                      HelperText="@(_confirmPassword.Length > 0 && _password == _confirmPassword ? "Passwords match." : null)"
                      OnKeyDown="OnFieldKeyDown" />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <OdsAlert Severity="Severity.Error" Class="mt-4">@_error</OdsAlert>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   Class="mt-6"
                   Disabled="@(!CanSubmit || _isSubmitting)"
                   OnClick="SubmitAsync">
            @if (_isSubmitting)
            {
                <OdsSpinner Class="me-2" Decorative="true" />
            }
            Set new password
        </MudButton>

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
            <MudLink Href="/login">Back to sign in</MudLink>
        </MudText>
    }
    else
    {
        <h2 @ref="_headingRef" tabindex="-1" class="auth-panel-heading">@Panel.Heading</h2>

        <OdsAlert Severity="@Panel.Severity" Class="mt-4">@Panel.Body</OdsAlert>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   Class="mt-6"
                   Href="@Panel.Href">
            @Panel.Cta
        </MudButton>
    }
</MudCard>

@code {
    private enum Phase { InvalidLink, Form, Done, Failed }

    private Phase _phase = Phase.InvalidLink;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private bool _isSubmitting;
    private ElementReference _headingRef;

    // Nullable, NOT `Phase _announcedPhase` — a non-nullable field defaults to the first enum member,
    // which is InvalidLink: exactly the phase that must take focus on the FIRST render, and the only
    // one with no live region to announce it instead. A non-nullable sentinel would make that case
    // silently no-op.
    private Phase? _announcedPhase;

    // Read once into state, then scrubbed from the address bar (see OnAfterRenderAsync). The client
    // never decodes, splits or validates the token's shape — only whether it is there at all.
    private string _code = string.Empty;

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    protected override void OnInitialized()
    {
        _code = Code ?? string.Empty;
        _phase = string.IsNullOrWhiteSpace(_code) ? Phase.InvalidLink : Phase.Form;
    }

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_email)
        && PasswordPolicy.IsSatisfied(_password)
        && _confirmPassword.Length > 0
        && _password == _confirmPassword;

    private (string Heading, Severity Severity, string Body, string Cta, string Href) Panel => _phase switch
    {
        Phase.Done => (
            "Password updated",
            Severity.Success,
            "Your password has been updated. You can now sign in with your new password. "
                + "Any other devices you were signed in on will be signed out shortly.",
            "Go to sign in",
            "/login"),
        Phase.Failed => (
            "Link no longer valid",
            Severity.Error,
            "This reset link is no longer valid. It may have expired or already been used.",
            "Request a new link",
            "/forgot-password"),
        _ => (
            "Link incomplete",
            Severity.Error,
            "This reset link is incomplete. Request a new one to continue.",
            "Request a new link",
            "/forgot-password"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The token is scrubbed from the visible URL as soon as it is in state, so it doesn't linger
        // in the address bar, the history entry, or any cross-device history sync. Replace, not push,
        // so Back doesn't lead to the token either.
        if (firstRender && !string.IsNullOrEmpty(Code))
        {
            NavigationManager.NavigateTo("/reset-password", replace: true);
        }

        if (_announcedPhase == _phase || _phase == Phase.Form)
        {
            return;
        }

        _announcedPhase = _phase;
        await _headingRef.FocusAsync();
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit || _isSubmitting)
        {
            return;
        }

        _error = null;
        _isSubmitting = true;

        var (outcome, serverMessage) = await AuthApiClient.ResetPasswordAsync(
            _email.Trim(), _code, _password);

        _isSubmitting = false;

        switch (outcome)
        {
            case PasswordResetOutcome.Success:
                _phase = Phase.Done;
                break;

            case PasswordResetOutcome.InvalidToken:
                // The only outcome that retires the form: no amount of retyping fixes a spent link.
                _phase = Phase.Failed;
                break;

            case PasswordResetOutcome.PasswordRejected:
                // The entries stay put — the user only has to change the password, not retype everything.
                _error = serverMessage ?? "That password doesn't meet the requirements. Please choose another.";
                break;

            case PasswordResetOutcome.RateLimited:
                _error = "Too many attempts. Please wait a few minutes and try again.";
                break;

            default:
                _error = "Unable to set your new password right now. Please try again.";
                break;
        }
    }

    private async Task OnFieldKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanSubmit)
        {
            await SubmitAsync();
        }
    }
}
