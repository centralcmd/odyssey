@using System.Globalization
@*
    NewsArticleCard — one article on /news (issue #473 §3.2.5–§3.2.7; Odyssey Design System · ui_kits/web/News.jsx,
    NewsArticleCard). An h3 record card: the title (or "(untitled)") in the article's language, the read state as the
    single text chip — a visible "Unread", or an sr-only "Read" (no Dimmed style) — a warning "Updated since read"
    for a read article the publisher changed afterwards (else "Updated" when it was ever edited), its own and its
    feed's tags (a feed's tag is the same chip with a dashed edge), and the meta line: feed title · author · relative
    time · image count. The article glyph takes the Status filter's colour — blue unread, amber updated since read,
    grey read — and only supports the text. Chips and meta sit inside the expand button, so nothing interactive
    renders there.

    Expanded, it follows OdsRecordCard's fixed order: the "Updated by the publisher" alert with its Show earlier
    versions button → the detail tiles (no Feed tile; the header already names the feed; the Original link tile shows
    the URL and host, its Open original and Copy link in the tile's own ⋯ menu) → the reading panel, which
    holds the body (or its Loading / Error / Unavailable / Omitted state) and the image carousel. There is no action
    row and no tag row: Mark read / unread and Tags… live in the ⋯ menu, the tags are the header's chips.
*@

<OdsRecordCard Id="@CardId(Article.Id)"
               Icon="article"
               Accent="@AccentColor"
               AccentSoft="@AccentSoftColor"
               HeadingLevel="3"
               Name="@Title"
               NameLang="@Lang"
               Meta="Meta"
               Open="Open"
               OnToggle="OnToggle">
    <Chips>
        @if (Article.IsRead)
        {
            <span class="odc-sr-only">Read</span>
        }
        else
        {
            <OdsChip Tone="OdsChipTone.Info" Dot="true" Class="sm">Unread</OdsChip>
        }
        @if (IsUpdatedSinceRead)
        {
            <OdsChip Tone="OdsChipTone.Warning" Icon="update" Class="sm">Updated since read</OdsChip>
        }
        else if (Article.ContentChangedAtUtc is not null)
        {
            <OdsChip Tone="OdsChipTone.Warning" Icon="update" Class="sm">Updated</OdsChip>
        }
        @foreach (var tag in OwnTags)
        {
            <OdsTagChip Name="@(tag.Archived is not null ? $"{tag.Name} (archived)" : tag.Name)" Icon="@tag.Icon" Color="@tag.Color" Class="sm" />
        }
        @foreach (var tag in InheritedTags)
        {
            <OdsTagChip Name="@tag.Name" Icon="@tag.Icon" Color="@tag.Color" Class="sm nw-inherited" SrSuffix=" (from feed)" />
        }
    </Chips>
    <Actions>
        @if (Busy)
        {
            <span class="nw-row-busy"><OdsSpinner Size="OdsSize.Sm" AriaLabel="@($"Saving {Title}")" /></span>
        }
        else if (Menu.Count > 0)
        {
            <OdsMenu Items="Menu" AriaLabel="@($"Actions for {Title}")" />
        }
    </Actions>
    <Alert>
        @if (Article.ContentChangedAtUtc is { } changed)
        {
            <OdsAlert Severity="Severity.Info" Live="OdsAlertLive.None">
                <span class="nw-alert-line">
                    <span>Updated by the publisher on <time datetime="@Iso(changed)">@Day(changed)</time>@(IsUpdatedSinceRead ? ", after you read it" : string.Empty).</span>
                    <OdsButton Variant="OdsButtonVariant.Text" Size="OdsButtonSize.Sm" Icon="history" OnClick="ShowVersions">Show earlier versions</OdsButton>
                </span>
            </OdsAlert>
        }
    </Alert>
    <Details>
        <OdsInfoTileGrid>
            <OdsInfoTile Icon="event" Label="Published" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@AbsoluteTime(Article.PublishedAtUtc, "Not given")</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="download" Label="First seen" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@AbsoluteTime(Article.FirstSeenAtUtc, "—")</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="done_all" Label="Read" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@(Article.IsRead ? AbsoluteTime(Article.ReadAtUtc, "Read") : AbsoluteTime(null, "Not read"))</Value>
            </OdsInfoTile>
            @* The URL and its host token only; Open original and Copy link are in the tile's own ⋯ menu and the card's. *@
            <div class="nw-tile wide">
                <OdsInfoTile Icon="link" ValueVariant="OdsInfoTileVariant.Text" Wide="true" WrapValue="true">
                    <LabelContent>
                        <span>Original link</span>
                        @if (LinkMenu.Count > 0)
                        {
                            <span class="nw-tile-menu">
                                <OdsMenu Items="LinkMenu" AriaLabel="@($"Actions for the original link of {Title}")" />
                            </span>
                        }
                    </LabelContent>
                    <Value>
                        @if (string.IsNullOrWhiteSpace(Article.Link))
                        {
                            <span>No link</span>
                        }
                        else
                        {
                            <OdsExternalLink Url="@Article.Link" Actions="false" />
                        }
                    </Value>
                </OdsInfoTile>
            </div>
        </OdsInfoTileGrid>
    </Details>
    <Content>
        <div class="nw-content">
            <div class="@ReadingClass">
                <div class="nw-reading-text">
                    @switch (Detail?.Phase ?? NewsBodyPhase.Loading)
                    {
                        case NewsBodyPhase.Loading:
                            <div class="nw-detail-loading" aria-busy="true">
                                <OdsSkeleton Variant="OdsSkeletonVariant.Text" Lines="4" />
                            </div>
                            break;
                        case NewsBodyPhase.Error:
                        case NewsBodyPhase.StorageUnavailable:
                            <OdsAlert Severity="Severity.Error" Live="OdsAlertLive.Alert">
                                <span class="nw-alert-line">
                                    <span>@(Detail!.Phase == NewsBodyPhase.StorageUnavailable ? StorageText : ErrorText)</span>
                                    <OdsButton id="@RetryId(Article.Id)" Variant="OdsButtonVariant.Outlined" Size="OdsButtonSize.Sm" Icon="refresh"
                                               AriaDisabled="@(Detail.Retrying)" OnClick="RetryDetail">@(Detail.Retrying ? "Retrying…" : "Retry")</OdsButton>
                                    @if (RetryWaitSeconds is { } wait && !Detail.Retrying)
                                    {
                                        <span class="nw-muted">@($"Available in {wait.ToString(CultureInfo.CurrentCulture)} s")</span>
                                    }
                                </span>
                            </OdsAlert>
                            break;
                        default:
                            var detail = Detail!.Detail!;
                            if (detail.BodyUnavailable)
                            {
                                <OdsAlert Severity="Severity.Info" Live="OdsAlertLive.Status">
                                    <span class="nw-alert-line">
                                        <span>@UnavailableText</span>
                                        @if (CanReadJobs)
                                        {
                                            <span>Ask an administrator to check the <a class="nw-inline-link" href="background-jobs">Background jobs</a> page.</span>
                                        }
                                    </span>
                                </OdsAlert>
                            }
                            else if (detail.BodyOmittedReason is not null)
                            {
                                <OdsAlert Severity="Severity.Info" Live="OdsAlertLive.Status">@OmittedText</OdsAlert>
                                @if (!string.IsNullOrWhiteSpace(detail.Link ?? Article.Link))
                                {
                                    <OdsExternalLink Url="@(detail.Link ?? Article.Link)" Text="Open original" Copyable="true" />
                                }
                            }
                            else
                            {
                                <NewsArticleBody Body="@detail.Body" Lang="@Lang" IdPrefix="@($"nwa-{Article.Id:N}")" />
                            }
                            break;
                    }
                </div>
                @if (Images.Count > 0)
                {
                    <div class="nw-reading-media">
                        <OdsImageCarousel Images="Images" Label="@($"Images for “{Title}”")" Lang="@Lang" />
                    </div>
                }
            </div>
        </div>
    </Content>
</OdsRecordCard>
