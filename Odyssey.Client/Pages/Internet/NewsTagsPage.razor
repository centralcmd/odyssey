@page "/news-tags"
@using Odyssey.Client.Authorization
@using Odyssey.Dtos.Internet
@attribute [Authorize(Policy = PermissionClaims.NewsRead)]
@inject Odyssey.Client.Services.INewsCatalogueCache Catalogue

<PageTitle>News Tags</PageTitle>

@*
    News tags — the tag-admin sister of Transaction/Journal/Task/Photo tags (Odyssey Design System ·
    TransactionTags · createTagsPage). Reuses the shared OdsTagAdmin over the api/news-tags contract: search +
    archival filter + sort, create / rename / archive / delete (an in-use tag returns 409 → toast). Every write drops
    the news tag cache, so the feed and article pickers see it. Podcast episodes are articles, so a tag's links count them
    too (issue #559 §3.5). Names are user text, rendered auto-encoded.
*@

<OdsTagAdmin TRow="ExistingNewsTag"
             Title="News tags"
             Noun="news tags"
             PageStateKey="news-tags-page"
             CreateClaim="@PermissionClaims.NewsTagsCreate"
             UpdateClaim="@PermissionClaims.NewsTagsUpdate"
             DeleteClaim="@PermissionClaims.NewsTagsDelete"
             NamePlaceholder="e.g. Favourites"
             ModalSubtitle="Tags group feeds, podcasts, articles and episodes. A feed’s tags apply to every article or episode it brings."
             EmptyDesc="Create your first tag to group feeds and articles — or to mark favourites."
             Id="@(t => t.NewsTagId)"
             Name="@(t => t.Name)"
             Description="@(t => t.Description)"
             Archived="@(t => t.Archived)"
             IconOf="@(t => t.Icon)"
             ColorOf="@(t => t.Color)"
             IconHelp="Shown for this tag and on every feed, article and episode carrying it. Default keeps the tag icon."
             OnTagsChanged="Catalogue.InvalidateTags" />
