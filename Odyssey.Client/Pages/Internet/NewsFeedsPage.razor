@page "/news-feeds"
@attribute [Authorize(Policy = PermissionClaims.NewsRead)]
@implements IDisposable

<PageTitle>Feeds</PageTitle>

@*
    Feeds — the household's feed list (issue #473 §3.3; Odyssey Design System · ui_kits/web/NewsFeeds.jsx). The page
    holds the FULL set (GET /api/news-feeds?state=All in pages of NewsLimits.MaxPageSize, at most five requests) and
    filters and sorts it client-side, as Accounts does; OdsInfiniteList shows it in its in-memory mode with a "Load N
    at a time" select. The Status filter is one mixed list (lifecycle OR, health OR, the two groups AND); the Overview's
    By status shows the same members, which overlap, so its total is the feed count. The "Attention" problems list
    every feed that needs attention, and Review reveals it on this page.

    No visible divider sits above the list; an sr-only h2 keeps the outline and is never a focus target. Where focus
    would go "to the list" it goes to the first card's header, else the visible empty-state heading (§6.6).
    A feed URL never appears in a route, a query string, the announcer or the page title.
*@

<OdsLiveAnnouncer @ref="_announcer" />

<div class="nw-page" id="@RootId">
<MudStack Spacing="4">
    <PageHeader Title="Feeds" Icon="@Icons.Material.Filled.RssFeed"
                Problems="Problems" ProblemsLabel="Attention"
                OverviewOpen="_overviewOpen" OverviewOpenChanged="OnOverviewToggled" OverviewOpenByDefault="true"
                SearchOpen="_searchOpen" SearchOpenChanged="OnSearchToggled" SearchOpenByDefault="true"
                PrimaryActionText="New feed" OnPrimaryAction="NewFeedClicked" ShowPrimaryAction="_canCreate"
                ActionMenu="FeedActions" ActionMenuLabel="Feed actions" ActionMenuId="@ActionMenuId">
        <SubLine>@SubLine</SubLine>
        <OverviewContent>
            @if (_feeds.Count > 0)
            {
                <div class="odc-summary-grid">
                    <OdsBreakdownTile Label="By tags" Rows="TagRows" Empty="No tagged feeds." />
                    <OdsBreakdownTile Label="By status" Rows="StatusRows" Empty="No feeds." TotalValue="@_feeds.Count" />
                </div>
            }
        </OverviewContent>
        <SearchContent>
            <div class="ph-filter-bar">
                <OdsSearchField Value="@_search" ValueChanged="OnSearchChanged" DebounceInterval="300"
                                Placeholder="Search name or site…" Class="ph-search" />
                <OdsMultiSelect Label="@(_statuses.Count == 0 ? "Status: All" : "Status")" Values="_statuses"
                                ValuesChanged="OnStatusesChanged" Options="NewsVisuals.StatusOptions" Class="ph-select" />
                <OdsMultiSelect Label="Tag" Values="_tagFilter" ValuesChanged="OnTagFilterChanged"
                                Options="TagFilterOptions" Class="ph-select" />
                <OdsSortSelect TRow="ExistingNewsFeed" Fields="SortFields" Sort="_sort" SortChanged="OnSortChanged" />
                <OdsPageSizeSelect Prefix="Load" Suffix="at a time" Label="Feeds per batch"
                                   Value="_batch" ValueChanged="OnBatchChanged" Options="OdsPageSizes.Batch" />
            </div>
        </SearchContent>
    </PageHeader>

    @if (_loading)
    {
        <div class="nw-loading" aria-busy="true">
            <span class="odc-sr-only" role="status">Loading feeds…</span>
            @for (var i = 0; i < 4; i++)
            {
                <OdsSkeleton Variant="OdsSkeletonVariant.Block" Height="88px" />
            }
        </div>
    }
    else if (_failure is { } failure)
    {
        <NewsLoadProblem Busy="failure.Busy" Noun="feeds" RetryAfter="failure.RetryAfter" Failure="_failureCount"
                         IdPrefix="nf-load" OnRetry="RetryLoadAsync" />
    }
    else if (_feeds.Count == 0)
    {
        <OdsEmptyState Icon="rss_feed">
            <Title><h2 class="nw-empty-h" tabindex="-1" id="nf-empty-h">No feeds yet</h2></Title>
            <Description>Subscribe to a site’s RSS, Atom or JSON feed to start reading.</Description>
            <Action>
                @if (_canCreate)
                {
                    <OdsButton Variant="OdsButtonVariant.Filled" Icon="add" OnClick="NewFeedClicked">New feed</OdsButton>
                }
                else
                {
                    <span class="nw-muted">Ask an administrator to add feeds.</span>
                }
            </Action>
        </OdsEmptyState>
    }
    else if (Filtered.Count == 0)
    {
        <OdsEmptyState Icon="search_off" MutedIcon="true">
            <Title><h2 class="nw-empty-h" tabindex="-1" id="nf-empty-h">No feeds match these filters</h2></Title>
            <Description>Try a different search or another status.</Description>
            <Action>
                @if (HasFilters)
                {
                    <OdsButton Variant="OdsButtonVariant.Outlined" Icon="close" OnClick="ClearFilters">Clear filters</OdsButton>
                }
                else
                {
                    <OdsButton Variant="OdsButtonVariant.Outlined" Icon="list" OnClick="ShowAllFeeds">Show all feeds</OdsButton>
                }
            </Action>
        </OdsEmptyState>
    }
    else
    {
        <h2 class="odc-sr-only">Feeds</h2>
        <div class="nw-list">
            <OdsInfiniteList TItem="ExistingNewsFeed" Items="Filtered" BatchSize="_batch" Noun="feeds"
                             ItemKey="@(f => (object)f.Id)" RevealKey="_revealId">
                <RenderItem Context="feed">
                    <NewsFeedCard @key="feed.Id" Feed="feed" TagsById="_tagsById" Menu="MenuFor(feed)"
                                  Open="@(_openId == feed.Id)" OnToggle="open => OnToggle(feed, open)"
                                  Highlight="@(_revealId == feed.Id)"
                                  Busy="@_busyIds.Contains(feed.Id)"
                                  OnCheckAgain="CheckAgainAsync" OnCopied="Say" />
                </RenderItem>
            </OdsInfiniteList>
        </div>
    }
</MudStack>
</div>

@if (_dialogKey != Guid.Empty)
{
    <NewsFeedDialog @key="_dialogKey" Open="_dialogOpen" OpenChanged="OnDialogOpenChanged"
                    Feed="_dialogFeed" Tags="_tags" InitialConflict="_dialogConflict" InitialUrl="_dialogUrl"
                    Saved="OnFeedSavedAsync" GoToFeed="GoToFeedAsync" Deleted="OnFeedGoneInDialog"
                    Refreshed="Replace" />
}

@if (_importKey != Guid.Empty)
{
    <ImportNewsFeedsDialog @key="_importKey" Open="_importOpen" OpenChanged="v => _importOpen = v"
                           ReturnFocusToId="@ActionMenuId" Closed="OnImportClosedAsync" />
}

@if (_deleting is { } deleting)
{
    <OdsModal @key="_deleteKey" Open="_deleteOpen" OpenChanged="OnDeleteOpenChanged"
              Icon="delete" IconTone="OdsModalTone.Error" Role="OdsModalRole.AlertDialog"
              InitialFocus="OdsModalInitialFocus.Cancel" RequiredLegend="false" DescribedById="nf-del-desc">
        <Title>@($"Delete “{deleting.DisplayTitle}”?")</Title>
        <ChildContent>
            @if (_deleteError is { } error)
            {
                <OdsAlert Severity="Severity.Error" Live="OdsAlertLive.Alert">@error</OdsAlert>
            }
            <p class="nw-dialog-line" id="nf-del-desc">
                Delete <strong lang="@deleting.Language"><bdi>@deleting.DisplayTitle</bdi></strong>@($" and its {NewsFeedback.Count(deleting.ArticleCount, "article", "articles")}? This cannot be undone.")
            </p>
            <OdsCheckbox Id="nf-del-ack" Label="I understand this cannot be undone"
                         Checked="_deleteAck" CheckedChanged="v => _deleteAck = v" />
        </ChildContent>
        <Footer>
            <OdsButton Variant="OdsButtonVariant.Text" OnClick="CloseDelete" data-dialog-cancel="true">Cancel</OdsButton>
            <OdsButton id="nf-del-confirm" Variant="OdsButtonVariant.Danger" Icon="delete" Loading="_deleteBusy"
                       AriaDisabled="@(!_deleteAck)" OnClick="DeleteAsync">Delete feed</OdsButton>
        </Footer>
    </OdsModal>
}

@code {
    /// <summary>
    /// The header's ⋯ "Feed actions" menu (issue #509 §3.1): Export all, Export filtered (N), a divider, Import from
    /// OPML…. Each item is ABSENT, never disabled, when it does not apply, and with no item the page passes no menu at
    /// all, so a reader gets no ⋯ button (F1).
    /// </summary>
    private RenderFragment? FeedActions => !ShowsExportAll && !_canCreate ? null : @<text>
        @if (ShowsExportAll)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.FileDownload" OnClick="@(() => ExportAsync(filtered: false))">Export all as OPML</MudMenuItem>
        }
        @if (ShowsExportFiltered)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.FilterList" OnClick="@(() => ExportAsync(filtered: true))">@($"Export filtered ({FilteredCountText}) as OPML")</MudMenuItem>
        }
        @if (ShowsExportAll && _canCreate)
        {
            <MudDivider />
        }
        @if (_canCreate)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.UploadFile" OnClick="OpenImport">Import from OPML…</MudMenuItem>
        }
    </text>;
}
