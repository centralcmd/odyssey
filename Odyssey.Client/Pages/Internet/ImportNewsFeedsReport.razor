@using Odyssey.Dtos.Internet
@*
    ImportNewsFeedsReport — the Result state of ImportNewsFeedsDialog (issue #509 §3.4): the three tiles, the outcome
    groups in a fixed order whose counts are the server's counters, and the notes. One role="group" labelled by its
    heading. Every report value renders as text; URLs are masked (ImportNewsFeedsDialog.Mask). Its disclosure state is
    its own, so dropping the component (Import another file, close) drops the report with it.
*@

@{
    var r = Result;
    var notImported = ImportNewsFeedsDialog.NotImported(r);
    var allAdded = r.Feeds > 0 && r.Created == r.Feeds;
}
<div class="cal-imp-result" role="group" aria-labelledby="@ImportNewsFeedsDialog.ResultHeadingId">
    <h3 class="cal-imp-result-h" id="@ImportNewsFeedsDialog.ResultHeadingId" tabindex="-1">
        Imported from <span class="cal-imp-result-cal"><bdi>@FileName</bdi></span>
    </h3>

    <div class="cal-imp-stats nw-opml-stats">
        <div class="cal-imp-stat ok">
            <span class="material-icons" aria-hidden="true">add_circle</span>
            <div class="cal-imp-stat-body">
                <span class="cal-imp-stat-n">@ImportNewsFeedsDialog.Number(r.Created)</span>
                <span class="cal-imp-stat-l">added</span>
            </div>
        </div>
        <div class="cal-imp-stat upd">
            <span class="material-icons" aria-hidden="true">bookmark_added</span>
            <div class="cal-imp-stat-body">
                <span class="cal-imp-stat-n">@ImportNewsFeedsDialog.Number(r.AlreadySubscribed)</span>
                <span class="cal-imp-stat-l">already subscribed</span>
            </div>
        </div>
        <div class="@($"cal-imp-stat{(notImported > 0 ? " skip" : "")}")">
            <span class="material-icons" aria-hidden="true">@(notImported > 0 ? "rule" : "check_circle")</span>
            <div class="cal-imp-stat-body">
                <span class="cal-imp-stat-n">@ImportNewsFeedsDialog.Number(notImported)</span>
                <span class="cal-imp-stat-l">not imported</span>
            </div>
        </div>
    </div>

    @if (r.Feeds == 0)
    {
        <div class="cal-imp-note">
            <span class="material-icons" aria-hidden="true">info</span>
            <span>This file doesn't list any feeds.</span>
        </div>
    }
    else if (allAdded)
    {
        <div class="cal-imp-clean">
            <span class="material-icons" aria-hidden="true">task_alt</span>Every feed in the file was added.
        </div>
    }
    else
    {
        <div class="cal-imp-skips">
            <div class="cal-imp-skips-head">Feeds, by outcome</div>
            @foreach (var group in ImportNewsFeedsDialog.Groups(r))
            {
                @Disclosure(group.Id, group.Reason, group.Count, group.Rows.Count, "feeds", group.Neutral, FeedRows(group))
            }
        </div>
    }

    @if (r.MergedOutlines > 0)
    {
        <div class="cal-imp-note">
            <span class="material-icons" aria-hidden="true">merge</span>
            <span>@ImportNewsFeedsDialog.MergedNote(r.MergedOutlines)</span>
        </div>
    }
    @if (r.ItemsTruncated)
    {
        <div class="cal-imp-note">
            <span class="material-icons" aria-hidden="true">short_text</span>
            <span>Some lists are shortened. The counts include every feed.</span>
        </div>
    }
    @if (r.TagsCreated.Count > 0)
    {
        <div class="cal-imp-note">
            <span class="material-icons" aria-hidden="true">local_offer</span>
            <span class="nw-opml-wrap">Added @ImportNewsFeedsDialog.Number(r.TagsCreated.Count) @(r.TagsCreated.Count == 1 ? "tag" : "tags"):
                @for (var i = 0; i < r.TagsCreated.Count; i++)
                {
                    @(i > 0 ? ", " : "")<bdi>@r.TagsCreated[i]</bdi>
                }
            </span>
        </div>
    }
    @if (r.TagsSkippedTotal > 0)
    {
        <div class="cal-imp-skips">
            @Disclosure("news-opml-g-tags", "Tags not added", r.TagsSkippedTotal, r.TagsSkipped.Count, "tags", false, TagRows(r))
        </div>
    }
    @if (r.Items.Any(i => i.TagsDropped > 0))
    {
        <div class="cal-imp-note">
            <span class="material-icons" aria-hidden="true">label_off</span>
            <span>@ImportNewsFeedsDialog.DroppedNote</span>
        </div>
    }
    @if (r.Created > 0)
    {
        <div class="cal-imp-note">
            <span class="material-icons" aria-hidden="true">schedule</span>
            <span>New feeds show as Pending until their first fetch. Paused ones are listed under Status: Paused.</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public NewsOpmlImportResult Result { get; set; } = default!;

    [Parameter, EditorRequired] public string FileName { get; set; } = default!;

    private readonly HashSet<string> _openGroups = new(StringComparer.Ordinal);

    private void ToggleGroup(string id)
    {
        if (!_openGroups.Remove(id))
        {
            _openGroups.Add(id);
        }
    }

    private RenderFragment FeedRows(ImportNewsFeedsDialog.OutcomeGroup group) => @<text>
        @foreach (var row in group.Rows)
        {
            <li class="cal-imp-skip-item nw-opml-row">
                <span class="material-icons" aria-hidden="true">@group.Icon</span>
                <span class="nw-opml-row-main">
                    <bdi class="nw-opml-title">@(string.IsNullOrWhiteSpace(row.Title) ? "Untitled feed" : row.Title)</bdi>
                    @Url(row.Url)
                    @if (group.WithMessage && !string.IsNullOrWhiteSpace(row.Message))
                    {
                        <span class="nw-opml-msg">@row.Message</span>
                    }
                </span>
            </li>
        }
    </text>;

    private RenderFragment TagRows(NewsOpmlImportResult r) => @<text>
        @foreach (var tag in r.TagsSkipped)
        {
            <li class="cal-imp-skip-item nw-opml-row">
                <span class="material-icons" aria-hidden="true">label_off</span>
                <span class="nw-opml-row-main">
                    <bdi class="nw-opml-title">@tag.Name</bdi>
                    <span class="nw-opml-msg">@ImportNewsFeedsDialog.TagReason(tag.Reason)</span>
                </span>
            </li>
        }
    </text>;

    /// <summary>
    /// One collapsed group: a button with aria-expanded / aria-controls whose name is the reason, the exact server
    /// count and its unit ("Address can't be used, 3 feeds"); rows render only while it is open, then "+n more" when
    /// the count exceeds the rows the (possibly truncated) report carries.
    /// </summary>
    private RenderFragment Disclosure(string id, string reason, int count, int rows, string unit, bool neutral, RenderFragment items)
    {
        var open = _openGroups.Contains(id);
        var listId = $"{id}-list";
        var more = Math.Max(0, count - rows);
        return @<div class="@($"cal-imp-skip nw-opml-group{(neutral ? " neutral" : "")}{(open ? " open" : "")}")">
            <button type="button" class="cal-imp-skip-head" aria-expanded="@(open ? "true" : "false")" aria-controls="@listId"
                    @onclick="@(() => ToggleGroup(id))">
                <span class="material-icons cal-imp-skip-chev" aria-hidden="true">chevron_right</span>
                <span class="cal-imp-skip-reason">@reason</span><span class="odc-sr-only">, </span>
                <span class="cal-imp-skip-count">@ImportNewsFeedsDialog.Number(count)</span><span class="odc-sr-only">@($" {unit}")</span>
            </button>
            <ul id="@listId" class="cal-imp-skip-list nw-opml-list" hidden="@(!open)">
                @if (open)
                {
                    @items
                    @if (more > 0)
                    {
                        <li class="cal-imp-skip-more">+@ImportNewsFeedsDialog.Number(more) more</li>
                    }
                }
            </ul>
        </div>;
    }

    private RenderFragment Url(string? url)
    {
        var masked = ImportNewsFeedsDialog.Mask(url);
        return @<bdi dir="ltr" class="nw-opml-url">@if (masked is null)
            {
                @("(address hidden)")
            }
            else if (!masked.Masked)
            {
                @masked.Head
            }
            else
            {
                @masked.Head<span aria-hidden="true">•••</span><span class="odc-sr-only">credentials hidden</span>@masked.Tail
            }</bdi>;
    }
}
