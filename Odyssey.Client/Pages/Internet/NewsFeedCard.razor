@using System.Globalization
@inject IClipboardService Clipboard
@*
    NewsFeedCard — one feed on /news-feeds (issue #473 §3.3; Odyssey Design System · ui_kits/web/NewsFeeds.jsx,
    NewsFeedRecord). An h3 record card: the display title (never a fetch host) in the feed's language, the HEALTH as a
    text chip, its tags, and the meta line — the site host (from siteUrl only), "Checked 12 min ago" and the interval —
    with unread and article counts. The feed glyph carries the health's colour (Paused amber); the chip's text is
    what says the state.

    The expanded body is ONE info-tile grid with no section headings: Health, Last success, Next check, Site, Check
    every, Download images, Active; then, ONLY when management is non-null (news-feeds.update — the client infers
    nothing from its absence), the last result in words, failures, today's articles and image size, the storage limit
    and, last and full width, the Feed URL with its own ⋯ menu. Under the grid, the https → http note when it applies.
    View articles is the first item of the card's ⋯ menu. Nothing interactive sits inside the card's expand button.
    Every publisher string is encoded text.

    A podcast (kind = Podcast, issue #559 §3.3) is the same card with: the show artwork as the mark (podcasts glyph
    fallback; the accent stays the health), a Podcast chip before the health chip, the author first in the meta line,
    Episodes · On the server in place of unread · articles, View episodes in the menu (the page's) and the
    Auto-download · Auto-delete · Audio on the server tiles.
*@

<OdsRecordCard Id="@CardId(Feed.Id)"
               Icon="@(IsPodcast ? "podcasts" : "rss_feed")"
               Image="@(IsPodcast && ArtworkUrl is { } art ? new OdsRecordImage(art) : null)"
               Accent="@Accent"
               AccentSoft="@AccentSoft"
               HeadingLevel="3"
               Name="@Feed.DisplayTitle"
               NameLang="@Lang"
               Meta="Meta"
               Counts="Counts"
               Dimmed="@(Feed.ArchivedAtUtc is not null)"
               Highlight="Highlight"
               Open="Open"
               OnToggle="OnToggle">
    <Chips>
        @if (IsPodcast)
        {
            <OdsChip Tone="OdsChipTone.Outline" Icon="podcasts" Class="sm">Podcast</OdsChip>
        }
        <NewsFeedHealthChip Health="Feed.Health" DescribedBy="@(QuotaText is null ? null : QuotaId)" />
        @if (QuotaText is { } quota)
        {
            <span id="@QuotaId" class="odc-sr-only">@quota</span>
        }
        @foreach (var tag in FeedTags)
        {
            <OdsTagChip Name="@(tag.Archived is not null ? $"{tag.Name} (archived)" : tag.Name)" Icon="@tag.Icon" Color="@tag.Color" Class="sm" />
        }
    </Chips>
    <Actions>
        @if (Busy)
        {
            <span class="nw-row-busy"><OdsSpinner Size="OdsSize.Sm" AriaLabel="@($"Saving {Feed.DisplayTitle}")" /></span>
        }
        else if (Menu.Any(item => !item.Divider))
        {
            <OdsMenu Items="Menu" AriaLabel="@($"Actions for {Feed.DisplayTitle}")" />
        }
    </Actions>
    <Alert>
        @if (Feed.Health == NewsFeedHealth.Quarantined)
        {
            <OdsAlert Severity="Severity.Error" Live="OdsAlertLive.None">Odyssey stopped fetching this feed because of what it returned. Check the feed, then release it from quarantine.</OdsAlert>
        }
        else if (QuotaText is { } quotaAlert)
        {
            <OdsAlert Severity="Severity.Warning" Live="OdsAlertLive.None">@quotaAlert</OdsAlert>
        }
        else if (Feed.Health == NewsFeedHealth.Pending)
        {
            <OdsAlert Severity="Severity.Info" Live="OdsAlertLive.None">
                <span class="nw-alert-line">
                    <span>Not fetched yet.</span>
                    <OdsButton Variant="OdsButtonVariant.Text" Size="OdsButtonSize.Sm" Icon="refresh" OnClick="CheckAgain">Check again</OdsButton>
                </span>
            </OdsAlert>
        }
    </Alert>
    <Details>
        <OdsInfoTileGrid>
            <OdsInfoTile Icon="monitor_heart" Label="Health" ValueVariant="OdsInfoTileVariant.Text">
                <Value><NewsFeedHealthChip Health="Feed.Health" Compact="true" /></Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="schedule" Label="Last success" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@(Feed.LastSuccessAtUtc is { } success ? OdsRelativeTime.Absolute(Utc(success)) : "Never")</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="update" Label="Next check" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@(Feed.NextFetchAtUtc is { } next && Feed.ArchivedAtUtc is null && Feed.IsActive ? OdsRelativeTime.Absolute(Utc(next)) : "Not scheduled")</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="language" Label="Site" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@(SiteHost ?? "—")</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="timer" Label="Check every" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@(Feed.FetchIntervalMinutes is { } own ? $"{own} min" : $"{Feed.EffectiveIntervalMinutes} min (default)")</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="image" Label="Download images" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@(Feed.DownloadImages ? "On" : "Off")</Value>
            </OdsInfoTile>
            @if (Feed.Podcast is { } podcast)
            {
                <OdsInfoTile Icon="cloud_download" Label="Auto-download" ValueVariant="OdsInfoTileVariant.Text">
                    <Value>@(podcast.AutoDownload ? "On" : "Off")</Value>
                </OdsInfoTile>
                <OdsInfoTile Icon="auto_delete" Label="Auto-delete" ValueVariant="OdsInfoTileVariant.Text">
                    <Value>@(podcast.AutoDeleteEnabled ? $"After {NewsFeedback.Count(podcast.AutoDeleteAfterDays, "day", "days")}" : "Off")</Value>
                </OdsInfoTile>
                <OdsInfoTile Icon="sd_storage" Label="Audio on the server" ValueVariant="OdsInfoTileVariant.Text">
                    <Value>@($"{NewsFeedback.Count(podcast.StoredAudioCount, "episode", "episodes")} · {PodcastFormat.Size(podcast.StoredAudioBytes)}")</Value>
                </OdsInfoTile>
            }
            <OdsInfoTile Icon="power_settings_new" Label="Active" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@(Feed.ArchivedAtUtc is not null ? "Archived" : Feed.IsActive ? "Yes" : "Paused")</Value>
            </OdsInfoTile>
            @if (Feed.Management is { } management)
            {
                <OdsInfoTile Icon="fact_check" Label="Last result" ValueVariant="OdsInfoTileVariant.Text" WrapValue="true">
                    <Value>@LastResult(management)</Value>
                </OdsInfoTile>
                <OdsInfoTile Icon="error_outline" Label="Consecutive failures" ValueVariant="OdsInfoTileVariant.Text">
                    <Value>@management.ConsecutiveFailures.ToString("N0", CultureInfo.CurrentCulture)</Value>
                </OdsInfoTile>
                @* Wraps instead of cutting to "…": articles on one line, images on the next. *@
                <OdsInfoTile Icon="today" Label="Today" ValueVariant="OdsInfoTileVariant.Text" WrapValue="true">
                    <Value>@NewsFeedback.Count(management.ArticlesToday, "article", "articles")<br />@($"{ByteSize.Format(management.ImageBytesToday)} of images")</Value>
                </OdsInfoTile>
                @if (QuotaText is { } limit)
                {
                    <OdsInfoTile Icon="storage" Label="Storage limit" ValueVariant="OdsInfoTileVariant.Text">
                        <Value>@limit</Value>
                    </OdsInfoTile>
                }
                @* The whole URL, query included; its action sits in the tile's own ⋯ menu, top-right. *@
                <div class="nw-tile wide">
                    <OdsInfoTile Icon="link" ValueVariant="OdsInfoTileVariant.Text" Wide="true" WrapValue="true">
                        <LabelContent>
                            <span>Feed URL</span>
                            <span class="nw-tile-menu">
                                <OdsMenu Items="UrlMenu(management.Url)" AriaLabel="@($"Actions for the feed URL of {Feed.DisplayTitle}")" />
                            </span>
                        </LabelContent>
                        <Value>
                            @if (UrlTarget(management.Url) is { } target)
                            {
                                @* A safe http/https URL is itself the link (OdsExternalLink's rule): new tab, no opener, no referrer. *@
                                <a class="nw-link-url" href="@target.AbsoluteUri" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"><bdi dir="ltr">@management.Url</bdi><span class="odc-sr-only"> (opens in a new tab)</span></a>
                            }
                            else
                            {
                                <bdi dir="ltr" class="nw-link-url">@management.Url</bdi>
                            }
                        </Value>
                    </OdsInfoTile>
                </div>
            }
        </OdsInfoTileGrid>
    </Details>
    <Content>
        @if (Feed.Management is { RedirectedFromHttps: true })
        {
            <p class="nw-line"><span class="material-icons" aria-hidden="true">lock_open</span>This feed was redirected from https to http. Its content now travels unencrypted.</p>
        }
    </Content>
</OdsRecordCard>
