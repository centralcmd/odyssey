@inject AuthApiClient AuthApiClient
@inject ISnackbar Snackbar
@using Odyssey.Client.Components
@* /account · "Change password", on Odyssey's first-party POST api/account/password.

   Moved off Identity's manage/info with issue #406: that endpoint changes the password AND the email
   address, so it could not be the one left reachable by a session blocked pending a forced password
   change. The first-party endpoint also refreshes the auth cookie, so changing your password here no
   longer signs you out a minute later.

   The fields are the shared OdsPasswordChangeForm — the identical triad the forced-reset gate renders,
   so the two can't drift and the autocomplete + role="alert" fixes land once. *@

@if (_saved)
{
    <OdsAlert Severity="Severity.Success" Class="acc-block-alert">
        <b>Password updated.</b> Your new password is in effect. Other devices you were signed in on will
        be signed out shortly.
    </OdsAlert>
}

<MudCard Elevation="1" Class="ods-outline">
    <MudCardContent Class="pa-4">
        <div class="acc-cardhead bordered">
            <span class="acc-ic"><MudIcon Icon="@Icons.Material.Filled.Password" /></span>
            <div class="acc-sec-titles">
                <div class="acc-sec-title">Change password</div>
                <div class="acc-sec-sub">Choose a strong password you don't use anywhere else.</div>
            </div>
        </div>

        <OdsPasswordChangeForm @ref="_form"
                               OnSubmit="UpdatePasswordAsync"
                               Error="@_error"
                               Busy="_saving"
                               Columns="2" />
    </MudCardContent>
</MudCard>

@code {
    private OdsPasswordChangeForm? _form;
    private bool _saving;
    private bool _saved;
    private string? _error;

    private async Task UpdatePasswordAsync(OdsPasswordChangeForm.PasswordChange change)
    {
        _saving = true;
        _saved = false;
        _error = null;

        var result = await AuthApiClient.ChangePasswordAsync(change.CurrentPassword, change.NewPassword);
        _saving = false;

        if (result.IsSuccess)
        {
            _saved = true;
            _form?.Reset();
            return;
        }

        // The endpoint answers RFC 7807 and distinguishes a wrong current password from a rejected new
        // one, so its own wording is shown rather than a hardcoded guess at which of the two it was.
        _error = result.Error ?? "Please check your current password and try again.";
        Snackbar.Add("Unable to update your password.", Severity.Error);
    }
}
