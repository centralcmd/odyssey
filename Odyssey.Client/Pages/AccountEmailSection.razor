@inject AuthApiClient AuthApiClient
@inject ISnackbar Snackbar
@using Odyssey.Client.Components
@* /account · "Email address", on Odyssey's first-party POST api/account/email (issue #246).

   That endpoint verifies the current password (counting failures toward lockout), signs out other
   sessions, mails a confirmation link to the new address and a notice to the current one. Identity's
   POST manage/info, which did the same with no password at all, is closed. The resend card below is
   still a design preview and calls nothing. *@

<MudCard Elevation="1" Class="ods-outline">
    <MudCardContent Class="pa-4">
        <div class="acc-cardhead bordered">
            <span class="acc-ic"><MudIcon Icon="@Icons.Material.Filled.AlternateEmail" /></span>
            <div class="acc-sec-titles">
                <div class="acc-sec-title">Email address</div>
                <div class="acc-sec-sub">Your email is your sign-in identity and where security notifications are sent.</div>
            </div>
        </div>

        <div class="acc-current-email">
            <span class="acc-kv-label">Current email</span>
            <code class="mono acc-current-email-val">@Email</code>
            @if (EmailConfirmed)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info"
                         Icon="@Icons.Material.Filled.MarkEmailRead">Email confirmed</MudChip>
            }
        </div>

        @if (_sent)
        {
            <div class="alert info acc-block-alert" role="status">
                <span class="material-icons alert-icon">info</span>
                <div class="alert-body">
                    <strong>Confirmation sent.</strong> We've emailed a confirmation link to your new address. Your sign-in email stays the same until you confirm it.
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <OdsAlert Severity="Severity.Error" Class="acc-block-alert">@_error</OdsAlert>
        }

        <div class="acc-form">
            <MudTextField @bind-Value="_newEmail"
                          Label="New email address"
                          Placeholder="you@example.com"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Immediate="true"
                          Error="@FieldError"
                          ErrorText="@ErrorText"
                          autocomplete="email" />
            <MudTextField @bind-Value="_password"
                          Label="Current password"
                          Placeholder="••••••••"
                          HelperText="Confirm it's you before we change your email."
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Immediate="true"
                          autocomplete="current-password" />
            <div class="acc-form-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Send"
                           Disabled="@(!CanUpdate || _saving)"
                           OnClick="UpdateEmailAsync">Update email</MudButton>
            </div>
        </div>
    </MudCardContent>
</MudCard>

<MudCard Elevation="1" Class="ods-outline">
    <MudCardContent Class="pa-4">
        <div class="acc-resend">
            <div class="acc-cardhead">
                <span class="acc-ic"><MudIcon Icon="@Icons.Material.Filled.MarkEmailUnread" /></span>
                <div class="acc-sec-titles">
                    <div class="acc-sec-title acc-sec-title-sm">Resend confirmation email</div>
                    <div class="acc-sec-sub">Didn't get the confirmation message? Send it again to your current address.</div>
                </div>
            </div>
            @if (_resent)
            {
                <span class="acc-saved"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />Sent — check your inbox</span>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ForwardToInbox"
                           OnClick="ResendConfirmation">Resend</MudButton>
            }
        </div>
    </MudCardContent>
</MudCard>

@code {
    /// <summary>The sign-in email address.</summary>
    [Parameter] public string Email { get; set; } = string.Empty;

    /// <summary>Whether it has been confirmed.</summary>
    [Parameter] public bool EmailConfirmed { get; set; }

    private string _newEmail = string.Empty;
    private string _password = string.Empty;
    private bool _sent;
    private bool _resent;
    private bool _saving;
    private string? _error;

    private bool LooksValid => System.Text.RegularExpressions.Regex.IsMatch(_newEmail, "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$");
    private bool IsSame => string.Equals(_newEmail.Trim(), Email, StringComparison.OrdinalIgnoreCase);
    private bool FieldError => _newEmail.Length > 0 && (!LooksValid || IsSame);
    private string? ErrorText => _newEmail.Length == 0 ? null
        : !LooksValid ? "Enter a valid email address."
        : IsSame ? "This is already your email address."
        : null;
    private bool CanUpdate => LooksValid && !IsSame && _password.Length > 0;

    private async Task UpdateEmailAsync()
    {
        _saving = true;
        _sent = false;
        _error = null;

        var result = await AuthApiClient.ChangeEmailAsync(_newEmail.Trim(), _password);
        _saving = false;

        if (result.IsSuccess)
        {
            _sent = true;
            _newEmail = string.Empty;
            _password = string.Empty;
            return;
        }

        // The endpoint answers RFC 7807 and tells a wrong password from a lockout or a rejected address,
        // so its own wording is shown. The password is cleared either way; the address is kept to retry.
        _password = string.Empty;
        _error = result.Error ?? "Please check your current password and try again.";
        Snackbar.Add("Unable to change your email address.", Severity.Error);
    }

    private void ResendConfirmation() => _resent = true;
}
