@*
    BackfillMoveStatus — a move's progress on the Background jobs overview (issues #428, #449; Odyssey Design System ·
    ui_kits/web/BackgroundJobs.jsx, BackfillMoveStatus): a lead sentence, an OdsInfoTileGrid of OdsInfoTiles (the file
    move adds its per-area on-disk counts as three more tiles), the parked items by reason, the back-off line while it runs
    and the last pass. No card: the section's h2 already frames it, and the tiles sit straight in the Overview like the
    Totals. It renders a BackfillMoveView and does no arithmetic: BackgroundJobPresentation.PhotoMoveView / FileMoveView
    build it from each DTO, which is null without file-storage.read — the page then renders no section at all. Counts and
    park codes only; no DTO carries an id, a name or a path. Plain content: no live region and no action (a manual run is
    the header menu's Run item). The parked list is labelled by its visible caption, not a hidden aria-label.
*@
@using Odyssey.Client.Services
@using static Odyssey.Client.Pages.JobRuns.BackgroundJobPresentation

<div class="bgj-move">
    <p class="bgj-move-lead">@View.Lead</p>
    <OdsInfoTileGrid>
        @foreach (var tile in View.Tiles)
        {
            <OdsInfoTile @key="tile.Label" Icon="@tile.Icon" Label="@tile.Label"
                         Value="@Text(Count(tile.Value))" Foot="@OdsInfoTile.Caption(tile.Foot)" />
        }
    </OdsInfoTileGrid>
    @if (View.ParkedLines.Count > 0)
    {
        <div class="bgj-move-parked">
            <p class="bgj-move-cap" id="@_captionId">@View.ParkedListCaption</p>
            <ul class="bgj-move-codes" aria-labelledby="@_captionId">
                @foreach (var line in View.ParkedLines)
                {
                    <li @key="line">@line</li>
                }
            </ul>
        </div>
    }
    @if (View.BackingOffUntilUtc is { } until && until > GeneratedAtUtc.UtcDateTime)
    {
        <p class="bgj-held">@($"Paused after a storage or database error until {RunTime.Clock(until)}.")</p>
    }
    <p class="bgj-caption">@(View.LastRunAtUtc is { } last ? $"Last pass {RunTime.Absolute(last)}" : "No pass yet")</p>
</div>

@code {
    [Parameter, EditorRequired] public BackfillMoveView View { get; set; } = default!;

    /// <summary>The overview's clock: the back-off line is compared against it, never the render clock (#410 F17).</summary>
    [Parameter] public DateTimeOffset GeneratedAtUtc { get; set; }

    private readonly string _captionId = $"bgj-move-cap-{Guid.NewGuid():N}";

    private static RenderFragment Text(string value) => builder => builder.AddContent(0, value);
}
