@*
    An instrument-price sync run's or purge's detail (issue #446 §4.6): instruments attempted, succeeded and failed, the
    prices it inserted (or a purge deleted), fallbacks used and the wire requests it made. Counts only. The full
    Background jobs surface for this job is specified in frontend issue #452 §3.6.
*@
@inherits JobRunDetailBodyBase

<div class="odc-meta-grid bgj-detail-grid">
    <OdsMetaTile Label="@Text("Instruments")">@N(Sync.InstrumentsAttempted)</OdsMetaTile>
    <OdsMetaTile Label="@Text("Succeeded")">@N(Sync.InstrumentsSucceeded)</OdsMetaTile>
    <OdsMetaTile Label="@Text("Failed")">@N(Sync.InstrumentsFailed)</OdsMetaTile>
    <OdsMetaTile Label="@Text("Prices added")">@N(Sync.PricesInserted)</OdsMetaTile>
    <OdsMetaTile Label="@Text("Prices deleted")">@N(Sync.PricesDeleted)</OdsMetaTile>
    <OdsMetaTile Label="@Text("Fallbacks")">@N(Sync.FallbacksUsed)</OdsMetaTile>
    <OdsMetaTile Label="@Text("Requests")">@N(Sync.RequestsMade)</OdsMetaTile>
    <JobRunDetailCommon Run="Run" CanReadDetail="CanReadDetail" />
</div>

@code {
    private InstrumentPriceSyncJobRunDetail Sync => (InstrumentPriceSyncJobRunDetail)Run;
}
