@page "/preferences"
@using Odyssey.Client.Authorization
@using Odyssey.Client.Theme
@using Odyssey.Dtos.Finance
@implements IDisposable
@attribute [Authorize(Policy = PermissionClaims.UserPreferencesRead)]
@inject IUserPreferenceService UserPreferences
@inject Odyssey.Client.Services.IPageStateService PageState
@inject IReferenceDataCache ReferenceData
@inject IWeatherApiClient Weather
@inject Odyssey.Client.Services.IWeatherPointOptionsCache WeatherOptions
@inject AuthenticationStateProvider Auth

<PageTitle>Preferences</PageTitle>

<MudStack Spacing="6">

    <PageHeader Title="Preferences" Icon="@Icons.Material.Filled.Tune"
                SearchOpen="_searchOpen" SearchOpenChanged="OnSearchToggled">
        <SubLine>User preferences for the Odyssey application</SubLine>
        @* Save is the page's primary verb (not a "create"), so it uses the custom
           PrimaryAction slot to carry its own saving / saved states. *@
        <PrimaryAction>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@(_justSaved ? Icons.Material.Filled.Check : Icons.Material.Filled.Save)"
                       Disabled="@(_isSaving || !HasUnsavedChanges)"
                       OnClick="Save">
                @if (_isSaving)
                {
                    <OdsSpinner Class="me-2" Decorative="true" />
                }
                @(_justSaved ? "Saved" : "Save changes")
            </MudButton>
        </PrimaryAction>
        <SearchContent>
            <OdsSearchField Value="@_searchText" ValueChanged="OnSearchChanged"
                            Placeholder="Search preferences…" />
        </SearchContent>
    </PageHeader>

    @if (_isLoading)
    {
        <MudCard Elevation="1" Class="ods-outline">
            <MudCardContent Class="pa-6">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <OdsSpinner Size="OdsSize.Lg" AriaLabel="Loading preferences" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Loading preferences…</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <div class="pref-stack">
            @if (ShowDarkModeCard)
            {
                <OdsSettingRow Icon="dark_mode" Title="Dark mode"
                               Desc="Toggle between dark and light theme"
                               Dirty="@DarkModeDirty">
                    <div class="pref-control">
                        <OdsSwitch @bind-Checked="DarkModeSwitchValue" />
                    </div>
                </OdsSettingRow>
            }

            @if (ShowCurrencyCard)
            {
                <OdsSettingRow Icon="attach_money" Title="Default currency"
                               Desc="Currency used by default for new transactions"
                               Dirty="@DefaultCurrencyDirty">
                    <div class="pref-control pref-currency">
                        @* The row title names the control, so the picker carries no visible label
                           of its own — only the accessible one. *@
                        <OdsCurrencySelect Label="" AriaLabel="Default currency"
                                           Variant="Variant.Filled"
                                           Value="@_currencyCode" ValueChanged="OnCurrencyChanged"
                                           Options="_currencyOptions" />
                    </div>
                </OdsSettingRow>
            }

            @if (ShowMainCurrencyCard)
            {
                <OdsSettingRow Icon="account_balance" Title="Main currency"
                               Desc="Currency used to display total net worth, assets and liabilities"
                               Dirty="@MainCurrencyDirty">
                    <div class="pref-control pref-currency">
                        <OdsCurrencySelect Label="" AriaLabel="Main currency"
                                           Variant="Variant.Filled"
                                           Value="@_mainCurrencyCode" ValueChanged="OnMainCurrencyChanged"
                                           Options="_currencyOptions" />
                    </div>
                </OdsSettingRow>
            }

            @if (ShowWeatherPointCard)
            {
                @* The caller's own weather point for the dashboard weather card — the card picker's choice and
                   stored value, saved through PUT /api/weather/preferences (design system ·
                   Preferences.jsx, components-weather.md → Preferences → Weather point). *@
                <OdsSettingRow Icon="wb_sunny" Title="Weather point"
                               Desc="Weather point the card on your dashboard shows"
                               Dirty="@WeatherPointDirty">
                    <div class="pref-control pref-weather">
                        <OdsSelect AriaLabel="Weather point"
                                   Value="@_weatherPoint" ValueChanged="OnWeatherPointChanged"
                                   Options="WeatherPickerOptions" Error="@_weatherError" />
                    </div>
                </OdsSettingRow>
            }

            @if (!ShowDarkModeCard && !ShowCurrencyCard && !ShowMainCurrencyCard && !ShowWeatherPointCard)
            {
                <OdsEmptyState Icon="search_off" MutedIcon="true">
                    <Title>No preferences match</Title>
                    <Description>Nothing here matches "@_searchText.Trim()". Clear the search to see every setting.</Description>
                </OdsEmptyState>
            }
        </div>
    }
</MudStack>
