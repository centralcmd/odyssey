@using System.Net
@using Odyssey.ApiClient.Resources
@using Odyssey.Client.Components
@using Odyssey.Dtos.Journal
@inject IWeatherApiClient Weather
@*
    WeatherPurgeDialog — Delete weather history (issue #348 §5.10; design system · Weather.jsx
    WeatherPurgeModal). Offered only once historical data is off, so the precondition 409 is unreachable from
    here. Its scope follows the forecast: still on, only the measured data goes and the forecast keeps
    running; both off, everything weather-related goes. A TYPED confirmation (the place's name) is the
    security review's requirement. A 504 or a dropped connection means "may still be running"
    (architect N3): the row is re-read, and with purgeInProgress the dialog offers to continue.
*@

@* While the purge runs the dialog cannot be dismissed: OdsModal derives Esc, scrim and the close button
   from OnClose having a delegate, so it is withheld, and an OpenChanged(false) arriving anyway is refused. *@
<OdsModal Open="Open" OpenChanged="OnOpenChanged" OnClose="@(_running ? default : EventCallback.Factory.Create(this, CloseAsync))" Icon="delete_forever" IconTone="OdsModalTone.Error" RequiredLegend="false"
          Title="@(b => b.AddContent(0, Resuming ? "Finish deleting weather history" : "Delete weather history"))"
          Subtitle="@(b => b.AddContent(0, Location.Name))">
    <ChildContent>
        <OdsLiveAnnouncer Message="@_announce" />
        <div class="ods-modal-body wx-form">
            @if (_busy)
            {
                <OdsAlert Severity="Severity.Warning">A weather fetch is running for this place right now. Try again in a minute.</OdsAlert>
            }
            @if (_error is not null)
            {
                <OdsAlert Severity="Severity.Error">@_error</OdsAlert>
            }
            @if (Resuming)
            {
                <OdsAlert Severity="Severity.Warning">The deletion was interrupted before it finished. Weather for this place stays paused, and nothing new is stored, until it completes. Continue to delete the rest.</OdsAlert>
            }
            @if (HistoryOnly)
            {
                <p class="wx-lede" tabindex="-1" @ref="_lede">This permanently deletes the measured weather Odyssey has stored for @Location.Name:</p>
                <ul class="wx-effects">
                    <li>every measured day — temperature, precipitation and wind;</li>
                    <li>the MET station it was matched to, which is looked up again if historical data is turned back on.</li>
                </ul>
                <p class="wx-lede">The forecast keeps running, and the location and its weather settings are kept. Backups follow the deployment’s own retention.</p>
            }
            else
            {
                <p class="wx-lede" tabindex="-1" @ref="_lede">This permanently deletes everything Odyssey has stored about the weather at @Location.Name:</p>
                <ul class="wx-effects">
                    <li>every forecast fetched for it, and the daily summaries built from them;</li>
                    <li>its measured history;</li>
                    <li>every weather position it has used.</li>
                </ul>
                <p class="wx-lede">The location itself is kept. Weather can be turned on again later, starting from nothing. Backups follow the deployment’s own retention.</p>
            }
            <OdsField Label="@($"Type {Location.Name} to confirm")" Value="@_typed" ValueChanged="@(v => _typed = v ?? "")"
                      Disabled="_running"
                      Help="@(_running ? "Deleting. This can take up to a minute — keep this dialog open." : "The name must match exactly.")" />
        </div>
    </ChildContent>
    <Footer>
        <OdsButton Variant="OdsButtonVariant.Text" Disabled="_running" OnClick="CloseAsync">@(_interrupted ? "Close" : "Cancel")</OdsButton>
        <OdsButton Variant="OdsButtonVariant.Danger" Icon="delete_forever" Loading="_running" Disabled="@(!Matches)" OnClick="RunAsync">
            @(Resuming ? "Continue deleting" : "Delete weather history")
        </OdsButton>
    </Footer>
</OdsModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public ExistingLocation Location { get; set; } = default!;
    [Parameter, EditorRequired] public ExistingWeatherLocation Row { get; set; } = default!;

    /// <summary>The purge completed: the row is gone, or — with the forecast still on — kept without its measured data.</summary>
    [Parameter] public EventCallback OnDeleted { get; set; }

    /// <summary>The purge may still be running or stopped part-way; carries the re-read row, when there is one.</summary>
    [Parameter] public EventCallback<ExistingWeatherLocation?> OnInterrupted { get; set; }

    private string _typed = "";
    private string _announce = "";
    private bool _running;
    private bool _busy;
    private bool _interrupted;
    private string? _error;

    private bool Resuming => Row.PurgeInProgress || _interrupted;

    /// <summary>With the forecast still on, the server deletes only the measured data and keeps the row.</summary>
    private bool HistoryOnly => Row.ForecastEnabled;

    private bool Matches => string.Equals(_typed.Trim(), Location.Name, StringComparison.Ordinal);

    // The paragraph that says what goes: focus moves here before the run disables every control, so keyboard
    // focus stays inside the dialog instead of dropping to <body> (WCAG 2.4.3). It is the dialog's own
    // explanation, so a screen reader lands on what is happening rather than on nothing.
    private ElementReference _lede;

    private async Task RunAsync()
    {
        try { await _lede.FocusAsync(); }
        catch (InvalidOperationException) { /* not rendered (prerender / teardown) */ }
        catch (Microsoft.JSInterop.JSException) { /* the element went away first */ }

        _running = true;
        _busy = false;
        _error = null;
        _announce = "Deleting weather history. This can take up to a minute.";
        StateHasChanged();

        var result = await Weather.PurgeAsync(Location.LocationId);
        _running = false;

        if (result.IsSuccess || result.Status == HttpStatusCode.NotFound)
        {
            await OnDeleted.InvokeAsync();
            await CloseAsync();
            return;
        }

        if (result.Status == HttpStatusCode.Conflict && result.Problem?.Code == "fetch-in-progress")
        {
            _busy = true;
            return;
        }

        if (result.Status == HttpStatusCode.TooManyRequests)
        {
            _error = "Weather actions have been used many times in the last few minutes. Wait a moment, then try again.";
            return;
        }

        // A gateway timeout or a dropped connection: the server may still be deleting. Re-read the row.
        var reread = await Weather.GetLocationAsync(Location.LocationId);
        if (reread.Status == HttpStatusCode.NotFound)
        {
            await OnDeleted.InvokeAsync();
            await CloseAsync();
            return;
        }

        _interrupted = reread.Value is { PurgeInProgress: true };
        _announce = _interrupted ? "The deletion was interrupted. Continue to delete the rest." : "Weather history couldn't be deleted.";
        if (!_interrupted)
            _error = result.Problem?.Message ?? "Weather history couldn’t be deleted. Try again.";
        await OnInterrupted.InvokeAsync(reread.Value);
    }

    private Task CloseAsync() => _running ? Task.CompletedTask : OpenChanged.InvokeAsync(false);

    private Task OnOpenChanged(bool open) => open || !_running ? OpenChanged.InvokeAsync(open) : Task.CompletedTask;
}
