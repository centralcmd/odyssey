@using Odyssey.Client.Components
@using Odyssey.Dtos.Journal
@*
    WeatherForecastBody — the Now block, the day strip, the measured line and the foot for ONE weather point
    (design system · Weather.jsx WeatherForecastBody, issue #388 §4). The dashboard card puts its header and
    picker around it; a linked location's Weather section puts a record-section label around it. Render it only
    for an Ok response that carries a step.
*@

@if (Current.Step is { } step && Current.Point is { } place)
{
    @Render(step, place, TodaySummary, Coming, Yesterday)
}

@code {
    private RenderFragment Render(WeatherStep step, WeatherPointRef point, WeatherDaySummary? today,
        IReadOnlyList<WeatherDaySummary> coming, WeatherDaySummary? yesterday) => @<div class="wx-body">
        <section class="wx-now" aria-label="@($"Now at {point.Name}")">
            <div class="wx-now-main">
                <span class="wx-now-glyph" aria-hidden="true"><OdsMIcon Name="@(WeatherVisuals.SymbolOf(step.SymbolCode)?.Icon ?? "cloud")" Size="52" /></span>
                <div class="wx-now-text">
                    <div class="wx-now-temp">@WeatherVisuals.Temp(step.AirTemperatureC)</div>
                    <div class="wx-now-label">@(WeatherVisuals.SymbolOf(step.SymbolCode)?.Label ?? "Unknown conditions")</div>
                    @if (today?.Forecast is { } t)
                    {
                        <div class="wx-now-range">Today @WeatherVisuals.TempRange(t.MinTempC, t.MaxTempC)</div>
                    }
                </div>
            </div>
            <dl class="wx-facts">
                <div><dt><OdsMIcon Name="air" Size="16" />Wind</dt><dd><WeatherWind Speed="step.WindSpeedMps" Gust="step.WindGustMps" Degrees="step.WindFromDirectionDeg" /></dd></div>
                <div><dt><OdsMIcon Name="water_drop" Size="16" />Next hour</dt><dd>@WeatherVisuals.Mm(step.PrecipitationMm) · @WeatherVisuals.Pct(step.PrecipitationProbabilityPct) chance</dd></div>
                <div><dt><OdsMIcon Name="water" Size="16" />Humidity</dt><dd>@WeatherVisuals.Pct(step.RelativeHumidityPct)</dd></div>
                <div><dt><OdsMIcon Name="speed" Size="16" />Pressure</dt><dd>@WeatherVisuals.Hpa(step.AirPressureHpa)</dd></div>
                @if (step.UvIndexClearSky is { } uv)
                {
                    <div><dt><OdsMIcon Name="light_mode" Size="16" />UV, clear sky</dt><dd>@uv.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                }
            </dl>
        </section>

        @if (coming.Count > 0)
        {
            @* Each card is a disclosure button for the ONE hours panel below the strip (issue #415 §6.1). The buttons
               are the tab stops, so the strip itself is no longer focusable; the browser scrolls a focused card into view. *@
            <ol class="wx-days" role="list" aria-label="@($"Forecast for {point.Name}, next {coming.Count} days")">
                @foreach (var day in coming)
                {
                    var f = day.Forecast!;
                    var date = day.Date;
                    var selected = _selected == date;
                    <li class="wx-day">
                        <button type="button" class="@($"wx-day-btn{(date == Today ? " today" : null)}")" aria-expanded="@(selected ? "true" : "false")"
                                aria-controls="@PanelId" @ref="_cards[date]" @onclick="() => ToggleAsync(date)">
                            <span class="wx-day-name">@WeatherVisuals.DayShort(date, Today)<span class="sr-only">, @WeatherVisuals.DayLong(date)</span></span>
                            <span aria-hidden="true"><WeatherGlyph Code="@f.SymbolCode" Size="28" /></span>
                            <span class="wx-day-temp">
                                <span class="wx-hi" aria-hidden="true">@WeatherVisuals.Temp(f.MaxTempC)</span><span class="wx-lo" aria-hidden="true"> / @WeatherVisuals.Temp(f.MinTempC)</span>
                                <span class="sr-only">@DaySentence(day)</span>
                            </span>
                            <span class="wx-day-precip @(f.PrecipitationMm > 0 ? null : "none")"><OdsMIcon Name="water_drop" Size="14" />@WeatherVisuals.Mm(f.PrecipitationMm)</span>
                            @if (f.CoverageHours < 24)
                            {
                                <span class="wx-day-partial">@f.CoverageHours h of forecast</span>
                            }
                            <span class="wx-day-chev" aria-hidden="true"><OdsMIcon Name="expand_more" Size="18" /></span>
                        </button>
                    </li>
                }
            </ol>

            @* Always mounted, so every card's aria-controls resolves; empty and hidden while closed. *@
            <div id="@PanelId" class="wx-hours-host" hidden="@(_selected is null)" @ref="_panel">
                @if (_selected is { } open)
                {
                    <WeatherDayHours Date="open" Response="_response" Phase="_phase" PointName="@point.Name" HeadingId="@HeadingId"
                                     HeadingLevel="HeadingLevel" RetryEnabled="RetryEnabled" BodyStale="Current.Stale" OnRetry="RetryAsync" />
                }
            </div>
            <OdsLiveAnnouncer @ref="_announcer" />
        }

        @if (yesterday?.Observed is { } o)
        {
            <div class="wx-measured">
                <OdsMIcon Name="history" Size="16" />
                <span><b>Yesterday, measured:</b> @WeatherVisuals.TempRange(o.MinTempC, o.MaxTempC) · @WeatherVisuals.Mm(o.PrecipitationMm)</span>
                <span class="wx-muted">Station day in UTC; rain counted 06:00–06:00 UTC.</span>
            </div>
        }

        <div class="wx-foot">
            @if (Current.Stale)
            {
                <span class="wx-stale">
                    <OdsMIcon Name="cloud_off" Size="16" />
                    Not up to date — MET Norway didn’t answer the last refresh. Showing the forecast issued @WeatherVisuals.Clock(step.IssuedAtUtc) (your time).
                </span>
            }
            else
            {
                <span>Forecast issued @WeatherVisuals.Clock(step.IssuedAtUtc) (your time)</span>
            }
            <WeatherAttributionLine Attribution="Current.Attribution" />
        </div>
    </div>;
}
