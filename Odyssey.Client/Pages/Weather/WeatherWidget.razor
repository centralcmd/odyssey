@using Odyssey.Client.Components
@using Odyssey.Dtos.Journal
@*
    WeatherWidget — the dashboard weather card (issue #348; design system · Weather.jsx, specimen
    components/WeatherWidget). Every role holds weather.read. Current conditions and the coming days for
    the caller's place, yesterday's measured values, and a picker that saves the caller's OWN default.
    There is deliberately no refresh: only rate-limited Admin actions may bring a fetch forward (§7.14).
    Times are UTC on the wire, so they are shown in the viewer's clock and labelled "your time".
*@

<OdsCard Class="ods-outline wx-card" aria-busy="@(_phase == Phase.Loading || _saving ? "true" : null)">
    <OdsCardHeader>
        <div class="odc-card-header-ttl">
            <h2 class="wx-ttl">
                <OdsMIcon Name="wb_sunny" Size="20" />
                <span>Weather<span class="wx-ttl-loc">@TitlePlace</span></span>
            </h2>
        </div>
        @if (ShowPicker)
        {
            <div class="wx-picker">
                @* Never disabled during a save: disabling the focused control drops focus to <body> (WCAG 2.4.3).
                   ChooseAsync ignores a change while one is saving; aria-busy and the announcement carry the state. *@
                <OdsSelect Prefix="Weather point" Value="@PickerValue" ValueChanged="ChooseAsync" Options="PickerOptions" />
            </div>
        }
    </OdsCardHeader>
    <OdsCardBody>
        @if (_prefError is not null)
        {
            <div class="wx-pref-error" role="alert"><OdsMIcon Name="error_outline" Size="16" />@_prefError</div>
        }
        @Body
    </OdsCardBody>
    <OdsLiveAnnouncer Message="@_announce" />
</OdsCard>

@code {
    private RenderFragment Skeleton => @<div class="wx-skel" role="status" aria-label="Loading weather">
        <OdsSkeleton Variant="OdsSkeletonVariant.Block" Width="14rem" Height="5.25rem" />
        <div class="wx-skel-days">
            @for (var i = 0; i < 7; i++)
            {
                <OdsSkeleton Variant="OdsSkeletonVariant.Block" Height="7rem" />
            }
        </div>
    </div>;

    // Each state without a forecast names its way out.
    private RenderFragment Empty(string icon, string title, string text, RenderFragment? action) => @<div class="wx-empty">
        <span class="wx-empty-ic" aria-hidden="true"><OdsMIcon Name="@icon" Size="22" /></span>
        <div class="wx-empty-text">
            <div class="wx-empty-title">@title</div>
            <div>@text</div>
            @if (action is not null)
            {
                <div class="wx-empty-act">@action</div>
            }
        </div>
    </div>;

    private RenderFragment Forecast => @<WeatherForecastBody Current="_current!" Days="_days" Reads="_hoursReads" HeadingLevel="3" />;
}
