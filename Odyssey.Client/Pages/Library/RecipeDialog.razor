@inject IRecipesApiClient Recipes
@inject ITagQuickCreate<ExistingRecipeTag> TagCreator
@inject IJSRuntime Js

@*
    RecipeDialog — New recipe / Edit recipe (issue #526; design system components-recipes.md · The dialog, version
    1795477868-c9a2). A WIZARD OdsModal (760px): Details · Ingredients · Method under the OdsWizardSteps path in the
    header — the path is the only step title, so there is no subtitle and no heading in the body; each step is a
    <section aria-label>. Every step opens from the path at any time; Next (steps 1–2) checks only the step it is on,
    Create recipe / Save (step 3) checks all three and opens the first step with a problem. On a step change focus goes
    to the step's first field (never the drag handle) and the polite region says "Step 2 of 3: Ingredients"; typing
    never moves focus.

    Ingredients and Method are each one OdsSortableList of section headings and lines (drag, keyboard lift, the row ⋯
    menu); Escape during a keyboard lift cancels the move and does not close the dialog (the list stops the key). The
    wire is unchanged: each line carries its section (RecipeDraft.ToGrouped / FromGrouped). Caps never hide a
    control: at RecipeLimits.MaxIngredients the Add row turns aria-disabled with its reason as the second line.

    A 409 recipe-version-conflict shows the error alert with Reload, which confirms before it replaces the draft;
    there is no overwrite path. Closing with changes asks first. Photos and files are never edited here: they are
    record actions in the ⋯ menu.
*@

<OdsModal Open="_modalOpen" OpenChanged="OnModalOpenChanged" OnClose="OnModalClosed" ReturnFocusToId="@ReturnFocusToId"
          Icon="@(IsEdit ? "edit" : "soup_kitchen")" TitleLevel="2" Class="rc-dialog" Title="@TitleFragment">
    <Steps>
        <OdsWizardSteps Steps="WizardSteps" Current="_step" OnStep="i => GoAsync(i)" AriaLabel="Recipe steps" />
    </Steps>
    <ChildContent>
        <OdsLiveAnnouncer @ref="_announcer" />
        <div class="ods-modal-body rc-wiz-body">
            @if (_conflict)
            {
                <OdsAlert Severity="Severity.Error" Live="OdsAlertLive.Alert">
                    <span class="rc-alert-line">
                        <span>Someone else changed this recipe while you were editing. Your changes are still here.</span>
                        <OdsButton id="@ReloadId" Variant="OdsButtonVariant.Outlined" Size="OdsButtonSize.Sm" Icon="refresh"
                                   Loading="_reloading" AriaDisabled="_reloading" OnClick="AskReload">Reload</OdsButton>
                    </span>
                </OdsAlert>
            }
            @if (_formAlert is { } alert)
            {
                <OdsAlert Severity="Severity.Error" Live="OdsAlertLive.Alert">@alert</OdsAlert>
            }

            @if (_step == RecipeDraft.DetailsStep)
            {
                <section class="rc-wiz-panel" aria-label="Details" id="@PanelId(RecipeDraft.DetailsStep)">
                    <div class="rc-dlg-grid">
                        <div class="rc-span">
                            <OdsField id="@F("title")" Label="Title" Required="true" Value="@_draft.Title"
                                      ValueChanged="@(v => Set(() => _draft.Title = v ?? string.Empty, "title"))"
                                      MaxLength="RecipeLimits.MaxTitleLength" Placeholder="e.g. Roasted tomato soup" Error="@Err("title")" />
                        </div>
                        <div class="rc-span">
                            <OdsNoteField Id="@F("description")" Label="Description" Rows="2" Value="@_draft.Description"
                                          ValueChanged="@(v => Set(() => _draft.Description = v ?? string.Empty, "description"))"
                                          MaxLength="RecipeLimits.MaxDescriptionLength" Placeholder="One or two lines about the dish" Error="@Err("description")" />
                        </div>
                        <OdsStepperField Id="@F("servings")" Label="Servings" Required="true" Value="_draft.Servings"
                                         ValueChanged="@(v => Set(() => _draft.Servings = v, "servings"))"
                                         Min="RecipeLimits.MinServings" Max="RecipeLimits.MaxServings"
                                         Unit="@ServingsUnit" UnitPlural="@ServingsUnitPlural"
                                         Help="How many the amounts in Ingredients are written for." Error="@Err("servings")" />
                        <OdsTextInputField Id="@F("servingslabel")" Label="Servings label" Value="@_draft.ServingsLabel"
                                           ValueChanged="@(v => Set(() => _draft.ServingsLabel = v ?? string.Empty, "servingslabel"))"
                                           MaxLength="RecipeLimits.MaxServingsLabelLength" Placeholder="e.g. pieces, loaf"
                                           Help="Empty reads “Serves 4”; a label reads “Makes 12 pieces”." Error="@Err("servingslabel")" />
                        <OdsNumberField Id="@F("prepminutes")" Label="Prep" Unit="min" Value="_draft.PrepMinutes"
                                        ValueChanged="@(v => Set(() => _draft.PrepMinutes = v, "prepminutes"))"
                                        Min="0" Max="RecipeLimits.MaxMinutes" Step="1" Error="@Err("prepminutes")" />
                        <OdsNumberField Id="@F("cookminutes")" Label="Cook" Unit="min" Value="_draft.CookMinutes"
                                        ValueChanged="@(v => Set(() => _draft.CookMinutes = v, "cookminutes"))"
                                        Min="0" Max="RecipeLimits.MaxMinutes" Step="1" Error="@Err("cookminutes")" />
                        <div class="rc-span">
                            <OdsTextInputField Id="@F("source")" Label="Source" InputMode="url" Value="@_draft.Source"
                                               ValueChanged="@(v => Set(() => _draft.Source = v ?? string.Empty, "source"))"
                                               MaxLength="RecipeLimits.MaxSourceLength" Placeholder="A web address, a book, or who taught you"
                                               Help="A web address becomes a link; anything else shows as text." Error="@Err("source")" />
                        </div>
                        <div class="rc-span">
                            <OdsNoteField Id="@F("notes")" Label="Notes" Rows="3" Value="@_draft.Notes"
                                          ValueChanged="@(v => Set(() => _draft.Notes = v ?? string.Empty, "notes"))"
                                          MaxLength="RecipeLimits.MaxNotesLength" Placeholder="Tips, substitutions, what to do differently next time"
                                          Error="@Err("notes")" />
                        </div>
                        @if (CanReadTags)
                        {
                            <div class="rc-span">
                                <OdsTagMultiSelect Id="@F("tagids")" Label="Tags" Value="_draft.TagIds" ValueChanged="OnTagsChanged" Options="TagOptions"
                                                   Placeholder="No tags" AddLabel="Add tag" Noun="recipe tag" NounPlural="recipe tags" Help="@TagsHelp"
                                                   OnCreate="@(CanCreateTags ? CreateTagOption : null)" CreateKinds="OdsTypeRegistries.TagCreateKinds.Recipe"
                                                   CreateBlocked="BlockedTagName" Error="@Err("tagids")" />
                            </div>
                        }
                    </div>
                </section>
            }
            else if (_step == RecipeDraft.IngredientsStep)
            {
                <section class="rc-wiz-panel" aria-label="Ingredients" id="@PanelId(RecipeDraft.IngredientsStep)">
                    <OdsSortableList TItem="RecipeRowDraft" Items="_draft.Ingredients" Class="rc-sort rc-sort-ing"
                                     GetKey="r => r.Key" GetLabel="(r, i) => RecipeDraft.LabelOf(_draft.Ingredients, i, IngredientNoun)"
                                     IsHeading="r => r is RecipeSectionDraft" RowClass="(r, i) => r is RecipeSectionDraft ? RowSection : RowIngredient"
                                     OnMove="m => MoveRow(_draft.Ingredients, m)" OnRemove="i => RemoveRowAsync(_draft.Ingredients, i, IngredientNoun)"
                                     Header="@(IngredientCount > 0 ? IngredientHead : null)">
                        <RenderItem Context="cell">
                            @if (cell.Item is RecipeSectionDraft heading)
                            {
                                @SectionCells(_draft.Ingredients, cell.Index, heading, "ingredients", "e.g. Filling")
                            }
                            else if (cell.Item is RecipeIngredientDraft line)
                            {
                                var amountKey = RecipeDraft.RowKey(_draft.Ingredients, cell.Index, "ingredients", "amount");
                                var unitKey = RecipeDraft.RowKey(_draft.Ingredients, cell.Index, "ingredients", "unit");
                                var nameKey = RecipeDraft.RowKey(_draft.Ingredients, cell.Index, "ingredients", "name");
                                <div class="rc-cell rc-ing-amt">
                                    <OdsNumberField Id="@F(amountKey)" Label="Amount" Value="line.Amount"
                                                    ValueChanged="@(v => Set(() => line.Amount = v, amountKey))"
                                                    Min="AmountMin" Max="AmountMax" Step="0.001" Error="@Err(amountKey)" />
                                </div>
                                <div class="rc-cell rc-ing-unit">
                                    <span class="odc-field-label rc-unit-label" aria-hidden="true">Unit</span>
                                    <OdsSelect id="@F(unitKey)" AriaLabel="Unit" Value="@line.Unit.ToString()" Options="UnitOptions"
                                               ValueChanged="@(v => Set(() => line.Unit = Enum.TryParse<IngredientUnit>(v, out var u) ? u : IngredientUnit.None, unitKey))"
                                               Error="@Err(unitKey)" />
                                </div>
                                <div class="rc-cell rc-ing-name">
                                    <OdsTextInputField Id="@F(nameKey)" Label="Ingredient" Required="true" Value="@line.Name"
                                                       ValueChanged="@(v => Set(() => line.Name = v ?? string.Empty, nameKey))"
                                                       MaxLength="RecipeLimits.MaxIngredientNameLength" Placeholder="e.g. wheat flour" Error="@Err(nameKey)" />
                                </div>
                                <div class="rc-ing-opt">
                                    <OdsCheckbox Label="Optional" Checked="line.Optional" CheckedChanged="@(v => Set(() => line.Optional = v, null))" />
                                </div>
                            }
                        </RenderItem>
                    </OdsSortableList>
                    <div class="rc-add-pair">
                        <OdsAddRow Id="@AddRowId(IngredientNoun)" Title="Add ingredient" Sub="Drag the handle to reorder."
                                   AriaDisabled="@(IngredientCount >= RecipeLimits.MaxIngredients)"
                                   DisabledReason="@($"A recipe holds at most {RecipeLimits.MaxIngredients} ingredients.")"
                                   OnClick="AddIngredientAsync" />
                        <OdsAddRow Id="@AddRowId("ingredient-section")" Title="Add section" Icon="segment"
                                   Sub="A heading; the ingredients below it are grouped under it."
                                   OnClick="@(() => AddSection(_draft.Ingredients, "ingredients"))" />
                    </div>
                </section>
            }
            else
            {
                <section class="rc-wiz-panel" aria-label="Method" id="@PanelId(RecipeDraft.MethodStep)">
                    <OdsSortableList TItem="RecipeRowDraft" Items="_draft.Method" Class="rc-sort rc-sort-step"
                                     GetKey="r => r.Key" GetLabel="(r, i) => RecipeDraft.LabelOf(_draft.Method, i, StepNoun)"
                                     IsHeading="r => r is RecipeSectionDraft" RowClass="(r, i) => r is RecipeSectionDraft ? RowSection : RowStep"
                                     OnMove="m => MoveRow(_draft.Method, m)" OnRemove="i => RemoveRowAsync(_draft.Method, i, StepNoun)">
                        <RenderItem Context="cell">
                            @if (cell.Item is RecipeSectionDraft heading)
                            {
                                @SectionCells(_draft.Method, cell.Index, heading, "steps", "e.g. Shaping and baking")
                            }
                            else if (cell.Item is RecipeStepDraft step)
                            {
                                var textKey = RecipeDraft.RowKey(_draft.Method, cell.Index, "steps", "text");
                                <span class="rc-step-disc" aria-hidden="true">@(RecipeDraft.OrdinalOf(_draft.Method, cell.Index) + 1)</span>
                                <div class="rc-cell">
                                    <OdsNoteField Id="@F(textKey)" Label="Step text" Required="true" Rows="2" Value="@step.Text"
                                                  ValueChanged="@(v => Set(() => step.Text = v ?? string.Empty, textKey))"
                                                  MaxLength="RecipeLimits.MaxStepTextLength" Placeholder="What to do in this step" Error="@Err(textKey)" />
                                </div>
                            }
                        </RenderItem>
                    </OdsSortableList>
                    <div class="rc-add-pair">
                        <OdsAddRow Id="@AddRowId(StepNoun)" Title="Add step" Sub="Steps number on across sections."
                                   AriaDisabled="@(StepCount >= RecipeLimits.MaxSteps)"
                                   DisabledReason="@($"A recipe holds at most {RecipeLimits.MaxSteps} steps.")"
                                   OnClick="AddStepAsync" />
                        <OdsAddRow Id="@AddRowId("step-section")" Title="Add section" Icon="segment"
                                   Sub="A heading; the steps below it are grouped under it."
                                   OnClick="@(() => AddSection(_draft.Method, "steps"))" />
                    </div>
                </section>
            }
        </div>
    </ChildContent>
    <Footer>
        @if (Problems.Count > 0)
        {
            <OdsErrorSummary Problems="Problems" OnJump="JumpAsync" />
        }
        <OdsButton Variant="OdsButtonVariant.Text" OnClick="RequestCloseAsync">Cancel</OdsButton>
        @if (_step > RecipeDraft.DetailsStep)
        {
            <OdsButton Variant="OdsButtonVariant.Outlined" Icon="arrow_back" OnClick="BackAsync">Back</OdsButton>
        }
        @if (IsLastStep)
        {
            <OdsButton Variant="OdsButtonVariant.Filled" Icon="@(IsEdit ? "check" : "add")" Loading="_saving" AriaDisabled="_saving" OnClick="SubmitAsync">
                @(IsEdit ? "Save" : "Create recipe")
            </OdsButton>
        }
        else
        {
            <OdsButton Variant="OdsButtonVariant.Filled" IconRight="arrow_forward" OnClick="NextAsync">Next</OdsButton>
        }
    </Footer>
</OdsModal>

<OdsFormDialog Open="_discardOpen" OpenChanged="OnDiscardOpenChanged"
               Icon="warning" IconTone="OdsModalTone.Warning" Title="Discard changes to this recipe?"
               RequiredLegend="false" Role="OdsModalRole.AlertDialog" InitialFocus="OdsModalInitialFocus.Cancel"
               CancelLabel="Keep editing" SubmitLabel="Discard changes" SubmitIcon="delete" SubmitVariant="OdsButtonVariant.Danger"
               OnSubmit="DiscardAsync">
    <p class="rc-confirm-p">Your changes on all three steps are discarded. Photos you uploaded from the photo picker stay in your library, unlinked.</p>
</OdsFormDialog>

<OdsFormDialog Open="_reloadOpen" OpenChanged="v => _reloadOpen = v"
               Icon="sync_problem" IconTone="OdsModalTone.Warning" Title="Replace your changes with the latest version?"
               RequiredLegend="false" Role="OdsModalRole.AlertDialog" InitialFocus="OdsModalInitialFocus.Cancel"
               ReturnFocusToId="@ReloadId"
               CancelLabel="Keep editing" SubmitLabel="Reload" SubmitIcon="refresh" SubmitVariant="OdsButtonVariant.Danger"
               OnSubmit="ReloadAsync">
    <p class="rc-confirm-p">Reloading shows what was saved most recently. The edits you made here are discarded.</p>
</OdsFormDialog>

@code {
    // Labels are drawn once, above the lines; each field keeps its own label for assistive tech (aria-hidden head).
    private static readonly RenderFragment IngredientHead =
        @<text><span></span><span>Amount</span><span>Unit</span><span>Ingredient<span class="odc-field-req">*</span></span><span></span><span></span></text>;

    // A section heading row: segment glyph · Section* — the list draws the band, the handle and the ⋯.
    private RenderFragment SectionCells(List<RecipeRowDraft> rows, int index, RecipeSectionDraft heading, string list, string placeholder)
    {
        var key = RecipeDraft.RowKey(rows, index, list, "title");
        return @<text>
            <span class="material-icons rc-sec-ic" aria-hidden="true">segment</span>
            <div class="rc-cell">
                <OdsTextInputField Id="@F(key)" Label="Section" Required="true" Value="@heading.Title"
                                   ValueChanged="@(v => Set(() => heading.Title = v ?? string.Empty, key))"
                                   MaxLength="RecipeLimits.MaxSectionLength" Placeholder="@placeholder" Error="@Err(key)" />
            </div>
        </text>;
    }
}
