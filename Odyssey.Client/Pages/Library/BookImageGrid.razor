@using Odyssey.Client.Components
@using Odyssey.Client.Services
@using Odyssey.Dtos.Books
@using Odyssey.Dtos.Journal
@inject IPhotosApiClient PhotosApi

@*
    BookImageGrid — a book's images (Odyssey Design System · Books.jsx BookImageGrid, version 1795477868-c9a2): THE
    library tile (OdsPhotoTile) in a 132px OdsPhotoGrid, cover first. The cover is labelled by a VISIBLE "Cover" badge
    (and an archived photo by "Archived") — text, never position or colour alone. Hover and focus reveal the caption,
    the heart (the library favourite from the link's own state, photos.update) and the ⋯ menu:
    Open · — · Make cover / Remove cover · — · Detach — cover and detach only with books.update; Detach removes the
    link only, the photo stays in the library. Open (the image or the menu item) raises OnOpen; the host mounts the
    shared PhotoViewer over the images and returns focus to the tile through TileId.
*@

<OdsPhotoGrid TItem="BookImageDto" MinTile="132" Class="bk-images"
              AriaLabel="@BookVisuals.Plural(Images.Count, "image", "images")">
    @foreach (var (image, index) in Images.Select((x, i) => (x, i)))
    {
        var img = image;
        var name = NameOf(img, index);
        var source = PhotoImageSources.For(img.PhotoId, img.ThumbnailsReady, ThumbnailSize.Small, new PhotoImageAccess(true), PhotosApi);
        <li class="odc-photogrid2-item" @key="img.PhotoId">
            <OdsPhotoTile Id="@TileId(img.PhotoId)" Name="@name" Image="source"
                          Badges="@([img.IsCover ? "Cover" : null, img.Archived is not null ? "Archived" : null])"
                          OnOpen="() => OnOpen.InvokeAsync(img.PhotoId)"
                          Fav="@(img.Favourited is not null)" OnToggleFav="FavCallback(img)"
                          Actions="MenuFor(img, name)" ActionsLabel="@($"Actions for image: {name}")" />
        </li>
    }
</OdsPhotoGrid>

@code {
    /// <summary>The images, already in display order (cover first).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<BookImageDto> Images { get; set; } = [];

    [Parameter] public EventCallback<Guid> OnOpen { get; set; }

    /// <summary><c>books.update</c>: Make cover / Remove cover and Detach.</summary>
    [Parameter] public bool CanUpdate { get; set; }

    /// <summary>Make cover (the photo id) or Remove cover (<c>null</c>).</summary>
    [Parameter] public EventCallback<Guid?> OnSetCover { get; set; }

    [Parameter] public EventCallback<Guid> OnDetach { get; set; }

    /// <summary>Toggle the library favourite (<c>photos.update</c>). Unset = no heart.</summary>
    [Parameter] public EventCallback<Guid> OnToggleFavourite { get; set; }

    /// <summary>The DOM id prefix of the tiles' image buttons (unique per record on the page).</summary>
    [Parameter] public string IdPrefix { get; set; } = "bk-image";

    /// <summary>A tile's image-button id — the viewer's focus-return target.</summary>
    public string TileId(Guid photoId) => $"{IdPrefix}-{photoId:N}";

    internal static string NameOf(BookImageDto image, int index) => PhotoMappers.Label(image.Title, image.FileName, $"Image {index + 1}");

    private EventCallback FavCallback(BookImageDto image) =>
        OnToggleFavourite.HasDelegate
            ? EventCallback.Factory.Create(this, () => OnToggleFavourite.InvokeAsync(image.PhotoId))
            : default;

    private IReadOnlyList<OdsMenuItem> MenuFor(BookImageDto image, string name)
    {
        var items = new List<OdsMenuItem>
        {
            new() { Icon = "open_in_full", Label = "Open", AriaLabel = $"Open {name}", OnClick = EventCallback.Factory.Create(this, () => OnOpen.InvokeAsync(image.PhotoId)) },
        };
        if (CanUpdate)
        {
            items.Add(new OdsMenuItem { Divider = true });
            items.Add(image.IsCover
                ? new OdsMenuItem { Icon = "hide_image", Label = "Remove cover", OnClick = EventCallback.Factory.Create(this, () => OnSetCover.InvokeAsync(null)) }
                : new OdsMenuItem { Icon = "star", Label = "Make cover", OnClick = EventCallback.Factory.Create(this, () => OnSetCover.InvokeAsync(image.PhotoId)) });
            items.Add(new OdsMenuItem { Divider = true });
            items.Add(new OdsMenuItem
            {
                Icon = "link_off",
                Label = "Detach",
                AriaLabel = $"Detach {name}",
                Danger = true,
                OnClick = EventCallback.Factory.Create(this, () => OnDetach.InvokeAsync(image.PhotoId)),
            });
        }

        return items;
    }
}
