@page "/accounts"
@using System.Globalization
@using Odyssey.Client.Authorization
@using Odyssey.Dtos.Finance
@attribute [Authorize(Policy = PermissionClaims.AccountsRead)]
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IClipboardService Clipboard
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Odyssey.Client.Theme.IUserPreferenceService UserPreferences
@inject IScrollManager ScrollManager
@inject Odyssey.Client.Services.IPageStateService PageState
@inject IReferenceDataCache ReferenceData
@inject IAccountsApiClient Accounts

<PageTitle>Accounts</PageTitle>

<OdsLiveAnnouncer Message="@_announce" />

<MudStack Spacing="4">

    <PageHeader Title="Accounts"
                Icon="@Icons.Material.Filled.AccountBalanceWallet"
                Problems="HeaderProblems"
                ProblemsOpen="_problemsOpen" ProblemsOpenChanged="OnProblemsToggled"
                OverviewOpen="_overviewOpen" OverviewOpenChanged="OnOverviewToggled"
                SearchOpen="_searchOpen" SearchOpenChanged="OnSearchToggled"
                PrimaryActionText="New account"
                OnPrimaryAction="AddClicked"
                ShowPrimaryAction="_canCreateAccounts">
        <SubLine>
            @* Sub uses the muted text-secondary token (not Color.Secondary, which is the blue brand color).
               Combined is a naive cross-currency sum (the app has no FX conversion) shown
               with a generic symbol — mirrors the design mockup's single combined figure. *@
            @ActiveCount open · combined <span style="color:@BalanceColor(CombinedBalance);">@FormatMoney(CombinedBalance, null)</span>
        </SubLine>
        @* The problem rollup is rendered by the header from HeaderProblems; each row's
           View jumps to the account (expand + scroll + flash). The contextual fix lives
           in the expanded record. *@
        <OverviewContent>
            <AccountsOverview Summary="_summary" FormatMoney="FormatMoney" />
        </OverviewContent>

        <!-- Search / filter bar -->
        <SearchContent>
            <div class="ph-filter-bar">
                        <OdsSearchField Value="@_searchString" ValueChanged="OnSearchChanged"
                                        DebounceInterval="300" OnSearch="GetAccounts"
                                        Placeholder="Search name, description, account number…"
                                        Class="ph-search" />
                        <OdsMultiSelect Label="Account type" Values="_typeFilter" ValuesChanged="OnTypeFilterChanged"
                                        Options="_typeOptions" Class="ph-select" />
                        <OdsMultiSelect Label="Status" Values="_statusFilter" ValuesChanged="OnStatusFilterChanged"
                                        Options="_statusOptions" Class="ph-select" />
                        <OdsSortSelect TRow="ExistingAccount" Fields="_sortFields" Sort="_sort" SortChanged="OnSortChanged" />
                        <OdsPageSizeSelect Prefix="Load" Suffix="at a time" Label="Accounts per batch"
                                           Value="_batch" ValueChanged="OnBatchChanged" Options="OdsPageSizes.Batch" />
            </div>
        </SearchContent>
    </PageHeader>

    <!-- ── Account list ───────────────────────────────────────── -->
    <div class="acct-list">
        <OdsInfiniteList TItem="ExistingAccount" Items="_accounts" BatchSize="_batch"
                         ItemKey="@(a => (object)a.AccountId)" Noun="accounts" RevealKey="_flashId"
                         Loading="_isLoading" Refetching="_refetching" Error="_loadError" OnRetry="GetAccounts"
                         HasFilters="_hasFilters" OnClearFilters="ClearFilters"
                         EmptyIcon="account_balance_wallet"
                         EmptyDescription="Add the cash, checking, savings, investment and loan accounts you want Odyssey to track.">
            <RenderItem Context="account">
                @{
                    var typeIcon = AccountTypeVisuals.MaterialIcon(account.AccountType);
                    var typeLabel = AccountTypeVisuals.Label(account.AccountType);
                    var problem = _problems.GetValueOrDefault(account.AccountId);

                    @* The meta line: custodian · type · number · in-force rate. The custodian is a
                       REFERENCE to a contact, so it keeps that contact type's own glyph. *@
                    var meta = new List<RenderFragment?>();
                    if (account.Custodian is { } cust)
                    {
                        meta.Add(CustodianMeta(OdsTypeRegistries.ContactTypeOf(cust.Type.ToString()).Icon, cust.Name));
                    }
                    meta.Add(OdsRecordMeta.Text(typeLabel));
                    if (!string.IsNullOrWhiteSpace(account.AccountNumber))
                    {
                        meta.Add(AccountNumberMeta(account.AccountNumber));
                    }
                    if (RateTermOf(account) is { } headerRate)
                    {
                        var rateInfo = TermKindVisuals.Info(headerRate.TermKind);
                        meta.Add(RateMeta(
                            TermKindVisuals.CostColor(headerRate, account) ?? rateInfo.Color,
                            rateInfo.Label,
                            TermKindVisuals.FormatValue(headerRate, account, FormatMoney)));
                    }

                    @* The header counts are the body's table of contents: same glyphs, same order as
                       the sections below. The optional collections are counted only when non-zero. *@
                    var counts = new List<OdsRecordCount>
                    {
                        new("receipt_long", account.TransactionCount.ToString(CultureInfo.CurrentCulture), "Transactions"),
                        new("attach_file", account.FileCount.ToString(CultureInfo.CurrentCulture), "Files"),
                    };
                    if (account.EstimateCount > 0)
                    {
                        counts.Add(new OdsRecordCount("monitor", account.EstimateCount.ToString(CultureInfo.CurrentCulture), "Estimates"));
                    }
                    if (account.TermCount > 0)
                    {
                        counts.Add(new OdsRecordCount("§", account.TermCount.ToString(CultureInfo.CurrentCulture), "Terms"));
                    }
                    if (account.SmartTagCount > 0)
                    {
                        counts.Add(new OdsRecordCount("sell", account.SmartTagCount.ToString(CultureInfo.CurrentCulture), "Smart tags"));
                    }
                }
                @* One accent per record, from the account's TYPE — the header mark and every tile icon
                   chip in the body resolve from it, while a custodian row keeps its contact's own. *@
                <OdsRecordCard Id="@($"acct-{account.AccountId}")"
                               Icon="@typeIcon"
                               Accent="@AccountTypeVisuals.FgColor(account.AccountType)"
                               AccentSoft="@AccountTypeVisuals.BgColor(account.AccountType)"
                               Name="@account.Name"
                               Meta="meta"
                               Counts="counts"
                               FigureCaption="@(account.CurrentEstimatedValue is null ? null : "Est. value")"
                               FigureTone="@FigureTone(account)"
                               Dimmed="@(account.Closed != null || account.Archived != null)"
                               Highlight="@(_flashId == account.AccountId)"
                               Open="@(_expandedId == account.AccountId)"
                               OnToggle="@(_ => ToggleExpand(account.AccountId))">

                    <Chips>
                        <OdsAccountStatusChip Label="@GetStatusLabel(account)" Tone="@GetStatusChipTone(account)" Compact="true" />
                        @if (problem is not null)
                        {
                            <span class="acct-flag @problem.Severity">
                                <span class="material-icons" aria-hidden="true">warning_amber</span>@problem.Chip
                            </span>
                        }
                    </Chips>

                    @* The in-force estimate leads for an asset whose worth transactions do not
                       capture; otherwise the transaction balance is the figure. *@
                    <Figure>
                        @if (account.CurrentEstimatedValue is { } estValue)
                        {
                            @FormatMoney(estValue, account.CurrentEstimatedValueCurrencyCode ?? account.CurrencyCode)
                        }
                        else
                        {
                            @FormatMoney(account.Balance, account.CurrencyCode)
                        }
                    </Figure>

                    <Actions>
                        <OdsMenu Items="RowActions(account)" AriaLabel="@($"Actions for {account.Name}")" />
                    </Actions>

                    <Alert>
                        @* The problem and its contextual fix — read before anything else, because it
                           is why the card was opened. *@
                        @if (problem is not null)
                        {
                            <div class="alert @problem.Severity acct-problem" role="status">
                                <div class="acct-problem-head">
                                    <span class="material-icons alert-icon">warning_amber</span>
                                    <div class="acct-problem-title">@problem.Title</div>
                                    <button type="button" class="alert-cta" @onclick="GoToExchangeRates">
                                        Set exchange rate
                                        <span class="material-icons" style="font-size:16px;">arrow_forward</span>
                                    </button>
                                </div>
                                <p class="acct-problem-detail">@problem.Detail</p>
                            </div>
                        }
                    </Alert>

                    <Details>
                        @* The account's full field set. Empty fields show no tile; the custodian keeps
                           its own type colour, because it points at a contact record. *@
                        <OdsInfoTileGrid>
                            <OdsInfoTile Icon="account_balance_wallet" Label="Name"
                                         ValueVariant="OdsInfoTileVariant.Text" WrapValue="true">
                                <Value>@account.Name</Value>
                            </OdsInfoTile>

                            @* No per-tile icon colour: the grid inherits the card's accent, which IS
                               this account's type colour. *@
                            <OdsInfoTile Icon="@typeIcon" Label="Account type" ValueVariant="OdsInfoTileVariant.Text">
                                <Value>@typeLabel</Value>
                            </OdsInfoTile>

                            @if (!string.IsNullOrWhiteSpace(account.AccountNumber))
                            {
                                <OdsInfoTile Icon="tag" Label="Account number"
                                             ValueVariant="OdsInfoTileVariant.Mono" Foot="@Caption("Custodian reference")">
                                    <Value>@account.AccountNumber</Value>
                                </OdsInfoTile>
                            }

                            @if (account.Custodian is { } custodian)
                            {
                                var custMeta = OdsTypeRegistries.ContactTypeOf(custodian.Type.ToString());
                                <OdsInfoTile Icon="@custMeta.Icon" IconColor="@custMeta.Color" IconSoft="@custMeta.Soft"
                                             Label="Custodian" ValueVariant="OdsInfoTileVariant.Text"
                                             Foot="@Caption(custMeta.Label)">
                                    <Value>@custodian.Name</Value>
                                </OdsInfoTile>
                            }

                            <OdsInfoTile Icon="payments" Label="Currency" Foot="@Caption(CurrencyFoot(account))">
                                <Value>@account.CurrencyCode</Value>
                            </OdsInfoTile>

                            @* A DERIVED summary: the state, with the full lifecycle line as its foot. *@
                            <OdsInfoTile Icon="@StatusIcon(account)" Label="Status"
                                         ValueVariant="OdsInfoTileVariant.Text"
                                         Tone="@StatusTone(account)"
                                         Foot="@Caption(GetLifecycle(account))">
                                <Value>@GetStatusLabel(account)</Value>
                            </OdsInfoTile>
                        </OdsInfoTileGrid>
                    </Details>

                    <Content>
                        @* Prose is not a field: the description goes in one wide tile. *@
                        @if (!string.IsNullOrWhiteSpace(account.Description))
                        {
                            <OdsInfoTileGrid>
                                <OdsInfoTile Icon="sticky_note_2" Label="Description" Wide="true">
                                    <Value>@account.Description</Value>
                                </OdsInfoTile>
                            </OdsInfoTileGrid>
                        }
                    </Content>

                    <Sections>
                        @* CURRENT — the account's in-force values, as the same tiles the details use.
                           A record with a current state puts that band first, above the collections. *@
                        @if (InForceCount(account) is > 0 and var inForce)
                        {
                            <div class="acct-section">
                                <OdsSectionDivider Label="Current"
                                                   Meta="@($"{inForce} {(inForce == 1 ? "value" : "values")} in force")" />
                                <OdsInfoTileGrid>
                                    @if (account.CurrentEstimatedValue is { } currentEstimate)
                                    {
                                        <OdsInfoTile Icon="trending_up" Label="Estimated value" Tone="OdsInfoTileTone.Income"
                                                     Foot="@Caption(EstimateFoot(account))">
                                            <Value>@FormatMoney(currentEstimate, account.CurrentEstimatedValueCurrencyCode ?? account.CurrencyCode)</Value>
                                        </OdsInfoTile>
                                        @* The balance stays quiet: the estimate is what counts toward
                                           net worth, so this is the secondary reading. *@
                                        <OdsInfoTile Icon="swap_horiz" Label="Transaction balance"
                                                     Foot="@Caption(BalanceFoot(account))">
                                            <Value>@FormatMoney(account.Balance, account.CurrencyCode)</Value>
                                        </OdsInfoTile>
                                    }
                                    @foreach (var term in account.CurrentTerms)
                                    {
                                        var info = TermKindVisuals.Info(term.TermKind);
                                        var asTerm = ToTerm(account, term);
                                        <OdsInfoTile Icon="@info.Icon" IconColor="@info.Color" IconSoft="@info.Soft"
                                                     Label="@info.Label" Foot="@Caption(TermFoot(term))">
                                            <Value>
                                                <span style="color:@(TermKindVisuals.CostColor(asTerm, account) ?? info.Color);">
                                                    @TermKindVisuals.FormatValue(asTerm, account, FormatMoney)
                                                </span>
                                            </Value>
                                        </OdsInfoTile>
                                    }
                                </OdsInfoTileGrid>
                            </div>
                        }

                        @* An OPTIONAL sub-collection is omitted entirely when empty, matching the
                           empty-field rule — the header only counts these when non-zero. *@
                        @if (_canReadEstimates && account.EstimateCount > 0)
                        {
                            <div class="acct-section">
                                <OdsSectionDivider Label="Estimates"
                                                   Meta="@($"{account.EstimateCount} {(account.EstimateCount == 1 ? "estimate" : "estimates")}")" />
                                <AccountEstimatesSection @key="@($"estimates:{account.AccountId}:{_estimatesRefreshToken}")"
                                                         Account="account"
                                                         CanWrite="@_canWriteEstimates"
                                                         Chrome="false" ShowCurrent="false" BareAction="false"
                                                         FormatMoney="FormatMoney"
                                                         CurrencySymbol="@CurrencySymbol(account.CurrencyCode)"
                                                         OnChanged="GetAccounts" />
                            </div>
                        }

                        @if (_canReadTerms && account.TermCount > 0)
                        {
                            <div class="acct-section">
                                <OdsSectionDivider Label="Terms"
                                                   Meta="@($"{account.TermCount} {(account.TermCount == 1 ? "entry" : "entries")}")" />
                                <AccountTermsSection @key="@($"terms:{account.AccountId}:{_termsRefreshToken}")"
                                                     Account="account"
                                                     CanWrite="@_canWriteTerms"
                                                     Chrome="false" ShowCurrent="false" BareAction="false"
                                                     FormatMoney="FormatMoney"
                                                     OnChanged="GetAccounts" />
                            </div>
                        }

                        @* Files and Transactions are INTRINSIC to an account, so they stay at zero:
                           the absence is a fact worth stating. *@
                        <div class="acct-section">
                            <OdsSectionDivider Label="Files"
                                               Meta="@($"{account.FileCount} file{(account.FileCount == 1 ? "" : "s")}")" />
                            <div class="acct-table-frame">
                                <AccountFilesSection @key="@($"{account.AccountId}:{_filesRefreshToken}")"
                                                     AccountId="@account.AccountId"
                                                     AccountName="@account.Name"
                                                     Chrome="false"
                                                     CanUpload="false"
                                                     CanDownload="@_canDownloadFiles"
                                                     CanDelete="@_canDeleteFiles"
                                                     CanEdit="@_canEditFiles"
                                                     CanAnalyze="@_canAnalyzeFiles" />
                            </div>
                        </div>

                        @if (_canReadTransactions)
                        {
                            <div class="acct-section">
                                <OdsSectionDivider Label="Transactions"
                                                   Meta="@($"{account.TransactionCount} transaction{(account.TransactionCount == 1 ? "" : "s")}")" />
                                <div class="acct-txn-table acct-table-frame">
                                    <AccountTransactionsSection @key="@($"txns:{account.AccountId}")"
                                                                AccountId="@account.AccountId"
                                                                Chrome="false"
                                                                CanDownloadFiles="@_canDownloadFiles" />
                                </div>
                            </div>
                        }

                        @* Always rendered: this section is the only place a first smart tag can be
                           added, so it is an entry point rather than an optional collection. *@
                        @if (_canReadTransactions)
                        {
                            <div class="acct-section">
                                <OdsSectionDivider Label="Smart tags"
                                                   Meta="@(account.SmartTagCount > 0 ? $"{account.SmartTagCount} watched" : "none watched")" />
                                <AccountSmartTagsSection @key="@($"smart-tags:{account.AccountId}")"
                                                         Account="account"
                                                         Chrome="false"
                                                         CanWrite="@_canUpdateAccounts"
                                                         CanDownloadFiles="@_canDownloadFiles"
                                                         FormatMoney="FormatMoney"
                                                         OnCountChanged="@(count => { account.SmartTagCount = count; })" />
                            </div>
                        }
                    </Sections>
                </OdsRecordCard>
            </RenderItem>
            <CreateAction>
                @if (_canCreateAccounts)
                {
                    <OdsButton Variant="OdsButtonVariant.Filled" Icon="add" OnClick="AddClicked">Add account</OdsButton>
                }
            </CreateAction>
            <Trailing>
                @if (_canCreateAccounts)
                {
                    <OdsAddRow Title="Add account"
                               Sub="Cash, checking, savings, investments, loans, and more."
                               OnClick="AddClicked" />
                }
            </Trailing>
        </OdsInfiniteList>
    </div>
</MudStack>

@if (_createAccountKey != Guid.Empty)
{
    <CreateAccountDialog @key="_createAccountKey"
                         @bind-Open="_createAccountOpen"
                         OnSaved="OnAccountCreated" />
}

@if (_editAccount is not null)
{
    <CreateAccountDialog @key="_editAccountKey"
                         @bind-Open="_editAccountOpen"
                         Account="_editAccount"
                         OnSaved="OnAccountEdited" />
}

@if (_txnAccount is not null)
{
    <CreateTransactionDialog @key="_txnKey"
                             @bind-Open="_txnOpen"
                             DefaultAccountId="_txnAccount.AccountId"
                             LockAccount="true"
                             OnSaved="GetAccounts" />
}

@if (_uploadAccount is not null)
{
    <AddFileDialog @key="_uploadKey"
                   @bind-Open="_uploadOpen"
                   AccountId="_uploadAccount.AccountId"
                   AccountName="@_uploadAccount.Name"
                   AccountNumber="@_uploadAccount.AccountNumber"
                   OnSaved="OnFilesUploaded" />
}

@if (_termAccount is not null)
{
    <AddTermDialog @key="_termKey"
                   @bind-Open="_termOpen"
                   Account="_termAccount"
                   OnSaved="OnTermCreated" />
}

@if (_estimateAccount is not null)
{
    <AddEstimateDialog @key="_estimateKey"
                       @bind-Open="_estimateOpen"
                       Account="_estimateAccount"
                       OnSaved="OnEstimateCreated" />
}

@code {
    // The meta-line entries that carry a glyph. Inline render fragments are Razor syntax, so they
    // cannot live in the code-behind. One span each, so each becomes the .odc-record-metaitem's only
    // child and picks up the meta line's alignment.

    private RenderFragment CustodianMeta(string icon, string name) =>
        @<span class="acct-cust-inline">
            <span class="material-icons" aria-hidden="true">@icon</span><span>@name</span>
        </span>;

    private RenderFragment AccountNumberMeta(string number) =>
        @<span class="acct-number-inline">
            <span class="material-icons" aria-hidden="true">tag</span><span class="mono">@number</span>
        </span>;

    @* The rate is the one meta item whose value does not say what it is — "−4.90%" alone is a bare
       number. Every sibling entry carries a visible glyph and label; this one carries its kind in the
       same visually-hidden span the header counts use, so the label is in the accessible name rather
       than in a tooltip nobody on a keyboard or screen reader ever sees (WCAG 1.3.1). *@
    private RenderFragment RateMeta(string color, string title, string value) =>
        @<span class="acct-rate mono" title="@title" style="color:@color;">@value<span class="odc-record-sr">@(" " + title)</span></span>;
}
