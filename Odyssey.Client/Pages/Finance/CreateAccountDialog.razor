@using Odyssey.Client.Authorization
@using Odyssey.Client.Theme
@using Odyssey.Dtos.Finance
@using Microsoft.AspNetCore.Components.Authorization
@using Odyssey.Dtos.Authorization
@using Odyssey.Dtos


@inject ISnackbar Snackbar
@inject IUserPreferenceService UserPreferences
@inject IReferenceDataCache ReferenceData
@inject IAccountsApiClient Accounts
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IContactQuickCreate ContactCreator

<OdsFormDialog Open="Open" OpenChanged="OpenChanged" OnSaved="OnSaved"
               Icon="account_balance_wallet" Title="@(IsEdit ? "Edit account" : "New account")"
               Subtitle="@(IsEdit
                   ? "Update this account's name, type, custodian, or lifecycle dates."
                   : "Add an account to track its balance, files, and transactions.")"
               SubmitLabel="@(IsEdit ? "Save changes" : "Create account")"
               SubmitIcon="@(IsEdit ? "check" : "add")"
               OnSubmit="SaveAsync">

    <!-- Account name -->
    <MudTextField @bind-Value="_name"
                  Label="Account name"
                  Required="true"
                  Placeholder="e.g. Chase Sapphire"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Error="@_nameError"
                  ErrorText="Give the account a name."
                  Immediate="true" />

    <!-- Account type picker (colored glyphs, grouped popover) -->
    <OdsAccountTypeSelect Value="_accountType" ValueChanged="OnAccountTypeChanged" Required="true"
                          Error="@(_typeError ? "Pick an account type." : null)" />

    <!-- Currency -->
    <OdsCurrencySelect Value="@_currencyCode" ValueChanged="OnCurrencyChanged" Required="true"
                       Options="_currencyOptions" />

    <!-- Lifecycle dates — Opened alone on create; Opened + Closed side by side on edit -->
    @if (IsEdit)
    {
        <OdsFormRow>
            <OdsDatePicker @bind-Value="_opened"
                           Label="Opened"
                           HelperText="Defaults to today" />
            <OdsDatePicker @bind-Value="_closed"
                           Label="Closed"
                           HelperText="Empty while active"
                           Clearable="true" />
        </OdsFormRow>
    }
    else
    {
        <OdsDatePicker @bind-Value="_opened"
                       Label="Opened"
                       HelperText="Defaults to today" />
    }

    <!-- Account number -->
    <MudTextField @bind-Value="_accountNumber"
                  Label="Account number"
                  Placeholder="As it appears on your statement"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  MaxLength="64" />

    <!-- Custodian — the contact that holds this account -->
    <OdsCustodianSelect Value="@_custodianId" ValueChanged="OnCustodianChanged"
                        Contacts="_contacts"
                        Loading="_contactsLoading"
                        Error="@_custodianError"
                        OnCreate="@(_canCreateContact ? CreateContactOption : null)"
                        Help="@CustodianHelp" />

    <!-- Description -->
    <OdsNoteField @bind-Value="_description"
                  Label="Description"
                  Placeholder="What's this account for?"
                  Rows="3"
                  MaxLength="256" />
</OdsFormDialog>
