@page "/subscriptions"
@using Odyssey.Client.Authorization
@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@attribute [Authorize(Policy = PermissionClaims.SubscriptionsRead)]
@inject ISubscriptionApiClient Subscriptions
@inject IDialogService DialogService
@inject IClipboardService Clipboard
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IScrollManager ScrollManager
@inject Odyssey.Client.Services.IPageStateService PageState
@inject Odyssey.Client.Theme.IUserPreferenceService UserPreferences
@inject ISnackbar Snackbar
@inject IReferenceDataCache ReferenceData

<PageTitle>Subscriptions</PageTitle>

<OdsLiveAnnouncer Message="@_announce" />


<MudStack Spacing="4">

    <PageHeader Title="Subscriptions"
                Icon="@Icons.Material.Filled.Subscriptions"
                Problems="RenewalProblems"
                ProblemsLabel="Upcoming renewals"
                ProblemsOpen="_problemsOpen" ProblemsOpenChanged="OnProblemsToggled"
                OverviewOpen="_overviewOpen" OverviewOpenChanged="OnOverviewToggled"
                SearchOpen="_searchOpen" SearchOpenChanged="OnSearchToggled"
                PrimaryActionText="New subscription"
                OnPrimaryAction="AddClicked"
                ShowPrimaryAction="_canCreate">
        <SubLine>
            @_activeCount active · @_pausedCount paused · @_endedCount ended · @_archivedCount archived
        </SubLine>

        <OverviewContent>
            <div class="sub-overview">
                <div class="sub-stat-tiles">
                    <OdsInfoTile Icon="@OdsTypeRegistries.BillingIntervalOf(BillingInterval.Monthly).Icon"
                                 IconColor="@OdsTypeRegistries.BillingIntervalOf(BillingInterval.Monthly).Color"
                                 IconSoft="@OdsTypeRegistries.BillingIntervalOf(BillingInterval.Monthly).Soft"
                                 Label="Monthly run rate" ValueVariant="OdsInfoTileVariant.Mono" Class="sub-runrate-tile">
                        <Value>@RunRateMonthly</Value>
                        <Foot>@RunRateMonthlyFoot</Foot>
                    </OdsInfoTile>
                    <OdsInfoTile Icon="@OdsTypeRegistries.BillingIntervalOf(BillingInterval.Yearly).Icon"
                                 IconColor="@OdsTypeRegistries.BillingIntervalOf(BillingInterval.Yearly).Color"
                                 IconSoft="@OdsTypeRegistries.BillingIntervalOf(BillingInterval.Yearly).Soft"
                                 Label="Yearly run rate" ValueVariant="OdsInfoTileVariant.Mono" Class="sub-runrate-tile">
                        <Value>@RunRateYearly</Value>
                        <Foot>@RunRateYearlyFoot</Foot>
                    </OdsInfoTile>
                </div>
                <div class="odc-summary-grid">
                    <OdsBreakdownTile Label="By interval" Rows="IntervalRows" Empty="No subscriptions." />
                    <OdsBreakdownTile Label="By status" Rows="StatusRows" Empty="No subscriptions." />
                </div>
            </div>
        </OverviewContent>

        <SearchContent>
            <div class="ph-filter-bar">
                <OdsSearchField Value="@_searchString" ValueChanged="OnSearchChanged"
                                DebounceInterval="300" OnSearch="LoadSubscriptions"
                                Placeholder="Search name, external id, company…"
                                Class="ph-search" />
                <OdsMultiSelect Label="Any interval" Icon="autorenew" Values="_intervalFilter" ValuesChanged="OnIntervalFilterChanged"
                                Options="OdsTypeRegistries.BillingIntervalOptions" Class="ph-select" />
                <OdsMultiSelect Label="Any status" Icon="flag" Values="_statusFilter" ValuesChanged="OnStatusFilterChanged"
                                Options="_statusOptions" Class="ph-select" />
                <OdsSortSelect TRow="SubscriptionListItem" Fields="_sortFields" Sort="_sort" SortChanged="OnSortChanged" />
                <OdsPageSizeSelect Prefix="Load" Suffix="at a time" Label="Subscriptions per batch"
                                   Value="_batch" ValueChanged="OnBatchChanged" Options="OdsPageSizes.Batch" />
            </div>
        </SearchContent>
    </PageHeader>

    <div class="acct-list">
        <OdsInfiniteList TItem="SubscriptionListItem" Items="_subscriptions" BatchSize="_batch"
                         ItemKey="@(s => (object)s.SubscriptionId)" Noun="subscriptions" RevealKey="_flashId"
                         Loading="_isLoading" Refetching="_refetching" Error="_loadError" OnRetry="LoadSubscriptions"
                         HasFilters="@(_hasFilters || _hasAnySubscriptions)" OnClearFilters="ClearFilters"
                         EmptyIcon="subscriptions"
                         EmptyDescription="Keep a manual list of the recurring subscriptions you want to track — what each one is, who bills it, how much, and how often.">
            <RenderItem Context="s">
                @{
                    var archived = s.Archived is not null;
                    var ended = IsEnded(s.EndDate);
                    var paused = s.Paused is not null;
                    var info = OdsTypeRegistries.BillingIntervalOf(s.Interval);
                    var anchor = OdsBillingIntervalChip.AnchorLabel(s.Interval, s.FirstBillingDate);
                    var cadence = OdsBillingIntervalChip.CadenceLabel(s.Interval, s.IntervalCount);
                    var company = s.Contact is null ? null : OdsTypeRegistries.ContactTypeOf(s.Contact.Type.ToString());
                    var detail = _details.GetValueOrDefault(s.SubscriptionId);

                    @* The single meta line: external id · company · cadence. Null entries are dropped
                       by the card, so an absent external id leaves no stray separator. *@
                    var meta = new List<RenderFragment?>();
                    if (!string.IsNullOrWhiteSpace(s.ExternalId))
                    {
                        meta.Add(ExternalIdMeta(s.ExternalId));
                    }
                    meta.Add(CompanyMeta(company?.Icon ?? "store", s.Contact?.Name ?? "No company"));
                    meta.Add(CadenceMeta(info.Icon, anchor is null ? cadence : $"{cadence} · {anchor}"));
                }
                @* The accent is the BILLING INTERVAL — a subscription has no type field, but the
                   interval is its type-equivalent: a categorical registry it always has exactly one
                   of, carrying its own icon and colour. Derived state (paused / ended / archived) is
                   never the accent; that stays with the status chip. *@
                <OdsRecordCard Id="@($"sub-{s.SubscriptionId}")"
                               Icon="@info.Icon"
                               Accent="@info.Color"
                               AccentSoft="@info.Soft"
                               Name="@s.Name"
                               Meta="meta"
                               FigureCaption="@OdsBillingIntervalChip.FigureCaption(s.Interval, s.IntervalCount)"
                               FigureTone="OdsRecordFigureTone.Expense"
                               Dimmed="archived"
                               Highlight="@(_flashId == s.SubscriptionId)"
                               Open="IsExpanded(s.SubscriptionId)"
                               OnToggle="@(_ => ToggleExpand(s.SubscriptionId))">

                    <Chips>
                        <OdsSubscriptionStatusChip Paused="paused" Ended="ended" Archived="archived" ShowActive="true" />
                    </Chips>

                    <Figure>@Money(s.Amount, s.CurrencyCode)</Figure>

                    <Actions>
                        <OdsMenu Items="RowActions(s, paused, ended, archived)" AriaLabel="@($"Actions for {s.Name}")" />
                    </Actions>

                    <Details>
                        @if (detail is null)
                        {
                            <div role="status" aria-live="polite" aria-busy="true">
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-hidden="true" />
                                <span class="sr-only">Loading subscription details…</span>
                            </div>
                        }
                        else
                        {
                            @* The record's FULL field set, including the fields the collapsed header
                               already shows: at tile scale a value arrives with its own label, so the
                               body reads as the record rather than the remainder of one. Tiles never
                               condition on each other — each renders on its own field, so no timestamp
                               can vanish when a derived state takes precedence. *@
                            var dEnded = IsEnded(detail.EndDate);
                            var dPaused = detail.Paused is not null;
                            var dArchived = detail.Archived is not null;
                            var dInfo = OdsTypeRegistries.BillingIntervalOf(detail.Interval);
                            var dAnchor = OdsBillingIntervalChip.AnchorLabel(detail.Interval, detail.FirstBillingDate);
                            var startsLater = detail.StartDate > TodayUtc;
                            <OdsInfoTileGrid>
                                <OdsInfoTile Icon="subscriptions" Label="Name"
                                             ValueVariant="OdsInfoTileVariant.Text" WrapValue="true">
                                    <Value>@detail.Name</Value>
                                </OdsInfoTile>

                                @if (!string.IsNullOrWhiteSpace(detail.ExternalId))
                                {
                                    <OdsInfoTile Icon="tag" Label="External id" ValueVariant="OdsInfoTileVariant.Mono">
                                        <Value>@detail.ExternalId</Value>
                                        <Foot>Provider reference</Foot>
                                    </OdsInfoTile>
                                }

                                @* A reference to ANOTHER record keeps that record's own icon and
                                   colour, so it stays recognisable as the contact it points at. *@
                                @if (detail.Contact is { } cp)
                                {
                                    var cpMeta = OdsTypeRegistries.ContactTypeOf(cp.Type.ToString());
                                    <OdsInfoTile Icon="@cpMeta.Icon" IconColor="@cpMeta.Color" IconSoft="@cpMeta.Soft"
                                                 Label="Company" ValueVariant="OdsInfoTileVariant.Text">
                                        <Value>@cp.Name</Value>
                                        <Foot>@cpMeta.Label</Foot>
                                    </OdsInfoTile>
                                }

                                <OdsInfoTile Icon="payments" Label="Price" Tone="OdsInfoTileTone.Expense">
                                    <Value>@Money(detail.Amount, detail.CurrencyCode)</Value>
                                    <Foot>@OdsBillingIntervalChip.FigureCaption(detail.Interval, detail.IntervalCount)</Foot>
                                </OdsInfoTile>

                                <OdsInfoTile Icon="@dInfo.Icon" Label="Billing interval"
                                             ValueVariant="OdsInfoTileVariant.Text" Foot="@OdsInfoTile.Caption(dAnchor)">
                                    <Value>@OdsBillingIntervalChip.CadenceLabel(detail.Interval, detail.IntervalCount)</Value>
                                </OdsInfoTile>

                                <OdsInfoTile Icon="event_available" Label="First billing date" ValueVariant="OdsInfoTileVariant.Sm">
                                    <Value>@LongDate(detail.FirstBillingDate)</Value>
                                    <Foot>cadence anchor</Foot>
                                </OdsInfoTile>

                                @* Server-derived (issue-free by construction: the same rule the
                                   header's upcoming-renewals rollup uses). Its emptiness IS the
                                   derivation — a paused, ended or archived subscription has no next
                                   charge — so the tile renders on its own value and never consults
                                   the Status tile. *@
                                @if (detail.NextBillingDate is { } due)
                                {
                                    <OdsInfoTile Icon="event_repeat" Label="Next billing"
                                                 ValueVariant="OdsInfoTileVariant.Sm" Tone="OdsInfoTileTone.Income">
                                        <Value>@LongDate(due)</Value>
                                        <Foot>@Money(detail.Amount, detail.CurrencyCode) · @RelativeDay(due.DayNumber - TodayUtc.DayNumber)</Foot>
                                    </OdsInfoTile>
                                }

                                @* Tense follows the date: not yet reached reads "Starts on" in info
                                   blue; already reached reads "Started on" in neutral ink. *@
                                <OdsInfoTile Icon="play_arrow" Label="@(startsLater ? "Starts on" : "Started on")"
                                             ValueVariant="OdsInfoTileVariant.Sm"
                                             Tone="@(startsLater ? OdsInfoTileTone.Info : OdsInfoTileTone.Default)"
                                             Foot="@OdsInfoTile.Caption(startsLater ? "upcoming" : null)">
                                    <Value>@LongDate(detail.StartDate)</Value>
                                </OdsInfoTile>

                                @* The empty case is kept deliberately: whether a recurring charge ever
                                   stops is material, so "No end date" is a fact, not a missing value. *@
                                <OdsInfoTile Icon="flag"
                                             Label="@(detail.EndDate is null ? "End date" : dEnded ? "Ended on" : "Ends on")"
                                             ValueVariant="@(detail.EndDate is null ? OdsInfoTileVariant.Text : OdsInfoTileVariant.Sm)"
                                             Tone="@(dEnded ? OdsInfoTileTone.Expense : OdsInfoTileTone.Default)">
                                    <Value>@(detail.EndDate is { } end ? LongDate(end) : "No end date")</Value>
                                    <Foot>@(detail.EndDate is null ? "open-ended" : dEnded ? "no longer billing" : "scheduled")</Foot>
                                </OdsInfoTile>

                                @* A DERIVED summary of end date / paused / archived: it carries the
                                   state and the date that state began, while the fields it derives
                                   from keep their own tiles below. *@
                                <OdsInfoTile Icon="@StatusIcon(dPaused, dEnded, dArchived)"
                                             Label="Status" ValueVariant="OdsInfoTileVariant.Text"
                                             Tone="@StatusTone(dPaused, dEnded, dArchived)">
                                    <Value>@StatusLabel(dPaused, dEnded, dArchived)</Value>
                                    <Foot>@StatusFoot(detail, dPaused, dEnded, dArchived)</Foot>
                                </OdsInfoTile>

                                @if (detail.Paused is { } pausedAt)
                                {
                                    <OdsInfoTile Icon="pause_circle" Label="Paused"
                                                 ValueVariant="OdsInfoTileVariant.Sm" Tone="OdsInfoTileTone.Pending">
                                        <Value>@LongDateTime(pausedAt)</Value>
                                        <Foot>still listed, not billing</Foot>
                                    </OdsInfoTile>
                                }

                                @if (detail.Archived is { } archivedAt)
                                {
                                    <OdsInfoTile Icon="inventory_2" Label="Archived"
                                                 ValueVariant="OdsInfoTileVariant.Sm" Tone="OdsInfoTileTone.Muted">
                                        <Value>@LongDateTime(archivedAt)</Value>
                                        <Foot>hidden from the default list</Foot>
                                    </OdsInfoTile>
                                }
                            </OdsInfoTileGrid>
                        }
                    </Details>

                    <Content>
                        @* Prose is not a field: notes go in one wide tile, never a tile column. *@
                        @if (detail is { Notes: { } notes } && !string.IsNullOrWhiteSpace(notes))
                        {
                            <OdsInfoTileGrid>
                                <OdsInfoTile Icon="sticky_note_2" Label="Notes" Wide="true">
                                    <Value>@notes</Value>
                                </OdsInfoTile>
                            </OdsInfoTileGrid>
                        }
                    </Content>
                </OdsRecordCard>
            </RenderItem>
            <CreateAction>
                @if (_canCreate)
                {
                    <OdsButton Variant="OdsButtonVariant.Filled" Icon="add" OnClick="AddClicked">New subscription</OdsButton>
                }
            </CreateAction>
            <Trailing>
                @if (_canCreate)
                {
                    <OdsAddRow Title="New subscription"
                               Sub="Record what it is, who bills it, the price, and how often it recurs."
                               OnClick="AddClicked" />
                }
            </Trailing>
        </OdsInfiniteList>
    </div>
</MudStack>

@if (_createKey != Guid.Empty)
{
    <CreateSubscriptionDialog @key="_createKey"
                              @bind-Open="_createOpen"
                              Companies="_companyOptions"
                              Currencies="_currencies"
                              OnSaved="OnSubscriptionCreated" />
}

@if (_editSubscription is not null)
{
    <CreateSubscriptionDialog @key="_editSubscriptionKey"
                              @bind-Open="_editSubscriptionOpen"
                              Subscription="_editSubscription"
                              Companies="_companyOptions"
                              Currencies="_currencies"
                              OnSaved="OnSubscriptionEdited" />
}

@code {
    // The three meta-line entries. They live here rather than in the code-behind because an inline
    // render fragment is Razor syntax — a .razor.cs cannot express one. Each is a single span so it
    // becomes the .odc-record-metaitem's only child, which is what the card's meta-line alignment
    // (.odc-record-metaitem > span) reaches down to.

    private RenderFragment ExternalIdMeta(string externalId) =>
        @<span class="sub-extid-inline">
            <span class="material-icons" aria-hidden="true">tag</span><span class="mono">@externalId</span>
        </span>;

    private RenderFragment CompanyMeta(string icon, string name) =>
        @<span class="sub-inst">
            <span class="material-icons" aria-hidden="true">@icon</span><span>@name</span>
        </span>;

    private RenderFragment CadenceMeta(string icon, string label) =>
        @<span class="sub-cadence">
            <span class="material-icons" aria-hidden="true">@icon</span><span>@label</span>
        </span>;
}
