@*
    FilesMetaEditDialog — the flat Files page's Edit-file dialog (Odyssey Design
    System · components/FilesTable → FTEditModal), the flat-file variant of
    OdsFilesEditDialog.

    The flat api/files contract exposes only two mutable metadata fields — file
    name and description (the bytes are immutable, and document type is a
    per-attachment concept a standalone file has no notion of). So this edits
    name + description instead of name + document type. Commits a Patch back
    through the table's OdsFilesTable.RenderEdit context.
*@

<OdsFormDialog Open="Open" OpenChanged="OpenChanged"
               Icon="edit" Title="Edit file" Subtitle="@File.Name"
               SubmitLabel="Save changes" SubmitIcon="check"
               OnSubmit="SubmitAsync">
    <OdsField Label="File name" @bind-Value="_name" Required="true" AutoFocus="true"
              Error="@(_touched && !_valid ? "A file needs a name." : null)" />
    <OdsField Label="Description" Optional="true" @bind-Value="_description"
              Placeholder="Optional — what this file is." />
</OdsFormDialog>

@code {
    [Parameter, EditorRequired] public OdsFilesRow File { get; set; } = default!;

    /// <summary>Dialog visibility. Bindable via @bind-Open.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Commit the edit patch (a <see cref="Patch"/>).</summary>
    [Parameter] public EventCallback<object?> OnSave { get; set; }

    private string _name = string.Empty;
    private string _description = string.Empty;
    private bool _touched;

    private bool _valid => !string.IsNullOrWhiteSpace(_name);

    protected override void OnInitialized()
    {
        _name = File.Name;
        _description = File.Description ?? string.Empty;
    }

    private async Task<bool> SubmitAsync()
    {
        _touched = true;
        if (!_valid)
            return false;

        await OnSave.InvokeAsync(new Patch(
            _name.Trim(),
            string.IsNullOrWhiteSpace(_description) ? null : _description.Trim()));
        return true;
    }

    /// <summary>The flat-file edit payload handed back through the table's OnSave.</summary>
    public sealed record Patch(string Name, string? Description);
}
