@page "/insurance-policies"
@using System.Globalization
@using Odyssey.Client.Authorization
@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@attribute [Authorize(Policy = PermissionClaims.InsuranceRead)]
@inject IInsuranceApiClient Insurance
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IClipboardService Clipboard
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IScrollManager ScrollManager
@inject Odyssey.Client.Services.IPageStateService PageState
@inject Odyssey.Client.Theme.IUserPreferenceService UserPreferences
@inject IReferenceDataCache ReferenceData
@inject IAccountsApiClient Accounts

<PageTitle>Insurance</PageTitle>

<OdsLiveAnnouncer Message="@_announce" />


<MudStack Spacing="4">

    <PageHeader Title="Insurance"
                Icon="@Icons.Material.Filled.Shield"
                Problems="HeaderProblems"
                ProblemsLabel="Renewals"
                ProblemsOpen="_problemsOpen" ProblemsOpenChanged="OnProblemsToggled"
                OverviewOpen="_overviewOpen" OverviewOpenChanged="OnOverviewToggled"
                SearchOpen="_searchOpen" SearchOpenChanged="OnSearchToggled"
                PrimaryActionText="New policy"
                OnPrimaryAction="AddClicked"
                ShowPrimaryAction="_canCreate">
        <SubLine>
            @ActiveCount polic@(ActiveCount == 1 ? "y" : "ies") on file
        </SubLine>

        <OverviewContent>
            @if (_summary is not null)
            {
                <InsurancePortfolioSummaryView Summary="_summary" Money="@MoneyFunc" MoneyCompact="@MoneyCompactFunc" />
            }
        </OverviewContent>

        <SearchContent>
            <div class="ph-filter-bar">
                <OdsSearchField Value="@_searchString" ValueChanged="OnSearchChanged"
                                DebounceInterval="300" OnSearch="LoadPolicies"
                                Placeholder="Search name, insurer…"
                                Class="ph-search" />
                <OdsMultiSelect Label="Any type" Icon="shield" Values="_typeFilter" ValuesChanged="OnTypeFilterChanged"
                                Options="OdsTypeRegistries.InsurancePolicyOptions" Class="ph-select" />
                <OdsMultiSelect Label="Any status" Icon="verified_user" Values="_statusFilter" ValuesChanged="OnStatusFilterChanged"
                                Options="_statusOptions" Class="ph-select" />
                <OdsSortSelect TRow="InsurancePolicyListItem" Fields="_sortFields" Sort="_sort" SortChanged="OnSortChanged" />
                <OdsPageSizeSelect Prefix="Load" Suffix="at a time" Label="Policies per batch"
                                   Value="_batch" ValueChanged="OnBatchChanged" Options="OdsPageSizes.Batch" />
            </div>
        </SearchContent>
    </PageHeader>

    <div class="acct-list">
        <OdsInfiniteList TItem="InsurancePolicyListItem" Items="_policies" BatchSize="_batch"
                         ItemKey="@(p => (object)p.InsurancePolicyId)" Noun="insurance policies" RevealKey="_flashId"
                         Loading="_isLoading" Refetching="_refetching" Error="_loadError" OnRetry="LoadPolicies"
                         HasFilters="_hasFilters" OnClearFilters="ClearFilters"
                         EmptyIcon="shield"
                         EmptyDescription="Add a policy to track its insurer, renewal periods, premium and coverage, and keep every supporting document in one place.">
            <RenderItem Context="p">
                @{
                    var archived = p.Archived is not null;
                    var typeInfo = OdsTypeRegistries.InsurancePolicyTypeOf(p.Type);
                    var headline = Headline(p);
                    var detail = _details.GetValueOrDefault(p.InsurancePolicyId);
                    var insurerMeta = OdsTypeRegistries.ContactTypeOf(p.Insurer.Type.ToString());

                    @* The meta line: type · insurer · policy number. The insurer is a REFERENCE to a
                       contact, so it keeps that contact type's own glyph. *@
                    var meta = new List<RenderFragment?>
                    {
                        OdsRecordMeta.Text(typeInfo.Label),
                        InsurerMeta(insurerMeta.Icon, p.Insurer.Name),
                        string.IsNullOrWhiteSpace(p.PolicyNumber) ? null : PolicyNumberMeta(p.PolicyNumber),
                    };

                    @* The header counts: periods, then the documents across them. Since issue #26 the
                       documents live INSIDE the renewal history rather than in a section of their
                       own, so the counts no longer map one-to-one onto the body's sections — the
                       second is a rollup of what the first contains. *@
                    var counts = new[]
                    {
                        new OdsRecordCount("event_repeat", p.RenewalCount.ToString(CultureInfo.CurrentCulture), "Renewal periods"),
                        new OdsRecordCount("description", p.FileCount.ToString(CultureInfo.CurrentCulture), "Documents"),
                    };
                }
                @* One accent per record, from the policy's TYPE. It reaches further here than on the
                   other pages: --rec also re-points the feature's own --ins-accent inside the body,
                   so the current-period row tint, the document chips and the premium trend line all
                   take this policy's hue instead of one page-wide indigo. *@
                <OdsRecordCard Id="@($"ins-{p.InsurancePolicyId}")"
                               Icon="@typeInfo.Icon"
                               Accent="@typeInfo.Color"
                               AccentSoft="@typeInfo.Soft"
                               Name="@p.Name"
                               Meta="meta"
                               Counts="counts"
                               FigureCaption="@headline.Word"
                               FigureTone="@HeadlineTone(headline.Cls)"
                               Dimmed="archived"
                               Highlight="@(_flashId == p.InsurancePolicyId)"
                               Open="IsExpanded(p.InsurancePolicyId)"
                               OnToggle="@(_ => ToggleExpand(p.InsurancePolicyId))">

                    <Chips>
                        <OdsCoverageStatusChip Status="p.CoverageStatus" Compact="true" />
                    </Chips>

                    <Figure>@headline.Value</Figure>

                    <Actions>
                        <OdsMenu Items="RowActions(p, archived)" AriaLabel="@($"Actions for {p.Name}")" />
                    </Actions>

                    <Details>
                        @if (detail is null)
                        {
                            <div role="status" aria-live="polite" aria-busy="true">
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-hidden="true" />
                                <span class="sr-only">Loading policy details…</span>
                            </div>
                        }
                        else
                        {
                            @* The policy's full field set, each tile rendering on its own field. Empty
                               fields drop out — except the insurer, where the absence is the fact: a
                               policy without one is broken, so it says so rather than vanishing. *@
                            var dInsurerMeta = OdsTypeRegistries.ContactTypeOf(detail.Insurer.Type.ToString());
                            var statusMeta = OdsCoverageStatus.Meta(detail.CoverageStatus);
                            <OdsInfoTileGrid>
                                <OdsInfoTile Icon="shield" Label="Name"
                                             ValueVariant="OdsInfoTileVariant.Text" WrapValue="true">
                                    <Value>@detail.Name</Value>
                                </OdsInfoTile>

                                @if (!string.IsNullOrWhiteSpace(detail.PolicyNumber))
                                {
                                    <OdsInfoTile Icon="tag" Label="Policy number"
                                                 ValueVariant="OdsInfoTileVariant.Mono" Foot="@OdsInfoTile.Caption("Insurer reference")">
                                        <Value>@detail.PolicyNumber</Value>
                                    </OdsInfoTile>
                                }

                                @* No per-tile icon colour: the grid inherits the card's accent, which
                                   IS this policy's type colour. *@
                                <OdsInfoTile Icon="@typeInfo.Icon" Label="Type" ValueVariant="OdsInfoTileVariant.Text">
                                    <Value>@typeInfo.Label</Value>
                                </OdsInfoTile>

                                @* Referenced records keep their own mark — they point elsewhere. *@
                                <OdsInfoTile Icon="@dInsurerMeta.Icon" IconColor="@dInsurerMeta.Color" IconSoft="@dInsurerMeta.Soft"
                                             Label="Insurer" ValueVariant="OdsInfoTileVariant.Text"
                                             Foot="@OdsInfoTile.Caption(dInsurerMeta.Label)">
                                    <Value>@detail.Insurer.Name</Value>
                                </OdsInfoTile>

                                @if (detail.InsuredAccount is { } insured)
                                {
                                    <OdsInfoTile Icon="@AccountTypeVisuals.MaterialIcon(insured.Type)"
                                                 IconColor="@AccountTypeVisuals.FgColor(insured.Type)"
                                                 IconSoft="@AccountTypeVisuals.BgColor(insured.Type)"
                                                 Label="Insured account" ValueVariant="OdsInfoTileVariant.Text"
                                                 Foot="@OdsInfoTile.Caption(AccountTypeVisuals.Label(insured.Type))">
                                        <Value>@insured.Name</Value>
                                    </OdsInfoTile>
                                }

                                @* A DERIVED summary: the state, plus the date that state began. The
                                   foot names the period the STATUS refers to, which is only the
                                   current one while cover is in force. *@
                                <OdsInfoTile Icon="@statusMeta.Icon" Label="Status"
                                             ValueVariant="OdsInfoTileVariant.Text"
                                             Tone="@StatusTone(statusMeta.Tone)"
                                             Foot="@OdsInfoTile.Caption(StatusFoot(detail))">
                                    <Value>@statusMeta.Label</Value>
                                </OdsInfoTile>

                                @* Server-derived: the conversion needs rates the client does not have,
                                   and a period with no rate is left out rather than summed at face
                                   value — so the count says what the figure actually includes. *@
                                @if (detail.AccruedPremium is { } accrued)
                                {
                                    <OdsInfoTile Icon="savings" Label="Total premium"
                                                 Foot="@OdsInfoTile.Caption($"{detail.AccruedPremiumPeriods} period{(detail.AccruedPremiumPeriods == 1 ? "" : "s")} to date")">
                                        <Value>@MoneyFunc(accrued, detail.AccruedPremiumCurrencyCode)</Value>
                                    </OdsInfoTile>
                                }
                            </OdsInfoTileGrid>
                        }
                    </Details>

                    <Content>
                        @* Prose is not a field: notes go in one wide tile. *@
                        @if (detail is { Notes: { } notes } && !string.IsNullOrWhiteSpace(notes))
                        {
                            <OdsInfoTileGrid>
                                <OdsInfoTile Icon="sticky_note_2" Label="Notes" Wide="true">
                                    <Value>@notes</Value>
                                </OdsInfoTile>
                            </OdsInfoTileGrid>
                        }
                    </Content>

                    <Sections>
                        @if (detail is not null)
                        {
                            <InsurancePolicyDetailView Policy="detail"
                                                       Money="@MoneyFunc"
                                                       CanWrite="_canUpdate"
                                                       CanDownload="_canDownloadFiles"
                                                       CanUpload="_canUploadFiles"
                                                       OnAddRenewal="@(() => AddRenewal(p.InsurancePolicyId))"
                                                       OnEditRenewal="@(r => EditRenewal(p.InsurancePolicyId, r))"
                                                       OnDeleteRenewal="@(r => DeleteRenewal(p.InsurancePolicyId, r))"
                                                       OnAttachRenewal="@(rid => AttachDocument(p.InsurancePolicyId, rid))"
                                                       OnChanged="@(() => ReloadPolicy(p.InsurancePolicyId))" />
                        }
                    </Sections>
                </OdsRecordCard>
            </RenderItem>
            <CreateAction>
                @if (_canCreate)
                {
                    <OdsButton Variant="OdsButtonVariant.Filled" Icon="add" OnClick="AddClicked">New policy</OdsButton>
                }
            </CreateAction>
            <Trailing>
                @if (_canCreate)
                {
                    <OdsAddRow Title="New policy"
                               Sub="Record an insurer, renewal periods, premium and coverage, and attach the documents."
                               OnClick="AddClicked" />
                }
            </Trailing>
        </OdsInfiniteList>
    </div>
</MudStack>

@if (_createKey != Guid.Empty)
{
    <CreateInsurancePolicyDialog @key="_createKey"
                                 @bind-Open="_createOpen"
                                 Insurers="_insurerOptions"
                                 Accounts="_accountOptions"
                                 OnSaved="OnPolicyCreated" />
}

@if (_editPolicy is not null)
{
    <CreateInsurancePolicyDialog @key="_editPolicyKey"
                                 @bind-Open="_editPolicyOpen"
                                 InsurancePolicy="_editPolicy"
                                 Insurers="_insurerOptions"
                                 Accounts="_accountOptions"
                                 OnSaved="OnPolicyEdited" />
}

@if (_renewalPolicy is not null)
{
    <AddRenewalDialog @key="_renewalKey"
                      @bind-Open="_renewalOpen"
                      Policy="_renewalPolicy"
                      Renewal="_editingRenewal"
                      OnSaved="@(() => OnRenewalSaved(_renewalPolicy.InsurancePolicyId))" />
}

@if (_uploadPolicy is not null)
{
    <InsuranceUploadDialog @key="_uploadKey"
                           @bind-Open="_uploadOpen"
                           Policy="_uploadPolicy"
                           RenewalId="_uploadRenewalId"
                           LockPeriod="_uploadLockPeriod"
                           OnSaved="@(rid => OnDocumentsAttached(_uploadPolicy.InsurancePolicyId, rid))" />
}

@code {
    // The two meta-line entries that carry a glyph. Inline render fragments are Razor syntax, so they
    // cannot live in the code-behind. One span each, so each becomes the .odc-record-metaitem's only
    // child and picks up the meta line's alignment.

    private RenderFragment InsurerMeta(string icon, string name) =>
        @<span class="ins-sub-insurer">
            <span class="material-icons" aria-hidden="true">@icon</span><span>@name</span>
        </span>;

    private RenderFragment PolicyNumberMeta(string policyNumber) =>
        @<span class="ins-sub-polno">
            <span class="material-icons" aria-hidden="true">tag</span><span class="mono">@policyNumber</span>
        </span>;
}
