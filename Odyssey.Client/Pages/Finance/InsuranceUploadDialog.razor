@using Microsoft.AspNetCore.Components.Forms
@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@inject Odyssey.ApiClient.Resources.IFilesApiClient FilesApi
@inject ISnackbar Snackbar
@inject IInsuranceApiClient Insurance
@inject IUploadLimitsCache UploadLimits

@*
    InsuranceUploadDialog — attach already-uploaded documents to ONE renewal period. The
    file is uploaded via the files API first, then attached by id to that period. Allowed
    types mirror the §4 allow-list (PDF / PNG / JPEG / WebP); the type picker uses the
    PolicyFileType vocabulary. The attach is gated server-side by insurance.update +
    files.read.

    There is no "whole policy" target any more (issue #26): a period is a document's only
    home, so the dialog is always scoped to ONE period. How that period is presented depends
    on whether the user chose it:

      • Opened from a period's own document panel, the target is FIXED (LockPeriod) and
        reads as an "Attaching to" line.
      • Opened from the row menu, the target was INFERRED (the current period, else the
        latest-ending one), so it is a PICKER defaulted to that period — a user filing a
        late-arriving document can still put it on an older one. With a single period there
        is no choice to make, so it reads as the fixed line again.

    Either way the target sits in the BODY, not the subtitle: the subtitle is small secondary
    text carrying boilerplate, and this is the one fact the user must check before dropping a
    file.
*@

<OdsModal Open="Open" OpenChanged="OpenChanged" OnClose="CloseAsync"
          Icon="upload_file" Title="@TitleFragment" Subtitle="@SubtitleFragment" Class="ins-dialog">
    <ChildContent>
        <div class="ods-modal-body">
            @if (_choosable)
            {
                <OdsSelect Label="Attaching to" Value="@_target.ToString()" ValueChanged="OnTargetChanged"
                           Options="_periodOptions"
                           Help="Defaults to the period in force — pick an earlier one to file a document against it." />
            }
            else
            {
                @* Nothing to choose: the user opened this from a period, or there is only one. *@
                <div class="ins-attach-target">
                    <span class="material-icons" aria-hidden="true">event</span>
                    <span class="ins-attach-target-label">Attaching to</span>
                    <span class="ins-attach-target-value">@PeriodLabel(_target)</span>
                </div>
            }

            <OdsFileUpload Files="_files" FilesChanged="OnFilesChanged"
                           Accept=".pdf,.jpg,.jpeg,.png,.webp"
                           Kinds="_kinds" GuessKind="GuessKind"
                           Error="@_error"
                           Hint="@($"PDF, JPG, PNG, WebP · up to {_uploadLimits.MaxUploadMegabytes} MB each · multiple at once")" />
        </div>
    </ChildContent>
    <Footer>
        <OdsButton Variant="OdsButtonVariant.Text" OnClick="CloseAsync">Cancel</OdsButton>
        <OdsButton Variant="OdsButtonVariant.Filled" Icon="upload_file" Loading="_isUploading" OnClick="SubmitAsync">
            @(_files.Count > 1 ? $"Attach {_files.Count} files" : "Attach")
        </OdsButton>
    </Footer>
</OdsModal>

@code {
    // Only the two inline render fragments stay here: @<text> is Razor syntax and cannot be
    // written in a code-behind. Everything else lives in InsuranceUploadDialog.razor.cs.
    private RenderFragment TitleFragment => @<text>Attach documents</text>;
    private RenderFragment SubtitleFragment => @<text>Attach the certificate, policy wording, invoice or claim documents to a renewal period.</text>;
}
