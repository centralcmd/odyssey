@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Odyssey.Client.Authorization
@using Odyssey.Client.Components
@using Odyssey.Dtos.Authorization
@using Odyssey.Dtos.Finance
@inject Odyssey.ApiClient.Resources.IFilesApiClient FilesApi
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IContractsApiClient Contracts
@inject IUploadLimitsCache UploadLimits
@inject IReferenceDataCache ReferenceData
@inject IContactQuickCreate ContactCreator
@inject AuthenticationStateProvider AuthenticationState

@*
    ContractUploadDialog — upload documents and attach them to a contract (issue #174 §3 step 4,
    §7 POST …/files). Uses the shared OdsFileUpload dropzone (the same control the design's
    AddContractFileModal renders): drag-or-browse, with a per-file name + ContractFileType picker, so
    each document can be tagged Signed / Amendment / Correspondence / Other individually, plus an
    optional per-file validity editor (Valid from/to · Issued · Issued by) rendered beneath each row
    via OdsFileUpload's RenderFileExtra slot — the same control AddFileDialog uses for account
    uploads, so the two upload surfaces read identically (issue #146). All four fields are optional
    and travel in the attach body; an omitted one is stored null. Each file is
    uploaded via the files API first, then attached by id with its chosen type. The attach is gated
    server-side by contracts.update + files.read; the §4 allow-list (PDF / PNG / JPEG / WebP) is
    enforced both here and on the server.
*@

<OdsModal Open="Open" OpenChanged="OpenChanged" OnClose="CloseAsync"
          Icon="upload_file" Title="@TitleFragment" Subtitle="@SubtitleFragment" Class="afm-dialog">
    <ChildContent>
        <div class="ods-modal-body">
            <OdsFileUpload Files="_files" FilesChanged="OnFilesChanged"
                           Accept=".pdf,.jpg,.jpeg,.png,.webp"
                           Kinds="_kinds" DefaultKind="@nameof(ContractFileType.Signed)"
                           Error="@_error"
                           Hint="@($"PDF, JPG, PNG · up to {_uploadLimits.MaxUploadMegabytes} MB each · multiple at once")"
                           RenderFileExtra="ValidityEditor" />

            @if (_existing.Count > 0)
            {
                <div class="con-existing-files">
                    <div class="con-existing-head">Already attached</div>
                    @foreach (var f in _existing)
                    {
                        var info = OdsTypeRegistries.ContractFileTypeOf(f.FileType);
                        <div class="con-existing-row">
                            <span class="con-existing-ic" style="background:@info.Soft;color:@info.Color;">
                                <span class="material-icons" aria-hidden="true" style="font-size:15px;">@info.Icon</span>
                            </span>
                            <span class="con-existing-name">@f.FileMetadata.FileName</span>
                            <span class="con-existing-kind">@info.Label</span>
                        </div>
                    }
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <OdsButton Variant="OdsButtonVariant.Text" OnClick="CloseAsync">Cancel</OdsButton>
        <OdsButton Variant="OdsButtonVariant.Filled" Icon="upload_file" Loading="_isUploading" OnClick="SubmitAsync">
            @(_files.Count > 1 ? $"Upload {_files.Count} documents" : "Upload document")
        </OdsButton>
    </Footer>
</OdsModal>

@code {

    // Razor syntax (@<text>), so these inline render fragments cannot live in the code-behind.
    private RenderFragment TitleFragment => @<text>Upload documents</text>;
    private RenderFragment SubtitleFragment => @<text>Upload the signed agreement, an amendment, or correspondence and attach it to this contract.</text>;

    // Per-file validity editor rendered beneath each row via OdsFileUpload.RenderFileExtra — the
    // contract twin of AddFileDialog's, with the same controls in the same order.
    private RenderFragment<OdsUploadFileExtraContext> ValidityEditor => ctx =>
    @<div>
        @* aria-expanded, not the changing label alone: the label conveys the state visually, but a
           disclosure control's state has to be programmatically determinable too (WCAG 2.2 SC 4.1.2).
           Same shape as OdsCollapsible's own toggle. *@
        <button type="button" class="afm-meta-toggle @(_metaOpen.Contains(ctx.File.Uid) ? "on" : "")"
                aria-expanded="@(_metaOpen.Contains(ctx.File.Uid) ? "true" : "false")"
                @onclick="@(() => ToggleMeta(ctx.File))">
            <OdsMIcon Name="event" Size="14" />
            @(_metaOpen.Contains(ctx.File.Uid) ? "Hide validity" : "Add validity")
        </button>
        @if (_metaOpen.Contains(ctx.File.Uid))
        {
            <div class="afm-meta">
                <div class="afm-meta-grid">
                    <OdsDateField Label="Valid from" Value="ctx.File.ValidFrom" Max="ctx.File.ValidTo"
                                  ValueChanged="@(v => Patch(ctx, f => f.ValidFrom = v))" />
                    <OdsDateField Label="Valid to" Value="ctx.File.ValidTo" Min="ctx.File.ValidFrom"
                                  Placeholder="No end date" Help="Leave blank if the document has no expiry."
                                  ValueChanged="@(v => Patch(ctx, f => f.ValidTo = v))" />
                    <OdsDateField Label="Issued" Value="ctx.File.IssuedAt"
                                  ValueChanged="@(v => Patch(ctx, f => f.IssuedAt = v))" />
                    <OdsContactSelect Label="Issued by" Value="@ctx.File.IssuedBy"
                                      Options="_issuerOptions"
                                      AllowCreate="@_canCreateContact" OnCreate="CreateContactOption"
                                      ValueChanged="@(v => Patch(ctx, f => f.IssuedBy = v))" />
                </div>
                @if (RangeBad(ctx.File))
                {
                    <div class="afm-meta-err">“Valid to” can’t be before “Valid from”.</div>
                }
            </div>
        }
    </div>;
}
