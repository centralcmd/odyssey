@using Odyssey.Dtos
@using Odyssey.Dtos.Finance
@using Odyssey.Client.Authorization
@using Odyssey.Client.Theme

@attribute [Authorize(Policy = PermissionClaims.AccountsRead)]
@attribute [Authorize(Policy = PermissionClaims.TransactionTagsRead)]
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserPreferenceService UserPreferences
@inject IContactQuickCreate ContactCreator
@inject ITagQuickCreate<ExistingTransactionTag> TagCreator
@inject ITransactionsApiClient Transactions
@inject IReferenceDataCache ReferenceData
@inject IAccountsApiClient Accounts


<OdsModal Open="Open" OpenChanged="OpenChanged" OnClose="CancelClicked" Icon="receipt_long"
          Wide="true" Class="atm-dialog">
    <Title>@(IsEdit ? "Edit transaction" : "New transaction")</Title>
    <Subtitle>@(IsEdit ? "Update this transaction's details or tags." : "Record money moving in or out of an account.")</Subtitle>
    <ChildContent>
        <div class="ods-modal-body">
          <div class="odc-form-grid">

                <!-- Amount hero (wide): direction, amount and currency as ONE control. The leading
                     segment flips expense ↔ income and drives the sign of the posted Amount, so the
                     form needs no separate segmented toggle. -->
                <div class="atm-amount-block odc-form-grid-wide">
                    <OdsMoneyField Label="Amount" Required="true" Size="lg" AllowNegative="false"
                                   Direction="@(_isExpense ? "expense" : "income")"
                                   DirectionChanged="OnDirectionChanged"
                                   Value="@_amountText" ValueChanged="OnAmountChanged"
                                   Currency="@_currencyCode" CurrencyChanged="OnCurrencyChanged"
                                   CurrencyOptions="_currencyOptions" CurrencySearchThreshold="0"
                                   Placeholder="0.00"
                                   Error="@(_amountError ? "Enter an amount greater than zero." : null)"
                                   Help="@DirectionHint" />
                </div>

                <!-- Date -->
                <OdsDateField Label="Date" Required="true" Value="_timeStamp" ValueChanged="OnDateChanged"
                              Help="Defaults to today" Error="@(_dateError ? "Pick the transaction date." : null)" />

                <!-- Description (wide) -->
                <div class="odc-form-grid-wide">
                    <OdsTextInputField Label="Description" Required="true" @bind-Value="_description"
                                       Placeholder="e.g. Whole Foods Market · Mission"
                                       MaxLength="256" Spellcheck="true"
                                       Error="@(_descError ? "Add a short description." : null)" />
                </div>

                <!-- Account -->
                <div class="aam-field">
                    <div class="aam-field-label">Account<span class="odc-field-req" aria-hidden="true">*</span></div>
                    @if (LockAccount && _selectedAccount is not null)
                    {
                        <div class="atm-acct-locked">
                            <span class="aam-type-ic sm"
                                  style="background:@AccountTypeVisuals.BgColor(_selectedAccount.AccountType);color:@(OdsGlyphInk.Glyph(AccountTypeVisuals.FgColor(_selectedAccount.AccountType)));">
                                <OdsMIcon Name="@AccountTypeVisuals.MaterialIcon(_selectedAccount.AccountType)" Size="16" />
                            </span>
                            <span class="atm-acct-name">@_selectedAccount.Name</span>
                            @if (!string.IsNullOrWhiteSpace(_selectedAccount.AccountNumber))
                            {
                                <span class="atm-acct-num mono">@_selectedAccount.AccountNumber</span>
                            }
                            <span class="atm-locked-pill">
                                <OdsMIcon Name="lock" Size="13" />From this account
                            </span>
                        </div>
                    }
                    else
                    {
                        @* One real trigger beside the popover (OdsPopupMenu, issue #255) — never inside
                           MudMenu's own role="button" activator wrapper. The rows are single-choice
                           menu rows (role="menuitemradio" + aria-checked) that OdsPopupMenu roves. *@
                        <OdsPopupMenu @ref="_accountPopup"
                                      TriggerClass="@($"aam-type-trigger {(_accountError ? "has-error" : "")}".TrimEnd())"
                                      AriaLabel="Account, required"
                                      AnchorOrigin="Origin.BottomCenter"
                                      TransformOrigin="Origin.TopCenter"
                                      RowId="@AccountRowId"
                                      RowCount="@_accounts.Count"
                                      SelectedRow="@SelectedAccountIndex">
                            <TriggerContent>
                                <span class="atm-acct-current">
                                    @if (_selectedAccount is not null)
                                    {
                                        <span class="aam-type-ic sm"
                                              style="background:@AccountTypeVisuals.BgColor(_selectedAccount.AccountType);color:@(OdsGlyphInk.Glyph(AccountTypeVisuals.FgColor(_selectedAccount.AccountType)));">
                                            <OdsMIcon Name="@AccountTypeVisuals.MaterialIcon(_selectedAccount.AccountType)" Size="16" />
                                        </span>
                                        <span class="atm-acct-name">@_selectedAccount.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(_selectedAccount.AccountNumber))
                                        {
                                            <span class="atm-acct-num mono">@_selectedAccount.AccountNumber</span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color:var(--mud-palette-text-secondary);">Choose an account…</span>
                                    }
                                </span>
                                <OdsMIcon Name="expand_more" Size="20" Style="color:var(--mud-palette-text-secondary);" />
                            </TriggerContent>
                            <ChildContent>
                                @for (var i = 0; i < _accounts.Count; i++)
                                {
                                    var index = i;
                                    var account = _accounts[i];
                                    var on = account.AccountId == _selectedAccount?.AccountId;
                                    <button type="button"
                                            id="@AccountRowId(index)"
                                            class="mud-menu-item mud-list-item-clickable odc-typesel-opt"
                                            role="menuitemradio"
                                            aria-checked="@(on ? "true" : "false")"
                                            tabindex="-1"
                                            @onclick="@(() => SelectAccountAsync(account))"
                                            @onkeydown="@(e => _accountPopup.RowKeyDownAsync(e, index))">
                                        <span class="mud-menu-item-text aam-type-item @(on ? "selected" : "")">
                                            <span class="aam-type-ic sm"
                                                  style="background:@AccountTypeVisuals.BgColor(account.AccountType);color:@(OdsGlyphInk.Glyph(AccountTypeVisuals.FgColor(account.AccountType)));">
                                                <OdsMIcon Name="@AccountTypeVisuals.MaterialIcon(account.AccountType)" Size="16" />
                                            </span>
                                            <span class="atm-acct-name">@account.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(account.AccountNumber))
                                            {
                                                <span class="atm-acct-num mono">@account.AccountNumber</span>
                                            }
                                            @if (on)
                                            {
                                                <OdsMIcon Class="aam-type-check" Name="check" Size="18" />
                                            }
                                        </span>
                                    </button>
                                }
                            </ChildContent>
                        </OdsPopupMenu>
                    }
                    @if (_accountError)
                    {
                        <div class="aam-err-text">Choose which account this belongs to.</div>
                    }
                </div>

                @* Merchant: the canonical OdsContactSelect — search an existing contact, or add a
                   missing one inline as a company or a person (typed create rows).

                   The form, the ledger column, the sort field and the filter all say "Merchant"
                   (design system · TxnTable, Transactions): the value is filled in from a receipt or
                   a statement line, where the counterparty is the merchant on it. The DETAIL TILE
                   still says "Contact", and that is deliberate, not drift — it names the RECORD the
                   link points at, which is a contact and may well be a person. *@
                <OdsContactSelect Id="atm-cp" Label="Merchant"
                                  Value="@_contactId" ValueChanged="@(v => _contactId = v)"
                                  Options="_cpOptions" Placeholder="Who is it with?"
                                  AllowCreate="@_canCreateContact" OnCreate="CreateContactOption"
                                  Help="@ContactHelp" />

                <!-- Tags (wide, many-to-many) -->
                <div class="odc-form-grid-wide">
                    <OdsTagMultiSelect Label="Tags"
                                       @bind-Value="_selectedTagIds"
                                       Options="_tagOptions"
                                       Placeholder="No tags"
                                       OnCreate="@(_canCreateTag ? CreateTagOption : null)"
                                       CreateKinds="OdsTypeRegistries.TagCreateKinds.Transaction"
                                       Help="Add as many as fit — e.g. a category plus Reimbursable." />
                </div>

                <!-- Status (wide) — metadata from the DTO, shown inline -->
                <OdsFieldShell Label="Status" Class="odc-form-grid-wide">
                    @* Single-select, so the chips are a radio group (matching OdsSegmentedControl): the
                       active one is conveyed by aria-checked (not colour alone), roving tabindex keeps a
                       single tab stop, and arrow / Home / End move + select together. *@
                    <div class="atm-status-row" role="radiogroup" aria-label="Status">
                        @for (var i = 0; i < _statuses.Length; i++)
                        {
                            var index = i;
                            var status = _statuses[index];
                            var sv = StatusVisual(status);
                            var on = status == _status;
                            <button type="button" class="atm-status-chip @(on ? "on" : "")"
                                    role="radio" aria-checked="@(on ? "true" : "false")"
                                    tabindex="@(on ? 0 : -1)"
                                    @ref="_statusRefs[index]"
                                    style="@(on ? $"background:{sv.Soft};color:{OdsGlyphInk.Text(sv.Color)};border-color:transparent;" : "")"
                                    @onclick="@(() => _status = status)"
                                    @onkeydown="OnStatusKeyDown"
                                    @onkeydown:preventDefault="false">
                                <OdsMIcon Name="@sv.Icon" Size="15" />@status
                            </button>
                        }
                    </div>
                </OdsFieldShell>

                <!-- Status comment (wide) -->
                <div class="odc-form-grid-wide">
                    <OdsTextInputField Label="Status comment" @bind-Value="_statusComment"
                                       MaxLength="256" Spellcheck="true" Placeholder="Why this status?" />
                </div>

                <!-- External ID + Internal ID -->
                <OdsTextInputField Label="External ID" @bind-Value="_externalId" MaxLength="64" Placeholder="The bank's reference" />
                <OdsTextInputField Label="Internal ID" @bind-Value="_internalId" MaxLength="64" Placeholder="Your own reference" />

                <!-- Extra data (wide) -->
                <div class="odc-form-grid-wide">
                    <OdsNoteField Label="Extra data" MaxLength="1024" @bind-Value="_extraData"
                                  Placeholder="Notes or raw metadata to keep with this transaction" />
                </div>


          </div>
        </div>
    </ChildContent>
    <Footer>
        <OdsButton Variant="OdsButtonVariant.Text" OnClick="CancelClicked">Cancel</OdsButton>
        <OdsButton Variant="OdsButtonVariant.Filled" Icon="@(IsEdit ? "check" : "add")" Loading="_isSaving" OnClick="SaveClicked">
            @(IsEdit ? "Save changes" : "Create transaction")
        </OdsButton>
    </Footer>
</OdsModal>
