@using System.Globalization
@using Odyssey.Client.Authorization
@using Odyssey.Client.Components
@using Odyssey.Client.Services
@using Odyssey.Dtos.Finance

@* Add/edit budget item. Caller gates which mode by passing ExistingItem (edit) or not
   (add); the matching budgets permission is enforced page-side and by the API.

   Three fields, down from five (issue #75): a budget item has no name and no description of its
   own — its transaction tag is REQUIRED, and the linked tag's name and description are the item's
   identity wherever it is displayed.

   Inline tag creation lives here and ONLY here. This dialog has a submit, so a staged create can
   settle and resolve to a real id before the item is written; the edit-multiple grid saves on change
   and is passed no create handler. *@
@attribute [Authorize(Policy = PermissionClaims.TransactionTagsRead)]

@inject IBudgetItemsApiClient BudgetItems
@inject ISnackbar Snackbar
@inject ITagQuickCreate<ExistingTransactionTag> TagCreator
@inject IReferenceDataCache ReferenceData
@inject AuthenticationStateProvider AuthenticationStateProvider

<OdsFormDialog Open="Open" OpenChanged="OpenChanged" OnSaved="OnSaved"
               Icon="@(IsEdit ? "edit" : "playlist_add")"
               Title="@(IsEdit ? "Edit budget item" : "New budget item")"
               SubmitIcon="@(IsEdit ? "check" : "add")"
               SubmitLabel="@(IsEdit ? "Save changes" : "Create budget item")"
               SubmitDisabled="@Blocked"
               OnSubmit="SaveAsync">
    <SubtitleContent>
        @(IsEdit ? "Update this line" : "Plan an income or expense line")@(string.IsNullOrWhiteSpace(BudgetName) ? "" : " for ")<strong>@BudgetName</strong>. The tag you pick names the line and collects its actuals.
    </SubtitleContent>
    <ChildContent>
        <!-- Transaction tag — the item's identity, not a label on it -->
        <OdsTransactionTagPicker @ref="_tagPicker"
                                 InputId="bi-tag-pick"
                                 Value="@_tagId"
                                 ValueChanged="OnTagChanged"
                                 Tags="TransactionTags"
                                 UsedTagIds="UsedTransactionTagIds"
                                 Error="@_tagError"
                                 LoadFailed="TagsLoadFailed"
                                 OnRetry="OnRetryTags"
                                 OnCreateTag="@(_canCreateTag ? CreateTagOption : null)" />

        @* ONE control for the planned amount, direction included. A budget item records a
           DIRECTION (Expense / Income), not a sign, so the direction rides in the slot a sign
           would occupy — the same lead a contract term's amount carries. The separate Category
           picker that used to sit beside it asked the same question twice, in a second place
           that could drift.

           The amount stays POSITIVE either way: the direction carries the meaning, and a sign
           would be a second, contradictory encoding of it. *@
        @* A planned amount is money, and the budget's base currency is the only one it can be
           in — so the code rides inside the control, locked. *@
        <OdsMoneyField Label="Planned amount" Required="true" @bind-Value="_plannedAmountText" AllowNegative="false"
                       Direction="@_categoryType.ToString()"
                       DirectionChanged="OnCategoryTypeChanged"
                       DirectionOptions="DirectionLead"
                       Currency="@BudgetCurrencyCode" CurrencyEditable="false"
                       HelpContent="@PlannedHelp"
                       Error="@(_plannedError ? "Enter a planned amount." : null)" />
    </ChildContent>
</OdsFormDialog>
