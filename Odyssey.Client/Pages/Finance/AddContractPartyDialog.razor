@using Odyssey.Client.Authorization
@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@using Microsoft.AspNetCore.Components.Authorization
@using Odyssey.Client.Services
@using Odyssey.Dtos.Authorization
@attribute [Authorize(Policy = PermissionClaims.ContractsUpdate)]
@inject IContractsApiClient Contracts
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IContactQuickCreate ContactCreator

@*
    AddContractPartyDialog — add OR edit ONE party on a contract (issue #121 §5: POST …/parties and
    PUT …/parties/{partyId}). Mirrors the design system's AddContractPartyModal.

    The accessible picker, now three decisions deep:
      1. the party KIND — Account / Contact (the XOR target)
      2. the ROLE the record plays in the agreement (ContractPartyRole; `Unspecified` is a real,
         selectable member and the default)
      3. the specific record. The Contact kind uses the canonical OdsContactSelect, create rows and
         all; the Account kind keeps the plain OdsCombobox over accounts. Either way the options are
         PRE-LOADED for the chosen kind (no in-widget async fetch).
    …plus the optional TERM — From / To — with the insurance-party semantics: both empty is the
    DEFAULT term, the contract's own extent, not an unset value.

    The save carries SCALAR IDS ONLY (accountId xor contactId) — never a nested Account or Contact
    object (§4 write-path invariant), so a party write can never create or rename the linked record.

    Duplicate guard (§8 rule 6): uniqueness is (contract, target, ROLE), so the picker hides only
    records already linked IN THE SELECTED ROLE, and the party being edited is excluded from its own
    check. The same contact can therefore be Seller and Service provider on one contract. Note the
    filter is on (kind, role), NOT on role alone as AddPolicyPartyDialog does: there the role IMPLIES
    the target type (four collections, each of one type), while a contract role implies nothing about
    the kind.

    In edit mode the PUT is a FULL REPLACEMENT of the link, not a patch: an omitted role resets to
    Unspecified and a cleared date clears. The dialog states that where the decision is made rather
    than after the fact.
*@

<OdsModal Open="Open" OpenChanged="OpenChanged" OnClose="CloseAsync"
          Icon="group_add" Title="@TitleFragment" Subtitle="@SubtitleFragment" Class="con-dialog">
    <ChildContent>
        <div class="ods-modal-body">
            @* The two kinds sit two-up and centred, so the pair balances the dialog rather than stretching. *@
            <OdsFieldShell Label="Party kind" Required="true" LabelId="con-party-kind-label">
                <OdsCardSelect AriaLabelledBy="con-party-kind-label" Required="true" Value="@_kind.ToString()" ValueChanged="PickKind"
                               Accent="var(--con-accent)" AccentLine="var(--con-accent-line)" AccentSoft="var(--con-accent-soft)"
                               Columns="2" MaxItemWidth="180" Center="true" Options="KindOptions" />
            </OdsFieldShell>

            @* A plain registry select, not a card grid: seven members and growing is a list, and the
               role is the one field a reader scans for. It is first in the tab order after the kind,
               and OdsModal's own autofocus lands here. *@
            <OdsContractPartyRoleSelect Id="con-party-role" Label="Role" Value="@_role.ToString()" ValueChanged="PickRole"
                                        Help="@RoleHelp" />

            @* OdsFieldShell owns the label association AND the helper/error ids; the hand-rolled
               .odc-field markup this replaced had neither, so a screen-reader user never heard the
               available-count hint or the reason a save was refused. Help and Error are mutually
               exclusive here, so the error reuses HelpId and one AriaDescribedBy covers both states. *@
            @if (IsContactKind)
            {
                <OdsContactSelect Id="con-party-pick" Label="@Current.Label" Required="true"
                                  Value="@_value" ValueChanged="OnValueChanged"
                                  Options="Available" Placeholder="Search contacts…"
                                  Help="@(_error is null ? PickerHelp : null)" Error="@_error"
                                  AllowCreate="@_canCreateContact" OnCreate="CreateContactOption" />
            }
            else
            {
                <OdsFieldShell Label="@Current.Label" HtmlFor="con-party-pick" Required="true"
                               Help="@(_error is null ? PickerHelp : null)" Error="@_error">
                    <OdsCombobox InputId="con-party-pick" Value="@_value" ValueChanged="OnValueChanged"
                                 Options="Available" Placeholder="@($"Search {Current.Label.ToLowerInvariant()}s…")"
                                 AriaDescribedBy="con-party-pick-help" Error="@(_error is not null)" />
                </OdsFieldShell>
            }

            @* The term is the party's own fact, not the contract's: left as it lands, the party is on
               the contract for its whole extent, and editing the contract's dates later never
               re-dates it. *@
            <OdsSectionDivider Label="In the role" />
            <OdsFormRow>
                <OdsDatePicker Value="_fromDate" ValueChanged="OnFromChanged" Clearable="true"
                               Label="From"
                               Error="@_errors.ContainsKey("fromDate")"
                               ErrorText="@_errors.GetValueOrDefault("fromDate")"
                               HelperText="@FromHelp" />
                <OdsDatePicker Value="_toDate" ValueChanged="OnToChanged" Clearable="true"
                               Label="To"
                               Error="@_errors.ContainsKey("toDate")"
                               ErrorText="@_errors.GetValueOrDefault("toDate")"
                               HelperText="Leave empty while the party is still in the role." />
            </OdsFormRow>

            @if (IsEdit)
            {
                <OdsAlert Severity="Severity.Info">
                    Saving replaces the whole party — role, record and both dates. Clearing a date clears it on
                    the contract; the party keeps its id, so this stays one party.
                </OdsAlert>
            }
        </div>
    </ChildContent>
    <Footer>
        @* Detaching a party lives on the party TILE's ⋯ menu, not here: this dialog edits ONE link and
           its footer carries that edit's own actions. A destructive action in a footer beside Save
           also reads as the opposite of Save, which is exactly where a mis-click hurts. *@
        <OdsButton Variant="OdsButtonVariant.Text" OnClick="CloseAsync">Cancel</OdsButton>
        <OdsButton Variant="OdsButtonVariant.Filled" Icon="@(IsEdit ? "check" : "add")"
                   Loading="_isSaving" OnClick="SubmitAsync">
            @(IsEdit ? "Save changes" : "Create party")
        </OdsButton>
    </Footer>
</OdsModal>

@code {
    // The title and subtitle are inline render fragments — Razor syntax, so they cannot live in the
    // code-behind. Everything else does.
    private RenderFragment TitleFragment => @<text>@(IsEdit ? "Edit party" : "New party")</text>;
    private RenderFragment SubtitleFragment => IsEdit
        ? @<text>Change the role, the linked record, or the dates this party is in the role.</text>
        : @<text>Link the account or contact this contract relates to, and say what it does in the agreement.</text>;
}
