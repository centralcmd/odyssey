@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance

@*
    InsurancePolicyDetailView — the SECTIONS of an expanded policy record (issue #175): the
    current-period snapshot and the renewal history (chart + table). Mirrors the design system's
    PolicyDetail. There is no policy-documents section: since issue #26 every document hangs off the
    period it belongs to, reachable through that period's row in the history table.

    The policy's fact tiles and notes are NOT here: they belong to the record card's Details and
    Content slots, whose order the card fixes, and InsuranceCard renders them there. What is left is
    what the body's last slot is for — the sections, each introduced by an OdsSectionDivider, in the
    same order as the header's counts, with the record's current state band first.

    Sections do not collapse and carry no action slot: the body already opens as a whole, and every
    section-level action ("New renewal period", "Attach document") lives in the row action menu. The
    one exception is the renewal history's EMPTY state, which offers "New renewal period" inline —
    with no period there is nothing to attach a document to, so the call to action has to be where
    the user is looking (issue #26 §3).
*@

@if (Policy.CurrentRenewal is { } current)
{
    @* The current-state band comes first, above the sub-collections. *@
    <div class="ins-current">
        <OdsSectionDivider Label="Current period" Meta="@($"in force · {LongDate(DateTime.UtcNow)}")" />
        <div class="ins-tiles">
            @* The premium is money going out, so it reads in the expense hue. *@
            <OdsInfoTile Icon="payments" Label="Premium" Tone="OdsInfoTileTone.Expense" Foot="@OdsInfoTile.Caption("for this period")">
                <Value>@Money(current.Premium, current.PremiumCurrencyCode)</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="shield" Label="Coverage" Foot="@OdsInfoTile.Caption("insured sum")">
                <Value>@Money(current.CoverageAmount, current.CoverageCurrencyCode)</Value>
            </OdsInfoTile>
            @* We know only when this period ENDS — whether it renews depends on terms we do not
               record, so the label never promises a renewal. *@
            <OdsInfoTile Icon="event"
                         Label="@(Lapsed(current) ? "Period ended" : "Period ends")"
                         ValueVariant="OdsInfoTileVariant.Sm"
                         Tone="@(Lapsed(current) ? OdsInfoTileTone.Expense : OdsInfoTileTone.Default)"
                         Foot="@OdsInfoTile.Caption($"{(current.FromDate.Date > Today ? "starts" : "since")} {LongDate(current.FromDate)}")">
                <Value>@LongDate(current.ToDate)</Value>
            </OdsInfoTile>
        </div>
    </div>
}

<div class="ins-section">
    <OdsSectionDivider Label="Renewal history" Meta="@($"{Policy.Renewals.Count} period{(Policy.Renewals.Count == 1 ? "" : "s")}")" />
    <InsuranceRenewalHistory Policy="Policy"
                             Money="Money"
                             CanWrite="CanWrite"
                             CanDownload="CanDownload"
                             CanUpload="CanUpload"
                             OnAddRenewal="OnAddRenewal"
                             OnEditRenewal="OnEditRenewal"
                             OnDeleteRenewal="OnDeleteRenewal"
                             OnAttachRenewal="OnAttachRenewal"
                             OnChanged="OnChanged" />
</div>

@code {
    [Parameter, EditorRequired] public ExistingInsurancePolicy Policy { get; set; } = default!;

    [Parameter, EditorRequired] public Func<decimal?, string?, string> Money { get; set; } = (v, _) => v?.ToString() ?? "—";

    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public bool CanDownload { get; set; }
    [Parameter] public bool CanUpload { get; set; }

    /// <summary>Raised by the renewal history's empty state — the only inline section action.</summary>
    [Parameter] public EventCallback OnAddRenewal { get; set; }

    [Parameter] public EventCallback<ExistingPolicyRenewal> OnEditRenewal { get; set; }
    [Parameter] public EventCallback<ExistingPolicyRenewal> OnDeleteRenewal { get; set; }
    [Parameter] public EventCallback<Guid> OnAttachRenewal { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static DateTime Today => DateTime.UtcNow.Date;

    /// <summary>Tense and tone follow the period's end against today.</summary>
    private static bool Lapsed(ExistingPolicyRenewal r) => r.ToDate.Date < Today;

    private static string LongDate(DateTime date) => date.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.CurrentCulture);

}
