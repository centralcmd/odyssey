@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance

@*
    InsurancePolicyDetailView — the read view inside an expanded policy (issue #175):
    the policy fact tiles, the current-period snapshot, the renewal history (chart +
    table) and the policy-level documents. Mirrors the design system's PolicyDetail.
*@

@{
    var typeInfo = OdsTypeRegistries.InsurancePolicyTypeOf(Policy.Type);
    var current = Policy.CurrentRenewal;
}

<div class="ins-tiles ins-policy-tiles">
    <OdsInfoTile Icon="tag" Label="Policy number" ValueVariant="OdsInfoTileVariant.Mono" Foot="@(InfoFoot("Insurer reference"))">
        <Value>@(string.IsNullOrWhiteSpace(Policy.PolicyNumber) ? "—" : Policy.PolicyNumber)</Value>
    </OdsInfoTile>
    <OdsInfoTile Icon="@typeInfo.Icon" IconColor="@typeInfo.Color" IconSoft="@typeInfo.Soft" Label="Type" ValueVariant="OdsInfoTileVariant.Text">
        <Value>@typeInfo.Label</Value>
    </OdsInfoTile>
    <OdsInfoTile Icon="apartment" Label="Insurer" ValueVariant="OdsInfoTileVariant.Text" Foot="@(InfoFoot(Policy.Insurer.Type.ToString()))">
        <Value>@Policy.Insurer.Name</Value>
    </OdsInfoTile>
    <OdsInfoTile Icon="account_balance_wallet" Label="Insured account" ValueVariant="OdsInfoTileVariant.Text"
                 Foot="@(InfoFoot(Policy.InsuredAccount is { } a ? AccountLabel(a.Type) : "Optional"))">
        <Value>@(Policy.InsuredAccount?.Name ?? "Not linked")</Value>
    </OdsInfoTile>
    @if (!string.IsNullOrWhiteSpace(Policy.Notes))
    {
        <OdsInfoTile Icon="sticky_note_2" Label="Notes" Wide="true" ValueVariant="OdsInfoTileVariant.Text">
            <Value>@Policy.Notes</Value>
        </OdsInfoTile>
    }
</div>

@if (current is not null)
{
    <div class="ins-current">
        <div class="ins-sub">
            <span class="ins-sub-label">Current period</span>
            <span class="ins-sub-rule"></span>
            <span class="ins-sub-meta">in force · @DateTime.UtcNow.ToString("MMM dd, yyyy")</span>
        </div>
        <div class="ins-tiles">
            <OdsInfoTile Icon="payments" Label="Premium" Foot="@(InfoFoot("for this period"))">
                <Value>@Money(current.Premium, current.PremiumCurrencyCode)</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="shield" Label="Coverage" Foot="@(InfoFoot("insured sum"))">
                <Value>@Money(current.CoverageAmount, current.CoverageCurrencyCode)</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="event" Label="Renews" ValueVariant="OdsInfoTileVariant.Sm" Foot="@(InfoFoot($"since {current.FromDate:MMM dd, yyyy}"))">
                <Value>@current.ToDate.ToString("MMM dd, yyyy")</Value>
            </OdsInfoTile>
        </div>
    </div>
}

<OdsCollapsible Icon="event_repeat" DefaultOpen="true">
    <Title>Renewal history</Title>
    <Count>@Policy.Renewals.Count</Count>
    <Actions>
        @if (CanWrite)
        {
            <OdsButton Variant="OdsButtonVariant.Text" Icon="add" OnClick="OnAddRenewal">New period</OdsButton>
        }
    </Actions>
    <ChildContent>
        <InsuranceRenewalHistory Policy="Policy"
                                 Money="Money"
                                 CanWrite="CanWrite"
                                 CanDownload="CanDownload"
                                 CanUpload="CanUpload"
                                 OnEditRenewal="OnEditRenewal"
                                 OnDeleteRenewal="OnDeleteRenewal"
                                 OnAttachRenewal="OnAttachRenewal"
                                 OnChanged="OnChanged" />
    </ChildContent>
</OdsCollapsible>

<OdsCollapsible Icon="folder" DefaultOpen="true">
    <Title>Policy documents</Title>
    <Count>@Policy.Files.Count</Count>
    <Actions>
        @if (CanUpload)
        {
            <OdsButton Variant="OdsButtonVariant.Text" Icon="upload_file" OnClick="OnAttachPolicy">Attach</OdsButton>
        }
    </Actions>
    <ChildContent>
        <InsuranceFilesTable PolicyId="Policy.InsurancePolicyId"
                             Files="@PolicyFiles"
                             CanDownload="CanDownload" CanDelete="CanWrite"
                             OnChanged="OnChanged"
                             Empty="_emptyPolicyDocs" />
    </ChildContent>
</OdsCollapsible>

@code {
    [Parameter, EditorRequired] public ExistingInsurancePolicy Policy { get; set; } = default!;

    [Parameter, EditorRequired] public Func<decimal?, string?, string> Money { get; set; } = (v, _) => v?.ToString() ?? "—";

    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public bool CanDownload { get; set; }
    [Parameter] public bool CanUpload { get; set; }

    /// <summary>Maps an insured account's type to its display label.</summary>
    [Parameter, EditorRequired] public Func<AccountType, string> AccountLabel { get; set; } = t => t.ToString();

    [Parameter] public EventCallback OnAddRenewal { get; set; }
    [Parameter] public EventCallback<ExistingPolicyRenewal> OnEditRenewal { get; set; }
    [Parameter] public EventCallback<ExistingPolicyRenewal> OnDeleteRenewal { get; set; }
    [Parameter] public EventCallback OnAttachPolicy { get; set; }
    [Parameter] public EventCallback<Guid> OnAttachRenewal { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<InsuranceFileItem> PolicyFiles => [.. Policy.Files.Select(InsuranceFileItem.From)];

    private readonly RenderFragment _emptyPolicyDocs =
        @<div class="empty-line" style="padding:20px;">No policy-level documents yet — attach the certificate, policy wording, or schedule.</div>;

    private static RenderFragment InfoFoot(string text) => @<text>@text</text>;
}
