@using Odyssey.Dtos.Finance
@inject ISnackbar Snackbar
@inject IClipboardService Clipboard
@inject ITransactionsApiClient Transactions
@inject AuthenticationStateProvider AuthenticationStateProvider

@*
    TransactionListView — the embedded ledger: an OdsInlinePager over OdsTxnTable, its expanded
    detail, its row action menu and the edit dialog that menu opens.

    It exists so a transaction row behaves identically wherever it is rendered. The account, budget
    and smart-tag sections each used to host their own OdsTxnTable and hand it a two-item menu (View
    details · Copy ID), which made the same row read-only when embedded and fully actionable on the
    Transactions page — a difference with no reason a user could see. The menu itself comes from
    TransactionRowMenu, which the Transactions page uses too, so the four surfaces cannot drift.

    The component resolves its own permission claims rather than taking them as parameters: the gates
    are what decide which items appear, and a host that forgot to pass one would silently render a
    lesser menu — the exact failure this replaces.

    Writes (status change, delete) are applied here and the host is told to reload through OnChanged,
    because the host owns the query the rows came from.
*@

@if (ServerPaged)
{
    @* Server-paged (the contract smart-tag host, issue #226): Rows is ONE page, so the sort goes to the
       server and the footer pager counts the host's total — a client-side pager over a page would
       report the page as the whole set. *@
    <OdsTxnTable Rows="Rows"
                 HideAccount="HideAccount"
                 ServerSort="true"
                 Sort="Sort"
                 SortChanged="SortChanged"
                 Refetching="Loading"
                 Actions="BuildActions"
                 OnDelete="HandleDeleteAsync">
        <RenderDetail Context="t">
            <TransactionDetailPanel Transaction="t" CanDownloadFiles="_canDownloadFiles" CanDeleteFiles="@(_canUpdate && _canDeleteFiles)" />
        </RenderDetail>
    </OdsTxnTable>
    <OdsPager Page="Page" PageChanged="PageChanged"
              PageSize="PageSize" PageSizeChanged="PageSizeChanged"
              TotalCount="TotalCount" Loading="Loading" />
}
else
{
    <OdsInlinePager Items="Rows" Context="pageRows">
        <OdsTxnTable Rows="pageRows"
                     HideAccount="HideAccount"
                     Actions="BuildActions"
                     OnDelete="HandleDeleteAsync">
            <RenderDetail Context="t">
                <TransactionDetailPanel Transaction="t" CanDownloadFiles="_canDownloadFiles" CanDeleteFiles="@(_canUpdate && _canDeleteFiles)" />
            </RenderDetail>
        </OdsTxnTable>
    </OdsInlinePager>
}

@if (_editTransaction is not null)
{
    <CreateTransactionDialog @key="_editKey"
                             @bind-Open="_editOpen"
                             Transaction="_editTransaction"
                             OnSaved="ChangedAsync" />
}

@if (_attachTransaction is not null)
{
    <TransactionAttachDialog @key="_attachKey"
                             @bind-Open="_attachOpen"
                             Transaction="_attachTransaction"
                             OnAttached="ChangedAsync" />
}
