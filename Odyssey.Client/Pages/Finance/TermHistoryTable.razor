@using Odyssey.Dtos.Finance

@*
    TermHistoryTable — the table of a contract's term rows (its price history). A term row is the
    surface where the three temporal states are read — In force / Scheduled / Superseded — and every
    piece of wording and formatting comes from TermVisuals, the one term registry. A contract is the
    only owner of a term since issue #190.
*@

<table class="trm-tbl">
    <thead>
        <tr>
            <th scope="col">Term</th>
            <th scope="col">Effective from</th>
            <th scope="col" class="num">Value</th>
            <th scope="col">Status</th>
            @if (CanWrite)
            {
                <th scope="col" class="act" aria-label="Actions"></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Terms)
        {
            var term = t;
            var info = TermVisuals.Info(term);
            var (iconColor, iconSoft) = TermVisuals.IconColors(term);
            var isCurrent = CurrentIds.Contains(term.TermId);
            var cadence = TermVisuals.CadenceText(term);
            <tr class="@(isCurrent ? "current" : "")" @key="term.TermId">
                <td>
                    <div class="trm-row-kind">
                        @* The glyph follows the unit; on a contract term its hue is the direction's, the
                           same hue the figure takes, so the row reads as one side of the ledger. *@
                        <span class="trm-kind-ic sm" style="background:@iconSoft;color:@iconColor;">
                            @* Decorative: the name is written out beside it, so the glyph carries no
                               meaning of its own and a screen reader announcing its ligature text
                               would read as noise (WCAG 1.1.1). *@
                            <span class="material-icons" style="font-size:15px;" aria-hidden="true">@info.Icon</span>
                        </span>
                        <div>
                            @* A term's NAME is its own label, as plain text, so nothing is carried by
                               the glyph or its hue alone (WCAG 1.1.1 / 1.4.1). *@
                            <div class="trm-row-top">
                                <span class="trm-name">
                                    <span class="trm-row-kind-name">@TermVisuals.DisplayName(term)</span>
                                </span>
                                @* The WORD beside the name, on every term and both ways round. The
                                   figure's hue is the other carrier; neither is alone, so the
                                   direction never rests on colour (WCAG 1.4.1). *@
                                <span class="trm-row-dot" aria-hidden="true"></span>
                                <span class="trm-dir">@TermDirectionVisuals.Info(term.Direction).Label</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(term.Note))
                            {
                                <div class="trm-row-note">@term.Note</div>
                            }
                        </div>
                    </div>
                </td>
                <td class="trm-cell-date">@term.EffectiveFrom.ToString("MMM dd, yyyy")</td>
                @* A contract figure keeps its direction's hue at full strength on every row, in force
                   or not: dimming a superseded one drops it below the contrast floor, and dimming a
                   SCHEDULED one draws the entry that is next as though it were already history. The
                   hierarchy is carried by the in-force row's tinted ground, its heavier figure and the
                   status cell's own words — none of which costs contrast. *@
                <td class="trm-cell-value" style="@ValueStyle(term)">
                    @TermVisuals.FormatValue(term, FormatMoney)@if (cadence is not null)
                    {@* The separator is an explicit string: Razor trims leading whitespace inside an
                         element, which glued "$45.00" to "every 3 months". *@
                        <span style="color:var(--mud-palette-text-secondary);font-weight:400;">@($" {cadence}")</span>}
                </td>
                <td>
                    @if (term.EffectiveFrom.Date > DateTime.UtcNow.Date)
                    {
                        <span class="trm-scheduled">Scheduled</span>
                    }
                    else if (isCurrent)
                    {
                        @* Same rule: "In force" is the status, the tick is decoration. Without this
                           a screen reader announces the ligature text on every in-force row. *@
                        <span class="trm-inforce"><span class="material-icons" aria-hidden="true">check_circle</span>In force</span>
                    }
                    else
                    {
                        <span class="trm-superseded">Superseded</span>
                    }
                </td>
                @if (CanWrite)
                {
                    <td class="trm-cell-act">
                        <OdsRowActions Actions="@(new OdsRowAction[]
                                       {
                                           new() { Icon = Icons.Material.Filled.Edit, Label = "Edit term",
                                                   OnClick = EventCallback.Factory.Create<MouseEventArgs>(this, () => OnEdit.InvokeAsync(term)) },
                                           new() { Icon = Icons.Material.Filled.Delete, Label = "Delete term", Danger = true,
                                                   OnClick = EventCallback.Factory.Create<MouseEventArgs>(this, () => OnDelete.InvokeAsync(term)) },
                                       })" />
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    /// <summary>
    /// The figure's colour: the term's direction hue on every row.
    /// </summary>
    private static string ValueStyle(ExistingTerm term) => $"color:{TermVisuals.ValueColor(term)};";
}
