@*
    Shared Person / Organization field set for the contact create + edit surfaces
    (Odyssey Design System · Contacts PersonFields / OrgFields, issue #325 v5).
    Two-way binds a ContactDraft; the host owns the Type discriminator.
*@
@using Odyssey.Dtos
@using Odyssey.Dtos.Finance

@if (Draft.Type == ContactType.Person)
{
    <OdsFormRow>
        <OdsField Label="First name" @bind-Value="Draft.FirstName" Required="true"
                  Error="@(FieldErrors.GetValueOrDefault("firstName"))" MaxLength="128" />
        <OdsField Label="Last name" @bind-Value="Draft.LastName" Required="true"
                  Error="@(FieldErrors.GetValueOrDefault("lastName"))" MaxLength="128" />
    </OdsFormRow>
    @* Stored and searchable, but deliberately outside the "First Last" display-name fallback — so
       adding one shifts no name and no sort position. *@
    <OdsField Label="Middle name" @bind-Value="Draft.MiddleName" Optional="true"
              Placeholder="As it appears on a passport or bank record"
              Help="Not part of the display name" MaxLength="128" />
    @* BOTH dates are OdsDateFields, not bare OdsDatePickers (issue #48). The birth/death pair is
       checked from both sides, so each needs its own Error / aria-invalid channel — which
       OdsDatePicker does not have. That is why date of birth migrates here too. *@
    <OdsFormRow>
        <OdsDateField Label="Date of birth" @bind-Value="Draft.DateOfBirth" Max="DateTime.Today" Optional="true"
                      Error="@(FieldErrors.GetValueOrDefault("dateOfBirth"))"
                      Help="Cannot be in the future" />
        <OdsDateField Label="Date of death" @bind-Value="Draft.DateOfDeath" Max="DateTime.Today" Optional="true"
                      Error="@(FieldErrors.GetValueOrDefault("dateOfDeath"))"
                      Help="Recording it archives nothing" />
    </OdsFormRow>
    <OdsFormRow>
        <OdsSelect Label="Sex" Value="@Draft.Sex" ValueChanged="@(v => Draft.Sex = v)"
                   Options="OdsTypeRegistries.SexOptions" Placeholder="Unspecified" Optional="true" Help="Optional" />
        <OdsField Label="Job title" @bind-Value="Draft.Title" Placeholder="e.g. Senior Engineer" Help="Optional" MaxLength="128" />
    </OdsFormRow>
    <OdsField Label="Company" @bind-Value="Draft.Company" Placeholder="Employer name (optional)"
              Help="A free-text note — not linked to another contact" MaxLength="256" />
}
else
{
    <OdsField Label="Legal name" @bind-Value="Draft.LegalName" Required="true"
              Error="@(FieldErrors.GetValueOrDefault("legalName"))"
              Placeholder="e.g. Lakeside Property Management LLC" MaxLength="256" />
    <OdsFormRow>
        <OdsField Label="Organization number" @bind-Value="Draft.OrganizationNumber" Placeholder="Optional" MaxLength="64" />
        <OdsField Label="Website" @bind-Value="Draft.Website" Error="@(FieldErrors.GetValueOrDefault("website"))"
                  Placeholder="https://example.com" Help="http/https only" MaxLength="2048" />
    </OdsFormRow>
    @* "Dissolved", the term a business register publishes (Norwegian oppløst) — not "closed". Either
       date may stand without the other. *@
    <OdsFormRow>
        <OdsDateField Label="Established" @bind-Value="Draft.EstablishedDate" Max="DateTime.Today" Optional="true"
                      Error="@(FieldErrors.GetValueOrDefault("establishedDate"))"
                      Help="Cannot be in the future" />
        <OdsDateField Label="Dissolved" @bind-Value="Draft.DissolvedDate" Max="DateTime.Today" Optional="true"
                      Error="@(FieldErrors.GetValueOrDefault("dissolvedDate"))"
                      Help="Reads as historical — still linkable" />
    </OdsFormRow>
}
<OdsField Label="Display name" @bind-Value="Draft.DisplayName" Placeholder="Optional override"
          Help="@DisplayNameHint" MaxLength="128" />
@* Notes belong to the contact itself, not to either field set — so the dialog edits them here rather
   than leaving a persisted value reachable only through the API. *@
<OdsNoteField Label="Notes" Optional="true" @bind-Value="Draft.Notes" MaxLength="1024" Rows="3"
              Placeholder="@NotesPlaceholder" />

@code {
    [Parameter, EditorRequired] public ContactDraft Draft { get; set; } = default!;
    [Parameter] public IReadOnlyDictionary<string, string> FieldErrors { get; set; } = new Dictionary<string, string>();

    private string NotesPlaceholder => Draft.Type == ContactType.Person
        ? "How you know them, what they invoice for…"
        : "What this organization is to you, billing quirks…";

    private string DisplayNameHint => Draft.Type == ContactType.Person
        ? "Defaults to \"First Last\" if left blank"
        : "Defaults to the legal name if left blank";
}
