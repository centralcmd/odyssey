@page "/"
@using System.Globalization
@using System.Security.Claims
@using Odyssey.Client.Authorization
@using Odyssey.Dtos.Finance
@attribute [Authorize]
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITransactionsApiClient Transactions
@inject ISnackbar Snackbar
@inject IAccountsApiClient Accounts
@inject Odyssey.Client.Theme.IUserPreferenceService UserPreferences
@inject IReferenceDataCache ReferenceData

<PageTitle>Home</PageTitle>

@*
    Dashboard — the home view at "/" (Odyssey Design System · Screens · Dashboard
    (home) · Dashboard.jsx). A carded greeting PageHeader, the Net worth line
    chart, and an excerpt of the shared transactions table showing recent activity.

    Adapted from the specimen to the real contracts:
      • Net worth comes from GET /api/accounts/totals, which converts every
        non-archived account into the user's main currency at the rate in force now
        and applies the in-force estimate replace policy. The specimen summed the mock
        accounts client-side; that mock was single-currency, the real data is not.
        Accounts the server could not convert are surfaced in the header's problem
        rollup, because each one counts as 0 and understates the figure. The history
        line is GONE rather than invented (issue #88, issue #90 phase 1): it used to
        resample the design's eased growth curve across the real account span and
        anchor it on today's figure, so every point but the last was fabricated and
        the curve rose for everyone. A real series arrives with the net-worth-history
        endpoint; until then the chart shows its empty state, which is the correct
        intermediate — a chart that invents its own history is worse than none.
      • Recent transactions are the eight newest rows from api/transactions, drawn
        with the design's Description · Tag · Status · Amount · Date columns.
      • Each region is permission-gated: the chart needs accounts.read, the table
        needs transactions.read; either is dropped (not 403'd) when not granted.
*@

<MudStack Spacing="6">

    @* 1 · Greeting header (canonical carded PageHeader) *@
    <PageHeader Title="@Greeting" Icon="@Icons.Material.Filled.SpaceDashboard"
                Problems="HeaderProblems" ProblemsLabel="Net worth issues">
        <SubLine>@HeaderSubLine</SubLine>
    </PageHeader>

    @* 2 · Net worth chart (the design-system LineChart) *@
    @if (_canReadAccounts)
    {
        @if (_isLoadingAccounts)
        {
            <OdsCard Class="ods-outline" Style="padding:20px;">
                <OdsSkeleton Variant="OdsSkeletonVariant.Block" Height="300px" />
            </OdsCard>
        }
        else
        {
            <OdsLineChart Class="ods-outline"
                          Title="Net worth"
                          Series="_chartSeries"
                          Color="var(--chart-1)"
                          Format="FormatMoney"
                          AxisFormat="KLabel"
                          AriaLabel="Net worth over time"
                          EmptyLabel="@ChartEmptyLabel">
                <Sub>@ChartSubLine</Sub>
            </OdsLineChart>
        }
    }

    @* 3 · Recent transactions — an excerpt of the shared transactions table *@
    @if (_canReadTransactions)
    {
        <OdsCard Flush="true" Class="ods-outline" Style="overflow:hidden;">
            <OdsCardHeader Title="Recent transactions">
                <Action>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               OnClick="@(() => NavigationManager.NavigateTo("transactions"))">View all</MudButton>
                </Action>
            </OdsCardHeader>

            @if (_isLoadingTransactions)
            {
                <OdsCardBody>
                    <OdsSkeleton Variant="OdsSkeletonVariant.Text" Lines="5" />
                </OdsCardBody>
            }
            else
            {
                @* Edge-to-edge: the table fills the card, per the design system's CardBody padding:0. *@
                <OdsCardBody Style="padding:0;">
                    <OdsTable TRow="ExistingTransaction" Columns="Columns" Rows="RecentTransactions">
                        <Empty>
                            <OdsEmptyState Icon="receipt_long">
                                <Title>No transactions yet</Title>
                                <Description>New activity will appear here as it lands in your accounts.</Description>
                            </OdsEmptyState>
                        </Empty>
                    </OdsTable>
                </OdsCardBody>
            }
        </OdsCard>
    }

</MudStack>

@code {
    private RenderFragment<ExistingTransaction> IconCell => txn =>
        @<span class="dsh-txn-avatar @(IsIncome(txn) ? "income" : "expense")">
            <span class="material-icons">@(IsIncome(txn) ? "arrow_downward" : "arrow_upward")</span>
        </span>;

    private RenderFragment<ExistingTransaction> DescriptionCell => txn =>
        @<text>@(string.IsNullOrWhiteSpace(txn.Description) ? "—" : txn.Description)</text>;

    private RenderFragment<ExistingTransaction> TagCell => txn =>
        @<OdsTagChips Tags="txn.TransactionTags" Max="2" />;

    private RenderFragment<ExistingTransaction> StatusCell => txn =>
        @<OdsChip Tone="StatusTone(txn.Status)" Dot="true">@txn.Status.ToString()</OdsChip>;

    private RenderFragment<ExistingTransaction> AmountCell => txn =>
        @<span class="@(IsIncome(txn) ? "dsh-amt income" : "dsh-amt expense")">@FormatSignedMoney(txn.Amount)</span>;

    private RenderFragment<ExistingTransaction> DateCell => txn =>
        @<span class="dsh-muted">@txn.TimeStamp.ToLocalTime().ToString("MMM d", CultureInfo.InvariantCulture)</span>;
}
