@page "/"
@using System.Globalization
@using System.Security.Claims
@using Odyssey.Client.Authorization
@using Odyssey.Dtos.Finance
@attribute [Authorize]
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITransactionsApiClient Transactions
@inject ISnackbar Snackbar
@inject IAccountsApiClient Accounts
@inject Odyssey.Client.Theme.IUserPreferenceService UserPreferences
@inject IReferenceDataCache ReferenceData
@inject IPageStateService PageState

<PageTitle>Home</PageTitle>

@*
    Dashboard — the home view at "/" (Odyssey Design System · Screens · Dashboard
    (home) · Dashboard.jsx). A carded greeting PageHeader, the Net worth line
    chart, and an excerpt of the shared transactions table showing recent activity.

    Adapted from the specimen to the real contracts:
      • Net worth comes from GET /api/accounts/totals, which converts every
        in-term account — and, when the response says PropertiesIncluded, every
        held property's in-force estimate (issue #214) — into the user's main
        currency at the rate in force now and applies the in-force estimate replace
        policy. The specimen summed the mock
        accounts client-side; that mock was single-currency, the real data is not.
        Accounts the server could not convert are surfaced in the header's problem
        rollup, because each one counts as 0 and understates the figure.
      • The history line comes from GET /api/accounts/net-worth-history, reconstructed
        server-side from stored data with every point measured as of its own instant
        (issue #90). It used to resample the design's eased growth curve across the
        account span and anchor it on today's figure, so every point but the last was
        fabricated and the curve rose for everyone (issue #88). Nothing is interpolated
        now, so the line can fall and can go negative, and its last point is the same
        figure the header shows. When the data is not there the chart is not there:
        there is no fallback series, and the empty copy NAMES its cause, which the
        response carries because several of the causes cannot be told apart from the
        rest of the payload.
      • The chart's period is the reader's (NetWorthRangeDialog, behind the head's settings
        button): last 6 or 12 months, all time from the earliest account, or a custom range.
        It persists in the "home-page" page state, so it sticks across visits. The figure and
        its change sit in the legend row under the plot rather than in the head.
      • The allocation donuts under the chart draw the totals' own composition rows, already
        converted into the main currency, so the slices sum to the header's net worth.
      • Recent transactions are the eight newest rows from api/transactions, drawn
        with the design's Description · Tag · Status · Amount · Date columns.
      • Each region is permission-gated: the chart needs accounts.read, the table
        needs transactions.read; either is dropped (not 403'd) when not granted.
*@

<MudStack Spacing="6">

    @* 1 · Greeting header (canonical carded PageHeader) *@
    <PageHeader Title="@Greeting" Icon="@Icons.Material.Filled.SpaceDashboard"
                Problems="HeaderProblems" ProblemsLabel="@ProblemsLabel">
        <SubLine>@HeaderSubLine</SubLine>
    </PageHeader>

    @* 2 · Net worth chart (the design-system LineChart), with its period settings *@
    @if (_canReadAccounts)
    {
        @* Gated on BOTH loads: the series and the figure arrive separately, and showing the chart
           the moment one of them lands would flash an empty state that is about to be wrong. *@
        @if (_chartIsLoading)
        {
            <OdsCard Class="ods-outline" Style="padding:20px;">
                <OdsSkeleton Variant="OdsSkeletonVariant.Block" Height="300px" />
            </OdsCard>
        }
        else
        {
            @* The figure rides in the legend row under the plot (ShowFigure off); the change there
               follows the same V15 rule the head delta did. *@
            <OdsLineChart Class="ods-outline"
                          Title="Net worth"
                          Series="_chartSeries"
                          Color="var(--chart-1)"
                          Format="FormatMoney"
                          AxisFormat="KLabel"
                          ShowFigure="false"
                          Legend="true"
                          LegendShowsChange="ChartShowsDelta"
                          DeltaSuffix="@ChartDeltaSuffix"
                          XTickEveryAuto="true"
                          TextEquivalent="true"
                          PartialDescription="@ChartPartialDescription"
                          RevaluedDescription="@ChartRevaluedDescription"
                          AriaLabel="@ChartAriaLabel"
                          EmptyLabel="@ChartEmptyLabel">
                <ControlsEnd>
                    <OdsIconButton Icon="@Icons.Material.Filled.Settings" Size="OdsSize.Sm" AriaLabel="Chart settings"
                                   OnClick="@(() => _rangeDialogOpen = true)" />
                </ControlsEnd>
                <Sub>
                    <span>@ChartCaption</span>
                    @* The property share of the latest figure, as plain text in document order —
                       never a tooltip — so a screen reader reads it with the chart (issue #215). *@
                    @if (CompositionNote is { } composition)
                    {
                        <span class="odc-lc-note">@composition</span>
                    }
                    @* One note sentence per disclosure, each in its own block. An understated period
                       and a revalued one are opposites — one is a missing movement, the other a real
                       one — so they never share a sentence. *@
                    @if (UnderstatedNote is { } understated)
                    {
                        <span class="odc-lc-note">@understated</span>
                    }
                    @if (RevaluedNote is { } revalued)
                    {
                        <span class="odc-lc-note">@revalued</span>
                    }
                </Sub>
            </OdsLineChart>

            <NetWorthRangeDialog @bind-Open="_rangeDialogOpen" Value="_range" OnApply="ApplyRangeAsync"
                                 MinDate="@(EarliestOpened?.ToDateTime(TimeOnly.MinValue))"
                                 MaxDate="@TodayUtc.ToDateTime(TimeOnly.MinValue)" />
        }

        @* 2b · Asset / liability allocation — accounts plus, when the figure includes it, owned
           property at its in-force estimate, every slice already in the main currency. *@
        @if (!_isLoadingAccounts && _totals is not null)
        {
            var (assetSlices, liabilitySlices) = DashboardFigures.AllocationSlices(_totals);
            <OdsAllocationDonuts AssetSlices="assetSlices"
                                 LiabilitySlices="liabilitySlices"
                                 Format="AllocationFormat"
                                 AssetsEmpty="Nothing held yet"
                                 LiabilitiesEmpty="Nothing owed"
                                 AssetsAriaLabel="Asset allocation in your main currency"
                                 LiabilitiesAriaLabel="Liability allocation in your main currency">
                <AssetsSub>@DashboardFigures.AllocationAssetsSub(_totals, assetSlices)</AssetsSub>
                <LiabilitiesSub>@DashboardFigures.AllocationLiabilitiesSub(liabilitySlices)</LiabilitiesSub>
            </OdsAllocationDonuts>
        }
    }

    @* 3 · Recent transactions — an excerpt of the shared transactions table *@
    @if (_canReadTransactions)
    {
        <OdsCard Flush="true" Class="ods-outline" Style="overflow:hidden;">
            <OdsCardHeader Title="Recent transactions">
                <Action>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               OnClick="@(() => NavigationManager.NavigateTo("transactions"))">View all</MudButton>
                </Action>
            </OdsCardHeader>

            @if (_isLoadingTransactions)
            {
                <OdsCardBody>
                    <OdsSkeleton Variant="OdsSkeletonVariant.Text" Lines="5" />
                </OdsCardBody>
            }
            else
            {
                @* Edge-to-edge: the table fills the card, per the design system's CardBody padding:0. *@
                <OdsCardBody Style="padding:0;">
                    <OdsTable TRow="ExistingTransaction" Columns="Columns" Rows="RecentTransactions">
                        <Empty>
                            <OdsEmptyState Icon="receipt_long">
                                <Title>No transactions yet</Title>
                                <Description>New activity will appear here as it lands in your accounts.</Description>
                            </OdsEmptyState>
                        </Empty>
                    </OdsTable>
                </OdsCardBody>
            }
        </OdsCard>
    }

</MudStack>

@code {
    private RenderFragment<ExistingTransaction> IconCell => txn =>
        @<span class="dsh-txn-avatar @(IsIncome(txn) ? "income" : "expense")">
            <span class="material-icons">@(IsIncome(txn) ? "arrow_downward" : "arrow_upward")</span>
        </span>;

    private RenderFragment<ExistingTransaction> DescriptionCell => txn =>
        @<text>@(string.IsNullOrWhiteSpace(txn.Description) ? "—" : txn.Description)</text>;

    private RenderFragment<ExistingTransaction> TagCell => txn =>
        @<OdsTagChips Tags="txn.TransactionTags" Max="2" />;

    private RenderFragment<ExistingTransaction> StatusCell => txn =>
        @<OdsChip Tone="StatusTone(txn.Status)" Dot="true">@txn.Status.ToString()</OdsChip>;

    private RenderFragment<ExistingTransaction> AmountCell => txn =>
        @<span class="@(IsIncome(txn) ? "dsh-amt income" : "dsh-amt expense")">@FormatSignedMoney(txn.Amount, txn.CurrencyCode)</span>;

    private RenderFragment<ExistingTransaction> DateCell => txn =>
        @<span class="dsh-muted">@txn.TimeStamp.ToLocalTime().ToString("MMM d", CultureInfo.InvariantCulture)</span>;
}
