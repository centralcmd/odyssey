@using Odyssey.Client.Authorization
@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@inject IInsuranceApiClient Insurance
@inject ISnackbar Snackbar

@*
    CreateInsurancePolicyDialog — the "New policy" dialog (issue #175), reused in edit mode
    when an InsurancePolicy is supplied. Fields mirror the NewInsurancePolicy /
    UpdateInsurancePolicy DTOs: name (required), policy number (optional), type and notes.

    The four link collections (issue #27) are NOT edited here. A party is added, re-dated and removed
    one at a time from the policy's own "New party" action and its party tiles, which carry the
    member's TERM in the role — a fact this dialog has nowhere to put. So it leaves all four
    untouched: a policy edit can neither add nor drop a party.

    Untouched is expressed by OMITTING them, which is what null means on UpdateInsurancePolicy. The
    design system's prototype reads the sets in and writes the same sets back because it has no
    server; here that round trip would only create a race — a party added in another tab between load
    and save would be computed as removed.
*@

<OdsFormDialog Open="Open" OpenChanged="OpenChanged" OnSaved="OnSaved"
               Icon="shield" Title="@(IsEdit ? "Edit insurance policy" : "New insurance policy")"
               Subtitle="@(IsEdit
                   ? "Update the policy details. Parties, renewal periods and documents are managed from the policy."
                   : "Record the policy details, then add parties, renewal periods and documents from the policy.")"
               SubmitLabel="@(IsEdit ? "Save changes" : "Create policy")"
               SubmitIcon="@(IsEdit ? "check" : "add")"
               OnSubmit="SaveAsync">

    <OdsField Label="Policy name" @bind-Value="_name" Placeholder="e.g. Home & Contents 2026"
              Error="@_nameError" />

    <OdsFormRow>
        <OdsField Label="Policy number" @bind-Value="_policyNumber" Placeholder="Optional — insurer's reference" />
        <OdsInsurancePolicyTypeSelect Value="@_type"
                                      ValueChanged="@(v => { _type = v; _typeError = null; })"
                                      Placeholder="Choose a type…" Error="@_typeError" />
    </OdsFormRow>

    <OdsNoteField Label="Notes" Optional="true" MaxLength="1024" @bind-Value="_notes"
                  Placeholder="What this policy covers, excess, claims history…" />
</OdsFormDialog>
