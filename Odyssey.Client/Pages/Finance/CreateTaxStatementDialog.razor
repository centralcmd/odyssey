@using Odyssey.Client.Authorization
@using Odyssey.Client.Theme
@using Odyssey.Dtos.Finance
@using Microsoft.AspNetCore.Components.Authorization
@using Odyssey.ApiClient.Resources
@using Odyssey.Dtos.Authorization


@inject ISnackbar Snackbar
@inject IUserPreferenceService UserPreferences
@inject IReferenceDataCache ReferenceData
@inject ITaxStatementsApiClient TaxStatements
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITagQuickCreate<ExistingTransactionTag> TagCreator

<OdsFormDialog Open="Open" OpenChanged="OpenChanged" OnSaved="OnSaved"
               Icon="request_quote" Title="@(IsEdit ? "Edit tax statement" : "New tax statement")"
               Subtitle="@(IsEdit
                   ? "Update the fiscal year, declared figures, derivation tags and lifecycle dates."
                   : "Record a fiscal year's official assessment, then reconcile it against your accounts and tagged transactions.")"
               SubmitLabel="@(IsEdit ? "Save changes" : "Create statement")"
               SubmitIcon="@(IsEdit ? "check" : "add")"
               OnSubmit="SaveAsync">

    <MudTextField @bind-Value="_name"
                  Label="Statement name"
                  Required="true"
                  Placeholder="e.g. Tax year 2025"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Error="@_nameError"
                  ErrorText="Give the statement a name."
                  Immediate="true" />

    <OdsFormRow>
        <OdsNumberField Value="@((decimal?)_fiscalYear)" ValueChanged="OnYearChanged"
                        Label="Fiscal year" Required="true"
                        Min="1900" Max="2200"
                        Help="The income year." />
        <OdsCurrencySelect Label="Base currency" Required="true" Value="@_baseCurrencyCode"
                           ValueChanged="@(v => _baseCurrencyCode = v)"
                           Options="_currencyOptions"
                           Help="Derived sums include only this currency." />
    </OdsFormRow>

    <OdsFormRow>
        <OdsDatePicker @bind-Value="_startDate" @bind-Value:after="FollowPeriod" Label="Period start"
                           Min="TaxSettlementRange.MinDate" Max="TaxSettlementRange.MaxDate" Required="true" />
        <OdsDatePicker @bind-Value="_endDate" @bind-Value:after="FollowPeriod" Label="Period end"
                           Min="TaxSettlementRange.MinDate" Max="TaxSettlementRange.MaxDate" Required="true"
                       Error="@_dateError" ErrorText="End date can't be before the start date."
                       HelperText="Defaults to the calendar year." />
    </OdsFormRow>

    @* Declared figures are money, so each carries the statement's base currency inside the control,
       locked — a figure in another currency would not belong to this statement. They read the same
       on create and on edit: the collapsed create-only subset is gone. *@
    <OdsSectionDivider Label="Declared figures" Meta="from the official statement" HeadingLevel="0" />
    <OdsFormRow>
        <OdsMoneyField Label="Total assets" @bind-Value="_totalAssetsText" AllowNegative="false"
                       Currency="@_baseCurrencyCode" CurrencyEditable="false" />
        <OdsMoneyField Label="Total liabilities" @bind-Value="_totalLiabilitiesText" AllowNegative="false"
                       Currency="@_baseCurrencyCode" CurrencyEditable="false" />
    </OdsFormRow>
    <OdsFormRow>
        <OdsMoneyField Label="Net worth" @bind-Value="_netWorthText" SignEditable="true"
                       Currency="@_baseCurrencyCode" CurrencyEditable="false"
                       Help="Stated directly — may differ from assets − liabilities." />
        <OdsMoneyField Label="Total income" @bind-Value="_totalIncomeText" AllowNegative="false"
                       Currency="@_baseCurrencyCode" CurrencyEditable="false" />
    </OdsFormRow>
    <OdsFormRow>
        <OdsMoneyField Label="Assessed tax" @bind-Value="_assessedTaxText" AllowNegative="false"
                       Currency="@_baseCurrencyCode" CurrencyEditable="false" />
        <OdsMoneyField Label="Settlement amount" @bind-Value="_settlementAmountText" SignEditable="true"
                       Currency="@_baseCurrencyCode" CurrencyEditable="false"
                       Help="Positive = additional tax owed · negative = refund." />
    </OdsFormRow>
    <OdsFormRow>
        <OdsDatePicker @bind-Value="_settledAtUtc" Label="Settlement paid" Clearable="true" />
        <OdsDatePicker @bind-Value="_filedAtUtc" Label="Filed to authority" Clearable="true" />
    </OdsFormRow>
    <OdsFormRow>
        <OdsDatePicker @bind-Value="_taxOfficeApprovedAtUtc" Label="Authority approved" Clearable="true" />
        <div></div>
    </OdsFormRow>

    <MudTextField @bind-Value="_notes"
                  Label="Notes"
                  Placeholder="Anything worth remembering about this statement…"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Lines="3"
                  Class="odc-field-multiline"
                  FullWidth="true" />

    @* Derivation tags stay edit-only: POST /api/tax-statements carries no tag ids, and the tags are
       set by their own PUT against an id that does not exist until the statement is created. *@
    @if (IsEdit)
    {
        <OdsSectionDivider Label="Derivation tags" Meta="tags feeding the derived figures" HeadingLevel="0" />
        @* The picker is the tag FORM control (chips + a searchable list), not the ledger header's
           filter — and it can create, naming the vocabulary it mints: a transaction tag. *@
        <OdsFormRow>
            <OdsTagMultiSelect Id="tax-statement-tax-tags" Label="Tax-payment tags"
                               Value="_taxTags" ValueChanged="OnTaxTagsChanged" Options="_tagOpts"
                               Placeholder="No tags" AddLabel="Add tag"
                               OnCreate="@(_canCreateTag ? CreateTagOption : null)"
                               CreateKinds="OdsTypeRegistries.TagCreateKinds.Transaction"
                               Help="Sum into derived advance tax paid (within the year)." />
            <OdsTagMultiSelect Id="tax-statement-income-tags" Label="Income tags"
                               Value="_incomeTags" ValueChanged="@(v => _incomeTags = v)" Options="_tagOpts"
                               Placeholder="No tags" AddLabel="Add tag"
                               OnCreate="@(_canCreateTag ? CreateTagOption : null)"
                               CreateKinds="OdsTypeRegistries.TagCreateKinds.Transaction"
                               Help="Sum into derived actual income." />
        </OdsFormRow>
        <OdsFormRow>
            <OdsTagMultiSelect Id="tax-statement-settlement-tags" Label="Settlement tags"
                               Value="_settlementTags" ValueChanged="OnSettlementTagsChanged" Options="_tagOpts"
                               Placeholder="No tags" AddLabel="Add tag"
                               OnCreate="@(_canCreateTag ? CreateTagOption : null)"
                               CreateKinds="OdsTypeRegistries.TagCreateKinds.Transaction"
                               Error="@_settlementTagsError"
                               Help="@(_settlementTagsError ?? "Additional tax paid or refund received — summed within the settlement range.")" />
            <div></div>
        </OdsFormRow>
        @* The settlement range follows the period (+1 year) until the user sets it; an untouched
           range is sent as null so the server keeps it following later period edits too. *@
        <OdsFormRow>
            <OdsDatePicker @ref="_settlementStartPicker"
                           @bind-Value="_settlementStartDate" @bind-Value:after="TouchRange" Label="Settlement from"
                           Min="TaxSettlementRange.MinDate" Max="TaxSettlementRange.MaxDate"
                           HelperText="@(_rangeTouched ? "Custom range." : "Follows the period, +1 year.")" />
            <OdsDatePicker @bind-Value="_settlementEndDate" @bind-Value:after="TouchRange" Label="Settlement to"
                           Min="TaxSettlementRange.MinDate" Max="TaxSettlementRange.MaxDate"
                           Error="@_settlementRangeError" ErrorText="End date can't be before the start date." />
        </OdsFormRow>
        @* The helper line switches silently, so the change is also announced (WCAG 4.1.3). *@
        <span class="sr-only" role="status">@_rangeAnnouncement</span>
        @if (_rangeTouched)
        {
            <div>
                <OdsButton Variant="OdsButtonVariant.Text" Icon="restart_alt" OnClick="ResetRange">Reset to period +1 year</OdsButton>
            </div>
        }
    }
</OdsFormDialog>
