@*
    Add / edit dialog for a single contact-method record — address, email, or phone
    (Odyssey Design System · Contacts ContactForm, issue #325). An email or phone is handed back to the
    host as a ContactMethodDraft, which performs the sub-resource API call. An ADDRESS is a shared place
    since issue #380: the dialog edits it through OdsAddressBlock and writes it itself, because only it
    knows which request it sent — the 403 carries no reason (issue #383 §5.3).
*@
@using Odyssey.Dtos
@using Odyssey.Dtos.Finance
@using Odyssey.Client.Pages.Journal
@inject IJSRuntime Js
@inject IContactsApiClient Contacts
@inject ILocationsApiClient Locations
@inject ISnackbar Snackbar

<OdsFormDialog Open="Open" OpenChanged="OpenChanged"
               Icon="@KindIcon" Title="@DialogTitle"
               SubmitLabel="@SubmitLabel" SubmitIcon="@(IsEdit ? "check" : "add")"
               SubmitDisabled="@AddressLoading" OnSubmit="SubmitAsync">
    <div style="display:flex;flex-direction:column;gap:12px;">
        <OdsContactMethodLabelSelect Id="@LabelFieldId" Kind="@Kind" ContactType="ContactType"
                                    Value="@Draft.Label" ValueChanged="@(v => Draft.Label = v)"
                                    Required="true" Error="@Err("label")" />

        @if (Kind == "address")
        {
            @* The shared address block (issue #383 §3.3): pick a saved place or type the address. *@
            <OdsLiveAnnouncer Message="@_announce" />
            <LocationErrorSummary Id="@SummaryId" Errors="SummaryErrors" ApplyGroupId="@ApplyGroupId" OnApplyTo="FocusApplyToAsync" />
            @if (!string.IsNullOrEmpty(_formAlert))
            {
                <OdsAlert Severity="Severity.Error" Live="OdsAlertLive.Alert">@_formAlert</OdsAlert>
            }
            @if (_block is null)
            {
                @* The stored place's usage is still loading: say so rather than show an empty block that Save
                   could not act on (frontend review N2). *@
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" role="status">Loading address…</MudText>
            }
            else
            {
                <OdsAddressBlock @ref="_addressBlock" Model="_block" Errors="_errors" ApplyToAlert="@_applyToAlert"
                                 ApplyGroupId="@ApplyGroupId" OnChange="OnBlockChanged" OnAnnounce="@(m => _announce = m)" />
            }
        }
        else if (Kind == "email")
        {
            <OdsField Label="Email address" @bind-Value="Draft.Value" Required="true" Error="@Err("value")"
                      Placeholder="name@example.com" MaxLength="256" />
        }
        else
        {
            <OdsField Label="Phone number" @bind-Value="Draft.Value" Required="true" Error="@Err("value")"
                      Placeholder="+47 22 00 00 00" Help="International format recommended" MaxLength="32" />
        }

        @* The switch carries its own label so it has an accessible name (4.1.2); no wrapping
           <label> around MudSwitch's own <label>+<input>. *@
        <div style="font:500 12.5px/1 var(--font-sans);color:var(--mud-palette-text-secondary);">
            <OdsSwitch Checked="Draft.IsPrimary" CheckedChanged="@(v => Draft.IsPrimary = v)"
                       Disabled="IsFirst" Label="@(IsFirst ? "Primary (first record)" : "Set as primary")" />
        </div>
    </div>
</OdsFormDialog>
