@using Odyssey.Dtos.Finance
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ITransactionsApiClient Transactions

<OdsCollapsible Chrome="Chrome" Open="_isOpen" OnToggle="@(_ => ToggleOpen())" Lead="receipt_long">
    <Title>Transactions</Title>
    <Count>@_transactions.Count</Count>
    <Actions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Size="Size.Small"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   OnClick="ViewAllTransactions">View all</MudButton>
    </Actions>
    <ChildContent>
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_transactions.Count == 0)
        {
            <div class="empty-line">No transactions recorded for this account yet.</div>
        }
        else
        {
            @* The shared embedded ledger, dropping the Account column (one account). A row carries
               the SAME action menu it does on the Transactions page — edit, the status transitions
               and delete included. *@
            <TransactionListView Rows="_transactions" HideAccount="true" OnChanged="ReloadAsync" />
        }
    </ChildContent>
</OdsCollapsible>

@code {
    [Parameter] public Guid AccountId { get; set; }

    /// <summary>
    /// The disclosure shell. False renders the section bare — no OdsCollapsible, no header — for a host
    /// that introduces it with its own OdsSectionDivider (an OdsRecordCard body).
    /// </summary>
    [Parameter] public bool Chrome { get; set; } = true;

    /// <summary>
    /// Raised after a write applied from a row's action menu — a status change, a delete, or a save
    /// from the edit dialog. The host's own record carries a transaction count and a rollup derived
    /// from these rows, so it has to refetch or its header keeps reporting the pre-write number.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<ExistingTransaction> _transactions = [];
    private bool _isLoading;
    private bool _isOpen = false;

    protected override async Task OnInitializedAsync()
    {
        if (!OperatingSystem.IsBrowser()) return;
        await LoadTransactionsAsync();
    }

    private async Task ToggleOpen()
    {
        _isOpen = !_isOpen;
        // Lazy-load on first expand if the initial fetch was skipped (e.g. prerender).
        if (_isOpen && _transactions.Count == 0 && !_isLoading)
            await LoadTransactionsAsync();
    }

    // A row write changes this section's rows AND the host's transaction count, so both reload.
    private async Task ReloadAsync()
    {
        await LoadTransactionsAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task LoadTransactionsAsync()
    {
        _isLoading = true;
        _transactions = (await Transactions.ListAllAsync(accountIds: [AccountId.ToString()]))
            .ItemsOrToast(Snackbar, "transactions");
        _isLoading = false;
        StateHasChanged();
    }

    private void ViewAllTransactions()
    {
        NavigationManager.NavigateTo("/transactions");
    }
}
