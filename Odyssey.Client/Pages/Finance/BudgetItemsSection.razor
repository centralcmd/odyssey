@using Odyssey.Dtos.Finance
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IClipboardService Clipboard
@inject IBudgetItemsApiClient BudgetItems

@* Budget items — grouped income/expense rows with an actual-vs-planned bar, plus an
   inline "edit multiple" mode (tag · category · planned). A budget item is a planned amount for a
   TAG (issue #75): the tag's name is the row's label and its description the secondary line, so
   there is no item name column in either mode. Actuals come from the parent's per-tag report sums;
   the parent reloads on change.

   Inside an OdsRecordCard the host passes Chrome="false" and introduces the section with
   its own OdsSectionDivider, and both section-level actions ("New item", "Edit multiple")
   live on the record's row menu — which is why Editing is a host-owned parameter here
   rather than local state. *@
<OdsCollapsible Chrome="Chrome" Open="_isOpen" OnToggle="@(_ => ToggleOpen())" Lead="format_list_bulleted">
    <Title>Budget items</Title>
    <Count>@Items.Count</Count>
    <ChildContent>
            @if (Items.Count == 0)
            {
                <OdsEmptyLine Text="No budget items yet. Add income and expense items to plan this period." />
            }
            else if (Editing)
            {
                <!-- ── Edit multiple ─────────────────────────────────────── -->
                <div class="bi-edit-grid">
                    @* The first column is the tag picker, not a name field — and it is passed NO
                       create handler: this grid saves on change, so there is no submit point at which
                       to await WhenSettledAsync, and an unresolved temporary id must never reach the
                       wire. Creating a tag happens in the dialog, which has a submit. The filler track
                       sits between Category and Planned and carries nothing. *@
                    <div class="bi-edit-head">
                        <span>Transaction tag</span>
                        <span>Category</span>
                        <span class="bi-edit-filler"></span>
                        <span class="bi-right">Planned</span>
                        <span></span>
                    </div>
                    @foreach (var item in Items)
                    {
                        var draft = GetDraft(item);
                        <div class="bi-edit-row">
                            @* A per-ROW InputId, never a constant: OdsCombobox keys its aria wiring to
                               it, and .bi-edit-head is display:none below 760px, so the row's own
                               visually hidden label is the control's real accessible name. *@
                            <OdsTransactionTagPicker InputId="@($"bi-tag-pick-{item.BudgetItemId}")"
                                                     HideLabel="true" Dense="true"
                                                     Value="@draft.TransactionTagId"
                                                     ValueChanged="@(v => OnTagChanged(item, v))"
                                                     Tags="TransactionTags"
                                                     UsedTagIds="@UsedTagIds(item.BudgetItemId)"
                                                     Error="@DraftError(item)"
                                                     LoadFailed="TagsLoadFailed"
                                                     OnRetry="OnRetryTags" />
                            <MudSelect T="BudgetCategoryType" Value="@draft.CategoryType" ValueChanged="@(v => OnCategoryChanged(item, v))"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                       Label="Category">
                                <MudSelectItem T="BudgetCategoryType" Value="BudgetCategoryType.Income">Income</MudSelectItem>
                                <MudSelectItem T="BudgetCategoryType" Value="BudgetCategoryType.Expense">Expense</MudSelectItem>
                            </MudSelect>
                            <span class="bi-edit-filler"></span>
                            <MudNumericField T="decimal" Value="@draft.PlannedAmount" ValueChanged="@(v => OnPlannedChanged(item, v))"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true"
                                             Label="Planned amount"
                                             Class="bi-planned-input" />
                            <div class="bi-edit-actions">
                                @if (CanDelete)
                                {
                                    <OdsIconButton Icon="@Icons.Material.Filled.Delete" Size="OdsSize.Sm" Danger="true"
                                                   Disabled="@_isBusy" OnClick="@(() => DeleteItem(item))"
                                                   AriaLabel="Delete budget item" />
                                }
                            </div>
                        </div>
                    }
                    <div class="bi-edit-foot">
                        <span class="bi-edit-note">Changes apply as you type.</span>
                        @if (CanCreate)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="AddItem">New item</MudButton>
                        }
                        @* The way out of the batch grid. The row menu's "Done editing items" is the
                           other, and both go through the host's Editing parameter. *@
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Check" OnClick="StopEditing">Done</MudButton>
                    </div>
                </div>
            }
            else
            {
                <!-- ── View ──────────────────────────────────────────────── -->
                @* Rows are color-coded by kind (income mint / expense coral) via a left
                   accent — no header band; the row color marks the split. *@
                <div class="bi-table acct-table-frame odc-scroll">
                    <div class="bi-colhead">
                        <span>Transaction tag</span>
                        <span>Actual vs planned</span>
                        <span class="bi-right">Actual</span>
                        <span class="bi-right">Planned</span>
                        <span></span>
                    </div>

                    @foreach (var group in VisibleGroups)
                    {
                        var income = group.Category == BudgetCategoryType.Income;
                        <div class="bi-group">
                            @foreach (var item in group.Items)
                            {
                                var actual = ItemActual(item);
                                var planned = item.PlannedAmount;
                                var fraction = planned > 0 && actual is not null ? (double)(actual.Value / planned) : 0;
                                var pct = Math.Clamp(fraction, 0, 1) * 100;
                                var over = !income && actual is not null && actual.Value > planned;
                                var barTone = income ? OdsProgressTone.Income : (over ? OdsProgressTone.Over : OdsProgressTone.Expense);
                                @* The tag IS the item's identity: its name on line 1, its description
                                   muted on line 2, omitted entirely when there is none. There is no tag
                                   pill — it would print the same string beside itself — and no untagged
                                   state, since the tag is required and the read model embeds it.
                                   "Archived" is a WORD, never colour or an icon alone. *@
                                <div class="bi-row @(income ? "income" : "expense")">
                                    <div class="bi-item">
                                        <span class="bi-item-line">
                                            <span class="bi-item-name">@item.Tag.Name</span>
                                            @if (item.Tag.Archived is not null)
                                            {
                                                <span class="bi-item-archived">Archived</span>
                                            }
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(item.Tag.Description))
                                        {
                                            <span class="bi-item-desc">@item.Tag.Description</span>
                                        }
                                    </div>
                                    <div class="bi-bar">
                                        <OdsProgressBar Value="@pct" Tone="@barTone" />
                                        @if (over)
                                        {
                                            <span class="bi-over">over by @Format(actual!.Value - planned, CurrencyCode)</span>
                                        }
                                    </div>
                                    <div class="bi-actual mono">@(actual is null ? "—" : Format(actual.Value, CurrencyCode))</div>
                                    <div class="bi-planned mono">@Format(planned, CurrencyCode)</div>
                                    <div class="bi-actions">
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Color="Color.Default"
                                                 AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopRight">
                                            @if (CanUpdate)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                             OnClick="@(() => EditItem(item))">Edit</MudMenuItem>
                                            }
                                            <MudMenuItem OnClick="@(() => CopyItemId(item))">
                                                <span class="odc-menu-item">
                                                    <span class="material-icons odc-menu-item-ic" aria-hidden="true">fingerprint</span>
                                                    <span>Copy ID</span>
                                                    <span class="material-icons odc-menu-item-trail" aria-hidden="true">content_copy</span>
                                                </span>
                                            </MudMenuItem>
                                            @if (CanDelete)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                             Style="color:var(--mud-palette-error);"
                                                             OnClick="@(() => DeleteItem(item))">Delete</MudMenuItem>
                                            }
                                        </MudMenu>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
    </ChildContent>
</OdsCollapsible>

@if (_itemKey != Guid.Empty)
{
    <CreateBudgetItemDialog @key="_itemKey"
                            @bind-Open="_itemDialogOpen"
                            BudgetId="BudgetId"
                            BudgetName="@BudgetName"
                            BudgetCurrencyCode="@CurrencyCode"
                            TransactionTags="TransactionTags"
                            UsedTransactionTagIds="_dialogUsedTagIds"
                            TagsLoadFailed="TagsLoadFailed"
                            OnRetryTags="OnRetryTags"
                            ExistingItem="_editItem"
                            OnSaved="OnItemSaved" />
}
