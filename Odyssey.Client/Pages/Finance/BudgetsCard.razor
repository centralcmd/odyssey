@page "/budgets"
@using System.Globalization
@using Odyssey.Dtos.Finance
@using Odyssey.Client.Authorization
@attribute [Authorize(Policy = PermissionClaims.BudgetsRead)]
@inject IDialogService DialogService
@inject IClipboardService Clipboard
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Odyssey.Client.Services.IPageStateService PageState
@inject ISnackbar Snackbar
@inject IReferenceDataCache ReferenceData
@inject IBudgetsApiClient Budgets
@inject IBudgetItemsApiClient BudgetItems

<PageTitle>Budgets</PageTitle>

<OdsLiveAnnouncer Message="@_announce" />

<MudStack Spacing="4">

    <PageHeader Title="Budgets"
                Icon="@Icons.Material.Filled.PieChart"
                SearchOpen="_searchOpen" SearchOpenChanged="OnSearchToggled"
                PrimaryActionText="New budget"
                OnPrimaryAction="AddClicked"
                ShowPrimaryAction="_canCreate">
        <SubLine>
            @ActiveCount active · planned balance
            <span style="color:@BalanceColor(PlannedBalance);">@FormatMoney(PlannedBalance, null)</span>
        </SubLine>
        <SearchContent>
            <div class="ph-filter-bar">
                        <OdsSearchField Value="@_searchString" ValueChanged="OnSearchChanged"
                                        DebounceInterval="300" OnSearch="GetBudgets"
                                        Placeholder="Search name or description…"
                                        Class="ph-search" />
                        <OdsMultiSelect Label="Status" Values="_statusFilter" ValuesChanged="OnStatusFilterChanged"
                                        Options="_statusOptions" Class="ph-select" />
                        <OdsSortSelect TRow="ExistingBudget" Fields="_sortFields" Sort="_sort" SortChanged="OnSortChanged" />
                        <OdsPageSizeSelect Prefix="Load" Suffix="at a time" Label="Budgets per batch"
                                           Value="_batch" ValueChanged="OnBatchChanged" Options="OdsPageSizes.Batch" />
            </div>
        </SearchContent>
    </PageHeader>

    <!-- ── Budget list ── -->
    <div class="acct-list">
        <OdsInfiniteList TItem="ExistingBudget" Items="_budgets" BatchSize="_batch"
                         ItemKey="@(b => (object)b.BudgetId)" Noun="budgets"
                         Loading="_isLoading" Refetching="_refetching" Error="_loadError" OnRetry="GetBudgets"
                         HasFilters="_hasFilters" OnClearFilters="ClearFilters"
                         EmptyIcon="pie_chart"
                         EmptyDescription="Plan a period's income and expenses, then track against transactions.">
            <RenderItem Context="budget">
                @{
                    var isExpanded = _expandedId == budget.BudgetId;
                    var archived = budget.Archived is not null;
                    var report = _reports.GetValueOrDefault(budget.BudgetId);
                    var hasReport = report is not null;
                    var actualByTag = ActualByTag(budget.BudgetId);
                    var actualIncome = ActualIncome(budget, actualByTag);
                    var actualExpenses = ActualExpenses(budget, actualByTag);
                    var actualBalance = actualIncome - actualExpenses;
                    var incomeItemCount = budget.BudgetItems.Count(i => i.CategoryType == BudgetCategoryType.Income);
                    var expenseItemCount = budget.BudgetItems.Count(i => i.CategoryType == BudgetCategoryType.Expense);
                    var itemCount = budget.BudgetItems.Count;
                    var editingItems = _editingItemsId == budget.BudgetId;
                    var period = $"{budget.StartDate:MMM dd, yyyy} → {budget.EndDate:MMM dd, yyyy}";

                    @* The single meta line: period · base currency. *@
                    var meta = new List<RenderFragment?> { PeriodMeta(period), CurrencyMeta(budget.BaseCurrencyCode) };

                    @* The header counts are the body's table of contents: same glyphs, same order as
                       the sections below, kept live while the body edits them. *@
                    var counts = new[]
                    {
                        new OdsRecordCount("format_list_bulleted", itemCount.ToString(CultureInfo.CurrentCulture), "Budget items"),
                        new OdsRecordCount("receipt_long", budget.TransactionCount.ToString(CultureInfo.CurrentCulture), "Transactions"),
                    };
                }
                @* A budget has no TYPE field and no type-equivalent registry, so it takes the brand
                   accent rather than a hue picked out of the chart palette by list position — that
                   would re-colour the whole body on every re-sort. Archived is derived state and
                   stays with the status chip. *@
                <OdsRecordCard Id="@($"bdg-{budget.BudgetId}")"
                               Icon="pie_chart"
                               Name="@budget.Name"
                               Meta="meta"
                               Counts="counts"
                               FigureCaption="Expected balance"
                               FigureTone="@BalanceFigureTone(budget.ExpectedDifference)"
                               Dimmed="archived"
                               Open="isExpanded"
                               OnToggle="@(_ => ToggleExpand(budget.BudgetId))">

                    <Chips>
                        <OdsChip Tone="@(archived ? OdsChipTone.Outline : OdsChipTone.Income)" Dot="true">@(archived ? "Archived" : "Active")</OdsChip>
                    </Chips>

                    <Figure>@FormatMoney(budget.ExpectedDifference, budget.BaseCurrencyCode)</Figure>

                    <Actions>
                        <OdsMenu Items="RowActions(budget, archived, editingItems)" AriaLabel="@($"Actions for {budget.Name}")" />
                    </Actions>

                    <Details>
                        @* The budget's FULL field set, including what the collapsed header already
                           shows: at tile scale a value arrives with its own label, so the body reads
                           as the record rather than the remainder of one. The derived roll-ups never
                           replace the planned tiles they are computed from. *@
                        <OdsInfoTileGrid>
                            <OdsInfoTile Icon="pie_chart" Label="Name"
                                         ValueVariant="OdsInfoTileVariant.Text" WrapValue="true">
                                <Value>@budget.Name</Value>
                            </OdsInfoTile>

                            <OdsInfoTile Icon="event" Label="Start date" ValueVariant="OdsInfoTileVariant.Sm"
                                         Foot="@OdsInfoTile.Caption("plan period opens")">
                                <Value>@LongDate(budget.StartDate)</Value>
                            </OdsInfoTile>

                            <OdsInfoTile Icon="event_busy" Label="End date" ValueVariant="OdsInfoTileVariant.Sm"
                                         Foot="@OdsInfoTile.Caption("plan period closes")">
                                <Value>@LongDate(budget.EndDate)</Value>
                            </OdsInfoTile>

                            <OdsInfoTile Icon="payments" Label="Base currency" Foot="@OdsInfoTile.Caption("reporting currency")">
                                <Value>@budget.BaseCurrencyCode</Value>
                            </OdsInfoTile>

                            <OdsInfoTile Icon="@(archived ? "inventory_2" : "check_circle")" Label="Status"
                                         ValueVariant="OdsInfoTileVariant.Text"
                                         Tone="@(archived ? OdsInfoTileTone.Muted : OdsInfoTileTone.Income)"
                                         Foot="@OdsInfoTile.Caption(budget.Archived is { } archivedAt ? $"since {LongDate(archivedAt)}" : "in the default list")">
                                <Value>@(archived ? "Archived" : "Active")</Value>
                            </OdsInfoTile>

                            <OdsInfoTile Icon="trending_up" Label="Planned income" Tone="OdsInfoTileTone.Income"
                                         Foot="@OdsInfoTile.Caption(Lines(incomeItemCount, "income line"))">
                                <Value>@FormatMoney(budget.ExpectedIncomes, budget.BaseCurrencyCode)</Value>
                            </OdsInfoTile>

                            <OdsInfoTile Icon="shopping_cart" Label="Planned expenses" Tone="OdsInfoTileTone.Expense"
                                         Foot="@OdsInfoTile.Caption(Lines(expenseItemCount, "expense line"))">
                                <Value>@FormatMoney(budget.ExpectedExpenses, budget.BaseCurrencyCode)</Value>
                            </OdsInfoTile>

                            @* The four derived tiles need the budget's transaction report, which is
                               fetched when the record opens — until it lands they have no value, so
                               they render no tile rather than an empty one. *@
                            @if (hasReport)
                            {
                                <OdsInfoTile Icon="south_west" Label="Actual income" Tone="OdsInfoTileTone.Income"
                                             Foot="@OdsInfoTile.Caption("from matched transactions")">
                                    <Value>@FormatMoney(actualIncome, budget.BaseCurrencyCode)</Value>
                                </OdsInfoTile>

                                <OdsInfoTile Icon="north_east" Label="Actual expenses" Tone="OdsInfoTileTone.Expense"
                                             Foot="@OdsInfoTile.Caption("from matched transactions")">
                                    <Value>@FormatMoney(actualExpenses, budget.BaseCurrencyCode)</Value>
                                </OdsInfoTile>
                            }

                            <OdsInfoTile Icon="balance" Label="Expected balance"
                                         Tone="@BalanceTileTone(budget.ExpectedDifference)"
                                         Foot="@OdsInfoTile.Caption("planned in − planned out")">
                                <Value>@FormatMoney(budget.ExpectedDifference, budget.BaseCurrencyCode)</Value>
                            </OdsInfoTile>

                            @if (hasReport)
                            {
                                <OdsInfoTile Icon="account_balance" Label="Actual balance"
                                             Tone="@BalanceTileTone(actualBalance)"
                                             Foot="@OdsInfoTile.Caption(actualBalance >= budget.ExpectedDifference ? "ahead of plan" : "behind plan")">
                                    <Value>@FormatMoney(actualBalance, budget.BaseCurrencyCode)</Value>
                                </OdsInfoTile>
                            }
                        </OdsInfoTileGrid>
                    </Details>

                    <Content>
                        @* Prose is not a field: the description goes in one wide tile. *@
                        @if (!string.IsNullOrWhiteSpace(budget.Description))
                        {
                            <OdsInfoTileGrid>
                                <OdsInfoTile Icon="notes" Label="Description" Wide="true">
                                    <Value>@budget.Description</Value>
                                </OdsInfoTile>
                            </OdsInfoTileGrid>
                        }
                    </Content>

                    <Sections>
                        @* Planned income / expense donuts — amounts in the budget's base currency;
                           the total row uses the budget's expected in/out. Planned, not actual. *@
                        @if (itemCount > 0)
                        {
                            <div class="acct-section">
                                <OdsSectionDivider Label="Allocation" Meta="@($"planned · {budget.BaseCurrencyCode}")" />
                                <MudCard Elevation="1" Class="ods-outline" Style="background:var(--mud-palette-background);">
                                    <MudCardContent Class="pa-4">
                                        <BudgetDonutPair IncomeSlices="BuildSlices(BudgetItemSlices(budget, BudgetCategoryType.Income))"
                                                         ExpenseSlices="BuildSlices(BudgetItemSlices(budget, BudgetCategoryType.Expense))"
                                                         IncomeSub="@Lines(incomeItemCount, "item")"
                                                         ExpenseSub="@Lines(expenseItemCount, "item")"
                                                         IncomeFormat="@((v, slice) => slice is null ? FormatMoney(budget.ExpectedIncomes, budget.BaseCurrencyCode) : FormatMoney(v, budget.BaseCurrencyCode))"
                                                         ExpenseFormat="@((v, slice) => slice is null ? FormatMoney(budget.ExpectedExpenses, budget.BaseCurrencyCode) : FormatMoney(v, budget.BaseCurrencyCode))" />
                                    </MudCardContent>
                                </MudCard>
                            </div>
                        }

                        @* Budget items — the planned-vs-actual table. "New item" and "Edit multiple"
                           live in the row menu: a section header labels, it does not act. *@
                        <div class="acct-section">
                            <OdsSectionDivider Label="Budget items"
                                               Meta="@($"{itemCount} item{(itemCount == 1 ? "" : "s")}{(editingItems ? " · editing" : "")}")" />
                            <BudgetItemsSection @key="@($"items:{budget.BudgetId}")"
                                                BudgetId="@budget.BudgetId"
                                                BudgetName="@budget.Name"
                                                Items="@budget.BudgetItems"
                                                ActualByTag="@actualByTag"
                                                HasReport="@hasReport"
                                                TransactionTags="@_transactionTags"
                                                Format="@FormatMoney"
                                                CurrencyCode="@budget.BaseCurrencyCode"
                                                Chrome="false"
                                                Editing="@editingItems"
                                                EditingChanged="@(on => SetItemsEditing(budget.BudgetId, on))"
                                                CanCreate="@_canCreate"
                                                CanUpdate="@_canUpdate"
                                                CanDelete="@_canDelete"
                                                OnChanged="@(() => OnBudgetChanged(budget.BudgetId))" />
                        </div>

                        @if (_canReadTransactions)
                        {
                            <div class="acct-section">
                                <OdsSectionDivider Label="Transactions"
                                                   Meta="@($"{budget.TransactionCount} matched · in range and tagged")" />
                                <div class="acct-txn-table acct-table-frame">
                                    <BudgetTransactionsSection @key="@($"txns:{budget.BudgetId}")"
                                                               BudgetId="@budget.BudgetId"
                                                               StartDate="@budget.StartDate"
                                                               EndDate="@budget.EndDate"
                                                               TagIds="@BudgetTagIds(budget)"
                                                               Chrome="false"
                                                               CanDownloadFiles="@_canDownloadFiles" />
                                </div>
                            </div>
                        }
                    </Sections>
                </OdsRecordCard>
            </RenderItem>
            <CreateAction>
                @if (_canCreate)
                {
                    <OdsButton Variant="OdsButtonVariant.Filled" Icon="add" OnClick="AddClicked">New budget</OdsButton>
                }
            </CreateAction>
            <Trailing>
                @if (_canCreate)
                {
                    <OdsAddRow Title="New budget"
                               Sub="Plan a period's income and expenses, then track against transactions."
                               OnClick="AddClicked" />
                }
            </Trailing>
        </OdsInfiniteList>
    </div>
</MudStack>

@if (_createBudgetKey != Guid.Empty)
{
    <CreateBudgetDialog @key="_createBudgetKey"
                        @bind-Open="_createBudgetOpen"
                        OnSaved="OnBudgetChanged" />
}

@if (_editBudget is not null)
{
    <CreateBudgetDialog @key="_editBudgetKey"
                        @bind-Open="_editBudgetOpen"
                        Budget="_editBudget"
                        OnSaved="OnBudgetEdited" />
}

@if (_itemBudget is not null)
{
    <CreateBudgetItemDialog @key="_itemKey"
                            @bind-Open="_itemOpen"
                            BudgetId="_itemBudget.BudgetId"
                            BudgetName="@_itemBudget.Name"
                            BudgetCurrencyCode="@_itemBudget.BaseCurrencyCode"
                            TransactionTags="_transactionTags"
                            UsedTransactionTagIds="_itemUsedTagIds"
                            OnSaved="OnItemSaved" />
}

@code {
    // The two meta-line entries. An inline render fragment is Razor syntax, so it cannot live in the
    // code-behind. One span each, so it becomes the .odc-record-metaitem's only child and picks up the
    // meta line's alignment.

    private RenderFragment PeriodMeta(string range) =>
        @<span>
            <span class="material-icons" aria-hidden="true">date_range</span><span>@range</span>
        </span>;

    // `currency`, not `code`: `@code` at the start of a line is the directive, so a parameter of that
    // name breaks the parse.
    private RenderFragment CurrencyMeta(string currency) =>
        @<span class="mono">
            <span class="material-icons" aria-hidden="true">payments</span><span>@currency</span>
        </span>;
}
