@page "/budgets"
@using System.Globalization
@using Odyssey.Dtos.Finance
@using Odyssey.Client.Authorization
@attribute [Authorize(Policy = PermissionClaims.BudgetsRead)]
@inject IDialogService DialogService
@inject IClipboardService Clipboard
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Odyssey.Client.Services.IPageStateService PageState
@inject ISnackbar Snackbar
@inject IReferenceDataCache ReferenceData
@inject IBudgetsApiClient Budgets
@inject IBudgetItemsApiClient BudgetItems

<PageTitle>Budgets</PageTitle>

<OdsLiveAnnouncer Message="@_announce" />

<MudStack Spacing="4">

    <PageHeader Title="Budgets"
                Icon="@Icons.Material.Filled.PieChart"
                SearchOpen="_searchOpen" SearchOpenChanged="OnSearchToggled"
                PrimaryActionText="New budget"
                OnPrimaryAction="AddClicked"
                ShowPrimaryAction="_canCreate">
        <SubLine>
            @ActiveCount active · planned balance
            <span style="color:@BalanceColor(PlannedBalance);">@FormatMoney(PlannedBalance, null)</span>
        </SubLine>
        <SearchContent>
            <div class="ph-filter-bar">
                        <OdsSearchField Value="@_searchString" ValueChanged="OnSearchChanged"
                                        DebounceInterval="300" OnSearch="GetBudgets"
                                        Placeholder="Search name or description…"
                                        Class="ph-search" />
                        <OdsMultiSelect Label="Status" Values="_statusFilter" ValuesChanged="OnStatusFilterChanged"
                                        Options="_statusOptions" Class="ph-select" />
                        <OdsSortSelect TRow="ExistingBudget" Fields="_sortFields" Sort="_sort" SortChanged="OnSortChanged" />
                        <OdsPageSizeSelect Prefix="Load" Suffix="at a time" Label="Budgets per batch"
                                           Value="_batch" ValueChanged="OnBatchChanged" Options="OdsPageSizes.Batch" />
            </div>
        </SearchContent>
    </PageHeader>

    <!-- ── Budget list ── -->
    <div class="acct-list">
        <OdsInfiniteList TItem="ExistingBudget" Items="_budgets" BatchSize="_batch"
                         ItemKey="@(b => (object)b.BudgetId)" Noun="budgets"
                         Loading="_isLoading" Refetching="_refetching" Error="_loadError" OnRetry="GetBudgets"
                         HasFilters="_hasFilters" OnClearFilters="ClearFilters"
                         EmptyIcon="pie_chart"
                         EmptyDescription="Plan a period's income and expenses, then track against transactions.">
            <RenderItem Context="budget">
                @{
                    var index = _budgets.IndexOf(budget);
                    var isExpanded = _expandedId == budget.BudgetId;
                    var accent = OdsDonutPalette.Default[index % OdsDonutPalette.Default.Count];
                    var archived = budget.Archived is not null;
                    var report = _reports.GetValueOrDefault(budget.BudgetId);
                    var actualByTag = ActualByTag(budget.BudgetId);
                }
                <OdsExpandableCard Open="isExpanded"
                                   Dimmed="archived"
                                   Label="@budget.Name"
                                   OnToggle="@(() => ToggleExpand(budget.BudgetId))">

            <Lead>
                <div class="acct-badge"
                     style="background:color-mix(in srgb, @accent 16%, transparent);color:@accent;">
                    <span class="material-icons" aria-hidden="true">pie_chart</span>
                </div>
            </Lead>

            <Head>
                    <div class="acct-name-row">
                        <span class="acct-name">@budget.Name</span>
                        <OdsChip Tone="@(archived ? OdsChipTone.Outline : OdsChipTone.Income)" Dot="true">@(archived ? "Archived" : "Active")</OdsChip>
                    </div>
                    <div class="acct-tags">
                        <span class="mono">@budget.StartDate.ToString("MMM dd, yyyy") → @budget.EndDate.ToString("MMM dd, yyyy")</span>
                        <span class="acct-dot">·</span>
                        <span class="mono">@budget.BaseCurrencyCode</span>
                        <span class="acct-dot">·</span>
                        <span class="acct-counts">
                            <span>
                                <span class="material-icons" aria-hidden="true">list_alt</span>
                                @budget.BudgetItems.Count
                            </span>
                            <span>
                                <span class="material-icons" aria-hidden="true">receipt_long</span>
                                @budget.TransactionCount
                            </span>
                        </span>
                    </div>
            </Head>

            <Figures>
                    <div class="acct-balance" style="color:@BalanceColor(budget.ExpectedDifference);">@FormatMoney(budget.ExpectedDifference, budget.BaseCurrencyCode)</div>
                    <div class="bdg-balance-lab">expected balance</div>
            </Figures>

            <Actions>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                             Size="Size.Small"
                             Color="Color.Default"
                             AnchorOrigin="Origin.TopRight"
                             TransformOrigin="Origin.TopRight">
                        @if (_canUpdate)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                         OnClick="@(() => EditClicked(budget))">
                                Edit budget
                            </MudMenuItem>
                        }
                        @if (_canCreate)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.PlaylistAdd"
                                         OnClick="@(() => AddItemClicked(budget))">
                                New item
                            </MudMenuItem>
                        }
                        @* Copy ID — fingerprint lead + content_copy affordance on hover/focus
                           (Odyssey Design System · ActionMenu trailingIcon). *@
                        <MudMenuItem OnClick="@(() => CopyBudgetId(budget.BudgetId))">
                            <span class="odc-menu-item">
                                <span class="material-icons odc-menu-item-ic" aria-hidden="true">fingerprint</span>
                                <span>Copy ID</span>
                                <span class="material-icons odc-menu-item-trail" aria-hidden="true">content_copy</span>
                            </span>
                        </MudMenuItem>
                        @if (_canUpdate)
                        {
                            <MudDivider />
                            <MudMenuItem Icon="@(archived ? Icons.Material.Filled.Unarchive : Icons.Material.Filled.Archive)"
                                         OnClick="@(() => ToggleArchive(budget))">
                                @(archived ? "Unarchive" : "Archive")
                            </MudMenuItem>
                        }
                        @if (_canDelete)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                         Style="color:var(--mud-palette-error);"
                                         OnClick="@(() => ConfirmDelete(budget))">
                                Delete
                            </MudMenuItem>
                        }
                    </MudMenu>
            </Actions>

            <!-- Expanded body -->
            <Detail>
                @{
                    var actualIncome = ActualIncome(budget, actualByTag);
                    var actualExpenses = ActualExpenses(budget, actualByTag);
                    var actualBalance = actualIncome - actualExpenses;
                    var hasReport = report is not null;
                }

                    <!-- Field cards -->
                    <div class="meta-grid">
                        <div class="meta-tile">
                            <div class="meta-tile-label">Start date</div>
                            <div class="meta-tile-value">@budget.StartDate.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="meta-tile">
                            <div class="meta-tile-label">End date</div>
                            <div class="meta-tile-value">@budget.EndDate.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="meta-tile">
                            <div class="meta-tile-label">Base currency</div>
                            <div class="meta-tile-value mono">@budget.BaseCurrencyCode</div>
                        </div>
                        <div class="meta-tile">
                            <div class="meta-tile-label">Status</div>
                            <div class="meta-tile-value">@(archived ? "Archived" : "Active")</div>
                        </div>
                        <div class="meta-tile wide">
                            <div class="meta-tile-label">Description</div>
                            <div class="meta-tile-value">@(string.IsNullOrWhiteSpace(budget.Description) ? "—" : budget.Description)</div>
                        </div>
                    </div>

                    @{
                        var incomeItemCount = budget.BudgetItems.Count(i => i.CategoryType == BudgetCategoryType.Income);
                        var expenseItemCount = budget.BudgetItems.Count(i => i.CategoryType == BudgetCategoryType.Expense);
                        var incomeSub = $"{incomeItemCount} item{(incomeItemCount == 1 ? "" : "s")}";
                        var expenseSub = $"{expenseItemCount} item{(expenseItemCount == 1 ? "" : "s")}";
                    }

                    <!-- Planned income / expense donuts — amounts in the budget's base
                         currency; the total row uses the budget's expected in/out. -->
                    <MudCard Elevation="1" Class="ods-outline" Style="background:var(--mud-palette-background);">
                        <MudCardContent Class="pa-4">
                            <BudgetDonutPair IncomeSlices="BuildSlices(BudgetItemSlices(budget, BudgetCategoryType.Income))"
                                             ExpenseSlices="BuildSlices(BudgetItemSlices(budget, BudgetCategoryType.Expense))"
                                             IncomeSub="@incomeSub"
                                             ExpenseSub="@expenseSub"
                                             IncomeFormat="@((v, slice) => slice is null ? FormatMoney(budget.ExpectedIncomes, budget.BaseCurrencyCode) : FormatMoney(v, budget.BaseCurrencyCode))"
                                             ExpenseFormat="@((v, slice) => slice is null ? FormatMoney(budget.ExpectedExpenses, budget.BaseCurrencyCode) : FormatMoney(v, budget.BaseCurrencyCode))" />
                        </MudCardContent>
                    </MudCard>

                    @* Balance stat tiles — OdsStatTile keeps the figure neutral and
                       carries the up/down tint on the delta (Ahead of / Behind plan). *@
                    <div class="stat-grid duo">
                        <OdsStatTile>
                            <Overline>Expected balance</Overline>
                            <Value>@FormatMoney(budget.ExpectedDifference, budget.BaseCurrencyCode)</Value>
                        </OdsStatTile>
                        @if (hasReport)
                        {
                            <OdsStatTile DeltaDir="@(actualBalance >= budget.ExpectedDifference ? OdsDeltaDirection.Up : OdsDeltaDirection.Down)">
                                <Overline>Actual balance</Overline>
                                <Value>@FormatMoney(actualBalance, budget.BaseCurrencyCode)</Value>
                                <Delta>@(actualBalance >= budget.ExpectedDifference ? "Ahead of plan" : "Behind plan")</Delta>
                            </OdsStatTile>
                        }
                        else
                        {
                            <OdsStatTile>
                                <Overline>Actual balance</Overline>
                                <Value>—</Value>
                            </OdsStatTile>
                        }
                    </div>

                    <!-- Budget items -->
                    <BudgetItemsSection @key="@($"items:{budget.BudgetId}")"
                                        BudgetId="@budget.BudgetId"
                                        BudgetName="@budget.Name"
                                        Items="@budget.BudgetItems"
                                        ActualByTag="@actualByTag"
                                        HasReport="@hasReport"
                                        TransactionTags="@_transactionTags"
                                        Format="@FormatMoney"
                                        CurrencyCode="@budget.BaseCurrencyCode"
                                        CanCreate="@_canCreate"
                                        CanUpdate="@_canUpdate"
                                        CanDelete="@_canDelete"
                                        OnChanged="@(() => OnBudgetChanged(budget.BudgetId))" />

                    <!-- Transactions -->
                    @if (_canReadTransactions)
                    {
                        <BudgetTransactionsSection @key="@($"txns:{budget.BudgetId}")"
                                                   BudgetId="@budget.BudgetId"
                                                   StartDate="@budget.StartDate"
                                                   EndDate="@budget.EndDate"
                                                   TagIds="@BudgetTagIds(budget)"
                                                   CanDownloadFiles="@_canDownloadFiles" />
                    }
            </Detail>
                </OdsExpandableCard>
            </RenderItem>
            <CreateAction>
                @if (_canCreate)
                {
                    <OdsButton Variant="OdsButtonVariant.Filled" Icon="add" OnClick="AddClicked">New budget</OdsButton>
                }
            </CreateAction>
            <Trailing>
                @if (_canCreate)
                {
                    <button class="bdg-add" @onclick="AddClicked">
                        <div class="bdg-badge" style="background:var(--mud-palette-action-disabled-background);color:var(--mud-palette-text-secondary);">
                            <span class="material-icons" style="font-size:20px;">add</span>
                        </div>
                        <div>
                            <div class="bdg-add-title">New budget</div>
                            <div class="bdg-add-sub">Plan a period's income and expenses, then track against transactions.</div>
                        </div>
                    </button>
                }
            </Trailing>
        </OdsInfiniteList>
    </div>
</MudStack>

@if (_createBudgetKey != Guid.Empty)
{
    <CreateBudgetDialog @key="_createBudgetKey"
                        @bind-Open="_createBudgetOpen"
                        OnSaved="OnBudgetChanged" />
}

@if (_editBudget is not null)
{
    <CreateBudgetDialog @key="_editBudgetKey"
                        @bind-Open="_editBudgetOpen"
                        Budget="_editBudget"
                        OnSaved="OnBudgetEdited" />
}

@if (_itemBudget is not null)
{
    <CreateBudgetItemDialog @key="_itemKey"
                            @bind-Open="_itemOpen"
                            BudgetId="_itemBudget.BudgetId"
                            BudgetName="@_itemBudget.Name"
                            TransactionTags="_transactionTags"
                            UsedTransactionTagIds="_itemUsedTagIds"
                            OnSaved="OnItemSaved" />
}

