@using Odyssey.Client.Authorization
@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@inject IContractsApiClient Contracts
@inject ISnackbar Snackbar

@*
    CreateContractDialog — the "New contract" dialog (issue #174), reused in edit mode when a
    Contract is supplied (design-system update: every record's Edit action opens its create dialog
    in edit mode instead of an inline expand-to-edit panel). Fields mirror the NewContract /
    UpdateContract DTOs: name (required, ≤256), type, description (optional, ≤1024), and the term.
    A contract is either TERM-based — startDate (optional) + endDate (optional, ≥ startDate) — or a
    ONE-OFF — a required completionDate point-in-time agreement with no ongoing term. Parties and
    documents are never edited here; they are managed from the contract's detail (§6/§10).

    On EDIT the type is the one field that can be refused by something OTHER than itself: changing
    it to one whose column rejects an existing party's role is a 422 (issue #157), and the server
    writes nothing. The dialog computes the same thing from the shared matrix, names each offending
    party, and states the two routes that work — re-role them, or detach them — rather than letting
    the user save into a refusal.

    The two SIGNATURE stamps (issue #145) are EDIT-ONLY: a brand-new contract always starts as a
    Draft, so create mode does not offer them at all and the stamps are set from the contract itself
    — usually the row menu's one-click Mark ready / Mark signed, or this dialog in edit mode when a
    paper contract signed last month is entered in one go. Nothing constrains them against the TERM
    dates — signing after cover has begun is ordinary, and signing before a term starts is the
    normal case.
*@

<OdsFormDialog Open="Open" OpenChanged="OpenChanged" OnSaved="OnSaved"
               Icon="handshake" Title="@(IsEdit ? "Edit contract" : "New contract")"
               Subtitle="@(IsEdit
                   ? "Update the agreement's name, type, term and signature dates. Parties and documents are managed from the contract."
                   : "Record the agreement's name, type and dates — a term or a one-off. It starts as a draft; mark it ready and signed from the contract itself.")"
               SubmitLabel="@(IsEdit ? "Save changes" : "Create contract")"
               SubmitIcon="@(IsEdit ? "check" : "add")"
               OnSubmit="SaveAsync">

    <OdsField Label="Contract name" Required="true" @bind-Value="_name" Placeholder="e.g. Maple St Residence — Lease"
              Error="@_nameError" />

    <OdsFormRow>
        <OdsContractTypeSelect Required="true" Value="@_type"
                               ValueChanged="@(v => { _type = v; _typeError = null; })"
                               Placeholder="Choose a type…" Error="@_typeError" />
        <OdsFieldShell Label="Term">
            <OdsSegmentedControl Full="true" Value="@_mode" ValueChanged="OnModeChanged"
                                 AriaLabel="Contract term" Options="_modeOptions" />
        </OdsFieldShell>
    </OdsFormRow>

    @if (BlockedByParties)
    {
        <OdsAlert Severity="Severity.Warning">
            <strong>
                A @RequestedTypeLabel contract can't hold
                @(OrphanedParties.Count == 1 ? "this party" : "these parties").
            </strong>
            <p>
                @(OrphanedParties.Count == 1 ? "One party holds" : $"{OrphanedParties.Count} parties hold")
                a role a @RequestedTypeLabel contract does not accept. Re-role
                @(OrphanedParties.Count == 1 ? "it" : "them") to @LegalRolesText, or detach
                @(OrphanedParties.Count == 1 ? "it" : "them") — then change the type. Nothing is saved until then.
            </p>
            <ul class="con-orphans">
                @foreach (var party in OrphanedParties)
                {
                    <li class="con-orphan">
                        <span class="con-orphan-role">@PartyRoleLabel.For(party.Role)</span>
                        <span class="con-orphan-name">@PartyDisplayName(party)</span>
                    </li>
                }
            </ul>
        </OdsAlert>
    }

    @if (_mode == TermMode)
    {
        <OdsFormRow>
            <OdsDateField Label="Starts" @bind-Value="_startDate"
                          Placeholder="No start date" />
            <OdsDateField Label="Ends" Value="_endDate"
                          ValueChanged="@(v => { _endDate = v; _endError = null; })"
                          Placeholder="Open-ended"
                          Error="@_endError"
                          Help="Leave empty for an open-ended agreement." />
        </OdsFormRow>
    }
    else
    {
        <OdsFormRow>
            <OdsDateField Label="Completion" Required="true" Value="_completionDate"
                          ValueChanged="@(v => { _completionDate = v; _completionError = null; })"
                          Placeholder="Completion date"
                          Error="@_completionError"
                          Help="The one-off closing / delivery date — no ongoing term." />
            <div></div>
        </OdsFormRow>
    }

    @* SIGNATURE — edit only. A brand-new contract always starts as a Draft, so the two stamps are
       set later from the contract itself; on edit they matter, and neither is required. *@
    @if (IsEdit)
    {
        <OdsFormRow>
            <OdsDateField Label="Ready for signature" Value="_ready"
                          ValueChanged="@(v => { _ready = v; _readyError = null; _signedError = null; })"
                          Placeholder="Not yet ready"
                          Error="@_readyError"
                          Help="Leave blank while it is still being drafted." />
            <OdsDateField Label="Signed" Value="_signed"
                          ValueChanged="@(v => { _signed = v; _signedError = null; })"
                          Placeholder="Not signed"
                          Error="@_signedError"
                          Help="Signed by all parties. Until this is set, the contract stays out of the run rate." />
        </OdsFormRow>
    }

    <OdsNoteField Label="Description" MaxLength="1024" @bind-Value="_description"
                  Placeholder="What this agreement covers, term, notice period, key conditions…" />
</OdsFormDialog>

@code {
    /// <summary>
    /// A blocked party as the reader already sees it on the contract. An unresolvable target keeps
    /// its row and loses its name — the same rule the read path follows, and the reason the server's
    /// own payload allows a null display name.
    /// </summary>
    private static string PartyDisplayName(ExistingContractParty party) =>
        party.Account?.Name ?? party.Institution?.Name ?? "Unnamed party";
}
