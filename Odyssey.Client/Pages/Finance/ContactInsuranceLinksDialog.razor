@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance

@*
    ContactInsuranceLinksDialog — the blocked contact delete (409) and its detach path
    (Odyssey Design System · ContactLinksBlockedModal).

    A contact named as an INSURER, an INSURED CONTACT or a BENEFICIARY on any policy — or, since the
    contract party-role matrix (issue #157), as a BENEFICIARY on any contract — cannot be deleted by
    the ordinary route: the delete is refused, because a beneficiary designation vanishing silently on
    contact deletion would lose it without trace. RESTRICT alone is not an acceptable answer for a
    person exercising erasure, so this dialog also carries the supported release valve — detach every
    blocking link and delete the contact in ONE request, one transaction.

    Two things are claim-conditional, PER BLOCKER CLASS, and the dialog is honest about both:
      • The payload. Policy names need insurance.read; contract names need contracts.read. Without the
        claim the caller still gets the COUNT — enough to act, since the valve never asks you to name
        them. That decision is the server's: it simply sends no records, and the dialog says why the
        list is absent rather than rendering an empty one.
      • The action. Detaching needs contacts.delete plus insurance.update for policy rows and
        contracts.update for contract rows — demanded only for the classes actually PRESENT, so a
        caller whose contact has no contract links is not held back by a rule about contracts. Without
        a needed claim the button is unavailable with the reason stated, never a silent downgrade to
        the refused delete.

    Meaning never rides on a glyph: each blocking KIND is named in text alongside its row count.
*@

<OdsFormDialog Open="Open"
               OpenChanged="OpenChanged"
               Icon="@(_result is null ? "block" : "link_off")"
               IconTone="@(_result is null ? OdsModalTone.Error : OdsModalTone.Brand)"
               Title="@(_result is null ? "Unable to delete this contact" : "Contact deleted")"
               Subtitle="@(_result is null
                   ? BlockedSubtitle
                   : "The links and the contact were removed in one transaction.")"
               ShowCancel="@(_result is null)"
               SubmitLabel="@(_result is null ? "Detach links & delete" : "Done")"
               SubmitIcon="@(_result is null ? "link_off" : "check")"
               SubmitVariant="@(_result is null ? OdsButtonVariant.Danger : OdsButtonVariant.Filled)"
               ShowSubmit="@(_result is not null || CanDetach)"
               OnSubmit="SubmitAsync">

    @if (_result is { } result)
    {
        var destroyed = result.TotalLinks + result.ContractBeneficiaryLinks;
        <OdsAlert Severity="Severity.Info">
            <strong>@destroyed link@(destroyed == 1 ? "" : "s") detached</strong>
            @if (result.AffectedPolicyIds.Count > 0)
            {
                <text> across @result.AffectedPolicyIds.Count polic@(result.AffectedPolicyIds.Count == 1 ? "y" : "ies")</text>
            }
            @if (result.AffectedPolicyIds.Count > 0 && result.AffectedContractIds.Count > 0)
            {
                <text> and</text>
            }
            @if (result.AffectedContractIds.Count > 0)
            {
                <text> @result.AffectedContractIds.Count contract@(result.AffectedContractIds.Count == 1 ? "" : "s")</text>
            }, then the contact was deleted.
        </OdsAlert>

        <ul class="cpl-kinds">
            @foreach (var kind in result.Kinds)
            {
                <li>
                    <span class="material-icons" aria-hidden="true">@KindIcon(kind.Kind)</span>
                    <span class="cpl-kind-name">@KindLabel(kind.Kind)</span>
                    <span class="cpl-kind-count">@kind.Count</span>
                </li>
            }
            @if (result.ContractBeneficiaryLinks > 0)
            {
                <li>
                    <span class="material-icons" aria-hidden="true">handshake</span>
                    <span class="cpl-kind-name">Contract beneficiary</span>
                    <span class="cpl-kind-count">@result.ContractBeneficiaryLinks</span>
                </li>
            }
        </ul>

        <p class="cpl-note">
            The policies and contracts themselves are untouched — each stands with one fewer party.
        </p>
    }
    else
    {
        <OdsAlert Severity="Severity.Error">
            <strong>@ContactName</strong> holds @TotalBlockingLinks
            link@(TotalBlockingLinks == 1 ? "" : "s") that must be detached first.
        </OdsAlert>

        @* Which KINDS block, always — the counts are link rows, the same thing every other surface
           counts, and the part no claim withholds. *@
        <ul class="cpl-kinds">
            @foreach (var kind in Blockers.Kinds)
            {
                <li>
                    <span class="material-icons" aria-hidden="true">@KindIcon(kind.Kind)</span>
                    <span class="cpl-kind-name">@KindLabel(kind.Kind)</span>
                    <span class="cpl-kind-note">@KindNote(kind.Kind)</span>
                    <span class="cpl-kind-count">@kind.Count</span>
                </li>
            }
            @if (BlockedByContracts)
            {
                <li>
                    <span class="material-icons" aria-hidden="true">handshake</span>
                    <span class="cpl-kind-name">Contract beneficiary</span>
                    <span class="cpl-kind-note">receives under the agreement</span>
                    <span class="cpl-kind-count">@ContractBeneficiaries.TotalLinks</span>
                </li>
            }
        </ul>

        @if (BlockedByInsurance && Blockers.Policies.Count > 0)
        {
            <OdsSectionDivider Label="Blocking policies"
                               Meta="@($"{Blockers.Policies.Count} record{(Blockers.Policies.Count == 1 ? "" : "s")}")"
                               HeadingLevel="0" />
            @* A list of records, marked up as one — same as the .cpl-kinds block above. Reading as
               a list visually while being a run of divs programmatically is exactly the 1.3.1 gap. *@
            <ul class="cpl-policies">
                @foreach (var policy in Blockers.Policies)
                {
                    <li class="cpl-policy">
                        <span class="material-icons" aria-hidden="true">shield</span>
                        <span class="cpl-policy-name">@policy.Name</span>
                        <span class="cpl-policy-kinds">@string.Join(" · ", policy.Kinds.Select(KindLabel))</span>
                    </li>
                }
            </ul>
        }
        else if (BlockedByInsurance)
        {
            @* The server withheld the identifiers because the caller cannot read insurance records.
               Saying so beats rendering an empty list that reads as "no policies". *@
            <p class="cpl-note">
                Which policies these are is not shown, because you do not have access to insurance
                records. Ask someone who can edit them to detach the links.
            </p>
        }

        @if (BlockedByContracts && ContractBeneficiaries.Contracts.Count > 0)
        {
            <OdsSectionDivider Label="Blocking contracts"
                               Meta="@($"{ContractBeneficiaries.ContractCount} record{(ContractBeneficiaries.ContractCount == 1 ? "" : "s")}")"
                               HeadingLevel="0" />
            <ul class="cpl-policies">
                @foreach (var contract in ContractBeneficiaries.Contracts)
                {
                    <li class="cpl-policy">
                        <span class="material-icons" aria-hidden="true">handshake</span>
                        <span class="cpl-policy-name">@contract.ContractName</span>
                        <span class="cpl-policy-kinds">Beneficiary</span>
                    </li>
                }
            </ul>
        }
        else if (BlockedByContracts)
        {
            @* Same boundary, one claim over. The COUNT above is what the detach actually needs, so
               the absence of names costs the user nothing but is stated rather than implied. *@
            <p class="cpl-note">
                Which contracts these are is not shown, because you do not have access to contract
                records. The count is what the detach needs.
            </p>
        }

        @if (CanDetach)
        {
            <p class="cpl-note">
                <strong>Detach links &amp; delete</strong> removes all @TotalBlockingLinks
                link@(TotalBlockingLinks == 1 ? "" : "s") and the contact in one transaction — either
                all of it happens, or none of it does. The records survive with one fewer party.
                This cannot be undone.
            </p>
        }
        else
        {
            <OdsAlert Severity="Severity.Warning">
                Detaching needs permission to @string.Join(" and ", MissingCapabilities), which you do
                not have. Ask someone who does, then delete the contact.
            </OdsAlert>
        }
    }
</OdsFormDialog>
