@using Odyssey.Client.Components
@using Odyssey.Client.Services
@using Odyssey.Dtos.Finance
@inject IClipboardService Clipboard
@inject NavigationManager Navigation

@*
    InsurancePolicyLinkTiles — the read display of ONE of a policy's four link collections
    (Odyssey Design System · Insurance "Parties" section).

    One tile PER MEMBER, so every linked record reads as its own card with its own type glyph,
    colour, name and type caption — a referenced record points elsewhere, so it reads as that record
    rather than as a line in a list. Empty collections render nothing at all: zero members is a
    healthy state, including zero insurers.

    A member whose ROLE TERM differs from the default (in the role for the whole policy) carries that
    term on its own small line under the label — the term is the party's own fact, so a renewal never
    rewrites it, and keeping it out of the caption leaves the type on one line where a long range
    would have wrapped it.

    An UNNAMED member (archived, or no longer resolvable) shows the STATE WORD where its name would
    be — the read model carries the id and the type, never the name — with no type caption at all
    when the link is unresolvable, since there is no contact row to read a type from. Meaning never
    rides on the glyph alone. It also carries NO edit action: its record is not in the picker, so the
    dialog could not round-trip it — but it keeps Copy ID and Remove, because detaching an unnamed
    link is exactly the cleanup a reader most needs and its name being unreadable does not block it.

    Every member carries the same ⋯ menu the contact-method tiles do, in the same corner at the same
    24px target, ALWAYS VISIBLE rather than hover-revealed: a menu that appears only on hover is
    invisible to a touch user and to anyone reading the grid without a pointer.

    Past five members the collection collapses into a "+N more" tile that expands in place, so a
    collection at the cap of 50 has a defined rendering.
*@

@if (Members.Count > 0)
{
    var shown = _expanded ? Members : Members.Take(TileLimit).ToList();
    var hidden = Members.Count - shown.Count;

    @* Label is the collection's SINGULAR name, repeated per member — no position and no count: the
       tiles themselves are the count, and the caption slot keeps the type, which is where the
       record's meaning lives in text. *@
    @* @key is load-bearing, not tidiness: a removal shrinks this list in place, and without an
       identity Blazor diffs the survivors POSITIONALLY — it would keep the focused tile's DOM node
       and re-point it at the NEXT member's data, so a menu a keyboard user is sitting on silently
       starts describing a different party under the same focus (WCAG 4.1.2). *@
    @foreach (var member in shown)
    {
        var m = member;
        <OdsInfoTile @key="m.Key"
                     Icon="@(m.Unnamed ? UnnamedIcon(m) : (m.Icon ?? FallbackIcon))"
                     IconColor="@(m.Unnamed ? null : m.IconColor)"
                     IconSoft="@(m.Unnamed ? null : m.IconSoft)"
                     LabelContent="@LabelFor(m)"
                     ValueVariant="OdsInfoTileVariant.Text"
                     WrapValue="true"
                     Tone="@(m.Unnamed ? OdsInfoTileTone.Muted : OdsInfoTileTone.Default)"
                     Foot="@OdsInfoTile.Caption(m.TypeLabel)">
            <Value>@m.Display</Value>
        </OdsInfoTile>
    }

    @if (hidden > 0)
    {
        <OdsInfoTile Icon="more_horiz" Label="@Label" ValueVariant="OdsInfoTileVariant.Text"
                     Tone="OdsInfoTileTone.Muted"
                     Foot="@OdsInfoTile.Caption($"{Members.Count} in total")">
            <Value>
                <button type="button" class="ins-linkmore" @onclick="@(() => _expanded = true)">
                    +@hidden more
                </button>
            </Value>
        </OdsInfoTile>
    }
}

@code {
    /// <summary>
    /// The overline: the collection's singular name, plus the member's term when it has one, plus the
    /// tile's own ⋯ menu. The term goes on its OWN line rather than into the caption so the type
    /// stays one line and a long range never wraps it.
    /// </summary>
    private RenderFragment LabelFor(LinkTileMember member) =>
        @<text>
            @Label
            @if (!string.IsNullOrEmpty(member.Term))
            {
                <span class="ins-term">@member.Term</span>
            }
            @if (MenuFor(member) is { Count: > 0 } items)
            {
                @* The id is the focus anchor a removal lands on — see FocusAfterRemovalAsync. It goes on
                   the wrapper rather than the trigger so OdsMenu needs no new parameter. *@
                <span class="ins-tile-menu" id="@PartyMenuId(member)">
                    <OdsMenu Items="items" AriaLabel="@($"Actions for {Label?.ToLowerInvariant()} {member.Display}")" />
                </span>
            }
        </text>;
}
