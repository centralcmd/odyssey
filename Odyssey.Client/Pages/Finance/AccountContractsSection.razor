@using Odyssey.Dtos.Finance
@inject IAccountsApiClient Accounts
@inject ISnackbar Snackbar

@*
    AccountContractsSection — the "Contracts" section inside an expanded account record: every
    contract naming this account as a party (GET /api/accounts/{id}/contracts), drawn by the shared
    ContractLinkTiles.

    The host's OdsRecordSection owns the divider, the count and the empty line, so this renders the
    tile grid alone.
*@

@if (_isLoading)
{
    <div role="status" aria-live="polite" aria-busy="true">
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-hidden="true" />
        <span class="sr-only">Loading contracts…</span>
    </div>
}
else
{
    <ContractLinkTiles Links="_contracts" />
}
