@*
    The contact-methods section of an expanded contact card (Odyssey Design System · Contacts
    ContactList, bare). The interactive collections — addresses / emails / phones — as a tile grid.
    Address/Email/Phone CRUD + "set as primary" use their own sub-resource endpoints (§3).

    The record's own FIELDS are not here: the card renders them as ContactInfoTiles in its details
    grid, and its notes as a wide content tile. The section heading is the card's own
    OdsSectionDivider, so this component renders bare — one heading, not two.
*@
@using Odyssey.Dtos
@using Odyssey.Dtos.Finance
@inject IClipboardService Clipboard
@inject IContactsApiClient Contacts
@inject ISnackbar Snackbar

<div class="cp-contact-wrap">
    @if (_total == 0)
    {
        <div class="cp-empty-row">
            @(CanEdit && !IsArchived
                ? "No contact details yet — use the ⋯ menu to add an address, email, or phone number."
                : "No contact details.")
        </div>
    }
    else
    {
        <div class="cp-tile-grid">
            @foreach (var t in Tiles)
            {
                <div class="cp-tile" style="grid-column:@t.GridColumn;" title="@t.Value">
                    <span class="cp-tile-menu">
                        <OdsMenu Items="TileMenu(t)" AriaLabel="@($"Actions for {t.KindTitle}: {t.Value}")" />
                    </span>
                    <div class="cp-tile-top">
                        <span class="cp-tile-ic" style="background:@t.Soft;color:@t.Fg;">
                            <span class="material-icons" aria-hidden="true" style="font-size:16px;">@t.Icon</span>
                        </span>
                        <span class="cp-tile-kind">@t.KindTitle</span>
                    </div>
                    <div class="cp-tile-value" style="color:@t.Fg;">@t.Value</div>
                    <div class="cp-tile-foot">
                        <span>@t.Label</span>
                        @if (t.IsPrimary)
                        {
                            <span class="cp-tile-sep">·</span>
                            <span class="cp-tile-primary">Primary</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_dialogOpen)
{
    <ContactMethodDialog @bind-Open="_dialogOpen"
                               Kind="@_dialogKind"
                               Draft="_dialogDraft"
                               IsEdit="_dialogIsEdit"
                               IsFirst="_dialogIsFirst"
                               ContactType="Contact.Type"
                               OnCommit="CommitContact" />
}
