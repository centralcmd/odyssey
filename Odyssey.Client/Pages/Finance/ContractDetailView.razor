@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@inject IDialogService DialogService
@inject IContractsApiClient Contracts
@inject ISnackbar Snackbar

@*
    ContractDetailView — the SECTIONS of an expanded contract record (issue #174): the parties (one
    InfoTile per typed link — Account / Contact, the minimal projection) and the documents. Mirrors
    the design system's ContractDetail.

    A party tile is the same shape a policy's Parties section uses, so the two surfaces read alike:
    the referenced record's own icon and colour, the kind as the overline, the target's own type as
    the caption, and the detach action riding on the tile, revealed on hover / focus-within.

    The contract's fact tiles and description are NOT here: they belong to the record card's Details
    and Content slots, whose order the card fixes, and ContractsCard renders them there. What is left
    is what the body's last slot is for — the sub-collections, each introduced by an
    OdsSectionDivider, in the same order as the header's counts.

    Sections do not collapse and carry no action slot: the body already opens as a whole, and every
    section-level action ("New party", "Upload document") lives in the row action menu, where a reader
    looks for actions on this record. A section header labels; it does not act.
*@

<div class="con-section">
    <OdsSectionDivider Label="Parties" Meta="@($"{Contract.Parties.Count} linked")" />
    @if (Contract.Parties.Count > 0)
    {
        <OdsInfoTileGrid>
            @foreach (var party in Contract.Parties)
            {
                var p = party;
                var r = Resolve(p);
                <div class="con-party-tile">
                    @* A referenced record is drawn in ITS OWN type icon and colour — the same mark it
                       carries on its own page — so it stays recognisable as that record rather than
                       as part of this one. *@
                    <OdsInfoTile Icon="@r.Icon" IconColor="@r.Color" IconSoft="@r.Soft"
                                 Label="@r.KindLabel" ValueVariant="OdsInfoTileVariant.Text" WrapValue
                                 Value="@(b => b.AddContent(0, r.Name))"
                                 Foot="@OdsInfoTile.Caption(r.TypeLabel)" />
                    @if (CanWrite)
                    {
                        <span class="con-party-detach">
                            <OdsIconButton Icon="@Icons.Material.Filled.LinkOff" AriaLabel="@($"Detach {r.Name}")" Size="OdsSize.Sm" OnClick="@(() => DetachPartyAsync(p))" />
                        </span>
                    }
                </div>
            }
        </OdsInfoTileGrid>
    }
    else
    {
        <div class="con-empty-line">
            <span class="material-icons" aria-hidden="true">diversity_3</span>
            <div style="flex:1;">No parties yet — link the account or contact this contract relates to.</div>
        </div>
    }
</div>

<div class="con-section">
    <OdsSectionDivider Label="Documents" Meta="@($"{Contract.Files.Count} file{(Contract.Files.Count == 1 ? "" : "s")}")" />
    <div class="con-files con-tbl-frame">
        <ContractFilesTable ContractId="Contract.ContractId"
                            Files="@ContractFiles"
                            CanDownload="CanDownload" CanDelete="CanWrite"
                            OnChanged="OnChanged"
                            Empty="_emptyDocs" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ExistingContract Contract { get; set; } = default!;

    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public bool CanDownload { get; set; }

    /// <summary>Raised after a party detach or file detach so the host re-fetches the contract.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<ContractFileItem> ContractFiles => [.. Contract.Files.Select(ContractFileItem.From)];

    private readonly RenderFragment _emptyDocs =
        @<div class="con-empty-line"><span class="material-icons" aria-hidden="true">folder_open</span><div style="flex:1;">No documents yet — upload the signed agreement, an amendment, or correspondence.</div></div>;

    private sealed record PartyVisual(string KindLabel, string Name, string? TypeLabel, string Icon, string? Color, string? Soft);

    private static PartyVisual Resolve(ExistingContractParty party)
    {
        switch (party.Kind)
        {
            case ContractPartyKind.Account when party.Account is { } a:
            {
                return new PartyVisual("Account", a.Name, AccountTypeVisuals.Label(a.Type),
                    AccountTypeVisuals.MaterialIcon(a.Type), AccountTypeVisuals.FgColor(a.Type), AccountTypeVisuals.BgColor(a.Type));
            }
            // The DTO member is still named Institution — it is a serialized enum value, so renaming it
            // would de-authorize nothing but would break every stored and in-flight payload. The design
            // renamed what the reader sees, which is all that changed here.
            case ContractPartyKind.Institution when party.Institution is { } c:
            {
                var m = OdsTypeRegistries.ContactTypeOf(c.Type.ToString());
                return new PartyVisual("Contact", c.Name, m.Label, m.Icon, m.Color, m.Soft);
            }
            default:
                return new PartyVisual("Party", "—", null, "help", null, null);
        }
    }

    private async Task DetachPartyAsync(ExistingContractParty party)
    {
        if (!CanWrite) return;
        var r = Resolve(party);
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Detach party",
            $"Detach '{r.Name}' from this contract? The {r.KindLabel.ToLowerInvariant()} itself is not affected.",
            yesText: "Detach", cancelText: "Cancel");

        if (confirmed == true
            && (await Contracts.RemovePartyAsync(Contract.ContractId, party.ContractPartyId)).Toast(Snackbar, "Detach failed", "Party detached."))
        {
            await OnChanged.InvokeAsync();
        }
    }
}
