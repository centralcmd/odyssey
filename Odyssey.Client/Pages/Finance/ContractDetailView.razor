@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@inject IDialogService DialogService
@inject IContractsApiClient Contracts
@inject ISnackbar Snackbar

@*
    ContractDetailView — the SECTIONS of an expanded contract record (issue #174, #121): the parties
    (one InfoTile per typed link — Account / Contact, the minimal projection) and the documents.
    Mirrors the design system's ContractDetail.

    A party tile is the same shape a policy's Parties section uses, so the two surfaces read alike.
    What the ROLE feature changes is the overline: it now names what the record DOES in the agreement,
    with the kind and the record's own type demoted to the caption — "who is the employer and who is
    the employee" is the question this section answers, and the kind was never the answer to it. Under
    the role sits the TERM, but only when it is not simply the contract's own extent (both dates null,
    which is the DEFAULT term and needs no line). A party whose term has closed is drawn quieter: still
    a party of record, no longer in the role.

    Every tile carries the ⋯ menu, ALWAYS VISIBLE rather than hover-revealed — a menu that appears only
    on hover is invisible to a touch user and to anyone reading the grid without a pointer, which is
    what the old detach icon was.

    The contract's fact tiles and description are NOT here: they belong to the record card's Details
    and Content slots, whose order the card fixes, and ContractsCard renders them there. What is left
    is what the body's last slot is for — the sub-collections, each introduced by an
    OdsSectionDivider, in the same order as the header's counts.

    Sections do not collapse and carry no action slot: the body already opens as a whole, and every
    section-level action ("New party", "Upload document") lives in the row action menu, where a reader
    looks for actions on this record. A section header labels; it does not act.
*@

<div class="con-section">
    <OdsSectionDivider Label="Parties" Meta="@($"{Contract.Parties.Count} linked")" />
    @if (Contract.Parties.Count > 0)
    {
        <OdsInfoTileGrid>
            @* @key is load-bearing, not tidiness: a detach shrinks this list in place, and without an
               identity Blazor diffs the survivors POSITIONALLY — it would keep the focused tile's DOM
               node and re-point it at the NEXT party's data, so a menu a keyboard user is sitting on
               silently starts describing a different party under the same focus (WCAG 4.1.2). *@
            @foreach (var party in Contract.Parties)
            {
                var p = party;
                var r = Resolve(p);
                <div class="con-party-tile" @key="p.ContractPartyId">
                    @* A referenced record is drawn in ITS OWN type icon and colour — the same mark it
                       carries on its own page — so it stays recognisable as that record rather than
                       as part of this one. *@
                    <OdsInfoTile Icon="@r.Icon" IconColor="@r.Color" IconSoft="@r.Soft"
                                 LabelContent="@LabelFor(p, r)"
                                 ValueVariant="OdsInfoTileVariant.Text" WrapValue
                                 Tone="@(IsPast(p) ? OdsInfoTileTone.Muted : OdsInfoTileTone.Default)"
                                 Value="@(b => b.AddContent(0, r.Name))"
                                 Foot="@OdsInfoTile.Caption(r.Caption)" />
                </div>
            }
        </OdsInfoTileGrid>
    }
    else
    {
        <div class="con-empty-line" id="con-parties-empty" tabindex="-1">
            <span class="material-icons" aria-hidden="true">diversity_3</span>
            <div style="flex:1;">No parties yet — link the account or contact this contract relates to, and say what it does in the agreement.</div>
        </div>
    }
</div>

<div class="con-section">
    <OdsSectionDivider Label="Documents" Meta="@($"{Contract.Files.Count} file{(Contract.Files.Count == 1 ? "" : "s")}")" />
    <div class="con-files con-tbl-frame">
        <ContractFilesTable ContractId="Contract.ContractId"
                            Files="@ContractFiles"
                            CanDownload="CanDownload" CanDelete="CanWrite"
                            OnChanged="OnChanged"
                            Empty="_emptyDocs" />
    </div>
</div>

@code {
    // Razor syntax (@<div>), so these inline render fragments cannot live in the code-behind.
    // Everything else does.
    private readonly RenderFragment _emptyDocs =
        @<div class="con-empty-line"><span class="material-icons" aria-hidden="true">folder_open</span><div style="flex:1;">No documents yet — upload the signed agreement, an amendment, or correspondence.</div></div>;

    /// <summary>
    /// The overline: the party's ROLE, the non-default term on its own line beneath, and the tile's
    /// own ⋯ menu. The term goes on its own line rather than into the caption so the type stays one
    /// line and a long range never wraps it.
    /// </summary>
    private RenderFragment LabelFor(ExistingContractParty party, PartyVisual visual) =>
        @<text>
            @* `plain` is an ABSENCE, not a category: an unstated or unrecognised role is drawn
               quieter and never confusable with the deliberate "Other". Both are still TEXT — the
               state never rides on colour alone. *@
            <span class="con-role@(PartyRoleLabel.IsNamed(party.Role) ? "" : " unset")">
                <span>@PartyRoleLabel.For(party.Role)</span>
            </span>
            @if (PartyTerm.Format(party.FromDate, party.ToDate) is { } term)
            {
                <span class="con-term@(IsPast(party) ? " past" : "")">
                    @term
                    @if (IsPast(party))
                    {
                        @* The strike-through and the tile's muted tone are PRESENTATION: the term text
                           reads identically whether it has closed or is still running, so without this
                           a screen-reader user hears no difference between a party still in the role
                           and one that left it (WCAG 1.3.1 / 1.4.1, both Level A). The word matches
                           the "Past" that InsuranceRenewalHistory's status pill already renders. *@
                        <span class="sr-only"> (ended)</span>
                    }
                </span>
            }
            @if (MenuFor(party, visual) is { Count: > 0 } items)
            {
                @* The id is the focus anchor a detach lands on — see the shared TileRemovalFocus. It
                   goes on the wrapper rather than the trigger so OdsMenu needs no new parameter. *@
                <span class="con-tile-menu" id="@PartyMenuIdFor(party.ContractPartyId.ToString())">
                    <OdsMenu Items="items" AriaLabel="@($"Actions for {PartyRoleLabel.For(party.Role)} {visual.Name}")" />
                </span>
            }
        </text>;
}
