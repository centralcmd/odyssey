@using Odyssey.Dtos.Finance
@inject IDialogService DialogService
@inject IContractsApiClient Contracts
@inject ISnackbar Snackbar

@*
    ContractTermsSection — the "Terms" sections inside an expanded contract record (issue #135),
    between Parties and Documents.

    A contract records WHAT was agreed; a term records what it COSTS, with a dated history rather than
    a single current number. These are the same Term rows, in the same table, under the same domain
    rules as an account's rate & fee history — only the owner differs. So the surface reuses the
    account treatment: the values in force as the record's own tiles, then the editable history
    through the shared TermHistoryTable. What it drops is the hero rate chart: an agreement's price is
    usually an amount, not a rate.

    Two sections, not one with sub-headings: what the contract costs TODAY and how it got there are
    separate questions, and they sit at the same level as Parties and Documents. Sections carry no
    action slot — every section-level action lives in the record's row action menu, which is where a
    reader looks for actions on this record — so "New term" is passed in from the host.

    Three things are contract-specific, and each is drawn rather than assumed:
      • Kind eligibility — Fee and InterestRate on every ContractType; ExpectedReturn is refused.
        Handled in the dialog.
      • Archiving changes NOTHING here: an archived contract still records and edits terms, and keeps
        its per-row controls. Archival hides a contract from the default list; the final rent or the
        closing fee is exactly what gets recorded after an agreement has ended.
      • A per-contract cap (ContractMaxTermsPerContract) — the only thing that refuses a term write.
        It is a system setting the client deliberately does not hold a copy of — see the note on the
        cap in the code-behind.
*@

<div class="con-section">
    <OdsSectionDivider Label="@CurrentLabel" Meta="@CurrentMeta" />

    @if (_isLoading)
    {
        <div role="status" aria-live="polite" aria-busy="true">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-hidden="true" />
            <span class="sr-only">Loading terms…</span>
        </div>
    }
    else if (_terms.Count == 0)
    {
        <OdsEmptyLine>No terms yet — record what this agreement costs: a rent, a service fee, an interest rate. Each keeps its own dated history.</OdsEmptyLine>
    }
    else if (_current.Count == 0)
    {
        @* Every entry is dated ahead: a real state, and not the same one as "nothing recorded". *@
        <OdsEmptyLine>Nothing in force today — every entry on this contract is scheduled for a later date.</OdsEmptyLine>
    }
    else
    {
        <OdsInfoTileGrid>
            @foreach (var t in _current)
            {
                var term = t;
                var info = TermKindVisuals.Info(term.TermKind);
                @* The cadence is what separates a 2,150 monthly rent from a 2,150 one-off, so it
                   rides in the foot beside the date. From the one helper every surface reads. *@
                var cadence = TermKindVisuals.CadenceText(term);
                var labelled = TermKindVisuals.IsLabelled(term);
                <OdsInfoTile @key="term.TermId"
                             Icon="@info.Icon" IconColor="@info.Color" IconSoft="@info.Soft"
                             Label="@TermKindVisuals.DisplayName(term, null)"
                             ValueVariant="OdsInfoTileVariant.Text"
                             Foot="@OdsInfoTile.Caption(TileFoot(term, labelled, cadence))">
                    <Value>
                        <span style="color:@info.Color;">@TermKindVisuals.FormatValue(term, FormatMoney)</span>
                    </Value>
                </OdsInfoTile>
            }
        </OdsInfoTileGrid>
    }
</div>

@if (_terms.Count > 0)
{
    <div class="con-section">
        <OdsSectionDivider Label="Term history" Meta="@($"{_terms.Count} {(_terms.Count == 1 ? "entry" : "entries")}")" />
        <div class="con-tbl-frame">
            <TermHistoryTable Terms="_terms"
                              CurrentIds="_currentIds"
                              Account="null"
                              FormatMoney="FormatMoney"
                              CanWrite="CanWrite"
                              OnEdit="OpenEdit"
                              OnDelete="DeleteAsync" />
        </div>
    </div>
}

@if (_dialogKey != Guid.Empty)
{
    <AddTermDialog @key="_dialogKey"
                   @bind-Open="_dialogOpen"
                   Contract="Contract"
                   Term="_editingTerm"
                   Existing="_terms"
                   OnSaved="OnTermChanged" />
}
