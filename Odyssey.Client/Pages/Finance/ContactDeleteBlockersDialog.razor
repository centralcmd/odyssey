@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance

@*
    ContactDeleteBlockersDialog — the blocked contact delete (409) and its detach path
    (Odyssey Design System · ContactLinksBlockedModal).

    A contact named as a BENEFICIARY on any contract (the contract party-role matrix, issue #157)
    cannot be deleted by the ordinary route: the delete is refused, because a beneficiary designation
    vanishing silently on contact deletion would lose it without trace. RESTRICT alone is not an
    acceptable answer for a person exercising erasure, so this dialog also carries the supported
    release valve — detach every blocking link and delete the contact in ONE request, one transaction.

    Two things are claim-conditional and the dialog is honest about both:
      • The payload. Contract names need contracts.read. Without the claim the caller still gets the
        COUNT — enough to act, since the valve never asks you to name them. That decision is the
        server's: it simply sends no records, and the dialog says why the list is absent rather than
        rendering an empty one.
      • The action. Detaching needs contacts.delete plus contracts.update. Without it the button is
        unavailable with the reason stated, never a silent downgrade to the refused delete.

    Meaning never rides on a glyph: the blocking role is named in text alongside its row count.
*@

<OdsFormDialog Open="Open"
               OpenChanged="OpenChanged"
               Icon="@(_result is null ? "block" : "link_off")"
               IconTone="@(_result is null ? OdsModalTone.Error : OdsModalTone.Brand)"
               Title="@(_result is null ? "Unable to delete this contact" : "Contact deleted")"
               Subtitle="@(_result is null
                   ? "It is named as a beneficiary on contracts. Detach those links to delete it."
                   : "The links and the contact were removed in one transaction.")"
               ShowCancel="@(_result is null)"
               SubmitLabel="@(_result is null ? "Detach links & delete" : "Done")"
               SubmitIcon="@(_result is null ? "link_off" : "check")"
               SubmitVariant="@(_result is null ? OdsButtonVariant.Danger : OdsButtonVariant.Filled)"
               ShowSubmit="@(_result is not null || CanDetach)"
               OnSubmit="SubmitAsync">

    @if (_result is { } result)
    {
        <OdsAlert Severity="Severity.Info">
            <strong>@result.ContractBeneficiaryLinks link@(result.ContractBeneficiaryLinks == 1 ? "" : "s") detached</strong>
            @if (result.AffectedContractIds.Count > 0)
            {
                <text> across @result.AffectedContractIds.Count contract@(result.AffectedContractIds.Count == 1 ? "" : "s")</text>
            }, then the contact was deleted.
        </OdsAlert>

        <ul class="cpl-kinds">
            <li>
                <span class="material-icons" aria-hidden="true">handshake</span>
                <span class="cpl-kind-name">Contract beneficiary</span>
                <span class="cpl-kind-count">@result.ContractBeneficiaryLinks</span>
            </li>
        </ul>

        <p class="cpl-note">
            The contracts themselves are untouched — each stands with one fewer party.
        </p>
    }
    else
    {
        <OdsAlert Severity="Severity.Error">
            <strong>@ContactName</strong> holds @TotalBlockingLinks
            link@(TotalBlockingLinks == 1 ? "" : "s") that must be detached first.
        </OdsAlert>

        @* Which KIND blocks, always — the counts are link rows, the same thing every other surface
           counts, and the part no claim withholds. *@
        <ul class="cpl-kinds">
            <li>
                <span class="material-icons" aria-hidden="true">handshake</span>
                <span class="cpl-kind-name">Contract beneficiary</span>
                <span class="cpl-kind-note">receives under the agreement</span>
                <span class="cpl-kind-count">@ContractBeneficiaries.TotalLinks</span>
            </li>
        </ul>

        @if (ContractBeneficiaries.Contracts.Count > 0)
        {
            <OdsSectionDivider Label="Blocking contracts"
                               Meta="@($"{ContractBeneficiaries.ContractCount} record{(ContractBeneficiaries.ContractCount == 1 ? "" : "s")}")"
                               HeadingLevel="0" />
            @* A list of records, marked up as one — same as the .cpl-kinds block above. Reading as
               a list visually while being a run of divs programmatically is exactly the 1.3.1 gap. *@
            <ul class="cpl-policies">
                @foreach (var contract in ContractBeneficiaries.Contracts)
                {
                    <li class="cpl-policy">
                        <span class="material-icons" aria-hidden="true">handshake</span>
                        <span class="cpl-policy-name">@contract.ContractName</span>
                        <span class="cpl-policy-kinds">Beneficiary</span>
                    </li>
                }
            </ul>
        }
        else
        {
            @* The server withheld the identifiers because the caller cannot read contract records.
               Saying so beats rendering an empty list that reads as "no contracts". The COUNT above
               is what the detach actually needs, so the absence costs the user nothing. *@
            <p class="cpl-note">
                Which contracts these are is not shown, because you do not have access to contract
                records. The count is what the detach needs.
            </p>
        }

        @if (CanDetach)
        {
            <p class="cpl-note">
                <strong>Detach links &amp; delete</strong> removes all @TotalBlockingLinks
                link@(TotalBlockingLinks == 1 ? "" : "s") and the contact in one transaction — either
                all of it happens, or none of it does. The contracts survive with one fewer party.
                This cannot be undone.
            </p>
        }
        else
        {
            <OdsAlert Severity="Severity.Warning">
                Detaching needs permission to edit contracts, which you do not have. Ask someone who
                does, then delete the contact.
            </OdsAlert>
        }
    }
</OdsFormDialog>
