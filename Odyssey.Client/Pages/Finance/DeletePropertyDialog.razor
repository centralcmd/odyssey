@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@inject IPropertiesApiClient Properties

@*
    DeletePropertyDialog — the delete confirmation (issue #167; design system · Properties.jsx
    DeletePropertyModal). Deletion is hard and cascades the detail row, every estimate, every
    smart-tag link, the whole event log (issue #209), every document link (issue #210 — the files
    themselves stay in Files) AND every contract party link naming it (issue #208), in one
    transaction. Party links do not block the delete — each contract survives with one fewer party and
    records a "Party removed" event — so there is still no blocker to report, only a statement of what
    goes, and Archive as the reversible alternative.

    The party-link line is counted only for a contracts.read holder. Without it ContractCount is null
    and the line is stated without numbers — never as "none", which would be a claim about contracts
    the reader cannot see. The document line follows the same rule for a property whose Documents
    section never loaded (ExistingProperty carries no document count, issue #210 Non-Goal 4).
*@

<OdsModal Open="Open" OpenChanged="OpenChanged" OnClose="CloseAsync"
          Icon="delete" IconTone="OdsModalTone.Error" RequiredLegend="false"
          Title="@TitleFragment" Subtitle="@SubtitleFragment" Class="prop-del-dialog">
    <ChildContent>
        <div class="ods-modal-body">
            <ul class="prop-del-list">
                <li><span class="material-icons" aria-hidden="true">home_work</span>The property and its @(Property.Type == PropertyType.Vehicle ? "vehicle" : "real estate") details</li>
                @if (Property.EstimateCount is { } estimates)
                {
                    <li>
                        <span class="material-icons" aria-hidden="true">monitor</span>
                        @(estimates == 0 ? "No estimates" : $"{estimates} estimate{(estimates == 1 ? "" : "s")} — the whole value history")
                    </li>
                }
                else
                {
                    <li><span class="material-icons" aria-hidden="true">monitor</span>Its estimate history, if it has one</li>
                }
                <li>
                    <span class="material-icons" aria-hidden="true">sell</span>
                    @(Property.SmartTagCount == 0 ? "No smart tags" : $"{Property.SmartTagCount} smart-tag link{(Property.SmartTagCount == 1 ? "" : "s")}")
                </li>
                <li>
                    <span class="material-icons" aria-hidden="true">history</span>
                    @(Property.EventCount == 0 ? "No events" : $"{Property.EventCount} event{(Property.EventCount == 1 ? "" : "s")} — the whole log, including recorded ones")
                </li>
                <li>
                    <span class="material-icons" aria-hidden="true">attach_file</span>
                    @(DocumentCount switch
                    {
                        null => "Its document links, if it has any — the files stay in Files",
                        0 => "No documents",
                        1 => "1 document link — the file stays in Files",
                        var n => $"{n} document links — the files stay in Files",
                    })
                </li>
                <li>
                    <span class="material-icons" aria-hidden="true">link_off</span>
                    @* A status region: the line narrows from the contract count to the party count once
                       GET …/contracts returns, after the dialog may already have been read (WCAG 4.1.3). *@
                    <span role="status" aria-live="polite">@ContractLinksLine</span>
                </li>
            </ul>
            <p class="prop-del-foot">
                @if (MayDetachParties)
                {
                    @("Contracts are kept — each loses this party and records a “Party removed” event. ")
                }
                The transaction tags themselves and the transactions carrying them are not affected. Archiving
                keeps everything and hides the property from the default list.
            </p>
        </div>
    </ChildContent>
    <Footer>
        <OdsButton Variant="OdsButtonVariant.Text" OnClick="CloseAsync">Cancel</OdsButton>
        @if (CanArchive && Property.Archived is null)
        {
            <OdsButton Variant="OdsButtonVariant.Outlined" Icon="inventory_2" OnClick="ArchiveAsync">Archive instead</OdsButton>
        }
        <OdsButton Variant="OdsButtonVariant.Danger" Icon="delete_forever" Loading="_busy" OnClick="DeleteAsync">Delete property</OdsButton>
    </Footer>
</OdsModal>

@code {
    [Parameter, EditorRequired] public ExistingProperty Property { get; set; } = default!;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// The document count the Documents section last reported, or <c>null</c> when the property was never
    /// opened — ExistingProperty carries no count (issue #210 Non-Goal 4), so the line then goes unnumbered.
    /// </summary>
    [Parameter] public int? DocumentCount { get; set; }

    /// <summary>Offers "Archive instead" (<c>properties.update</c>).</summary>
    [Parameter] public bool CanArchive { get; set; }

    /// <summary>The host performs the delete; the dialog closes when it returns.</summary>
    [Parameter] public EventCallback OnDelete { get; set; }

    [Parameter] public EventCallback OnArchive { get; set; }

    /// <summary>
    /// Whether the caller holds <c>contracts.read</c>, which is what licenses counting the party links
    /// (the party count needs <c>GET /api/properties/{id}/contracts</c>; the contract count is
    /// <see cref="ExistingProperty.ContractCount"/>, already null without it).
    /// </summary>
    [Parameter] public bool CanReadContracts { get; set; }

    private bool _busy;

    /// <summary>Party rows naming the property, summed from the roles on each contract row; null until read.</summary>
    private int? _partyLinks;

    private int? ContractCount => CanReadContracts ? Property.ContractCount : null;

    protected override async Task OnInitializedAsync()
    {
        // Nothing to count when the count is withheld or zero. A failed read leaves the line stating
        // the contract count alone — this is a confirmation, not a place for an error toast.
        if (ContractCount is not > 0)
            return;

        var result = await Properties.ListContractsAsync(Property.PropertyId);
        if (result.IsSuccess && result.Value is { } rows)
            _partyLinks = rows.Sum(r => r.Roles.Count);
    }

    private string ContractLinksLine => ContractCount switch
    {
        null => "Any contract party links naming it",
        0 => "No contract party links",
        { } contracts when _partyLinks is { } parties =>
            $"{parties} party link{(parties == 1 ? "" : "s")} on {contracts} contract{(contracts == 1 ? "" : "s")}",
        { } contracts => $"Party links on {contracts} contract{(contracts == 1 ? "" : "s")}",
    };

    /// <summary>The "contracts are kept" sentence, unless the reader is known to have none to lose.</summary>
    private bool MayDetachParties => ContractCount is not 0;

    private RenderFragment TitleFragment => @<text>Delete @Property.Name?</text>;

    private RenderFragment SubtitleFragment => @<text>This can’t be undone.</text>;

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);

    private async Task DeleteAsync()
    {
        if (_busy)
            return;

        _busy = true;
        try
        {
            await OnDelete.InvokeAsync();
            await CloseAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ArchiveAsync()
    {
        await OnArchive.InvokeAsync();
        await CloseAsync();
    }
}
