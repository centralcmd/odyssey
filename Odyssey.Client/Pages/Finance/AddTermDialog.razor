@using System.Globalization
@using Odyssey.Dtos.Finance
@inject IReferenceDataCache ReferenceData
@inject ISnackbar Snackbar
@inject IContractsApiClient Contracts

@*
    AddTermDialog — New / Edit dialog for a term on a CONTRACT (its price history) — the only
    owner a term has since issue #190. Built on the shared OdsModal shell like every other create/edit dialog. The field
    set mirrors the NewTerm DTO and the TermService validation: the series name (required),
    percentage-or-amount value, currency (amount only), effective date, the two-part cadence
    and the anchor date, and a note. The owner is never in the body; it comes from the route.
    Rejects a (label, effectiveFrom) duplicate client-side on the SAME normalized,
    case-folded key the server writes — the shared TermLabel delegate, not a second
    implementation. The API still has the final say (400 / 409 surfaced as a toast).
*@

<OdsModal Open="Open" OpenChanged="OpenChanged" OnClose="CloseAsync"
          Icon="@(IsEdit ? "edit" : "§")"
          Title="@TitleFragment" Subtitle="@SubtitleFragment" Class="trm-dialog">
    <ChildContent>
        <div class="ods-modal-body">

            @* Name — the series label, required on every term, since two unnamed terms could not be
               told apart. It is the existing OdsField, so the label / helper / error / required
               semantics — and the aria-invalid wiring MudBlazor does from ErrorText — are the
               established ones; this introduces no new widget and no new ARIA contract. *@
            @* On a CONTRACT the name also decides whether this entry JOINS an existing price history
               or STARTS one, so the field suggests the names this contract already uses
               — a free-text combobox, never a constrained select: a new name is a first-class answer,
               and the help line names which of the two writes is about to happen. *@
            @{
                var labelError = _errors.TryGetValue("label", out var contractLabelErr) ? contractLabelErr : null;
                @* Help and error are mutually exclusive, as in AddContractPartyDialog: with no help
                   node the error takes the help line's id, which is what the combobox's
                   aria-describedby names — a help fragment left in place would push the error onto a
                   separate "-error" id nothing points at. *@
                <OdsFieldShell Label="Name" HtmlFor="trm-label" Required="true" Error="@labelError"
                               HelpContent="@(labelError is null ? NameHelp : null)">
                    <ChildContent>
                        <OdsCombobox InputId="trm-label" FreeText="true" Clearable="true"
                                     Value="@_label" ValueChanged="OnLabelChanged"
                                     Options="NameOptions"
                                     OnCreate="CreateNameOption" CreateLabel="New term"
                                     Placeholder="e.g. Monthly rent, Notice period"
                                     AriaDescribedBy="trm-label-help"
                                     Required="true" Error="@(labelError is not null)"
                                     EmptyText="@(NameOptions.Count > 0 ? "No matching term — type to name a new one" : "No terms yet — type a name")" />
                    </ChildContent>
                </OdsFieldShell>
            }

            @* Direction — which way the money moves, from the HOUSEHOLD's side, not from either
               named party's. It rides in the VALUE control itself, in the slot a sign would occupy:
               the record stores a direction, not a sign, so the word IS the sign. Both units carry
               the same lead, so there is exactly ONE control for the value whichever way it is
               priced — and a rate is asked the same way a fee is, because an arrears rate charges and
               a deposit rate pays. *@

            @* Kind — first, because it decides which fields exist below (issue #192). Percentage and
               Amount are priced; Text and DateTime record a fact. On the two fact kinds the direction,
               currency, cadence and first-billed date are not hidden-but-kept — they are NOT SENT: the
               server refuses each one rather than clearing it, so a kind change on edit nulls them
               here, and the line under the picker says so. *@
            <OdsFieldShell Label="Kind" Required="true" Class="trm-kind-seg">
                <ChildContent>
                    <OdsSegmentedControl Value="@_unit.ToString()" ValueChanged="OnUnitChanged"
                                         Options="_unitOptions" AriaLabel="Kind" Full="true" />
                </ChildContent>
            </OdsFieldShell>
            @if (KindSwitchNote is { } switchNote)
            {
                <div class="trm-kind-switch" role="status">@switchNote</div>
            }

            <div class="trm-value-block">
                @if (IsText)
                {
                    @* One plain line, counted AFTER the trim — the same count the server applies — so the
                       counter never says "fits" about a value the server would refuse. Tabs, line
                       breaks and bidi marks are refused inline, and no message repeats the text. *@
                    var textError = TextError;
                    <OdsFieldShell Label="Text" HtmlFor="trm-text" Required="true" Error="@textError"
                                   Help="@(textError is null ? "One line of plain text, as the contract words it." : null)">
                        <Aside>
                            <span class="@($"trm-text-count{(TrimmedTextLength > TermTextValue.MaxLength ? " over" : "")}")"
                                  aria-hidden="true">@TrimmedTextLength / @TermTextValue.MaxLength</span>
                        </Aside>
                        <ChildContent>
                            <input id="trm-text" class="odc-input" type="text"
                                   value="@_textValue"
                                   placeholder="e.g. 3 months, to the end of a month"
                                   aria-required="true"
                                   aria-invalid="@(textError is null ? null : "true")"
                                   aria-describedby="trm-text-help"
                                   @oninput="OnTextChanged" />
                        </ChildContent>
                    </OdsFieldShell>
                }
                else if (IsDateTime)
                {
                    @* The pickers read in the VIEWER's time zone; the offset in force at that instant is
                       stated, and so is the UTC value the entry will be saved as. The request always
                       carries a UTC instant, so the server's no-offset refusal cannot trigger. *@
                    <OdsFormRow Cols="2">
                        <OdsDatePicker Value="_dtDate" ValueChanged="OnDateTimeDateChanged"
                                       Label="Date" Required="true"
                                       HelperText="@DateTimeHelp"
                                       Error="@_errors.ContainsKey("dateTimeDate")"
                                       ErrorText="@(_errors.TryGetValue("dateTimeDate", out var dateErr) ? dateErr : null)" />
                        <OdsTimeField Value="_dtTime" ValueChanged="OnDateTimeTimeChanged"
                                      Label="Time" Required="true" Help="24-hour, in your time zone"
                                      Error="@(_errors.TryGetValue("dateTimeTime", out var timeErr) ? timeErr : null)" />
                    </OdsFormRow>
                }
                else
                {
                    <div class="trm-field-head">
                        <div class="trm-label" style="margin-bottom:0;">Value<span class="odc-field-req" aria-hidden="true">*</span></div>
                    </div>
                    @* A percentage has no currency, so it stays on OdsAmountField with a "%" suffix; a
                       flat amount is money, and money carries its code inside the control. *@
                    @if (IsPercentage)
                    {
                        @* The caption is the "Value" heading above — not a label
                           element — so the input carries its own accessible name. *@
                        @* A percentage term carries the same direction lead as an amount, so the two
                           units are one control with one unit swapped rather than two
                           differently-shaped questions. *@
                        @* No minus: the lead carries which way the money moves, so a typed minus would be
                           a second and contradictory encoding of the same fact — the defect this feature
                           exists to prevent. Note the consequence on EDIT: a pre-existing negative
                           percentage (a term moved from an account by issue #190 can carry one) loses its
                           minus on the next keystroke. That is a nudge toward the
                           invariant rather than away from it, and the server still accepts the stored
                           value untouched if nothing is typed. *@
                        <OdsAmountField Size="lg" Required="true" AllowNegative="false" Suffix="%"
                                        Value="@_valueStr" ValueChanged="OnValueChanged"
                                        Direction="@DirectionValue"
                                        DirectionChanged="OnDirectionChanged"
                                        DirectionOptions="DirectionLead"
                                        AriaLabel="Value"
                                        Error="@(_errors.TryGetValue("value", out var pctErr) ? pctErr : null)">
                            <HelpContent>
                                <text><b>@DirectionInfo.Label</b> — @DirectionInfo.Sentence. Click <b>@DirectionInfo.Short</b> to switch. </text>
                                <text>Stored as a fraction: <b>@PreviewFraction</b>@CadenceValueHint</text>
                            </HelpContent>
                        </OdsAmountField>
                    }
                    else
                    {
                        @* No SIGN affordance: a fee amount can't be negative (this dialog rejects it, and
                           so does the service), so a −/+ toggle would offer a state the form always
                           refuses. What the lead carries instead on a contract fee is the DIRECTION
                           (issue #159) — a different fact in the same slot, and the reason the amount can
                           stay positive while still saying which way the money moves. *@
                        @* An owner with a currency of its own lends it; a contract has none, so the
                           picker opens unset with a placeholder, the helper says WHY, and submitting
                           without an answer is refused inline. A silently-assigned currency would be
                           indistinguishable from a chosen one on the next read. *@
                        <OdsMoneyField Size="lg" Required="true" AllowNegative="false"
                                       Value="@_valueStr" ValueChanged="OnValueChanged"
                                       Direction="@DirectionValue"
                                       DirectionChanged="OnDirectionChanged"
                                       DirectionOptions="DirectionLead"
                                       Currency="@_currency" CurrencyChanged="OnCurrencyChanged"
                                       CurrencyOptions="_currencyOptions" CurrencySearchThreshold="0"
                                       CurrencyPlaceholder="@CurrencyPlaceholder"
                                       AriaLabel="Value"
                                       Error="@MoneyError">
                            <HelpContent>
                                @if (string.IsNullOrEmpty(_currency))
                                {
                                    <text>A contract has no currency of its own — <b>pick one</b> for this amount.</text>
                                    <text> The word on the left says which way the money moves.</text>
                                }
                                else
                                {
                                    @* The amount stays POSITIVE either way — the direction carries the
                                       sign, and a negative would make the sign mean two different things
                                       depending on who typed it. *@
                                    <text><b>@DirectionInfo.Label</b> — @DirectionInfo.Sentence. Flat amount in <b>@_currency</b>@CadenceValueHint Click <b>@DirectionInfo.Short</b> to switch@(IsEdit ? " — a correction supersedes the entry, it never forks the history" : "").</text>
                                }
                            </HelpContent>
                        </OdsMoneyField>
                    }
                }
            </div>

            @if (!IsNumeric)
            {
                <div class="trm-na-note">
                    <span class="material-icons" aria-hidden="true">info</span>
                    <span>@(IsText ? "A text term" : "A date-time term") records a fact, not a charge. It has no direction, currency or cadence, and it doesn’t count toward the contract’s run rate.</span>
                </div>
            }

            @* Effective date — the currency lives inside the money field (amount mode); a percentage
               has no currency, so nothing about it is shown here. *@
            <OdsFormRow Cols="1">
                <OdsDatePicker Value="_effectiveFrom" ValueChanged="OnEffectiveFromChanged"
                               Label="Effective from" Required="true" />
            </OdsFormRow>
            @if (_errors.TryGetValue("effectiveFrom", out var dateErr))
            {
                <div class="trm-err" style="margin-top:-6px;">@dateErr</div>
            }

            @* Cadence — the unit picker always; the count ONLY once the unit is periodic,
               so a "how many" question is never asked about a one-time or per-occurrence charge. The
               field is absent rather than disabled because the answer is not merely unknown there —
               it has no meaning, and the request writes null. Beneath them, the anchor date: when the
               term is first actually charged, which is a different fact from when its price took
               effect. *@
            @if (IsNumeric)
            {
                <div class="trm-cadence">
                    <OdsFormRow Cols="@(IsPeriodicInterval ? 2 : 1)">
                        @* The unit carries its own label, and the non-periodic branch's guidance
                           rides its Help slot rather than a loose sibling — MudSelect wires that
                           into aria-describedby, which a bare <div> beside the control is not. *@
                        <OdsSelect Label="Interval" Help="@IntervalHelp"
                                   Value="@_interval" ValueChanged="OnIntervalChanged" Options="_intervalOptions" />
                        @if (IsPeriodicInterval)
                        {
                            @* The echo below is named here, not left beside the field: it is what the
                               typed count MEANS, so a screen-reader user landing on this control has
                               to receive it the same way a sighted one sees it appear (WCAG 1.3.1).
                               AriaDescribedBy appends to the field's own help and unit ids. *@
                            <OdsNumberField Label="Every"
                                            Min="TermIntervalCount.Min" Max="TermIntervalCount.Max" Step="1"
                                            Unit="@IntervalUnitNoun" Placeholder="1"
                                            Value="_intervalCount" ValueChanged="OnIntervalCountChanged"
                                            Help="@IntervalCountHelp"
                                            AriaDescribedBy="@(ShowsCadenceEcho ? CadenceEchoId : null)"
                                            Error="@(_errors.TryGetValue("intervalCount", out var countErr) ? countErr : null)" />
                        }
                    </OdsFormRow>

                    @* The cadence echoed in words, from the one helper every surface reads — so what
                       the dialog promises and what the tile later shows cannot diverge. *@
                    @if (ShowsCadenceEcho)
                    {
                        <div class="trm-cadence-echo" id="@CadenceEchoId">Applies @CadenceEcho.</div>
                    }

                    <OdsDatePicker Value="_anchorDate" ValueChanged="OnAnchorDateChanged"
                                   Label="First billed on" Clearable="true"
                                   HelperText="When this is first actually charged, if that isn’t the effective date" />
                </div>
            }

            @* Note *@
            <OdsNoteField Label="Note" MaxLength="512"
                          Value="@_note" ValueChanged="OnNoteChanged"
                          Placeholder="What changed, and why — e.g. “Fed cut pass-through”."
                          Error="@(_errors.TryGetValue("note", out var noteErr) ? noteErr : null)" />
        </div>
    </ChildContent>
    <Footer>
        <OdsButton Variant="OdsButtonVariant.Text" OnClick="CloseAsync">Cancel</OdsButton>
        <OdsButton Variant="OdsButtonVariant.Filled" Icon="@(IsEdit ? "check" : "add")"
                   Loading="_isSaving" OnClick="SubmitAsync">
            @(IsEdit ? "Save changes" : "Create term")
        </OdsButton>
    </Footer>
</OdsModal>

@code {
    private RenderFragment TitleFragment => @<text>@(IsEdit ? "Edit term" : "New term")</text>;

    private RenderFragment SubtitleFragment => IsEdit
        ? @<text>Correct this entry in the contract’s term history.</text>
        : @<text>Record a price, a rate or a fact of @OwnerName, effective from a date.</text>;
}
