@using System.Globalization
@using Odyssey.Dtos.Finance
@inject IReferenceDataCache ReferenceData
@inject ISnackbar Snackbar
@inject IAccountsApiClient Accounts

@*
    AddTermDialog — New / Edit dialog for an account term (interest-rate & fee history),
    built on the shared OdsModal shell like every other create/edit dialog. The field set
    mirrors the NewTerm DTO and the TermService validation: eligibility-gated kind, the
    series name (required on a fee, refused on a rate), percentage-or-amount value,
    currency (amount only), effective date, the two-part cadence and the anchor date
    (fees only), and a note.
    Rejects a (kind, label, effectiveFrom) duplicate client-side on the SAME normalized,
    case-folded key the server writes — the shared TermLabel delegate, not a second
    implementation. The API still has the final say (400 / 409 surfaced as a toast).
*@

<OdsModal Open="Open" OpenChanged="OpenChanged" OnClose="CloseAsync"
          Icon="@(IsEdit ? "edit" : "§")"
          Title="@TitleFragment" Subtitle="@SubtitleFragment" Class="trm-dialog">
    <ChildContent>
        <div class="ods-modal-body">

            @* Term kind — eligibility-gated OdsCardSelect, each kind in its own hue (new) · locked
               tile (edit) · nothing at all when the account type leaves one eligible kind. Dropping a
               one-option card row removes a control, not information: the kind it would have selected
               is still written out on every tile and history row. *@
            @if (IsEdit || _eligibleKinds.Count > 1)
            {
            <div class="trm-field">
                <div class="trm-label" id="trm-kind-label">Term<span class="odc-field-req" aria-hidden="true">*</span></div>
                @if (IsEdit)
                {
                    var info = TermKindVisuals.Info(_kind);
                    <div class="trm-kind-opt on" style="cursor:default;">
                        <span class="trm-kind-ic md" style="background:@info.Soft;color:@info.Color;">
                            <span class="material-icons" style="font-size:18px;">@info.Icon</span>
                        </span>
                        <span class="trm-kind-opt-txt">
                            <span class="trm-kind-opt-name">@info.Label</span>
                            <span class="trm-kind-opt-grp">@(info.Group == TermGroup.Rate ? "Rate" : "Fee")</span>
                        </span>
                    </div>
                }
                else
                {
                    <OdsCardSelect AriaLabelledBy="trm-kind-label" Required="true" Value="@_kind.ToString()" ValueChanged="OnKindPicked"
                                   Options="KindOptions" />
                    @if (_eligibleKinds.Count < TermKindVisuals.All.Count)
                    {
                        <div class="trm-kind-ineligible">
                            Some kinds don’t apply to a <b>@AccountTypeVisuals.Label(Account.AccountType)</b> account and are hidden.
                        </div>
                    }
                }
                @if (_errors.TryGetValue("kind", out var kindErr))
                {
                    <div class="trm-err">@kindErr</div>
                }
            </div>
            }

            @* Name — the series label. Not rendered on a rate kind (the headline rate stays
               unambiguous); required on every fee, since with one fee kind two unnamed fees could not
               be told apart. It is the existing OdsField, so the label / helper / error / required
               semantics — and the aria-invalid wiring MudBlazor does from ErrorText — are the
               established ones; this introduces no new widget and no new ARIA contract. *@
            @if (TakesLabel)
            {
                <OdsField Label="Name" Required="true" MaxLength="TermLabelMaxLength"
                          Value="@_label" ValueChanged="OnLabelChanged"
                          Placeholder="e.g. ATM withdrawal · abroad"
                          Help="Names this fee so it keeps its own history, separate from the account’s other fees."
                          Error="@(_errors.TryGetValue("label", out var labelErr) ? labelErr : null)" />
            }

            @* Unit + value — the hero input *@
            <div class="trm-value-block">
                <div class="trm-field-head">
                    <div class="trm-label" style="margin-bottom:0;">Value<span class="odc-field-req" aria-hidden="true">*</span></div>
                    @if (!IsRate)
                    {
                        <div style="margin-left:auto;">
                            <OdsSegmentedControl Value="@_unit.ToString()" ValueChanged="OnUnitChanged"
                                                 Options="_unitOptions" AriaLabel="Unit" />
                        </div>
                    }
                </div>

                @* A rate has no currency, so it stays on OdsAmountField with a "%" suffix; a flat
                   amount is money, and money carries its code inside the control. *@
                @if (IsPercentage)
                {
                    @* The caption is the "Value" heading above, beside the unit toggle — not a label
                       element — so the input carries its own accessible name. *@
                    <OdsAmountField Size="lg" Required="true" AllowNegative="true" Suffix="%"
                                    Value="@_valueStr" ValueChanged="OnValueChanged"
                                    aria-label="Value"
                                    Error="@(_errors.TryGetValue("value", out var pctErr) ? pctErr : null)">
                        <HelpContent>
                            <text>Stored as a fraction: <b>@PreviewFraction</b>@(IsRate ? " · annual" : "")</text>
                        </HelpContent>
                    </OdsAmountField>
                }
                else
                {
                    @* No sign affordance here, which diverges from the DS's prop set on purpose: a fee
                       amount can't be negative (this dialog rejects it, and so does the service), so a
                       −/+ toggle would offer a state the form always refuses. The DS kit carries the
                       same contradiction — its own submit() rejects a negative fee. The rate branch
                       above keeps its sign, where a negative genuinely means something. *@
                    <OdsMoneyField Size="lg" Required="true" AllowNegative="false"
                                   Value="@_valueStr" ValueChanged="OnValueChanged"
                                   Currency="@_currency" CurrencyChanged="OnCurrencyChanged"
                                   CurrencyOptions="_currencyOptions" CurrencySearchThreshold="0"
                                   AriaLabel="Value"
                                   Error="@(_errors.TryGetValue("value", out var valErr) ? valErr : null)">
                        <HelpContent>
                            <text>Flat amount in <b>@_currency</b>@CadenceValueHint</text>
                        </HelpContent>
                    </OdsMoneyField>
                }
            </div>

            @* Effective date — the currency lives inside the money field (amount mode); a rate has no
               currency, so nothing about it is shown here. *@
            <OdsFormRow Cols="1">
                <OdsDatePicker Value="_effectiveFrom" ValueChanged="OnEffectiveFromChanged"
                               Label="Effective from" Required="true" />
            </OdsFormRow>
            @if (_errors.TryGetValue("effectiveFrom", out var dateErr))
            {
                <div class="trm-err" style="margin-top:-6px;">@dateErr</div>
            }

            @* Cadence — fees only. The unit picker always; the count ONLY once the unit is periodic,
               so a "how many" question is never asked about a one-time or per-occurrence charge. The
               field is absent rather than disabled because the answer is not merely unknown there —
               it has no meaning, and the request writes null. Beneath them, the anchor date: when the
               term is first actually charged, which is a different fact from when its price took
               effect. *@
            @if (!IsRate)
            {
                <div class="trm-cadence">
                    <OdsFormRow Cols="@(IsPeriodicInterval ? 2 : 1)">
                        @* The unit carries its own label, and the non-periodic branch's guidance
                           rides its Help slot rather than a loose sibling — MudSelect wires that
                           into aria-describedby, which a bare <div> beside the control is not. *@
                        <OdsSelect Label="Billing interval" Help="@IntervalHelp"
                                   Value="@_interval" ValueChanged="OnIntervalChanged" Options="_intervalOptions" />
                        @if (IsPeriodicInterval)
                        {
                            @* The echo below is named here, not left beside the field: it is what the
                               typed count MEANS, so a screen-reader user landing on this control has
                               to receive it the same way a sighted one sees it appear (WCAG 1.3.1).
                               AriaDescribedBy appends to the field's own help and unit ids. *@
                            <OdsNumberField Label="Every"
                                            Min="TermIntervalCount.Min" Max="TermIntervalCount.Max" Step="1"
                                            Unit="@IntervalUnitNoun" Placeholder="1"
                                            Value="_intervalCount" ValueChanged="OnIntervalCountChanged"
                                            Help="@IntervalCountHelp"
                                            AriaDescribedBy="@(ShowsCadenceEcho ? CadenceEchoId : null)"
                                            Error="@(_errors.TryGetValue("intervalCount", out var countErr) ? countErr : null)" />
                        }
                    </OdsFormRow>

                    @* The cadence echoed in words, from the one helper every surface reads — so what
                       the dialog promises and what the tile later shows cannot diverge. *@
                    @if (ShowsCadenceEcho)
                    {
                        <div class="trm-cadence-echo" id="@CadenceEchoId">Charged @CadenceEcho.</div>
                    }

                    <OdsDatePicker Value="_anchorDate" ValueChanged="OnAnchorDateChanged"
                                   Label="First billed on" Clearable="true"
                                   HelperText="When this is first actually charged, if that isn’t the effective date" />
                </div>
            }

            @* Note *@
            <OdsNoteField Label="Note" MaxLength="512"
                          Value="@_note" ValueChanged="OnNoteChanged"
                          Placeholder="What changed, and why — e.g. “Fed cut pass-through”."
                          Error="@(_errors.TryGetValue("note", out var noteErr) ? noteErr : null)" />
        </div>
    </ChildContent>
    <Footer>
        <OdsButton Variant="OdsButtonVariant.Text" OnClick="CloseAsync">Cancel</OdsButton>
        <OdsButton Variant="OdsButtonVariant.Filled" Icon="@(IsEdit ? "check" : "add")"
                   Loading="_isSaving" OnClick="SubmitAsync">
            @(IsEdit ? "Save changes" : "Create term")
        </OdsButton>
    </Footer>
</OdsModal>

@code {
    private RenderFragment TitleFragment => @<text>@(IsEdit ? "Edit term" : "New term")</text>;

    private RenderFragment SubtitleFragment => IsEdit
        ? @<text>Correct this rate or fee entry.</text>
        : @<text>Record a rate or fee on @Account.Name, effective from a date.</text>;
}
