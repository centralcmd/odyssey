@page "/tax-statements"
@using System.Globalization
@using Odyssey.Client.Authorization
@using Odyssey.Dtos.Finance
@attribute [Authorize(Policy = PermissionClaims.TaxesRead)]
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IClipboardService Clipboard
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IScrollManager ScrollManager
@inject Odyssey.Client.Services.IPageStateService PageState
@inject IReferenceDataCache ReferenceData
@inject ITaxStatementsApiClient TaxStatements

<PageTitle>Tax Statements</PageTitle>

<OdsLiveAnnouncer Message="@_announce" />

@{
    var cur = OverviewCurrency;
    var firstYear = FirstYear;
}

<div class="tax-shell">
<MudStack Spacing="4">

    <PageHeader Title="Tax Statements"
                Icon="@Icons.Material.Filled.RequestQuote"
                Problems="HeaderProblems"
                ProblemsLabel="Attention"
                ProblemsOpen="_problemsOpen" ProblemsOpenChanged="OnProblemsToggled"
                OverviewOpen="_overviewOpen" OverviewOpenChanged="OnOverviewToggled"
                SearchOpen="_searchOpen" SearchOpenChanged="OnSearchToggled"
                PrimaryActionText="New tax statement"
                OnPrimaryAction="AddClicked"
                ShowPrimaryAction="_canCreate">
        <SubLine>
            @ActiveCount year@(ActiveCount == 1 ? "" : "s") on file@(LatestFiscalYear is { } latest ? $" · latest assessment {latest}" : "")
        </SubLine>

        @* Year-over-year declared figures, reusing the design-system line chart. *@
        <OverviewContent>
            <div class="tx-overview">
                <OdsLineChart Title="Net worth" Sub="@($"By fiscal year · {cur}")"
                              Series="DeclaredSeries(y => y.DeclaredNetWorth)"
                              Color="var(--chart-1)"
                              Format="@(n => TaxMoney(n, cur))" AxisFormat="@(n => TaxAxis(n, cur))"
                              ShowDelta DeltaSuffix="@($"vs {firstYear}")"
                              EmptyLabel="No declared figures yet."
                              AriaLabel="Net worth by fiscal year" />
                <OdsLineChart Title="Assessed tax" Sub="@($"By fiscal year · {cur}")"
                              Series="DeclaredSeries(y => y.AssessedTax)"
                              Color="var(--chart-2)"
                              Format="@(n => TaxMoney(n, cur))" AxisFormat="@(n => TaxAxis(n, cur))"
                              ShowDelta DeltaSuffix="@($"vs {firstYear}")"
                              EmptyLabel="No declared figures yet."
                              AriaLabel="Assessed tax by fiscal year" />
                <OdsLineChart Title="Accumulated" Sub="@($"Assessed tax · all years · {cur}")"
                              Series="DeclaredSeries(y => y.AssessedTax)"
                              Color="var(--chart-4)" Cumulative
                              Format="@(n => TaxMoney(n, cur))" AxisFormat="@(n => TaxAxis(n, cur))"
                              EmptyLabel="No declared figures yet."
                              AriaLabel="Accumulated assessed tax by fiscal year" />
            </div>
        </OverviewContent>

        <SearchContent>
            <div class="ph-filter-bar">
                <OdsSearchField Value="@_searchString" ValueChanged="OnSearchChanged"
                                DebounceInterval="300" OnSearch="GetStatements"
                                Placeholder="Search year, name, currency, notes…"
                                Class="ph-search" />
                <OdsMultiSelect Label="Status" Values="_statusFilter" ValuesChanged="OnStatusFilterChanged"
                                Options="_statusOptions" Class="ph-select" />
                <OdsSortSelect TRow="ExistingTaxStatement" Fields="_sortFields" Sort="_sort" SortChanged="OnSortChanged" />
                <OdsPageSizeSelect Prefix="Load" Suffix="at a time" Label="Statements per batch"
                                   Value="_batch" ValueChanged="OnBatchChanged" Options="OdsPageSizes.Batch" />
            </div>
        </SearchContent>
    </PageHeader>

    <div class="acct-list">
        <OdsInfiniteList TItem="ExistingTaxStatement" Items="_statements" BatchSize="_batch"
                         ItemKey="@(s => (object)s.TaxStatementId)" Noun="tax statements" RevealKey="_flashId"
                         Loading="_isLoading" Refetching="_refetching" Error="_loadError" OnRetry="GetStatements"
                         HasFilters="_hasFilters" OnClearFilters="ClearFilters"
                         EmptyIcon="request_quote"
                         EmptyDescription="Add a fiscal year to record its declared figures and reconcile them against your Odyssey accounts and tagged transactions.">
            <RenderItem Context="s">
                @{
                    var isExpanded = IsExpanded(s.TaxStatementId);
                    var archived = s.Archived is not null;
                    var report = _reports.GetValueOrDefault(s.TaxStatementId);
                    var problems = _problems.GetValueOrDefault(s.TaxStatementId) ?? [];
                    var settle = SettlementFigure(s);
                    var tagCount = s.TaxTagIds.Count + s.IncomeTagIds.Count;
                    var period = $"{s.StartDate:MMM dd, yyyy} → {s.EndDate:MMM dd, yyyy}";
                    var settled = s.SettledAtUtc is not null;

                    @* The single meta line: period · base currency. *@
                    var meta = new List<RenderFragment?> { PeriodMeta(period), CurrencyMeta(s.BaseCurrencyCode) };

                    @* The header counts are the body's table of contents: same glyphs, same order as
                       the sections below. *@
                    var counts = new[]
                    {
                        new OdsRecordCount("local_offer", tagCount.ToString(CultureInfo.CurrentCulture), "Derivation tags"),
                        new OdsRecordCount("description", s.Files.Count.ToString(CultureInfo.CurrentCulture), "Documents"),
                    };
                }
                @* A tax statement has no TYPE field, so the accent is the page's own magenta hue —
                   the same mark the Tax file-type avatar carries — rather than derived state, which
                   stays with the status chip. *@
                <OdsRecordCard Id="@($"tax-{s.TaxStatementId}")"
                               Icon="request_quote"
                               Accent="var(--tax)"
                               AccentSoft="var(--tax-soft)"
                               Name="@s.Name"
                               Meta="meta"
                               Counts="counts"
                               FigureCaption="@SettlementWord(s, settle)"
                               FigureTone="@SettlementTone(settle)"
                               Dimmed="archived"
                               Highlight="@(_flashId == s.TaxStatementId)"
                               Open="isExpanded"
                               OnToggle="@(_ => ToggleExpand(s.TaxStatementId))">

                    <Chips>
                        <OdsChip Tone="@StatusTone(s)" Dot="@StatusDot(s)">@StatusLabel(s)</OdsChip>
                        @if (problems.Count > 0)
                        {
                            var top = problems.MaxBy(p => (int)p.Severity)!;
                            <span class="acct-flag @FlagClass(top.Severity)">
                                <span class="material-icons" aria-hidden="true">@FlagGlyph(top.Severity)</span>@(problems.Count == 1 ? problems[0].Chip : "Attention")
                            </span>
                        }
                    </Chips>

                    <Figure>@(settle is null ? "—" : TaxMoney(Math.Abs(settle.Value), s.BaseCurrencyCode))</Figure>

                    <Actions>
                        <OdsMenu Items="RowActions(s, archived)" AriaLabel="@($"Actions for {s.Name}")" />
                    </Actions>

                    <Alert>
                        @* Problems first — they are why the card was opened. The review-status note is
                           an alert too, so it sits with them above the details rather than between. *@
                        @foreach (var p in problems)
                        {
                            <OdsProblemAlert Severity="p.Severity" Title="@p.Title" Detail="@p.Detail"
                                             ActionLabel="@p.FixLabel" OnAction="@(() => GoTo(p.FixTarget))" />
                        }
                        @if (!string.IsNullOrWhiteSpace(s.StatusComment))
                        {
                            <OdsAlert Severity="@(s.Status == TaxStatementStatus.Flagged ? Severity.Warning : Severity.Info)">
                                <b>@StatusLabel(s).</b> @s.StatusComment
                            </OdsAlert>
                        }
                    </Alert>

                    <Details>
                        @* The statement's FULL field set, including the fields the collapsed header
                           already shows: at tile scale a value arrives with its own label, so the body
                           reads as the record rather than the remainder of one. A date that has not
                           happened yet renders no tile — except the settlement, whose absence is the
                           fact ("Not yet"). *@
                        <OdsInfoTileGrid>
                            <OdsInfoTile Icon="request_quote" Label="Name"
                                         ValueVariant="OdsInfoTileVariant.Text" WrapValue="true">
                                <Value>@s.Name</Value>
                            </OdsInfoTile>

                            <OdsInfoTile Icon="event_note" Label="Fiscal year">
                                <Value>@s.FiscalYear</Value>
                            </OdsInfoTile>

                            <OdsInfoTile Icon="payments" Label="Base currency" Foot="@Caption("reporting currency")">
                                <Value>@s.BaseCurrencyCode</Value>
                            </OdsInfoTile>

                            <OdsInfoTile Icon="date_range" Label="Period"
                                         ValueVariant="OdsInfoTileVariant.Sm" WrapValue="true">
                                <Value>@period</Value>
                            </OdsInfoTile>

                            @* A DERIVED summary of the review state: it carries the state and the date
                               it began, while the dates it derives from keep their own tiles. *@
                            <OdsInfoTile Icon="@StatusIcon(s)" Label="Status"
                                         ValueVariant="OdsInfoTileVariant.Text"
                                         Tone="@StatusTileTone(s)"
                                         Foot="@Caption(StatusFoot(s))">
                                <Value>@StatusLabel(s)</Value>
                            </OdsInfoTile>

                            @if (s.FiledAtUtc is { } filed)
                            {
                                <OdsInfoTile Icon="outbox" Label="Filed to authority" ValueVariant="OdsInfoTileVariant.Sm">
                                    <Value>@LongDate(filed)</Value>
                                </OdsInfoTile>
                            }

                            @if (s.TaxOfficeApprovedAtUtc is { } approved)
                            {
                                <OdsInfoTile Icon="verified" Label="Authority approved" ValueVariant="OdsInfoTileVariant.Sm">
                                    <Value>@LongDate(approved)</Value>
                                </OdsInfoTile>
                            }

                            @* Kept when empty on purpose: whether the year has been settled is the
                               question the page exists to answer, so "Not yet" is a fact, not a blank. *@
                            <OdsInfoTile Icon="@(settled ? "task_alt" : "schedule")" Label="Settlement paid"
                                         ValueVariant="@(settled ? OdsInfoTileVariant.Sm : OdsInfoTileVariant.Text)"
                                         Tone="@(settled ? OdsInfoTileTone.Income : OdsInfoTileTone.Pending)"
                                         Foot="@Caption(settled ? null : "outstanding")">
                                <Value>@(s.SettledAtUtc is { } paid ? LongDate(paid) : "Not yet")</Value>
                            </OdsInfoTile>
                        </OdsInfoTileGrid>
                    </Details>

                    <Content>
                        @* Prose is not a field: notes go in one wide tile, never a tile column. *@
                        @if (!string.IsNullOrWhiteSpace(s.Notes))
                        {
                            <OdsInfoTileGrid>
                                <OdsInfoTile Icon="sticky_note_2" Label="Notes" Wide="true">
                                    <Value>@s.Notes</Value>
                                </OdsInfoTile>
                            </OdsInfoTileGrid>
                        }
                    </Content>

                    <Sections>
                        @* Derivation tags — the two role wells, now InfoTiles whose foot carries the
                           caption and the tag chips. *@
                        <div class="tax-section">
                            <OdsSectionDivider Label="Derivation tags" Meta="@($"{tagCount} tag{(tagCount == 1 ? "" : "s")}")" />
                            <div class="tx-roles">
                                <OdsInfoTile Icon="request_quote" Label="Tax-payment tags" Class="tx-role">
                                    <Value>@TaxMoney(report?.Derived.PaidTax ?? 0, s.BaseCurrencyCode)</Value>
                                    <Foot>
                                        <span class="tx-role-cap">Advance tax paid</span>
                                        <span class="tx-role-tags">
                                            @if (s.TaxTagIds.Count > 0)
                                            {
                                                <span class="tx-chips">
                                                    @foreach (var name in TagNames(s.TaxTagIds))
                                                    {
                                                        <OdsChip Tone="OdsChipTone.Tag">@name</OdsChip>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tx-role-empty">No tax-payment tags selected — derived advance tax is @TaxMoney(0, s.BaseCurrencyCode).</span>
                                            }
                                        </span>
                                    </Foot>
                                </OdsInfoTile>
                                <OdsInfoTile Icon="payments" Label="Income tags" Class="tx-role">
                                    <Value>@TaxMoney(report?.Derived.ActualIncome ?? 0, s.BaseCurrencyCode)</Value>
                                    <Foot>
                                        <span class="tx-role-cap">Actual income</span>
                                        <span class="tx-role-tags">
                                            @if (s.IncomeTagIds.Count > 0)
                                            {
                                                <span class="tx-chips">
                                                    @foreach (var name in TagNames(s.IncomeTagIds))
                                                    {
                                                        <OdsChip Tone="OdsChipTone.Tag">@name</OdsChip>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tx-role-empty">No income tags selected — derived income is @TaxMoney(0, s.BaseCurrencyCode).</span>
                                            }
                                        </span>
                                    </Foot>
                                </OdsInfoTile>
                            </div>
                        </div>

                        @* Reconciliation report — declared vs. derived vs. variance. *@
                        @if (report is not null)
                        {
                            <div class="tax-section">
                                <OdsSectionDivider Label="Reconciliation" Meta="@($"declared vs. recorded · {s.BaseCurrencyCode}")" />
                                <TaxReconciliation Statement="s" Report="report" Money="@(n => TaxMoney(n, s.BaseCurrencyCode))" />
                            </div>
                        }

                        @* Statement documents — last section. Upload is the row's "Upload file"
                           action (TaxUploadFileDialog): a section header labels, it does not act. *@
                        <div class="tax-section">
                            <OdsSectionDivider Label="Statement documents"
                                               Meta="@($"{s.Files.Count} file{(s.Files.Count == 1 ? "" : "s")}")" />
                            <div class="tax-tbl-frame">
                                <TaxStatementFilesSection @key="@($"files:{s.TaxStatementId}:{_filesRefreshToken}")"
                                                          StatementId="s.TaxStatementId"
                                                          StatementName="@s.Name"
                                                          Files="s.Files"
                                                          Chrome="false"
                                                          CanUpload="false"
                                                          CanDownload="_canDownloadFiles"
                                                          CanDelete="_canUpdate"
                                                          OnChanged="OnFilesChanged" />
                            </div>
                        </div>
                    </Sections>
                </OdsRecordCard>
            </RenderItem>
            <CreateAction>
                @if (_canCreate)
                {
                    <OdsButton Variant="OdsButtonVariant.Filled" Icon="add" OnClick="AddClicked">New tax statement</OdsButton>
                }
            </CreateAction>
            <Trailing>
                @if (_canCreate)
                {
                    <OdsAddRow Title="New tax statement"
                               Sub="Record a fiscal year's declared figures, then reconcile against your accounts and tags."
                               OnClick="AddClicked" />
                }
            </Trailing>
        </OdsInfiniteList>
    </div>
</MudStack>
</div>

@if (_createKey != Guid.Empty)
{
    <CreateTaxStatementDialog @key="_createKey"
                              @bind-Open="_createOpen"
                              OnSaved="OnStatementCreated" />
}

@if (_editStatement is not null)
{
    <CreateTaxStatementDialog @key="_editStatementKey"
                              @bind-Open="_editStatementOpen"
                              Statement="_editStatement"
                              OnSaved="OnStatementEdited" />
}

@if (_uploadStatement is not null)
{
    <TaxUploadFileDialog @key="_uploadKey"
                         @bind-Open="_uploadOpen"
                         StatementId="_uploadStatement.TaxStatementId"
                         StatementName="@_uploadStatement.Name"
                         OnSaved="OnFilesChanged" />
}

@code {
    // The two meta-line entries. An inline render fragment is Razor syntax, so it cannot live in the
    // code-behind. One span each, so it becomes the .odc-record-metaitem's only child and picks up the
    // meta line's alignment.

    private RenderFragment PeriodMeta(string range) =>
        @<span>
            <span class="material-icons" aria-hidden="true">date_range</span><span>@range</span>
        </span>;

    // `currency`, not `code`: `@code` at the start of a line is the directive, so a parameter of
    // that name breaks the parse.
    private RenderFragment CurrencyMeta(string currency) =>
        @<span class="mono">
            <span class="material-icons" aria-hidden="true">payments</span><span>@currency</span>
        </span>;
}
