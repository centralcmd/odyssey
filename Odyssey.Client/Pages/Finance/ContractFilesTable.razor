@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IClipboardService Clipboard
@inject IJSRuntime JsRuntime
@inject IReferenceDataCache ReferenceData
@inject IContactQuickCreate ContactCreator
@inject AuthenticationStateProvider AuthenticationState
@inject IContractsApiClient Contracts

@*
    ContractFilesTable — the attachments table for a contract (issue #174 §7, extended by #146).
    Wraps the shared OdsFilesTable; downloads, the metadata update and detach hit the
    CONTRACT-SCOPED routes via IContractsApiClient so the IDOR-free guarantee holds (§7/§10) —
    never a generic by-file-id route. Attach is owned by the host's "Upload" action
    (ContractUploadDialog).

    Three things differ from the account files table:
      • Renameable=false — a contract document's name lives on the FileMetadata it references, and
        PUT …/files/{fileId} carries the document type and the four validity fields only, so the
        dialog reads "Edit document" and offers no rename.
      • RequireType — the update is a full replacement and ContractFileType.Signed is the enum's
        zero member, so an unsent type is refused rather than defaulted into a claim that the
        document is the signed agreement.
      • Archived — the server refuses both writes on an archived contract with a 400, so the table
        drops Edit and Delete rather than offering a doomed dialog; the host states why in text.

    After a successful metadata save the table re-reads GET …/files — this contract's documents
    alone — and hands them up through OnFilesRefreshed, rather than firing OnChanged and pulling the
    whole contract, the contracts list and the summary back down. That is what the list endpoint
    exists for: an update creates no row, so nothing outside this table can have changed. A DETACH
    does change the file count the section header and the list row show, so it keeps OnChanged.
*@

<OdsInlinePager Items="FileRows.ToList()" Context="pageRows">
    <OdsFilesTable Files="pageRows"
                   TypeFor="@(row => KindMeta(FileById(row.Id).FileType))"
                   Kinds="OdsTypeRegistries.ContractFileOptions"
                   Actions="@BuildMenu"
                   ValidityColumns="true"
                   Issuers="_issuerOptions"
                   IssuerFor="@(row => IssuerName(FileById(row.Id).IssuedBy))"
                   OnCreateContact="@(_canCreateContact ? CreateContactOption : null)"
                   Renameable="false"
                   RequireType="true"
                   OnSave="@SaveAction"
                   OnDelete="@DeleteAction"
                   AriaLabel="Contract documents"
                   Empty="@Empty" />
</OdsInlinePager>
