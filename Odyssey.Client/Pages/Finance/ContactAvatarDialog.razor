@*
    ContactAvatarDialog — the contact surface's binding of the shared crop dialog
    (issue #86 §3, issue #94 §5). It supplies ContactAvatarLimits, the person/organization copy and
    the POST; OdsImageCropDialog owns the stage, the three range controls, the accessibility contract
    and the upload construction.

    It is a thin wrapper rather than nothing at all because the contact/organization split lives here:
    the mask, the framing, the output format and every noun in the copy follow Contact.Type, and that
    is contact knowledge the shared component must not carry.

    NO NUMBER IS WRITTEN DOWN HERE either — the caps are ContactAvatarLimits members handed straight
    across.
*@

@using Odyssey.Dtos
@using Odyssey.Dtos.Journal
@inject IContactsApiClient ContactsApi

<OdsImageCropDialog Open="Open" OpenChanged="OpenChanged"
                    Title="@(IsPerson ? "Crop profile picture" : "Crop logo")"
                    Subject="@Noun"
                    ChooseLabel="@(IsPerson ? "Choose a picture" : "Choose a logo")"
                    Cover="IsPerson"
                    EmptyIcon="@(IsPerson ? "person" : "corporate_fare")"
                    Note="@Note"
                    AllowedContentTypes="ContactAvatarLimits.AllowedContentTypes"
                    TypeLabel="@ContactAvatarLimits.TypeLabel"
                    MaxSourceBytes="ContactAvatarLimits.MaxSourceBytes"
                    MaxSourceDimension="ContactAvatarLimits.MaxSourceDimension"
                    OutputDimension="ContactAvatarLimits.OutputDimension"
                    JpegQuality="ContactAvatarLimits.JpegQuality"
                    SurfaceMegabytes="ContactAvatarLimits.MaxAvatarMegabytes"
                    UploadName="@($"contact-{Noun}")"
                    OnUpload="UploadAsync"
                    OnSaved="OnSaved"
                    OnAnnounce="OnAnnounce" />

@code {
    /// <summary>Controls visibility. Bindable via <c>@bind-Open</c>.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The contact whose image is being set. Its type decides the mask, the framing and the
    /// output format; its id is the endpoint the crop is POSTed to.</summary>
    [Parameter, EditorRequired] public ExistingContact? Contact { get; set; }

    /// <summary>Raised after a successful save, so the list can re-read the contact's new
    /// <c>AvatarFileId</c> and invalidate its session cache.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>Optional announcement hook for the page's own live region.</summary>
    [Parameter] public EventCallback<string> OnAnnounce { get; set; }

    private bool IsPerson => Contact?.Type != ContactType.Organization;

    private string Noun => IsPerson ? "picture" : "logo";

    private string Note => IsPerson
        ? "Saved as a square JPEG and shown as a circle. Location, capture time and device details are removed from the stored file."
        : "Saved as a PNG with its transparency and shown contained on a neutral ground — a wordmark is never cut. Metadata is removed from the stored file.";

    /// <summary>
    /// The one piece the shared dialog cannot own: which endpoint the bytes go to. It is a delegate
    /// rather than an injected client inside <c>Components/</c>, so the shared dialog knows no
    /// resource at all.
    /// </summary>
    private async Task<ApiResult> UploadAsync(ApiUpload upload)
    {
        if (Contact is not { } contact)
        {
            return ApiResult.Failure(
                System.Net.HttpStatusCode.BadRequest,
                new ApiProblem { Detail = "No contact is selected." });
        }

        // The contact endpoint answers with the updated contact; the shared dialog only needs to know
        // whether it succeeded, so the body is dropped here rather than widening the delegate.
        var result = await ContactsApi.UploadAvatarAsync(contact.ContactId, upload);
        return result.IsSuccess
            ? ApiResult.Success(result.Status)
            : ApiResult.Failure(result.Status, result.Problem!);
    }
}
