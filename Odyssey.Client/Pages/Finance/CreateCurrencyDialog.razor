@*
    Create / edit dialog for a currency (Odyssey Design System · Currencies AddCurrencyModal).
    One dialog serves both modes: pass an existing currency to prefill and switch into edit mode.
    CurrencyCode is the ISO-4217 primary key, so edit mode locks it; only Symbol, Name and
    Minor units are editable. Archive / restore stays a row action and is preserved here.

    Both modes add the exchange-rate sync start date (issue #351) when the host says the caller may set
    it (system-settings.update); in edit mode only for a currency with one to set — not the provider's
    base, not an archived currency. It is a second write, made only when the date differs, after the
    currency's own; a new currency's is written with sync left off.
*@
@using System.Globalization
@using System.Net
@using Odyssey.Client.Authorization
@using Odyssey.Dtos
@using Odyssey.Dtos.Finance
@inject ICurrenciesApiClient Currencies
@inject IExchangeRateSyncApiClient Sync
@inject IReferenceDataCache ReferenceData
@inject ISnackbar Snackbar
@inject TimeProvider Time



<OdsFormDialog Open="Open" OpenChanged="OpenChanged" OnSaved="OnSaved"
               Icon="attach_money" Title="@(IsEdit ? "Edit currency" : "New currency")"
               Subtitle="@(IsEdit
                   ? "Update this currency's name, symbol, or precision."
                   : "Enable a currency your accounts and budgets can be denominated in.")"
               SubmitLabel="@(IsEdit ? "Save changes" : "Create currency")"
               SubmitIcon="@(IsEdit ? "check" : "add")"
               OnSubmit="SaveAsync">

    <!-- Code + Symbol -->
    <OdsFormRow>
        <MudTextField @bind-Value="_currencyCode"
                      Label="Code"
                      Placeholder="e.g. USD"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      MaxLength="3"
                      ReadOnly="@IsEdit"
                      HelperText="@(IsEdit ? "ISO-4217 code — can't be changed" : null)"
                      Error="@_codeError"
                      ErrorText="Enter an ISO 4217 code."
                      Immediate="true" />
        <MudTextField @bind-Value="_symbol"
                      Label="Symbol"
                      Placeholder="e.g. $"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Error="@_symbolError"
                      ErrorText="Enter a symbol." />
    </OdsFormRow>

    <!-- Name -->
    <MudTextField @bind-Value="_name"
                  Label="Name"
                  Placeholder="e.g. US Dollar"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Error="@_nameError"
                  ErrorText="Give the currency a name." />

    <!-- Minor units -->
    <MudNumericField T="int"
                     @bind-Value="_minorUnits"
                     Label="Minor units"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Min="0"
                     Max="12"
                     HideSpinButtons="true"
                     HelperText="Decimal places — 2 for most currencies, 0 for yen." />

    @if (ShowSyncStart)
    {
        @* Empty means the instance default, so there is no separate "Use default". *@
        <OdsDateField Id="currency-sync-start"
                      Label="Sync start date"
                      Value="_syncStart"
                      ValueChanged="OnSyncStartChanged"
                      Min="HistoryFloor" Max="TodayUtc"
                      Placeholder="@SyncStartPlaceholder"
                      Error="@_syncStartError"
                      Help="Rates are fetched from this date. Leave empty for the default. Moving it later keeps rates already fetched." />
    }
</OdsFormDialog>

