@page "/contracts"
@using System.Globalization
@using Odyssey.Client.Authorization
@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@attribute [Authorize(Policy = PermissionClaims.ContractsRead)]
@inject IContractsApiClient Contracts
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IClipboardService Clipboard
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IScrollManager ScrollManager
@inject Odyssey.Client.Services.IPageStateService PageState
@inject IReferenceDataCache ReferenceData
@inject IAccountsApiClient Accounts
@inject Odyssey.Client.Theme.IUserPreferenceService UserPreferences

<PageTitle>Contracts</PageTitle>

<OdsLiveAnnouncer Message="@_announce" />


<MudStack Spacing="4">

    @* The header signal is labelled "Upcoming" because it carries four groups, not one: a term that
       ran out, one running out, one about to start, and the charges falling due. They answer a single
       question, so they share one label, one count and one worst-severity reading on the button. *@
    <PageHeader Title="Contracts"
                Icon="@Icons.Material.Filled.Handshake"
                Problems="HeaderProblems"
                ProblemsLabel="Upcoming"
                ProblemsOpen="_problemsOpen" ProblemsOpenChanged="OnProblemsToggled"
                OverviewOpen="_overviewOpen" OverviewOpenChanged="OnOverviewToggled"
                SearchOpen="_searchOpen" SearchOpenChanged="OnSearchToggled"
                PrimaryActionText="New contract"
                OnPrimaryAction="AddClicked"
                ShowPrimaryAction="_canCreate">
        <SubLine>
            @ActiveCount contract@(ActiveCount == 1 ? "" : "s") on file
        </SubLine>

        <OverviewContent>
            @if (_summary is not null)
            {
                <ContractsSummaryView Summary="_summary" FormatMoney="FormatMoney" />
            }
        </OverviewContent>

        <SearchContent>
            <div class="ph-filter-bar">
                <OdsSearchField Value="@_searchString" ValueChanged="OnSearchChanged"
                                DebounceInterval="300" OnSearch="LoadContracts"
                                Placeholder="Search name, party, description…"
                                Class="ph-search" />
                <OdsMultiSelect Label="Any type" Icon="handshake" Values="_typeFilter" ValuesChanged="OnTypeFilterChanged"
                                Options="OdsTypeRegistries.ContractOptions" Class="ph-select" />
                <OdsMultiSelect Label="Any status" Icon="event_available" Values="_statusFilter" ValuesChanged="OnStatusFilterChanged"
                                Options="_statusOptions" Class="ph-select" />
                <OdsSortSelect TRow="ContractListItem" Fields="_sortFields" Sort="_sort" SortChanged="OnSortChanged" />
                <OdsPageSizeSelect Prefix="Load" Suffix="at a time" Label="Contracts per batch"
                                   Value="_batch" ValueChanged="OnBatchChanged" Options="OdsPageSizes.Batch" />
            </div>
        </SearchContent>
    </PageHeader>

    <div class="acct-list">
        <OdsInfiniteList TItem="ContractListItem" Items="_contracts" BatchSize="_batch"
                         ItemKey="@(c => (object)c.ContractId)" Noun="contracts" RevealKey="_flashId"
                         Loading="_isLoading" Refetching="_refetching" Error="_loadError" OnRetry="LoadContracts"
                         HasFilters="_hasFilters" OnClearFilters="ClearFilters"
                         EmptyIcon="handshake"
                         EmptyDescription="Add a contract to record its type and active period, link the parties it relates to, and keep every signed document in one place.">
            <RenderItem Context="c">
                @{
                    var archived = c.Archived is not null;
                    @* On file but not in force. The card stays at FULL brightness — these are the
                       rows most likely to need attention — and is marked instead by a dashed edge:
                       nothing about the agreement is settled yet. That is the opposite reading to
                       archived, which is dimmed because it is finished. *@
                    var unsigned = ContractStatusOrder.IsUnsigned(c.Status);
                    var typeInfo = OdsTypeRegistries.ContractTypeOf(c.Type);
                    var headline = Headline(c);
                    var detail = _details.GetValueOrDefault(c.ContractId);

                    @* The meta line: type · the contact this contract is with · "Money in" when any
                       term in force today is incoming. That last one is on the COLLAPSED row on
                       purpose: it changes how the whole row reads, and is otherwise visible only once
                       the record is expanded. *@
                    var meta = new List<RenderFragment?>
                    {
                        OdsRecordMeta.Text(typeInfo.Label),
                        ContactMeta(string.IsNullOrWhiteSpace(c.InstitutionName) ? "No contact" : c.InstitutionName),
                    };

                    @if (c.HasIncomingTerm)
                    {
                        meta.Add(IncomingMeta());
                    }

                    @* The header counts are the body's table of contents: same glyphs, same order
                       as the sections below, kept live while the body edits them. *@
                    var counts = new[]
                    {
                        new OdsRecordCount("diversity_3", c.PartyCount.ToString(CultureInfo.CurrentCulture), "Parties"),
                        @* Term ROWS, not values in force — the same "count rows, never resolved
                           values" rule the insurance link counts follow, so a busy price history
                           never reads as empty. *@
                        new OdsRecordCount("sell", c.TermCount.ToString(CultureInfo.CurrentCulture), "Terms"),
                        new OdsRecordCount("description", c.FileCount.ToString(CultureInfo.CurrentCulture), "Documents"),
                        @* The event log's size, last — the same order the body's sections run in.
                           Archival does not lock the log, so this count is live on an archived
                           contract too. *@
                        new OdsRecordCount("history", c.EventCount.ToString(CultureInfo.CurrentCulture), "Events"),
                    };
                }
                @* One accent per record, taken from the contract's TYPE — the header mark, every tile
                   icon chip in the body and the party rows' own marks all resolve from it.

                   Dimmed follows ARCHIVE alone: a paused contract stays at full brightness, which is
                   most of what distinguishes the two states. Pausing suspends what an agreement
                   costs; archiving retires the record. *@
                <OdsRecordCard Id="@($"con-{c.ContractId}")"
                               Icon="@typeInfo.Icon"
                               Accent="@typeInfo.Color"
                               AccentSoft="@typeInfo.Soft"
                               Name="@c.Name"
                               Meta="meta"
                               Counts="counts"
                               FigureCaption="@headline.Word"
                               FigureTone="@HeadlineTone(headline.Cls)"
                               Dimmed="archived"
                               Class="@(unsigned ? "con-unsigned" : null)"
                               Highlight="@(_flashId == c.ContractId)"
                               Open="IsExpanded(c.ContractId)"
                               OnToggle="@(_ => ToggleExpand(c.ContractId))">

                    <Chips>
                        <OdsContractStatusChip Status="c.Status" Compact="true" />
                    </Chips>

                    <Figure>@headline.Value</Figure>

                    <Actions>
                        <OdsMenu Items="RowActions(c, archived)" AriaLabel="@($"Actions for {c.Name}")" />
                    </Actions>

                    <Details>
                        @if (detail is null)
                        {
                            <div role="status" aria-live="polite" aria-busy="true">
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-hidden="true" />
                                <span class="sr-only">Loading contract details…</span>
                            </div>
                        }
                        else
                        {
                            @* The contract's full field set. A one-off has a completion date instead
                               of a term, so those tiles are alternatives, not omissions. Tense and
                               tone follow each date against today. *@
                            var oneOff = detail.CompletionDate is not null;
                            var startFuture = detail.StartDate is { } st && st.Date > Today;
                            var endPast = detail.EndDate is { } en && en.Date < Today;
                            var completionPast = detail.CompletionDate is { } cd && cd.Date <= Today;
                            var statusMeta = OdsContractStatus.Meta(detail.Status);
                            <OdsInfoTileGrid>
                                <OdsInfoTile Icon="handshake" Label="Name"
                                             ValueVariant="OdsInfoTileVariant.Text" WrapValue="true">
                                    <Value>@detail.Name</Value>
                                </OdsInfoTile>

                                @* No per-tile icon colour: the grid inherits the card's accent, which
                                   IS this contract's type colour. *@
                                <OdsInfoTile Icon="@typeInfo.Icon" Label="Type"
                                             ValueVariant="OdsInfoTileVariant.Text" Foot="@OdsInfoTile.Caption(oneOff ? "One-off" : "Term")">
                                    <Value>@typeInfo.Label</Value>
                                </OdsInfoTile>

                                @if (detail.CompletionDate is { } completion)
                                {
                                    <OdsInfoTile Icon="event_available"
                                                 Label="@(completionPast ? "Completed on" : "Completes on")"
                                                 ValueVariant="OdsInfoTileVariant.Sm"
                                                 Tone="@(completionPast ? OdsInfoTileTone.Default : OdsInfoTileTone.Info)"
                                                 Foot="@OdsInfoTile.Caption(completionPast ? "delivered on this date" : "upcoming")">
                                        <Value>@LongDate(completion)</Value>
                                    </OdsInfoTile>
                                }
                                else
                                {
                                    @if (detail.StartDate is { } start)
                                    {
                                        <OdsInfoTile Icon="play_circle"
                                                     Label="@(startFuture ? "Starts on" : "Started on")"
                                                     ValueVariant="OdsInfoTileVariant.Sm"
                                                     Tone="@(startFuture ? OdsInfoTileTone.Info : OdsInfoTileTone.Default)"
                                                     Foot="@OdsInfoTile.Caption(startFuture ? "upcoming" : null)">
                                            <Value>@LongDate(start)</Value>
                                        </OdsInfoTile>
                                    }

                                    @* The empty case is kept deliberately: whether an agreement ever
                                       stops is material, so "Open-ended" is a fact, not a blank. *@
                                    <OdsInfoTile Icon="event_busy"
                                                 Label="@(detail.EndDate is null ? "End date" : endPast ? "Ended on" : "Ends on")"
                                                 ValueVariant="@(detail.EndDate is null ? OdsInfoTileVariant.Text : OdsInfoTileVariant.Sm)"
                                                 Tone="@(endPast ? OdsInfoTileTone.Expense : OdsInfoTileTone.Default)"
                                                 Foot="@OdsInfoTile.Caption(detail.EndDate is null ? "runs until ended" : endPast ? "no longer in force" : "scheduled")">
                                        <Value>@(detail.EndDate is { } end ? LongDate(end) : "Open-ended")</Value>
                                    </OdsInfoTile>
                                }

                                @* A DERIVED summary: it carries the state and the date that state
                                   began, while the dates it derives from keep their own tiles. *@
                                <OdsInfoTile Icon="@statusMeta.Icon" Label="Status"
                                             ValueVariant="OdsInfoTileVariant.Text"
                                             Tone="@StatusTone(statusMeta.Tone)"
                                             Foot="@OdsInfoTile.Caption(StatusFoot(detail, oneOff))">
                                    <Value>@statusMeta.Label</Value>
                                </OdsInfoTile>

                                @* ONE TILE PER STORED STAMP, so nothing is lost when the derived
                                   status can only show one of them: an archived contract that is
                                   also paused still says when each began. The tiles are independent
                                   of each other rather than suppressed per case — correctness beats
                                   the small overlap with the Status tile above. *@
                                @* The two SIGNATURE stamps, in lifecycle order and ahead of the
                                   suspension ones: they are the earliest facts about the contract.
                                   A tile appears only once its stamp exists, so a plain Draft adds
                                   nothing to the grid — the Status tile has already said so. *@
                                @if (detail.Ready is { } readyAt)
                                {
                                    <OdsInfoTile Icon="draw" Label="Ready for signature"
                                                 ValueVariant="OdsInfoTileVariant.Sm"
                                                 Tone="@(detail.Signed is null ? OdsInfoTileTone.Pending : OdsInfoTileTone.Default)"
                                                 Foot="@OdsInfoTile.Caption(detail.Signed is null ? "waiting on a signature" : "sent out on this date")">
                                        <Value>@LongDate(readyAt)</Value>
                                    </OdsInfoTile>
                                }

                                @if (detail.Signed is { } signedAt)
                                {
                                    <OdsInfoTile Icon="history_edu" Label="Signed"
                                                 ValueVariant="OdsInfoTileVariant.Sm" Tone="OdsInfoTileTone.Income"
                                                 Foot="@OdsInfoTile.Caption("signed by all parties")">
                                        <Value>@LongDate(signedAt)</Value>
                                    </OdsInfoTile>
                                }

                                @if (detail.Paused is { } pausedAt)
                                {
                                    <OdsInfoTile Icon="pause_circle" Label="Paused"
                                                 ValueVariant="OdsInfoTileVariant.Sm" Tone="OdsInfoTileTone.Pending"
                                                 Foot="@OdsInfoTile.Caption("still listed and editable, not costing")">
                                        <Value>@LongDate(pausedAt)</Value>
                                    </OdsInfoTile>
                                }

                                @if (detail.Archived is { } archivedAt)
                                {
                                    <OdsInfoTile Icon="inventory_2" Label="Archived"
                                                 ValueVariant="OdsInfoTileVariant.Sm" Tone="OdsInfoTileTone.Muted"
                                                 Foot="@OdsInfoTile.Caption("hidden from the default list")">
                                        <Value>@LongDate(archivedAt)</Value>
                                    </OdsInfoTile>
                                }
                            </OdsInfoTileGrid>
                        }
                    </Details>

                    <Content>
                        @* Prose is not a field: the description goes in one wide tile. *@
                        @if (detail is { Description: { } description } && !string.IsNullOrWhiteSpace(description))
                        {
                            <OdsInfoTileGrid>
                                <OdsInfoTile Icon="sticky_note_2" Label="Description" Wide="true">
                                    <Value>@description</Value>
                                </OdsInfoTile>
                            </OdsInfoTileGrid>
                        }
                    </Content>

                    <Sections>
                        @if (detail is not null)
                        {
                            @* The "New term" request travels down as DATA, not through an @ref: only the
                               row whose id matches receives a token, so it can never reach the section
                               of a record the reader just navigated away from. *@
                            <ContractDetailView Contract="detail"
                                                CanWrite="_canUpdate"
                                                FormatMoney="FormatMoney"
                                                NewTermRequestToken="@NewTermRequestFor(c.ContractId)"
                                                NewEventRequestToken="@NewEventRequestFor(c.ContractId)"
                                                CanDownload="_canDownloadFiles"
                                                OnEditParty="@(p => EditParty(c.ContractId, p))"
                                                OnAnnounce="@(m => Announce(m))"
                                                OnChanged="@(() => ReloadContract(c.ContractId))"
                                                OnFilesRefreshed="@(files => ApplyContractFiles(c.ContractId, files))" />
                        }
                    </Sections>
                </OdsRecordCard>
            </RenderItem>
            <CreateAction>
                @if (_canCreate)
                {
                    <OdsButton Variant="OdsButtonVariant.Filled" Icon="add" OnClick="AddClicked">New contract</OdsButton>
                }
            </CreateAction>
            <Trailing>
                @if (_canCreate)
                {
                    <OdsAddRow Title="New contract"
                               Sub="Record a type and active period, link the parties, and upload the signed documents."
                               OnClick="AddClicked" />
                }
            </Trailing>
        </OdsInfiniteList>
    </div>
</MudStack>

@if (_createKey != Guid.Empty)
{
    <CreateContractDialog @key="_createKey"
                          @bind-Open="_createOpen"
                          OnSaved="OnContractCreated" />
}

@if (_editContract is not null)
{
    <CreateContractDialog @key="_editContractKey"
                          @bind-Open="_editContractOpen"
                          Contract="_editContract"
                          OnSaved="OnContractEdited" />
}

@if (_partyContract is not null)
{
    @* One dialog serves add and edit; _editingParty is what switches it. The @key is a fresh Guid per
       opening, so the dialog's OnInitializedAsync re-seeds from whichever party (or none) it now has. *@
    <AddContractPartyDialog @key="_partyKey"
                            @bind-Open="_partyOpen"
                            Contract="_partyContract"
                            Party="_editingParty"
                            Accounts="_accountOptions"
                            Institutions="_institutionOptions"
                            OnAnnounce="@(m => Announce(m))"
                            OnSaved="@(() => ReloadContract(_partyContract.ContractId))" />
}

@if (_uploadContract is not null)
{
    <ContractUploadDialog @key="_uploadKey"
                          @bind-Open="_uploadOpen"
                          Contract="_uploadContract"
                          OnSaved="@(() => ReloadContract(_uploadContract.ContractId))" />
}

@code {
    // The contact entry on the card's meta line. An inline render fragment is Razor syntax, so it
    // cannot live in the code-behind. One span, so it becomes the .odc-record-metaitem's only child
    // and picks up the meta line's alignment.
    private RenderFragment ContactMeta(string name) =>
        @<span class="con-sub-inst">
            <span class="material-icons" aria-hidden="true">groups</span><span>@name</span>
        </span>;

    // The "money in" marker on a collapsed row. A WORD and no glyph, in .trm-dir's quiet caption with
    // NO hue — the treatment that class carries everywhere else, because an arrow beside a figure
    // reads as that figure rising or falling, and because the FIGURE is what colours a direction
    // while the word carries its meaning. There is no figure on a collapsed row, so the word is the
    // whole carrier and the row reads the same in greyscale.
    //
    // The `in` class is inert: neither this stylesheet nor the design system's own defines a
    // .trm-dir.in rule. It is carried because the design system's Contracts.jsx emits exactly this
    // class list, so a later export that does give the modifier a rule lands without a markup change
    // here. Stated rather than left to be discovered, so nobody "restores" a colour that was never
    // meant to be there.
    private RenderFragment IncomingMeta() =>
        @<span class="trm-dir in">Money in</span>;

    // A derived next-movement row in the header signal panel — a charge or a receipt, one shape
    // either way. Razor syntax, so it lives here rather than in the code-behind that builds the rest
    // of the panel.
    private RenderFragment ChargeRow(ContractUpcomingCharge charge, bool incoming) =>
        @<ContractChargeRow Charge="charge" Money="FormatMoney" Incoming="incoming" OnView="JumpTo" />;
}
