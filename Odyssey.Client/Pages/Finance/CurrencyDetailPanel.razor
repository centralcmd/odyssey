@*
    Read-only detail panel for an expanded currency row in the OdsRecordTable
    (DS RecordTable renderDetail · ui_kits/web/Currencies CurDetail).
*@
@using System.Globalization
@using Odyssey.Dtos.Finance

<div class="odc-meta-grid">
    <OdsMetaTile Mono="true">
        <Label>Currency code</Label>
        <ChildContent>@Currency.CurrencyCode</ChildContent>
    </OdsMetaTile>
    <OdsMetaTile>
        <Label>Symbol</Label>
        <ChildContent>@(string.IsNullOrWhiteSpace(Currency.Symbol) ? "—" : Currency.Symbol)</ChildContent>
    </OdsMetaTile>
    <OdsMetaTile>
        <Label>Name</Label>
        <ChildContent>@Currency.Name</ChildContent>
    </OdsMetaTile>
    <OdsMetaTile>
        <Label>Minor units</Label>
        <ChildContent>@Currency.MinorUnits decimal place@(Currency.MinorUnits == 1 ? "" : "s")</ChildContent>
    </OdsMetaTile>
    <OdsMetaTile>
        <Label>Status</Label>
        <ChildContent>
            @if (Currency.Archived is not null)
            {
                <OdsChip Tone="OdsChipTone.Outline" Dot="true">Archived</OdsChip>
            }
            else
            {
                <OdsChip Tone="OdsChipTone.Income" Dot="true">Active</OdsChip>
            }
        </ChildContent>
    </OdsMetaTile>
    <OdsMetaTile Mono="true">
        <Label>Example amount</Label>
        <ChildContent>@Currency.Symbol@((1234.5m).ToString("N" + Currency.MinorUnits, CultureInfo.InvariantCulture))</ChildContent>
    </OdsMetaTile>
    @if (Currency.Archived is not null)
    {
        <OdsMetaTile Mono="true">
            <Label>Archived</Label>
            <ChildContent>@Currency.Archived.Value.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</ChildContent>
        </OdsMetaTile>
    }
</div>

@code {
    [Parameter, EditorRequired] public ExistingCurrency Currency { get; set; } = default!;
}
