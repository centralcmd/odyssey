@using Odyssey.Dtos.Finance
@inject ISnackbar Snackbar
@inject ITransactionsApiClient Transactions

@* Transaction list for an expanded budget card. The transactions shown are those
   whose tag is one of the budget's item tags and whose timestamp falls within the
   budget period — fetched via the transactions API tagIds/from/to parameters.

   Inside an OdsRecordCard the host passes Chrome="false" and introduces the section with
   its own OdsSectionDivider. The matched rows page in place there; the section carries no
   "View all" link, because a section header inside a record body labels, it does not act. *@
<OdsCollapsible Chrome="Chrome" Open="_isOpen" OnToggle="@(_ => ToggleOpen())" Lead="receipt_long">
    <Title>Transactions</Title>
    <Count>@_transactions.Count</Count>
    <ChildContent>
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_transactions.Count == 0)
        {
            <div class="empty-line">No transactions fall within this budget's period yet.</div>
        }
        else
        {
            @* The shared embedded ledger (matched transactions span accounts, so the Account column
               stays). A row carries the SAME action menu it does on the Transactions page. *@
            <TransactionListView Rows="_transactions" OnChanged="ReloadAsync" />
        }
    </ChildContent>
</OdsCollapsible>

@code {
    [Parameter] public Guid BudgetId { get; set; }
    [Parameter] public DateTime StartDate { get; set; }
    [Parameter] public DateTime EndDate { get; set; }

    /// <summary>
    /// The disclosure shell. False renders the section bare — no OdsCollapsible, no header — for a host
    /// that introduces it with its own OdsSectionDivider (an OdsRecordCard body).
    /// </summary>
    [Parameter] public bool Chrome { get; set; } = true;

    /// <summary>
    /// Raised after a write applied from a row's action menu — a status change, a delete, or a save
    /// from the edit dialog. The host's own record carries a transaction count and a rollup derived
    /// from these rows, so it has to refetch or its header keeps reporting the pre-write number.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    // Transaction-tag ids drawn from the budget's items. With no tags there is nothing
    // to match, so the list stays empty rather than fetching every transaction.
    [Parameter] public IReadOnlyCollection<Guid> TagIds { get; set; } = [];

    private List<ExistingTransaction> _transactions = [];
    private bool _isLoading;
    private bool _isOpen = false;

    // Identifies the tag/date inputs of the last successful load so we can refetch
    // when the budget's items or period change (e.g. after adding a budget item).
    private string? _loadedSignature;
    private string CurrentSignature =>
        $"{StartDate:o}|{EndDate:o}|{string.Join(',', TagIds.OrderBy(id => id))}";

    protected override async Task OnParametersSetAsync()
    {
        if (!OperatingSystem.IsBrowser()) return;

        // (Re)load whenever the tag/date inputs change — including the initial render
        // and after the parent refreshes the budget following an item edit.
        if (_loadedSignature != CurrentSignature && !_isLoading)
            await LoadTransactionsAsync();
    }

    private void ToggleOpen() => _isOpen = !_isOpen;

    // A row write changes this section's rows AND the host's matched count, so both reload.
    private async Task ReloadAsync()
    {
        await LoadTransactionsAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task LoadTransactionsAsync()
    {
        // No budget item tags means no transactions can match — skip the round trip.
        if (TagIds.Count == 0)
        {
            _transactions = [];
            _loadedSignature = CurrentSignature;
            return;
        }

        _isLoading = true;
        var signature = CurrentSignature;

        var result = await Transactions.ListAllAsync(
            tagIds: [.. TagIds.Select(id => id.ToString())],
            from: StartDate,
            to: EndDate);

        _transactions = result.ItemsOrToast(Snackbar, "transactions");
        if (result.IsSuccess)
            // Only cache the signature on success, so a transient failure retries next trigger.
            _loadedSignature = signature;

        _isLoading = false;
        StateHasChanged();
    }
}
