@*
    Read-only detail panel shown when a transaction row is expanded in the
    OdsRecordTable (DS RecordTable renderDetail · ui_kits/web/Transactions
    TxnDetail). An OdsRecordBody InTable — the same surface an OdsRecordCard
    expands into — whose Details slot is an OdsInfoTileGrid of the transaction's
    fields, followed by the attached-files section introduced by an
    OdsSectionDivider.

    Status updated is a field the DS mock data does not carry; it keeps its own
    tile rather than competing with the status comment for the Status foot.
*@
@using Odyssey.Dtos.Finance

<OdsRecordBody InTable="true">
    <Details>
        <OdsInfoTileGrid>
            <OdsInfoTile Icon="payments" Label="Amount"
                         Tone="@(IsIncome ? OdsInfoTileTone.Income : OdsInfoTileTone.Expense)"
                         Foot="@OdsInfoTile.Caption(IsIncome ? "Money in" : "Money out")">
                <Value>@SignedAmount</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="event" Label="Date" ValueVariant="OdsInfoTileVariant.Sm">
                <Value>@Transaction.TimeStamp.ToLocalTime().ToString("MMM dd, yyyy")</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="flag" Label="Status" ValueVariant="OdsInfoTileVariant.Text"
                         Foot="@OdsInfoTile.Caption(Transaction.StatusComment)">
                <Value>
                    <OdsChip Tone="@StatusTone(Transaction.Status)" Dot="true">@Transaction.Status</OdsChip>
                </Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="update" Label="Status updated" ValueVariant="OdsInfoTileVariant.Sm">
                <Value>@Transaction.StatusChangedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="account_balance" Label="Account" ValueVariant="OdsInfoTileVariant.Text"
                         Foot="@OdsInfoTile.Caption(string.IsNullOrWhiteSpace(Transaction.Account?.Name) ? null : Transaction.Account?.AccountNumber)">
                <Value>@(string.IsNullOrWhiteSpace(Transaction.Account?.Name) ? "—" : Transaction.Account!.Name)</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="person" Label="Contact" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@(string.IsNullOrWhiteSpace(Transaction.Contact?.ResolvedDisplayName) ? "—" : Transaction.Contact!.ResolvedDisplayName)</Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="sell" Label="@(Transaction.TransactionTags.Count == 1 ? "Tag" : "Tags")" ValueVariant="OdsInfoTileVariant.Text">
                <Value>
                    @if (Transaction.TransactionTags.Count > 0)
                    {
                        <OdsTagChips Tags="Transaction.TransactionTags" />
                    }
                    else
                    {
                        @("—")
                    }
                </Value>
            </OdsInfoTile>
            <OdsInfoTile Icon="paid" Label="Currency">
                <Value>@Transaction.CurrencyCode</Value>
            </OdsInfoTile>
            @if (!string.IsNullOrWhiteSpace(Transaction.ExternalId) || !string.IsNullOrWhiteSpace(Transaction.InternalId))
            {
                <OdsInfoTile Icon="fingerprint" Label="External ID">
                    <Value>@(string.IsNullOrWhiteSpace(Transaction.ExternalId) ? "—" : Transaction.ExternalId)</Value>
                </OdsInfoTile>
                <OdsInfoTile Icon="fingerprint" Label="Internal ID">
                    <Value>@(string.IsNullOrWhiteSpace(Transaction.InternalId) ? "—" : Transaction.InternalId)</Value>
                </OdsInfoTile>
            }
            @if (!string.IsNullOrWhiteSpace(Transaction.ExtraData))
            {
                <OdsInfoTile Icon="data_object" Label="Extra data" Wide="true" ValueVariant="OdsInfoTileVariant.Text">
                    <Value>@Transaction.ExtraData</Value>
                </OdsInfoTile>
            }
            <OdsInfoTile Icon="notes" Label="Description" Wide="true" ValueVariant="OdsInfoTileVariant.Text">
                <Value>@Transaction.Description</Value>
            </OdsInfoTile>
        </OdsInfoTileGrid>
    </Details>
    <Sections>
        <div class="acct-section">
            <OdsSectionDivider Label="Files" Meta="@FilesMeta" />
            <div class="acct-table-frame odc-scroll">
                <TransactionFilesSection TransactionId="@Transaction.TransactionId"
                                         Chrome="false"
                                         CanUpload="false"
                                         CanDownload="@CanDownloadFiles"
                                         CanDelete="false" />
            </div>
        </div>
    </Sections>
</OdsRecordBody>

@code {
    [Parameter, EditorRequired] public ExistingTransaction Transaction { get; set; } = default!;

    [Parameter] public bool CanDownloadFiles { get; set; }

    private bool IsIncome => Transaction.Amount >= 0;

    private string FilesMeta
    {
        get
        {
            var count = Transaction.TransactionFiles.Count;
            return $"{count} file{(count == 1 ? "" : "s")}";
        }
    }

    private string SignedAmount =>
        $"{(IsIncome ? "+" : "-")}{Math.Abs(Transaction.Amount).ToString("N2")} {Transaction.CurrencyCode}";

    private static OdsChipTone StatusTone(TransactionStatus status) => status switch
    {
        TransactionStatus.Approved => OdsChipTone.Income,
        TransactionStatus.Flagged => OdsChipTone.Expense,
        _ => OdsChipTone.Info,
    };
}
