@using Odyssey.Dtos.Application
@inject Odyssey.ApiClient.Resources.IProfileApiClient ProfileApi
@inject ISnackbar Snackbar
@* /account · "Your profile" (issue #316). Owns the working copy and the PUT; the page keeps the
   canonical profile so the header, avatar and Permissions tile re-render on save with no reload. *@

@if (_saved)
{
    <div class="alert info acc-block-alert" role="status">
        <span class="material-icons alert-icon" aria-hidden="true">check_circle</span>
        <div class="alert-body">
            <strong>Profile saved.</strong> Your name updates everywhere you appear — no need to sign out.
        </div>
    </div>
}

<MudCard Elevation="1" Class="ods-outline">
    <MudCardContent Class="pa-4">
        <div class="acc-cardhead bordered">
            <span class="acc-ic"><MudIcon Icon="@Icons.Material.Filled.Badge" /></span>
            <div class="acc-sec-titles">
                <div class="acc-sec-title">Your profile</div>
                <div class="acc-sec-sub">Your name and personal details. This is how you appear to other people in this workspace.</div>
            </div>
        </div>

        @* The preview mark IS the picture control (Odyssey Design System · Account kit): Change /
           Remove appear over the image on hover, and on focus for keyboard and touch. The token it
           writes belongs to the PAGE, raised through ProfileChanged below, so the header mark
           re-renders with it — a section-local token would satisfy the upload and leave the header
           showing the monogram. *@
        <div class="acc-profile-preview">
            <OdsProfilePictureField Variant="OdsProfilePictureVariant.Overlay"
                                    Version="@RenderableVersion"
                                    Src="@ImageSrc"
                                    Initials="@ProfileValidation.Initials(_draft)"
                                    Alt="Your profile picture"
                                    Bg="color-mix(in srgb, var(--mud-palette-primary) 14%, transparent)"
                                    Fg="var(--mud-palette-primary)"
                                    Busy="_uploading"
                                    Removing="_removing"
                                    Disabled="@ImageControlsDisabled"
                                    DisabledReason="@ClaimStaleReason"
                                    OnAdd="OpenCropDialog"
                                    OnRemove="RequestRemoval" />
            <div class="acc-profile-preview-id">
                <div class="acc-profile-preview-name">@PreviewName</div>
                <div class="acc-profile-preview-meta">
                    <OdsChip Tone="OdsChipTone.Info" Icon="visibility">Shown to others</OdsChip>
                    <span class="acc-profile-preview-hint">@PreviewHint</span>
                </div>
            </div>
        </div>

        <OdsProfileFields Model="_draft" ModelChanged="OnFieldsChanged"
                          Errors="Errors" IdPrefix="acc" />

        <OdsProfileTransparencyNote />

        <div class="acc-form-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@(_saving ? null : Icons.Material.Filled.Save)"
                       Disabled="@(!CanSave)" OnClick="SaveAsync">
                @if (_saving)
                {
                    <OdsSpinner Class="me-2" Decorative="true" />
                }
                Save profile
            </MudButton>
            @if (_saved)
            {
                <span class="acc-saved"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />Saved</span>
            }
        </div>
    </MudCardContent>
</MudCard>

@* The shared crop dialog, bound to the self-scoped POST. The delegate is the only thing this surface
   supplies that the contact surface does not — the stage, the controls and the accessibility contract
   are the component's. *@
<OdsImageCropDialog @bind-Open="_cropOpen"
                    Title="Crop profile picture"
                    Subject="picture"
                    ChooseLabel="Choose a picture"
                    Cover="true"
                    EmptyIcon="person"
                    Note="Saved as a square JPEG and shown as a circle. Location, capture time and device details are removed from the stored file."
                    AllowedContentTypes="UserProfileImageLimits.AllowedContentTypes"
                    TypeLabel="@UserProfileImageLimits.TypeLabel"
                    MaxSourceBytes="UserProfileImageLimits.MaxSourceBytes"
                    MaxSourceDimension="UserProfileImageLimits.MaxSourceDimension"
                    OutputDimension="UserProfileImageLimits.OutputDimension"
                    JpegQuality="UserProfileImageLimits.JpegQuality"
                    SurfaceMegabytes="UserProfileImageLimits.MaxImageMegabytes"
                    UploadName="profile-picture"
                    OnUpload="UploadImageAsync"
                    OnSaved="ImageSavedAsync" />

@* Removal deletes the stored bytes — it is not undone by re-picking the same crop — so it is
   confirmed. The copy belongs here, with the page that knows whose picture it is; the field raises
   OnRemove and nothing else. *@
<OdsFormDialog @bind-Open="_removeOpen"
               Icon="hide_image"
               IconTone="OdsModalTone.Warning"
               RequiredLegend="false"
               Title="Remove profile picture?"
               SubmitLabel="Remove picture"
               SubmitIcon="delete_outline"
               SubmitVariant="OdsButtonVariant.Danger"
               OnSubmit="RemoveImageConfirmedAsync">
    <p class="cpl-note">
        The stored image is <strong>deleted, not hidden</strong> — your initials are shown everywhere
        you appear. You can add a new picture at any time.
    </p>
</OdsFormDialog>

@* /account has no general-purpose status region to borrow — its only one is a static info alert — so
   a completed removal is announced through the reusable channel the import dialogs already use. *@
<OdsLiveAnnouncer Message="@_live" />
