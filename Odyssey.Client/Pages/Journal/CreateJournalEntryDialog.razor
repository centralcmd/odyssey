@using Microsoft.AspNetCore.Components.Authorization
@using Odyssey.ApiClient.Resources
@using Odyssey.Client.Authorization
@using Odyssey.Dtos.Authorization
@using Odyssey.Dtos.Journal
@using Odyssey.Client.Components
@using Odyssey.Client.Services
@inject IFilesApiClient Files
@inject ISnackbar Snackbar
@inject IJournalApiClient Journal
@inject Odyssey.Client.Services.IUploadLimitsCache UploadLimits
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IContactQuickCreate ContactCreator
@inject ITagQuickCreate<ExistingJournalTag> TagCreator

@*
    CreateJournalEntryDialog — the "New / Edit entry" dialog (issue #311; design-system update: edit
    mode reuses this dialog instead of the old inline-edit panel). Fields mirror the NewJournalEntry /
    UpdateJournalEntry DTOs via the shared JournalEntryFields grid. Newly-attached photos/files are
    uploaded through the existing Files store first (POST /api/files); the entry write stores only the
    resulting scalar ids.
*@

<OdsFormDialog Open="Open" OpenChanged="OpenChanged" OnSaved="OnSaved"
               Icon="menu_book" Title="@(IsEdit ? "Edit entry" : "New entry")" Wide="true"
               Subtitle="Title, content, an entry date, and any photos, files, tags, or contacts."
               SubmitLabel="@(IsEdit ? "Save changes" : "Create entry")"
               SubmitIcon="@(IsEdit ? "check" : "add")"
               OnSubmit="SaveAsync">
    @if (_loadingDetail)
    {
        <OdsSpinner Size="OdsSize.Lg" AriaLabel="Loading entry" />
    }
    else
    {
        <JournalEntryFields Draft="_draft" TagOptions="_tagOpts" ContactOptions="_contactOpts" AutoFocus="true"
                            OnCreateTag="@(_canCreateTag ? CreateTagOption : null)"
                            OnCreateContact="@(_canCreateContact ? CreateContactOption : null)"
                            MaxMegabytes="@_maxUploadMb" />
    }
</OdsFormDialog>
