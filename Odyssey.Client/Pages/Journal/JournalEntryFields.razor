@using Odyssey.Client.Components
@using Odyssey.Dtos.Finance
@inject IFilesApiClient Files
@inject ISnackbar Snackbar
@*
    JournalEntryFields — the shared field grid for a journal entry, bound to a JournalEntryDraft.
    Used by both CreateJournalEntryDialog and the inline edit form so create + edit stay identical.
    Links are chosen as scalar ids (OdsTagMultiSelect for both tags and contacts, per FE #4/#5).
    Photos and attachments are picked through the shared dialogs — "Add photos" (AttachPhotosDialog:
    upload new or pick from the library) and "Attach documents" (AttachDocumentsDialog: upload new or
    pick from Files) — so the draft only ever holds stored ids and nothing uploads at save. Content is
    plain text.

    Both member pickers can create, and their create rows name what they make: Tags mints a journal
    tag (never a transaction one — a field only offers the vocabulary it searches), Contacts mints a
    contact, so the rows there are the contact types and the created record carries a real one.
*@

<OdsField Label="Title" Required="true" Value="@Draft.Title" MaxLength="200" AutoFocus="@AutoFocus"
          ValueChanged="@(v => { Draft.Title = v; Draft.TitleError = null; })" Error="@Draft.TitleError" />

<OdsFormRow>
    <OdsDateField Label="Entry date" Required="true" Value="Draft.EntryDate"
                  ValueChanged="@(v => { Draft.EntryDate = v; Draft.EntryDateError = null; })" Error="@Draft.EntryDateError" />
    <OdsField Label="Location" Value="@Draft.Location" MaxLength="300"
              ValueChanged="@(v => Draft.Location = v)" Placeholder="Where this happened" />
</OdsFormRow>

<OdsFormRow>
    <OdsTagMultiSelect Label="Tags" Value="Draft.TagIds"
                       ValueChanged="@(v => Draft.TagIds = v)" Options="TagOptions"
                       Placeholder="No tags" AddLabel="Add tag"
                       OnCreate="OnCreateTag" CreateKinds="OdsTypeRegistries.TagCreateKinds.Journal" />
    <OdsTagMultiSelect Label="Contacts" Value="Draft.ContactIds"
                       ValueChanged="@(v => Draft.ContactIds = v)" Options="ContactOptions"
                       Placeholder="No linked contacts" AddLabel="Link contact" Noun="contact"
                       SearchLabel="Search contacts"
                       SearchPlaceholder="@(OnCreateContact is null ? "Search contacts…" : "Search or add a contact…")"
                       OnCreate="OnCreateContact" CreateLabel="Add"
                       CreateKinds="OdsTypeRegistries.ContactCreateKinds"
                       EmptyText="@(OnCreateContact is null ? "No contacts match" : "No matches — type to add one")" />
</OdsFormRow>

<OdsNoteField Label="Content" Required="true" Value="@Draft.Content" MaxLength="4096" Rows="6"
              ValueChanged="@(v => { Draft.Content = v; Draft.ContentError = null; })"
              Error="@Draft.ContentError" Placeholder="What happened?" />

<OdsFormRow>
    <OdsFieldShell Label="Photos">
        @if (Draft.Photos.Count > 0)
        {
            <ul class="jef-photos">
                @foreach (var p in Draft.Photos)
                {
                    <li class="jef-photo" title="@p.Name" @key="p.FileId"
                        style="background-image: url('@Files.ContentUrl(p.FileId)');">
                        <button type="button" class="jef-photo-remove" aria-label="@($"Remove {p.Name}")"
                                @onclick="@(() => Draft.Photos.Remove(p))">
                            <OdsMIcon Name="close" Size="14" />
                        </button>
                    </li>
                }
            </ul>
        }
        <div>
            <OdsButton Variant="OdsButtonVariant.Outlined" Icon="add_photo_alternate" OnClick="@(() => _pickingPhotos = true)">Add photos</OdsButton>
        </div>
    </OdsFieldShell>
    <OdsFieldShell Label="Attachments">
        @if (Draft.Attachments.Count > 0)
        {
            <div class="jef-files">
                <JournalFileRows Attachments="Draft.Attachments" CanDownload="CanDownload" SingleColumn="true"
                                 OnRemove="@(EventCallback.Factory.Create<Guid>(this, id => Draft.Attachments.RemoveAll(a => a.Id == id)))" />
            </div>
        }
        <div>
            <OdsButton Variant="OdsButtonVariant.Outlined" Icon="attach_file" OnClick="@(() => _pickingFiles = true)">Attach documents</OdsButton>
        </div>
    </OdsFieldShell>
</OdsFormRow>

@if (_pickingFiles)
{
    <AttachDocumentsDialog @bind-Open="_pickingFiles"
                           Subtitle="Keep documents with this entry. Files stay in Files; attaching links them here."
                           Announce="false"
                           AttachedIds="@([.. Draft.Attachments.Select(a => a.Id)])"
                           Attach="StageAttachmentAsync" />
}

@if (_pickingPhotos)
{
    <AttachPhotosDialog @bind-Open="_pickingPhotos"
                        CreateLibraryPhoto="false"
                        Subtitle="Add photos to this entry. Photos stay in your library; adding links them here."
                        AttachedIds="@([.. Draft.Photos.Select(p => p.FileId)])"
                        OnSubmit="StagePhotos" />
}

@code {
    [Parameter, EditorRequired] public JournalEntryDraft Draft { get; set; } = default!;

    /// <summary>Offers Download on an attachment row (<c>files.read</c>).</summary>
    [Parameter] public bool CanDownload { get; set; }

    /// <summary>Active journal-tag options (id → name).</summary>
    [Parameter] public IReadOnlyList<OdsOption> TagOptions { get; set; } = [];

    /// <summary>Active contact options (id → name).</summary>
    [Parameter] public IReadOnlyList<OdsOption> ContactOptions { get; set; } = [];

    /// <summary>
    /// Stage a journal tag from the Tags picker's create row, or null to withhold the row (the host
    /// gates it on <c>journal.tags.create</c>). The host owns the POST and the id reconcile, because
    /// it owns the save.
    /// </summary>
    [Parameter] public Func<string, string?, OdsOption?>? OnCreateTag { get; set; }

    /// <summary>Stage a contact from the Contacts picker's create rows, or null to withhold them
    /// (gated on <c>contacts.create</c>).</summary>
    [Parameter] public Func<string, string?, OdsOption?>? OnCreateContact { get; set; }

    /// <summary>Focus the Title field on first render (create dialog / entering edit).</summary>
    [Parameter] public bool AutoFocus { get; set; }

    private bool _pickingFiles;
    private bool _pickingPhotos;

    // The picker has already uploaded or picked the file; staging reads its metadata so the row shows
    // the same kind, size and date an attachment on a saved entry does. Nothing is linked until save.
    private async Task<bool> StageAttachmentAsync(AttachDocumentItem item)
    {
        var meta = await Files.GetMetadataAsync(item.FileId);
        if (meta is null)
        {
            Snackbar.Add($"Couldn’t read “{item.Name}”.", Severity.Error);
            return false;
        }
        if (Draft.Attachments.All(a => a.Id != meta.Id))
            Draft.Attachments.Add(meta);
        return true;
    }

    private void StagePhotos(IReadOnlyList<AttachPhotoItem> items)
    {
        foreach (var item in items.Where(i => Draft.Photos.All(p => p.FileId != i.FileId)))
            Draft.Photos.Add(new JournalDraftPhoto(item.FileId, item.Name));
    }
}
