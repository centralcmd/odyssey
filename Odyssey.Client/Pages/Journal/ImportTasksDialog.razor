@using Odyssey.Client.Components
@using Odyssey.Dtos.Journal
@*
    ImportTasksDialog — the VTODO/.ics task import dialog (issue #337, Odyssey Design System ·
    ImportTasksModal). A sibling of ImportCalendarDialog: same shell, same shared cal-imp-* result
    styling, minus the target-calendar selector (the board is a single shared resource).

    Opened from the Tasks page-header overflow menu (visible only when the caller holds BOTH
    tasks.create AND tasks.update). One shell, two phases:
      • compose — a single-file .ics picker (OdsFileUpload, Multiple=false / ShowKinds=false).
      • result  — the TaskIcsImportResult summary. Imported / updated show as plain counts; the SKIPPED
                  list is grouped by reason, each group expandable to its task titles (server caps
                  samples at 100). A soft-skip note tallies the unresolved CATEGORIES tag links and
                  odyssey-file: ATTACH references (§6). An OdsLiveAnnouncer announces the summary; focus
                  moves to the result heading.
*@

@inject ITaskApiClient Tasks
@inject Odyssey.Client.Services.IImportLimitsCache ImportLimits

<OdsModal Open="Open" OpenChanged="OpenChanged" OnClose="CloseAsync" Icon="upload_file"
          Title="@TitleContent" Subtitle="@(_result is null ? SubtitleContent : null)" Class="cal-imp-dialog">
    <ChildContent>
        <OdsLiveAnnouncer Message="@_announce" />

        @if (_result is null)
        {
            <div class="cal-imp-form">
                @if (_error is not null)
                {
                    <OdsAlert Severity="Severity.Error">@_error</OdsAlert>
                }

                <OdsFieldShell Label="iCalendar file" Error="@_fileError">
                    <OdsFileUpload Files="_files" FilesChanged="OnFilesChanged"
                                   Multiple="false" ShowKinds="false" Compact="true"
                                   Accept=".ics,text/calendar"
                                   Hint="@($"iCalendar (.ics) · one file · up to {_maxImportMb} MB")" />
                </OdsFieldShell>

                <div class="cal-imp-note">
                    <span class="material-icons" aria-hidden="true">info</span>
                    <span>Re-importing a file you exported from Odyssey updates the same tasks in place instead of duplicating them, matched on each VTODO's UID.</span>
                </div>
            </div>
        }
        else
        {
            <div class="cal-imp-result">
                <h3 class="cal-imp-result-h" tabindex="-1" @ref="_resultHeading">
                    Imported from <span class="cal-imp-result-cal">@_fileName</span>
                </h3>

                <div class="cal-imp-stats">
                    <div class="cal-imp-stat ok">
                        <span class="material-icons" aria-hidden="true">add_task</span>
                        <div class="cal-imp-stat-body">
                            <span class="cal-imp-stat-n">@_result.ImportedCount</span>
                            <span class="cal-imp-stat-l">imported</span>
                        </div>
                    </div>
                    <div class="cal-imp-stat upd">
                        <span class="material-icons" aria-hidden="true">sync</span>
                        <div class="cal-imp-stat-body">
                            <span class="cal-imp-stat-n">@_result.UpdatedCount</span>
                            <span class="cal-imp-stat-l">updated</span>
                        </div>
                    </div>
                    <div class="@($"cal-imp-stat{(SkippedTotal > 0 ? " skip" : "")}")">
                        <span class="material-icons" aria-hidden="true">@(SkippedTotal > 0 ? "rule" : "check_circle")</span>
                        <div class="cal-imp-stat-body">
                            <span class="cal-imp-stat-n">@SkippedTotal</span>
                            <span class="cal-imp-stat-l">skipped</span>
                        </div>
                    </div>
                </div>

                @if (SkippedTotal > 0)
                {
                    <div class="cal-imp-skips">
                        <div class="cal-imp-skips-head">Skipped tasks, by reason</div>
                        @foreach (var group in _result.Skipped)
                        {
                            var open = _openReasons.Contains(group.Reason);
                            <div class="@($"cal-imp-skip{(open ? " open" : "")}")">
                                <button type="button" class="cal-imp-skip-head" aria-expanded="@(open ? "true" : "false")" @onclick="@(() => ToggleReason(group.Reason))">
                                    <span class="material-icons cal-imp-skip-chev" aria-hidden="true">chevron_right</span>
                                    <span class="cal-imp-skip-reason">@group.Reason</span>
                                    <span class="cal-imp-skip-count">@group.Count</span>
                                </button>
                                @if (open)
                                {
                                    <ul class="cal-imp-skip-list">
                                        @foreach (var title in group.SampleTitles)
                                        {
                                            <li class="cal-imp-skip-item">
                                                <span class="material-icons" aria-hidden="true">playlist_remove</span>
                                                <span>@(string.IsNullOrWhiteSpace(title) ? "Untitled task" : title)</span>
                                            </li>
                                        }
                                        @if (group.Count > group.SampleTitles.Count)
                                        {
                                            <li class="cal-imp-skip-more">+@(group.Count - group.SampleTitles.Count) more</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="cal-imp-clean">
                        <span class="material-icons" aria-hidden="true">task_alt</span>Every task in the file imported cleanly.
                    </div>
                }

                @if (SoftSkips > 0)
                {
                    <div class="cal-imp-note">
                        <span class="material-icons" aria-hidden="true">link_off</span>
                        <span>@SoftSkipMessage</span>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <div class="cal-imp-footer">
            @if (_result is null)
            {
                <OdsButton Variant="OdsButtonVariant.Text" OnClick="CloseAsync">Cancel</OdsButton>
                <span class="cal-imp-footer-spacer"></span>
                <OdsButton Variant="OdsButtonVariant.Filled" Icon="upload_file" Loading="_isImporting" OnClick="SubmitAsync">Import</OdsButton>
            }
            else
            {
                <OdsButton Variant="OdsButtonVariant.Text" Icon="restart_alt" OnClick="Reset">Import another file</OdsButton>
                <span class="cal-imp-footer-spacer"></span>
                <OdsButton Variant="OdsButtonVariant.Filled" Icon="check" OnClick="CloseAsync">Done</OdsButton>
            }
        </div>
    </Footer>
</OdsModal>

@code {
    private RenderFragment TitleContent => @<text>Import tasks</text>;

    private RenderFragment SubtitleContent => @<text>Add tasks from an iCalendar (.ics) file of VTODO items — from Odyssey or any VTODO-capable app. Entries whose UID matches an existing task are updated in place; the rest are created. Recurring or invalid entries are skipped with a reason.</text>;
}
