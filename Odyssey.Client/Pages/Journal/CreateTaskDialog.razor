@using Microsoft.AspNetCore.Components.Authorization
@using Odyssey.ApiClient.Resources
@using Odyssey.Client.Authorization
@using Odyssey.Dtos.Authorization
@using Odyssey.Dtos.Journal
@using Odyssey.Client.Components
@using Odyssey.Client.Services
@inject ISnackbar Snackbar
@inject ITaskApiClient Tasks
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITagQuickCreate<ExistingJournalTaskTag> TagCreator

@*
    CreateTaskDialog — the "New task" / "Edit task" dialog (issue #311). Mirrors the NewJournalTask /
    UpdateJournalTask DTOs. Status is chosen only when editing (a new task starts in Backlog); the API
    maps the chosen status to its StartedAt/CompletedAt/Archived timestamps. Attachments are not edited
    here — the task row's "Attach documents" owns them (DS Tasks) — and an edit carries the loaded ids
    through unchanged, because the update replaces the whole set.
*@

<OdsFormDialog Open="Open" OpenChanged="OpenChanged" OnSaved="OnSaved"
               Icon="checklist" Title="@(_editing ? "Edit task" : "New task")"
               Subtitle="Title, optional details, a deadline, tags, and attachments."
               SubmitLabel="@(_editing ? "Save changes" : "Create task")" OnSubmit="SaveAsync">

    <OdsField Label="Title" Required="true" Value="@_draft.Title" MaxLength="200" AutoFocus="true"
              ValueChanged="@(v => { _draft.Title = v; _draft.TitleError = null; })" Error="@_draft.TitleError" />

    <OdsFormRow>
        <OdsDateField Label="Deadline" Value="_draft.Deadline"
                      ValueChanged="@(v => _draft.Deadline = v)" Placeholder="No deadline" />
        @if (_editing)
        {
            <OdsSelect Label="Status" Required="true" Value="@_draft.Status.ToString()" Options="_statusOptions"
                       ValueChanged="@(v => { if (Enum.TryParse<JournalTaskStatus>(v, out var s)) _draft.Status = s; })" />
        }
    </OdsFormRow>

    @* The create row mints a TASK tag — a field only offers the vocabulary it searches. *@
    <OdsTagMultiSelect Label="Tags" Value="_draft.TagIds"
                       ValueChanged="@(v => _draft.TagIds = v)" Options="_tagOpts"
                       Placeholder="No tags" AddLabel="Add tag"
                       OnCreate="@(_canCreateTag ? CreateTagOption : null)"
                       CreateKinds="OdsTypeRegistries.TagCreateKinds.Task" />

    <OdsNoteField Label="Content" MaxLength="4096" Rows="4"
                  Value="@_draft.Content" ValueChanged="@(v => _draft.Content = v)" Placeholder="Details, links, next steps…" />

</OdsFormDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The task being edited, or null to create.</summary>
    [Parameter] public ExistingJournalTask? Task { get; set; }

    /// <summary>Active task-tag options (id → name).</summary>
    [Parameter] public IReadOnlyList<OdsOption> TagOptions { get; set; } = [];

    /// <summary>Raised after a successful create/update so the host can refresh.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    private JournalTaskDraft _draft = new();
    private bool _editing;

    private static readonly IReadOnlyList<OdsOption> _statusOptions = JournalTaskUi.StatusOptions;

    private bool _canCreateTag;

    // Tags created inline, ahead of the host's option-list refresh, so their chips resolve at once.
    private readonly List<OdsOption> _createdTags = [];

    private IReadOnlyList<OdsOption> _tagOpts => _createdTags.Count == 0
        ? TagOptions
        : [.. _createdTags.Where(c => TagOptions.All(o => o.Value != c.Value)), .. TagOptions];

    protected override async Task OnInitializedAsync()
    {
        TagCreator.OnCreateFailed = OnTagCreateFailed;
        _editing = Task is not null;
        _draft = Task is not null ? JournalTaskDraft.From(Task) : new JournalTaskDraft();

        var user = await AuthenticationStateProvider.GetUserAsync();
        _canCreateTag = user.HasPermission(PermissionClaims.TaskTagsCreate);
    }

    private OdsOption? CreateTagOption(string text, string? kind)
    {
        var option = TagCreator.Begin(text);
        if (option is not null)
            _createdTags.Add(option);
        return option;
    }

    private void OnTagCreateFailed(string tempId)
    {
        _createdTags.RemoveAll(o => o.Value == tempId);
        _draft.TagIds = [.. _draft.TagIds.Where(id => id != tempId)];
        StateHasChanged();
    }

    private async Task<bool> SaveAsync()
    {
        if (!_draft.Validate())
            return false;

        // Let any in-flight inline tag create land, then map staged ids to the real ones; a failed
        // create resolves to null and is dropped rather than posted.
        await TagCreator.WhenSettledAsync();
        _draft.TagIds = [.. _draft.TagIds.Select(TagCreator.Resolve).Where(id => id is not null).Select(id => id!)];

        if (_editing)
        {
            var update = JournalTaskWrite.ToUpdate(_draft);
            return (await Tasks.UpdateAsync(Task!.JournalTaskId, update)).Toast(Snackbar, "Unable to update task", "Task updated.");
        }

        var create = JournalTaskWrite.ToNew(_draft);
        return (await Tasks.CreateAsync(create)).Toast(Snackbar, "Unable to create task", "Task created.");
    }
}
