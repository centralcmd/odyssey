# TEMPLATE, not a config file (issue #370). The image's stock 20-envsubst-on-templates.sh renders it to
# /etc/nginx/conf.d/default.conf at container start, substituting ONLY the map origin variable
# (NGINX_ENVSUBST_FILTER in the Dockerfile) — so $host, $scheme, $forwarded_proto and every other nginx
# variable pass through untouched. Never introduce another ${…} placeholder without widening that filter
# deliberately. 15-validate-map-origins.sh checks the value before the render; 25-assert-rendered-config.sh
# refuses to let nginx start on a missing or unrendered result.
#
# Honor an X-Forwarded-Proto set by an upstream TLS-terminating proxy (Caddy in production)
# instead of overwriting it with this hop's $scheme (always http on the internal Caddy→nginx
# leg). Without this the API would see https browser requests as http — breaking Secure
# cookies and triggering Production HTTPS redirects. Falls back to $scheme when no upstream
# proxy is present (e.g. the dev compose, where the browser hits nginx directly).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# ── The self-hosted basemap (issue #384) ─────────────────────────────────────────────────────────────────
# The access check's answers: a 204 per complete Cookie header, for 60 s, in memory (/var/cache/nginx is a
# tmpfs in the production overlay). The key is the WHOLE header, never one cookie: ASP.NET splits the large
# identity cookie into a base cookie whose value is the literal "chunks-N" — the same in every session — plus
# C1, C2, …, so any single-cookie key would let a forged base cookie ride another session's cached answer.
proxy_cache_path /var/cache/nginx/basemap_auth levels=1 keys_zone=basemap_auth:1m max_size=8m inactive=2m use_temp_path=off;

# 1 when the request carries no identity cookie: such a request is never stored and never served from the
# cache, so it always reaches the API and gets its 401.
map $http_cookie $basemap_no_session {
    "~(?:^|;\s*)\.AspNetCore\.Identity\.Application=" 0;
    default 1;
}

# The real client, for the rate limits. Behind Caddy every connection comes from Caddy's address, so keying on
# it would make one budget for every user. Caddy's reverse_proxy OVERWRITES X-Forwarded-For with the address
# it saw, so the last element is the client; any other front proxy must do the same (docs/deployment.md).
# Without a header (the dev stack) the connection address is used.
map $http_x_forwarded_for $basemap_client {
    "~(?<last>[^,\s]+)\s*$" $last;
    default $binary_remote_addr;
}

limit_req_zone  $basemap_client zone=basemap:10m rate=30r/s;
limit_conn_zone $basemap_client zone=basemap_conn:10m;

server {
    # 8080, not 80: the container runs as the non-root nginx user (unprivileged image), which
    # can't bind privileged ports. Caddy and the compose port mappings forward to 8080.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security response headers (defense-in-depth for a financial-PII SPA). Defined at the
    # server level so they're inherited by the location blocks below (nginx only inherits
    # add_header when the child level defines none of its own). HSTS is set at the Caddy TLS
    # edge instead, since it's only meaningful over https.
    #
    # The CSP is tuned to what the client actually loads (see wwwroot/index.html):
    #   - script-src needs 'wasm-unsafe-eval' for the Blazor WASM runtime and 'unsafe-inline'
    #     for the inline scripts in index.html. Dropping 'unsafe-inline' (GitHub #256) is not
    #     feasible for this statically-hosted WASM SPA: besides the small bootstrap/service-worker
    #     and JS-interop blocks, the SDK's fingerprinting (OverrideHtmlAssetPlaceholders) emits a
    #     load-bearing inline <script type="importmap"> that resolves dotnet.js/blazor.webassembly.js
    #     to their fingerprinted files. Its contents (per-build fingerprints + sha256 integrity
    #     hashes) change every build, so a static nonce/hash baked into this config can't cover it,
    #     and nginx serves these files statically with no per-request token to inject. Accepted as a
    #     documented Blazor-WASM bootstrap constraint; the rest of the CSP (object-src 'none',
    #     frame-ancestors 'none', base-uri/form-action 'self', scoped connect-src/img-src) is strict.
    #   - img-src and connect-src add the location map's tile host(s) (issue #370), from the deploy-time
    #     MAP_ALLOWED_ORIGINS — the same value the API checks its style URLs against. Empty is the
    #     off-switch: nothing but 'self'. The allowance is app-wide, which is why only DEDICATED tile hosts
    #     belong in it (docs/deployment.md, "Location map").
    #   - worker-src 'self' admits MapLibre's CSP-build worker, served from the app's own static assets.
    #     No blob: — that would let any inline script start an arbitrary worker.
    #   - style-src 'unsafe-inline' covers MudBlazor's injected inline styles. Roboto + Material
    #     Icons are self-hosted under wwwroot/fonts (see css/fonts.css), so fonts load from 'self'
    #     with no external origin — CSP needs no fonts.googleapis.com / fonts.gstatic.com allowance.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: ${MAP_ALLOWED_ORIGINS}; connect-src 'self' ${MAP_ALLOWED_ORIGINS}; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # API endpoint proxy (Blazor client calls /api/*)
    location /api/ {
        proxy_pass http://api:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;

        # The server-level add_header above already sends X-Content-Type-Options on every response,
        # this location included (it declares no add_header of its own, so it inherits them). The API
        # sets the same header on its download surfaces, so without this the browser receives it
        # twice ("nosniff, nosniff") and ContactAvatarRenderTests fails under Compose. nginx's copy is
        # the one that covers every response, so the upstream's is the one dropped.
        proxy_hide_header X-Content-Type-Options;

        # The api container sits on the same Docker network, so a healthy connect takes well under a
        # millisecond. nginx's 60 s default only matters when the API is DOWN (stopped, restarting):
        # every request then hangs a full minute before its 504, and the client's session probe — which
        # renders nothing until it has an answer — leaves a blank page for that long before the
        # "Unable to reach Odyssey" retry panel can appear. This bounds the connect only; a slow
        # response (a large upload, an AI analysis) is governed by proxy_read_timeout, unchanged.
        proxy_connect_timeout 5s;

        # File uploads (statement/document attach, AI analysis) go through this proxy. nginx's
        # default client_max_body_size is 1 MB, which would 413 any upload over ~1 MB before it
        # ever reaches the API — while the API accepts up to 64 MB of file content. Keep this at
        # or above the API's FileStorage:MaxFileSizeBytes plus the multipart envelope headroom
        # (64 MB + 1 MB). Caddy's request_body limit must stay >= this value.
        #
        # FileStorage:MaxFileSizeBytes is the startup TRANSPORT ceiling, not the cap users hit: that
        # one is admin-editable in System Settings and can only be set at or below the ceiling
        # (issue #421 Wave 4). So lowering the limit needs no change here; raising it past 64 MB means
        # raising this value and Caddy's first. See docs/deployment.md, "Upload size".
        client_max_body_size 65m;

        # The Identity auth cookie bakes every permission claim into its value, so the
        # login Set-Cookie response header is large (and grows as claims are added — e.g.
        # the insurance.* claims). nginx's default 4k/8k proxy header buffer overflows it
        # and returns 502 ("upstream sent too big header"). Size the buffers generously so
        # the full cookie passes through.
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
    }

    # Household locations (issue #350 §7.7): no access log. The geocoding search sends an address someone
    # typed — often their own — to a third party, and although that text travels in the request body, not
    # the URL, this keeps every /locations request out of the log as defence in depth.
    #
    # The browser's path is /api/api/locations…: the client's base address is /api/ and its own paths
    # start with api/, and the /api/ block above strips the first segment. ^~ makes this prefix win over
    # that block, so it must repeat every directive the /api/ block sets — nginx inherits none of them.
    # proxy_pass replaces the matched prefix, so /api/api/locations/search reaches the API as
    # /api/locations/search, exactly as through the /api/ block.
    location ^~ /api/api/locations {
        access_log off;

        proxy_pass http://api:8080/api/locations;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_hide_header X-Content-Type-Options;
        proxy_connect_timeout 5s;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
    }

    # ── The self-hosted basemap (issue #384 §5.2) ──────────────────────────────────────────────────────
    # The one file on the read-only basemap volume, to a signed-in session holding locations.read. NO add_header
    # in these locations: one would silently drop every server-level header above, the CSP and nosniff
    # included. Cache headers come from `expires`; the ETag is nginx's default, strong.
    location = /basemap/basemap.pmtiles {
        access_log off;
        disable_symlinks on;

        # Checked before anything else, so a refused request never costs an access-check call. The one form
        # the pmtiles library sends; no header, bytes=0-, a suffix range, a non-bytes unit (which nginx would
        # otherwise ignore and answer with the whole file) and every multi-range value are refused.
        if ($request_method != GET) {
            return 405;
        }
        if ($http_range !~ "^bytes=[0-9]+-[0-9]+$") {
            return 416;
        }
        max_ranges 1;

        limit_req zone=basemap burst=120 nodelay;
        limit_conn basemap_conn 16;
        limit_req_status 429;
        limit_conn_status 429;
        # A tile or directory range is far below 512 KB; a wide range drains at 1 MB/s per connection.
        limit_rate_after 512k;
        limit_rate 1m;

        auth_request /_basemap_access;

        default_type application/octet-stream;
        types { }
        expires epoch;
    }

    # Anything else under /basemap — and /basemap itself, which would otherwise reach the SPA fallback — is
    # unreachable, whatever is on the volume.
    location ^~ /basemap {
        access_log off;
        return 404;
    }

    # The access check (§5.1). Every line closes a failure a review found: Host and X-Forwarded-Proto, or
    # Production's HTTPS redirect becomes a 500; ignore the probe's no-store and Set-Cookie, or nothing is
    # ever cached.
    location = /_basemap_access {
        internal;
        access_log off;
        proxy_pass http://api:8080/api/map-styles/basemap-access;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Range "";
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_cache basemap_auth;
        proxy_cache_key $http_cookie;
        proxy_no_cache $basemap_no_session;
        proxy_cache_bypass $basemap_no_session;
        proxy_cache_valid 204 60s;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_hide_header Set-Cookie;
        proxy_hide_header X-Content-Type-Options;
    }

    # The self-hosted styles' glyphs: a shipped range as is, any other range as an empty glyph file, so a
    # label in an unshipped script draws without those characters instead of failing the map.
    location ^~ /maps/self-hosted/fonts/ {
        try_files $uri /maps/self-hosted/fonts/empty.pbf;
    }

    # The sprite: a missing file is a 404, never the SPA's index.html with a 200.
    location ^~ /maps/self-hosted/ {
        try_files $uri =404;
    }

    # Everything else is a client-side Blazor route. Fall back to index.html so hard
    # refreshes, bookmarks, and direct links (including /login, /register, /logout,
    # /manage/*, /auth/*) reach the SPA router instead of hitting the POST-only Identity
    # endpoints and returning 405. All API traffic — including the Identity endpoints the
    # client consumes — goes through the /api/ proxy block above.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
