<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Odyssey.Dtos\Odyssey.Dtos.csproj" />
    <ProjectReference Include="..\Odyssey.Core\Odyssey.Core.csproj" />
    <ProjectReference Include="..\Odyssey.Context\Odyssey.Context.csproj" />
    <ProjectReference Include="..\Odyssey.TestData\Odyssey.TestData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Moq" />
    <PackageReference Include="AwesomeAssertions" />
    <!-- The INDEPENDENT oracle for the metadata-strip guarantee (issue #86 §5.3, issue #94 AC 14). It
         is a test-only dependency on purpose: a source-lint keeps it off the request path, where the
         production walk produces the same two integers without a full EXIF/IPTC/ICC/XMP parse over
         untrusted input. Strip-then-verify only means something when the verifier shares no code with
         the stripper. -->
    <PackageReference Include="MetadataExtractor" />
  </ItemGroup>

</Project>
