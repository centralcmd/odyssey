{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Aspire": {
    // RootPassword/Password below are deliberately weak, dev-scoped placeholders, published in
    // this repository and listed as out of scope in SECURITY.md. The AppHost is a local dev
    // orchestrator only: it ships no container image and is not part of any release, so these
    // values never reach a deployment. Override them per-developer with user-secrets or
    // appsettings.Development.json, neither of which is in the repository:
    //   dotnet user-secrets set "Aspire:MariaDb:Password" <value> --project Odyssey.AppHost
    // They are non-empty on purpose — GetRequiredValue rejects blank credentials, which used to
    // reach the MariaDB container and make it fail to initialise with no indication of why
    // (issue #458). To deploy for real, use docker-compose.prod.yml and .env.prod.example.
    "MariaDb": {
      "Version": "11.4",
      "RootPassword": "root_password",
      "Database": "odyssey",
      "User": "odyssey",
      "Password": "odyssey_password",
      "HostPort": 3307,
      "ContainerPort": 3306,
      "DataVolumeName": "mariadb-data",
      "InitScriptsPath": "../docker/mariadb/init",
      "Server": "localhost"
    },
    "Api": {
      "Environment": "Development",
      "SwaggerEnabled": true,
      "Databases": {
        "Odyssey": "odyssey"
      }
    },
    "Client": {
      "Urls": "http://localhost:5199"
    },
    "Seed": {
      "DemoData": true
    }
  }
}
