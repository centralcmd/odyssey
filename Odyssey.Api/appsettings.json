{
  "UseInMemoryDatabase": false,
  "ConnectionStrings": {
    "OdysseyConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5199",
      "https://localhost:7199"
    ]
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseStartTls": true,
    "ClientBaseUrl": "http://localhost:5199"
  },
  "FileStorage": {
    "MaxFileSizeBytes": 67108864
  },
  "RateLimiting": {
    "Identity": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "IdentityEmail": {
      "PermitLimit": 5,
      "WindowSeconds": 900
    },
    "AdminPasswordReset": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    },
    "PasswordChange": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    }
  },
  "FileAnalysis": {
    "Provider": "Claude",
    "TimeoutSeconds": 120,
    "PromptVersion": "1.0",
    "PromptTemplatePath": "Resources/Prompts/transaction-extraction.txt"
  }
}
