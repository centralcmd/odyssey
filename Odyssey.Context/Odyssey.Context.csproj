<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Odyssey.Dtos\Odyssey.Dtos.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
      <!-- IDataProtectionProvider / IDataProtector only (issue #444 §14). This is a plain
           Microsoft.NET.Sdk library with no ASP.NET Core framework reference, so the abstractions
           package is what makes the protector seam declarable here rather than in Odyssey.Api. -->
      <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <!-- Explicit so 9.0.13 flows to consumers of this project. Pomelo only floors
           Relational at 9.0.0, which produced an MSB3277 conflict downstream. -->
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
      <PackageReference Include="MySqlConnector" />
      <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    </ItemGroup>

    <ItemGroup>
      <!-- The repository LICENSE is the text of record for License acceptance (issue #354 §5): the API
           hashes it to decide who still owes consent and the demo seeder hashes it to seed matching
           acceptance rows. Declared here so it flows to the output of every referencing project — the
           published API image, the migration runner, and the test projects. -->
      <Content Include="..\LICENSE" Link="LICENSE">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Migrations\" />
    </ItemGroup>

</Project>
